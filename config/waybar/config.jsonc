{
    "layer": "top",
    "position": "top",
    "height": 30,
    "keyboard-interactive": true,
    "spacing": 6,
    "margin-top": 4,
    "margin-left": 6,
    "margin-right": 6,
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "custom/media",
        "custom/settings",
        "custom/calendar"
    ],
    "modules-right": [
        "custom/desktop",
        "custom/cliphist",
        "custom/screenshot",
        "custom/audio",
        "custom/netcycle",
        "custom/cpu",
        "custom/ram",
        "custom/notifications",
        "custom/session"
    ],
    "niri/workspaces": {
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "active": "\uf111",
            "default": "\uf111"
        }
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 153,
        "tooltip": false
    },
    "custom/settings": {
        "format": "\uf013",
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl settings"
    },
    "custom/calendar": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent calendar",
        "return-type": "json",
        "interval": 1,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup calendar",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl settings calendar"
    },
    "custom/desktop": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent display",
        "return-type": "json",
        "interval": 10,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup display",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl settings display"
    },
    "custom/cliphist": {
        "format": "\uf0ea",
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup clipboard",
        "tooltip": false
    },
    "custom/screenshot": {
        "format": "\uf030",
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup capture",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl action capture repeat"
    },
    "custom/audio": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent audio",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup audio",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "custom/netcycle": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent network",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup network",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl action network cycle-iface",
        "on-click-middle": "/usr/local/lib/nc-ui/bin/nc-ctl action network toggle-unit"
    },
    "custom/cpu": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent cpu",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup cpu",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl settings cpu"
    },
    "custom/ram": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent ram",
        "return-type": "json",
        "interval": 3,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup ram",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl settings ram"
    },
    "custom/notifications": {
        "class": "module-nc",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent notifications",
        "return-type": "json",
        "interval": 5,
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup notifications"
    },
    "custom/media": {
        "class": "module-nc-media",
        "exec": "/usr/local/lib/nc-ui/bin/nc-bar-agent media",
        "return-type": "json",
        "interval": 2,
        "tooltip": false
    },
    "custom/session": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "/usr/local/lib/nc-ui/bin/nc-ctl popup session",
        "on-click-right": "/usr/local/lib/nc-ui/bin/nc-ctl settings waybar"
    }
}
