_is_valid_recovery_user() {
    local u="${1:-}"
    [[ "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || return 1
    case "$u" in
        root|bin|daemon|mail|ftp|http|nobody|dbus|polkitd|tss|sshd|greeter|systemd-*) return 1 ;;
    esac
    return 0
}

load_rescue_config() {
    local host_def
    host_def="$(uname -n 2>/dev/null | cut -d. -f1 || true)"
    CFG_HOSTNAME="${host_def:-linux}"
    if [[ -r "$CONF_FILE" ]]; then
        local sec="" line k v
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            [[ -n "$line" ]] || continue
            if [[ "$line" =~ ^\[([a-zA-Z0-9_.-]+)\]$ ]]; then
                sec="${BASH_REMATCH[1]}"
                continue
            fi
            if [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*(true|false|\"[^\"]*\")$ ]]; then
                k="${BASH_REMATCH[1]}"
                v="${BASH_REMATCH[2]}"
                v="${v#\"}"; v="${v%\"}"
                case "${sec}.${k}" in
                    identity.hostname)    CFG_HOSTNAME="$v" ;;
                    snapshots.esp_mount)  CFG_ESP_MOUNT="${v%/}"; [[ -n "$CFG_ESP_MOUNT" ]] || CFG_ESP_MOUNT="/boot" ;;
                    snapshots.vg_name)    CFG_VG_NAME="$v" ;;
                    vault.smb_creds_file) CFG_SMB_CREDS="$v" ;;
                    recovery.uki_name)    [[ -n "$v" ]] && CFG_UKI_NAME="$v" ;;
                    recovery.sign_sbctl)  CFG_SIGN_SBCTL="$v" ;;
                    recovery.golden_subdir) CFG_GOLDEN_SUBDIR="$v" ;;
                    recovery.user)        _is_valid_recovery_user "$v" && CFG_RECOVERY_USER="$v" ;;
                esac
            fi
        done < "$CONF_FILE"
    fi
    return 0
}

