_resolve_host_desktop_user() {
    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        printf '%s' "$SUDO_USER"
        return 0
    fi
    local u uid h
    while IFS=: read -r u _ uid _ _ h _; do
        if [[ "$uid" =~ ^[0-9]+$ ]] && (( uid >= 1000 && uid < 65000 )) && [[ -d "${h}/.config/ncui" ]]; then
            printf '%s' "$u"
            return 0
        fi
    done < /etc/passwd
    return 1
}

