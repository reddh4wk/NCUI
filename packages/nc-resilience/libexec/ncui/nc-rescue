_dir_allows_exec() {
    local d="$1" opts=""
    while [[ -n "$d" && ! -e "$d" && "$d" != "/" ]]; do
        d="$(dirname "$d")"
    done
    [[ -n "$d" && -e "$d" ]] || return 1
    opts="$(findmnt -n -o OPTIONS -T "$d" 2>/dev/null || true)"
    [[ ",${opts}," != *",noexec,"* ]]
}

_pick_exec_work_base() {
    local min_bytes="${1:-0}" c p avail best_c="" best_avail=-1
    if [[ -n "${NC_BUILD_TMPDIR:-}" ]]; then
        if ! _dir_allows_exec "$NC_BUILD_TMPDIR"; then
            msg_err "NC_BUILD_TMPDIR '${NC_BUILD_TMPDIR}' is mounted noexec." >&2
            return 1
        fi
        mkdir -p "$NC_BUILD_TMPDIR"
        printf '%s\n' "$NC_BUILD_TMPDIR"
        return 0
    fi
    for c in "/var/tmp" "/var/lib/ncui/work" "/root/.cache/ncui-work" "/tmp"; do
        _dir_allows_exec "$c" || continue
        p="$c"
        while [[ -n "$p" && ! -d "$p" && "$p" != "/" ]]; do
            p="$(dirname "$p")"
        done
        avail="$(df -PB1 "$p" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
        [[ "$avail" =~ ^[0-9]+$ ]] || avail=0
        if (( avail > best_avail )); then
            best_avail="$avail"
            best_c="$c"
        fi
        if (( avail >= min_bytes )); then
            mkdir -p "$c"
            printf '%s\n' "$c"
            return 0
        fi
    done
    if [[ -n "$best_c" ]]; then
        mkdir -p "$best_c"
        printf '%s\n' "$best_c"
        return 0
    fi
    msg_err "No exec-capable temporary directory found (all candidates mounted noexec). Set NC_BUILD_TMPDIR." >&2
    return 1
}

_mount_chroot_api() {
    local dir="$1"
    [[ -n "$dir" && -d "$dir" ]] || return 1
    mkdir -p "${dir}/proc" "${dir}/sys" "${dir}/dev" "${dir}/dev/pts" "${dir}/run" "${dir}/etc"
    mountpoint -q "${dir}/proc" 2>/dev/null || mount -t proc proc "${dir}/proc"
    mountpoint -q "${dir}/sys" 2>/dev/null || mount -t sysfs sysfs "${dir}/sys"
    mountpoint -q "${dir}/dev" 2>/dev/null || { mount --bind /dev "${dir}/dev"; mount --make-rslave "${dir}/dev" 2>/dev/null || true; }
    mountpoint -q "${dir}/dev/pts" 2>/dev/null || mount -t devpts devpts "${dir}/dev/pts" 2>/dev/null || true
    mountpoint -q "${dir}/run" 2>/dev/null || mount -t tmpfs -o mode=0755,nosuid,nodev run "${dir}/run"
    if [[ -f /etc/resolv.conf ]]; then
        rm -f "${dir}/etc/resolv.conf" 2>/dev/null || true
        cp -L /etc/resolv.conf "${dir}/etc/resolv.conf" 2>/dev/null || true
    fi
}

_umount_chroot_api() {
    local dir="${1%/}" include_self="${2:-0}"
    [[ -n "$dir" && "$dir" != "/" ]] || return 0
    local submounts=() _id _pid _maj _rt _mp _rest
    while read -r _id _pid _maj _rt _mp _rest; do
        [[ -n "$_mp" ]] || continue
        _mp="${_mp//\\040/ }"; _mp="${_mp//\\011/$'\t'}"; _mp="${_mp//\\134/\\}"
        if [[ "$_mp" == "${dir}/"* ]] || { (( include_self == 1 )) && [[ "$_mp" == "$dir" ]]; }; then
            submounts+=("$_mp")
        fi
    done < /proc/self/mountinfo
    if (( ${#submounts[@]} > 0 )); then
        local rev=() m
        mapfile -t rev < <(printf '%s\n' "${submounts[@]}" | tac)
        for m in "${rev[@]}"; do
            umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
        done
    fi
}

_safe_rm_chroot_dir() {
    local dir="${1%/}"
    [[ -n "$dir" && "$dir" != "/" && -e "$dir" ]] || return 0
    _umount_chroot_api "$dir" 0
    local _id _pid _maj _rt _mp _rest
    while read -r _id _pid _maj _rt _mp _rest; do
        [[ -n "$_mp" ]] || continue
        _mp="${_mp//\\040/ }"; _mp="${_mp//\\011/$'\t'}"; _mp="${_mp//\\134/\\}"
        if [[ "$_mp" == "${dir}/"* || "$_mp" == "$dir" ]]; then
            msg_err "Refusing to remove ${dir}: active mount remains at ${_mp}." >&2
            return 1
        fi
    done < /proc/self/mountinfo
    rm -rf --one-file-system "$dir"
}

_cleanup_arch_bootstrap() {
    if [[ -n "${ARCH_BOOTSTRAP_DIR:-}" ]]; then
        _umount_chroot_api "$ARCH_BOOTSTRAP_DIR" 1
    fi
}

_ensure_arch_builder() {
    if command -v pacman >/dev/null 2>&1 && command -v pacstrap >/dev/null 2>&1; then
        ARCH_BOOTSTRAP_DIR=""
        return 0
    fi

    local dl_tool=""
    if command -v curl >/dev/null 2>&1; then
        dl_tool="curl"
    elif command -v wget >/dev/null 2>&1; then
        dl_tool="wget"
    else
        msg_err "Non-Arch host detected: curl or wget required to download Arch bootstrap."
        exit 1
    fi
    local req_b
    for req_b in tar zstd chroot mount; do
        command -v "$req_b" >/dev/null 2>&1 || { msg_err "MISSING: '${req_b}' required for Arch bootstrap on non-Arch host."; exit 1; }
    done

    if [[ -z "$ARCH_BOOTSTRAP_CACHE" ]]; then
        local bs_base
        bs_base="$(_pick_exec_work_base 1073741824)" || exit 1
        ARCH_BOOTSTRAP_CACHE="${bs_base}/ncui-arch-bootstrap"
    fi
    ARCH_BOOTSTRAP_DIR="${ARCH_BOOTSTRAP_CACHE}/root.x86_64"
    mkdir -p "$ARCH_BOOTSTRAP_CACHE"

    if [[ ! -f "${ARCH_BOOTSTRAP_DIR}/.ncui-bootstrapped" ]]; then
        local tb_path="${NC_ARCH_BOOTSTRAP_TARBALL:-}"
        if [[ -z "$tb_path" || ! -f "$tb_path" ]]; then
            tb_path="${ARCH_BOOTSTRAP_CACHE}/archlinux-bootstrap-x86_64.tar.zst"
            local sha_path="${ARCH_BOOTSTRAP_CACHE}/sha256sums.txt"
            msg_step "Non-Arch host detected: fetching official Arch Linux bootstrap tarball..."
            if [[ "$dl_tool" == "curl" ]]; then
                curl -fL --retry 3 -o "$tb_path" "$ARCH_BOOTSTRAP_URL"
                curl -fL --retry 3 -o "$sha_path" "$ARCH_BOOTSTRAP_SHA_URL" 2>/dev/null || true
            else
                wget -O "$tb_path" "$ARCH_BOOTSTRAP_URL"
                wget -O "$sha_path" "$ARCH_BOOTSTRAP_SHA_URL" 2>/dev/null || true
            fi
            if [[ -s "$sha_path" ]] && command -v sha256sum >/dev/null 2>&1; then
                local exp_sha got_sha
                exp_sha="$(awk '/archlinux-bootstrap-x86_64\.tar\.zst$/ {print $1; exit}' "$sha_path" || true)"
                if [[ -n "$exp_sha" ]]; then
                    got_sha="$(sha256sum "$tb_path" | awk '{print $1}')"
                    if [[ "$exp_sha" != "$got_sha" ]]; then
                        rm -f "$tb_path"
                        msg_err "Arch bootstrap SHA-256 verification failed!"
                        exit 1
                    fi
                fi
            fi
        fi

        rm -rf "$ARCH_BOOTSTRAP_DIR"
        msg_step "Extracting Arch bootstrap into ${ARCH_BOOTSTRAP_CACHE}..."
        tar --zstd -xf "$tb_path" -C "$ARCH_BOOTSTRAP_CACHE"
        [[ -d "$ARCH_BOOTSTRAP_DIR" ]] || { msg_err "Bootstrap directory ${ARCH_BOOTSTRAP_DIR} missing after extraction."; exit 1; }

        printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n' > "${ARCH_BOOTSTRAP_DIR}/etc/pacman.d/mirrorlist"
        if [[ -n "${NC_ARCH_NCUI_REPO_URL:-}" ]] && ! grep -q '^\[ncui\]' "${ARCH_BOOTSTRAP_DIR}/etc/pacman.conf" 2>/dev/null; then
            cat >> "${ARCH_BOOTSTRAP_DIR}/etc/pacman.conf" <<EOF_REPO

[ncui]
SigLevel = Optional TrustAll
Server = ${NC_ARCH_NCUI_REPO_URL}
EOF_REPO
        fi

        mountpoint -q "$ARCH_BOOTSTRAP_DIR" 2>/dev/null || mount --bind "$ARCH_BOOTSTRAP_DIR" "$ARCH_BOOTSTRAP_DIR"
        _mount_chroot_api "$ARCH_BOOTSTRAP_DIR"
        msg_step "Initializing Arch pacman keyring & arch-install-scripts inside bootstrap..."
        chroot "$ARCH_BOOTSTRAP_DIR" pacman-key --init
        chroot "$ARCH_BOOTSTRAP_DIR" pacman-key --populate archlinux
        chroot "$ARCH_BOOTSTRAP_DIR" pacman -Sy --noconfirm
        chroot "$ARCH_BOOTSTRAP_DIR" pacman -S --noconfirm --needed arch-install-scripts
        touch "${ARCH_BOOTSTRAP_DIR}/.ncui-bootstrapped"
    else
        mountpoint -q "$ARCH_BOOTSTRAP_DIR" 2>/dev/null || mount --bind "$ARCH_BOOTSTRAP_DIR" "$ARCH_BOOTSTRAP_DIR"
        _mount_chroot_api "$ARCH_BOOTSTRAP_DIR"
        msg_step "Syncing Arch bootstrap pacman databases..."
        chroot "$ARCH_BOOTSTRAP_DIR" pacman -Sy --noconfirm
    fi
}

_arch_pacman() {
    if [[ -z "${ARCH_BOOTSTRAP_DIR:-}" ]]; then
        pacman "$@"
    else
        chroot "$ARCH_BOOTSTRAP_DIR" pacman "$@"
    fi
}

_arch_pacman_si() {
    _arch_pacman -Si "$1" >/dev/null 2>&1
}

_arch_host_pacman_q() {
    [[ -z "${ARCH_BOOTSTRAP_DIR:-}" ]] && command -v pacman >/dev/null 2>&1 && pacman -Q "$1" >/dev/null 2>&1
}

_arch_pacstrap() {
    local target_dir="$1"
    shift
    mkdir -p "${target_dir}/etc/pacman.d/hooks"
    if [[ -z "${ARCH_BOOTSTRAP_DIR:-}" ]]; then
        local tmp_conf rc=0
        tmp_conf="$(mktemp /tmp/ncui-pacstrap.conf.XXXXXX)"
        awk -v hd="${target_dir}/etc/pacman.d/hooks/" '
            /^\[options\][[:space:]]*$/ { print; print "HookDir = " hd; next }
            /^[[:space:]]*HookDir[[:space:]]*=/ { next }
            { print }
        ' /etc/pacman.conf > "$tmp_conf"
        pacstrap -C "$tmp_conf" -c "$target_dir" "$@" || rc=$?
        rm -f "$tmp_conf"
        return "$rc"
    else
        local bs_tgt="${ARCH_BOOTSTRAP_DIR}/mnt/target"
        mkdir -p "$bs_tgt"
        mountpoint -q "$bs_tgt" 2>/dev/null || mount --bind "$target_dir" "$bs_tgt"
        local rc=0
        chroot "$ARCH_BOOTSTRAP_DIR" pacstrap -c -G -M /mnt/target "$@" || rc=$?
        umount "$bs_tgt" 2>/dev/null || umount -l "$bs_tgt" 2>/dev/null || true
        return "$rc"
    fi
}

_arch_pacman_root_S() {
    local target_dir="$1"
    shift
    mkdir -p "${target_dir}/etc/pacman.d/hooks"
    if [[ -z "${ARCH_BOOTSTRAP_DIR:-}" ]]; then
        pacman --noconfirm --needed -S --root "$target_dir" --hookdir "${target_dir}/etc/pacman.d/hooks/" --cachedir /var/cache/pacman/pkg "$@"
    else
        local bs_tgt="${ARCH_BOOTSTRAP_DIR}/mnt/target"
        mkdir -p "$bs_tgt"
        mountpoint -q "$bs_tgt" 2>/dev/null || mount --bind "$target_dir" "$bs_tgt"
        local rc=0
        chroot "$ARCH_BOOTSTRAP_DIR" pacman --noconfirm --needed -S --root /mnt/target --hookdir /mnt/target/etc/pacman.d/hooks/ "$@" || rc=$?
        umount "$bs_tgt" 2>/dev/null || umount -l "$bs_tgt" 2>/dev/null || true
        return "$rc"
    fi
}

_arch_pacman_root_U() {
    local target_dir="$1"
    shift
    mkdir -p "${target_dir}/etc/pacman.d/hooks"
    if [[ -z "${ARCH_BOOTSTRAP_DIR:-}" ]]; then
        pacman --noconfirm --root "$target_dir" --hookdir "${target_dir}/etc/pacman.d/hooks/" -U "$@"
    else
        local bs_tgt="${ARCH_BOOTSTRAP_DIR}/mnt/target"
        local bs_pkgs="${ARCH_BOOTSTRAP_DIR}/mnt/pkgs"
        mkdir -p "$bs_tgt" "$bs_pkgs"
        rm -f "$bs_pkgs"/* 2>/dev/null || true
        local -a chroot_files=()
        local pf
        for pf in "$@"; do
            cp -f "$pf" "$bs_pkgs/"
            chroot_files+=("/mnt/pkgs/$(basename "$pf")")
        done
        mountpoint -q "$bs_tgt" 2>/dev/null || mount --bind "$target_dir" "$bs_tgt"
        local rc=0
        chroot "$ARCH_BOOTSTRAP_DIR" pacman --noconfirm --root /mnt/target --hookdir /mnt/target/etc/pacman.d/hooks/ -U "${chroot_files[@]}" || rc=$?
        umount "$bs_tgt" 2>/dev/null || umount -l "$bs_tgt" 2>/dev/null || true
        rm -rf "$bs_pkgs" 2>/dev/null || true
        return "$rc"
    fi
}

cleanup_rescue() {
    local exit_code=$?
    trap - EXIT INT TERM HUP
    set +e
    _cleanup_arch_bootstrap
    if findmnt -n "$COMMIT_VIEW" &>/dev/null; then
        umount "$COMMIT_VIEW" 2>/dev/null || umount -l "$COMMIT_VIEW" 2>/dev/null
    fi
    if [[ -d "$COMMIT_VIEW" ]] && ! mountpoint -q "$COMMIT_VIEW" 2>/dev/null; then
        rmdir "$COMMIT_VIEW" 2>/dev/null
    fi
    local tf
    for tf in "${TMP_FILES[@]}"; do
        [[ -n "$tf" ]] && rm -f "$tf" 2>/dev/null
    done
    if (( exit_code != 0 && COMMIT_COMPLETED == 0 )); then
        if (( HAD_PREV_UKI_STATE == 1 )); then
            printf '%s\n' "$PREV_UKI_STATE" > "$UKI_STATE_FILE" 2>/dev/null
        fi
        if (( IN_FINAL_SWAP == 0 )); then
            [[ -n "$NEW_SQUASHFS" && -f "$NEW_SQUASHFS" ]] && rm -f "$NEW_SQUASHFS"
            [[ -n "$NEW_UKI" && -f "$NEW_UKI" ]] && rm -f "$NEW_UKI"
        fi
    fi
    if (( WE_MOUNTED_ESP == 1 )) && [[ -n "$TARGET_MNT" ]]; then
        sync 2>/dev/null || true
        umount "$TARGET_MNT" 2>/dev/null || umount -l "$TARGET_MNT" 2>/dev/null
        [[ -d "$TARGET_MNT" ]] && ! mountpoint -q "$TARGET_MNT" 2>/dev/null && rmdir "$TARGET_MNT" 2>/dev/null
    fi
    exit "$exit_code"
}
trap cleanup_rescue EXIT INT TERM HUP

ESP_DEV=""
resolve_esp_mnt() {
    local need_rw="${1:-0}"
    TARGET_MNT=""
    ESP_DEV=""
    if [[ -n "${NC_RESCUE_ESP_DIR:-}" && -d "${NC_RESCUE_ESP_DIR}" ]]; then
        TARGET_MNT="${NC_RESCUE_ESP_DIR%/}"
        ESP_DEV="sandbox"
        return 0
    fi
    if [[ -f /run/recovery-ram/esp-device ]]; then
        ESP_DEV="$(tr -d '[:space:]' < /run/recovery-ram/esp-device || true)"
    fi
    local cand
    for cand in "$CFG_ESP_MOUNT" "/boot" "/efi" "/run/boot-esp" "/boot/efi"; do
        [[ -n "$cand" ]] || continue
        if mountpoint -q "$cand" 2>/dev/null; then
            TARGET_MNT="$cand"
            ESP_DEV="$(findmnt -n -o SOURCE "$cand" 2>/dev/null || echo "$ESP_DEV")"
            if (( need_rw == 1 )); then
                local opts
                opts="$(findmnt -n -o OPTIONS "$cand" 2>/dev/null || true)"
                if [[ ",$opts," == *",ro,"* ]]; then
                    mount -o remount,rw "$cand" 2>/dev/null || true
                fi
            fi
            return 0
        fi
    done
    if [[ -z "$ESP_DEV" || ! -b "$ESP_DEV" ]]; then
        local p_tmp="/run/nc-esp-probe.$$" part fstype
        mkdir -p "$p_tmp"
        while read -r part; do
            [[ -b "$part" ]] || continue
            fstype="$(blkid -s TYPE -o value "$part" 2>/dev/null || true)"
            [[ "$fstype" == "vfat" ]] || continue
            if mount -t vfat -o ro "$part" "$p_tmp" 2>/dev/null; then
                if [[ -f "$p_tmp/recovery.squashfs" || -d "$p_tmp/EFI/Linux" || -f "$p_tmp/limine.conf" ]]; then
                    ESP_DEV="$part"
                    umount "$p_tmp" 2>/dev/null || true
                    break
                fi
                umount "$p_tmp" 2>/dev/null || true
            fi
        done < <(lsblk -pnro PATH,TYPE 2>/dev/null | awk '$2=="part" {print $1}')
        rmdir "$p_tmp" 2>/dev/null || true
    fi
    if [[ -n "$ESP_DEV" && -b "$ESP_DEV" ]]; then
        TARGET_MNT="/run/nc-boot-esp.$$"
        mkdir -p "$TARGET_MNT"
        local m_opt="ro,umask=0077"
        (( need_rw == 1 )) && m_opt="rw,flush,umask=0077"
        if mount -t vfat -o "$m_opt" "$ESP_DEV" "$TARGET_MNT" 2>/dev/null; then
            WE_MOUNTED_ESP=1
            return 0
        fi
        rmdir "$TARGET_MNT" 2>/dev/null || true
        TARGET_MNT=""
    fi
    return 1
}

detect_kernel() {
    RUNNING_KVER="$(uname -r)"
    INSTALLED_KVER=""
    if [[ -d "/usr/lib/modules/${RUNNING_KVER}" && ( -f "/usr/lib/modules/${RUNNING_KVER}/modules.dep" || -d "/usr/lib/modules/${RUNNING_KVER}/kernel" ) ]]; then
        INSTALLED_KVER="$RUNNING_KVER"
    else
        local mod_dir base_mod
        while IFS= read -r mod_dir; do
            [[ -d "$mod_dir" ]] || continue
            base_mod="${mod_dir##*/}"
            [[ "$base_mod" == extramodules* ]] && continue
            if [[ -f "${mod_dir}/modules.dep" || -d "${mod_dir}/kernel" ]]; then
                INSTALLED_KVER="$base_mod"
            fi
        done < <(printf '%s\n' /usr/lib/modules/* | sort -V)
    fi
    [[ -n "$INSTALLED_KVER" ]] || return 1
    KERNEL_IMG="/usr/lib/modules/${INSTALLED_KVER}/vmlinuz"
    if [[ ! -f "$KERNEL_IMG" && -n "$TARGET_MNT" ]]; then
        local c_vm
        for c_vm in "${TARGET_MNT}"/vmlinuz-*; do
            [[ -f "$c_vm" ]] && { KERNEL_IMG="$c_vm"; break; }
        done
    fi
    [[ -f "$KERNEL_IMG" ]]
}

compute_uki_fingerprint() {
    {
        echo "KVER=${INSTALLED_KVER:-}"
        local f
        for f in \
            "${KERNEL_IMG:-}" \
            /boot/*-ucode.img \
            "$MKINIT_CONF" \
            /etc/mkinitcpio.conf \
            "$INITCPIO_HOOK_PATH" \
            "$INITCPIO_INST_PATH" \
            /usr/lib/initcpio/hooks/recovery-ram \
            /usr/lib/initcpio/install/recovery-ram \
            /etc/vconsole.conf \
            /etc/modprobe.d/*.conf \
            "/usr/lib/modules/${INSTALLED_KVER:-none}/modules.dep" \
            "/usr/lib/modules/${INSTALLED_KVER:-none}"/extramodules/*nvidia* \
            "/usr/lib/modules/${INSTALLED_KVER:-none}"/updates/*nvidia* \
            "/usr/lib/modules/${INSTALLED_KVER:-none}"/kernel/drivers/video/*nvidia*; do
            [[ -n "$f" && -f "$f" ]] && sha256sum "$f" 2>/dev/null || true
        done
    } | sha256sum | awk '{print $1}'
}

write_recovery_hook_files_into() {
    local prefix="${1:-}"
    prefix="${prefix%/}"
    local hook_dst="${prefix}${INITCPIO_HOOK_PATH}"
    local inst_dst="${prefix}${INITCPIO_INST_PATH}"
    local conf_dst="${prefix}${MKINIT_CONF}"
    local rb_dst="${prefix}${ROLLBACK_BIN}"
    mkdir -p "$(dirname "$hook_dst")" "$(dirname "$inst_dst")" "$(dirname "$conf_dst")" "$(dirname "$rb_dst")"

    cat <<'EOF_HOOK' > "$hook_dst"
#!/usr/bin/ash

run_hook() {
    mount_handler="recovery_mount_handler"
}

recovery_mount_handler() {
    local newroot="${1:-/new_root}"
    local C_RESET="\033[0m" C_BOLD="\033[1m" C_SLATE="\033[38;5;110m"
    local C_MINT="\033[38;5;114m" C_PEACH="\033[38;5;216m" C_ROSE="\033[38;5;203m"
    local C_LAVENDER="\033[38;5;146m" C_MUTED="\033[38;5;245m"
    local probe_dir="/run/boot-esp" ram_dir="/run/recovery-ram" console_dev="/dev/console"
    [ -c "$console_dev" ] || console_dev="/dev/tty0"

    mkdir -p "$probe_dir" "$newroot"
    umount "$probe_dir" 2>/dev/null || true

    local force_menu=0
    if grep -Eq '(^|[[:space:]])recovery\.menu([=[:space:]]|$)' /proc/cmdline 2>/dev/null; then
        force_menu=1
    fi

    calc_tmpfs_size() {
        local mem_kb mem_mb size_mb
        mem_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null)
        [ -n "$mem_kb" ] || { echo "16G"; return; }
        mem_mb=$((mem_kb / 1024))
        if [ "$mem_mb" -ge 24576 ]; then
            echo "16G"
        else
            size_mb=$((mem_mb * 70 / 100))
            [ "$size_mb" -lt 4096 ] && size_mb=4096
            echo "${size_mb}M"
        fi
    }

    scan_esp_candidates() {
        local part dev_name dev_path uuid fsize
        for part in /sys/class/block/*; do
            [ -f "$part/partition" ] || continue
            dev_name=$(basename "$part")
            case "$dev_name" in loop*|ram*|dm-*|md*|sr*|zram*) continue ;; esac
            dev_path="/dev/$dev_name"
            [ -b "$dev_path" ] || continue
            if mount -t vfat -o ro "$dev_path" "$probe_dir" 2>/dev/null; then
                uuid=$(blkid -s UUID -o value "$dev_path" 2>/dev/null || true)
                [ -n "$uuid" ] || uuid="no-uuid"
                if [ -s "$probe_dir/recovery.squashfs" ]; then
                    fsize=$(ls -lh "$probe_dir/recovery.squashfs" 2>/dev/null | awk '{print $5}')
                    echo "${dev_path}|recovery.squashfs|${fsize:-?}|${uuid}|primary"
                fi
                if [ -s "$probe_dir/recovery.squashfs.old" ]; then
                    fsize=$(ls -lh "$probe_dir/recovery.squashfs.old" 2>/dev/null | awk '{print $5}')
                    echo "${dev_path}|recovery.squashfs.old|${fsize:-?}|${uuid}|fallback"
                fi
                umount "$probe_dir" 2>/dev/null || true
            fi
        done
    }

    printf "%b\n" "${C_SLATE}:: NC-UI RECOVERY${C_RESET} Scanning ESP for recovery.squashfs..."
    local timeout=20 scan_results=""
    while [ "$timeout" -gt 0 ]; do
        scan_results=$(scan_esp_candidates)
        [ -n "$scan_results" ] && break
        sleep 0.5
        timeout=$((timeout - 1))
    done

    local selected_dev="" selected_file="" auto_boot_tried=0
    while :; do
        if [ -x "$newroot/sbin/init" ] || [ -L "$newroot/sbin/init" ] || [ -x "$newroot/usr/lib/systemd/systemd" ]; then
            return 0
        fi
        [ -n "$scan_results" ] || scan_results=$(scan_esp_candidates)
        local primary_count=0 total_count=0 single_dev="" single_file=""
        local IFS_OLD="$IFS"
        IFS="
"
        for entry in $scan_results; do
            [ -n "$entry" ] || continue
            total_count=$((total_count + 1))
            if [ "${entry##*|}" = "primary" ]; then
                primary_count=$((primary_count + 1))
                single_dev="${entry%%|*}"
                local r="${entry#*|}"; single_file="${r%%|*}"
            fi
        done
        IFS="$IFS_OLD"

        if [ "$primary_count" -eq 1 ] && [ "$force_menu" -eq 0 ] && [ "$auto_boot_tried" -eq 0 ]; then
            selected_dev="$single_dev"; selected_file="$single_file"; auto_boot_tried=1
        else
            printf "\n%b\n" "${C_BOLD}${C_LAVENDER}NC-UI RESCUE — EMERGENCY / LIVE RAM MENU${C_RESET}"
            if [ "$total_count" -gt 0 ]; then
                local idx=1
                IFS="
"
                for entry in $scan_results; do
                    [ -n "$entry" ] || continue
                    printf "  [%d] %s (%s)\n" "$idx" "$(echo "$entry" | cut -d'|' -f1)" "$(echo "$entry" | cut -d'|' -f2)"
                    idx=$((idx + 1))
                done
                IFS="$IFS_OLD"
            else
                printf "  (No recovery.squashfs found on ESP — use [s] for rescue shell)\n"
            fi
            printf "  [r] Rescan  [s] Rescue Shell (ash)  [b] Reboot  [p] Poweroff\n"
            local choice=""
            printf "%b" "${C_LAVENDER}Select: ${C_RESET}" > "$console_dev"
            read -r choice < "$console_dev" || choice="s"
            case "$choice" in
                [1-9]*)
                    local ce
                    ce=$(echo "$scan_results" | sed -n "${choice}p")
                    [ -n "$ce" ] || continue
                    selected_dev=$(echo "$ce" | cut -d'|' -f1)
                    selected_file=$(echo "$ce" | cut -d'|' -f2)
                    ;;
                [rR]) scan_results=""; sleep 1; continue ;;
                [sS]) launch_interactive_shell; scan_results=""; continue ;;
                [bB]) reboot -f ;;
                [pP]) poweroff -f ;;
                *) continue ;;
            esac
        fi

        mount -t vfat -o ro "$selected_dev" "$probe_dir" 2>/dev/null || { force_menu=1; continue; }
        local tmpfs_sz
        tmpfs_sz=$(calc_tmpfs_size)
        mkdir -p "$ram_dir"
        mount -t tmpfs -o "size=${tmpfs_sz},mode=0755" tmpfs "$ram_dir" || { umount "$probe_dir" 2>/dev/null || true; force_menu=1; continue; }
        echo "$selected_dev" > "$ram_dir/esp-device"
        echo "$selected_file" > "$ram_dir/booted-image"
        if ! cp "$probe_dir/$selected_file" "$ram_dir/recovery.squashfs"; then
            umount "$probe_dir" 2>/dev/null || true; umount "$ram_dir" 2>/dev/null || true; force_menu=1; continue
        fi
        umount "$probe_dir" 2>/dev/null || umount -l "$probe_dir" 2>/dev/null
        mkdir -p "$ram_dir/sqfs" "$ram_dir/upper" "$ram_dir/work"
        mount -t squashfs -o loop,ro "$ram_dir/recovery.squashfs" "$ram_dir/sqfs" || { umount "$ram_dir" 2>/dev/null || true; force_menu=1; continue; }
        mount -t overlay overlay -o "lowerdir=$ram_dir/sqfs,upperdir=$ram_dir/upper,workdir=$ram_dir/work" "$newroot" || { umount "$ram_dir/sqfs" 2>/dev/null || true; umount "$ram_dir" 2>/dev/null || true; force_menu=1; continue; }
        break
    done
}
EOF_HOOK
    chmod 0755 "$hook_dst"

    cat <<'EOF_INST' > "$inst_dst"
#!/bin/bash

build() {
    local mod b
    for mod in vfat fat nls_cp437 nls_iso8859-1 loop squashfs overlay dm_mod dm_crypt ext4 btrfs; do
        add_module "$mod" 2>/dev/null || true
    done
    for b in blkid losetup cryptsetup lvm btrfs nc-rollback; do
        if command -v "$b" >/dev/null 2>&1; then
            add_binary "$(command -v "$b")"
        fi
    done
    add_runscript
}

help() {
    cat <<HELPEOF
NC-UI Live RAM SquashFS & Emergency Rescue hook.
HELPEOF
}
EOF_INST
    chmod 0644 "$inst_dst"

    if [[ ! -f "$conf_dst" ]]; then
        cat <<'EOF_CONF' > "$conf_dst"
MODULES=(vfat squashfs overlay loop)
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems recovery-ram)
COMPRESSION="zstd"
EOF_CONF
        chmod 0644 "$conf_dst"
    fi

    cat <<EOF_RB > "$rb_dst"
#!/bin/sh
# NC-UI Emergency Rollback Utility (busybox ash compatible)
PROBE_DIR="/run/boot-esp"
RAM_DIR="/run/recovery-ram"
NEWROOT="/new_root"
UKI_NAME="${CFG_UKI_NAME}"
CONSOLE="/dev/console"
[ -c "\$CONSOLE" ] || CONSOLE="/dev/tty0"
mkdir -p "\$PROBE_DIR" "\$NEWROOT"

find_and_mount_esp() {
    if mountpoint -q "\$PROBE_DIR" 2>/dev/null; then
        [ -f "\$PROBE_DIR/recovery.squashfs.old" ] || [ -f "\$PROBE_DIR/recovery.squashfs" ] && return 0
        umount "\$PROBE_DIR" 2>/dev/null || true
    fi
    for part in /sys/class/block/*; do
        [ -f "\$part/partition" ] || continue
        dev_name=\$(basename "\$part")
        case "\$dev_name" in loop*|ram*|dm-*|md*|sr*|zram*) continue ;; esac
        dev_path="/dev/\$dev_name"
        [ -b "\$dev_path" ] || continue
        if mount -t vfat -o ro "\$dev_path" "\$PROBE_DIR" 2>/dev/null; then
            if [ -f "\$PROBE_DIR/recovery.squashfs.old" ] || [ -f "\$PROBE_DIR/EFI/Linux/\${UKI_NAME}.old" ]; then
                ESP_FOUND="\$dev_path"
                return 0
            fi
            umount "\$PROBE_DIR" 2>/dev/null || true
        fi
    done
    return 1
}

ESP_FOUND=""
if ! find_and_mount_esp; then
    printf "ERROR: No ESP with .old rollback images found.\n"
    exit 1
fi
[ -z "\$ESP_FOUND" ] && ESP_FOUND=\$(grep " \$PROBE_DIR " /proc/mounts 2>/dev/null | cut -d' ' -f1)
OLD_UKI="\$PROBE_DIR/EFI/Linux/\${UKI_NAME}.old"
CUR_UKI="\$PROBE_DIR/EFI/Linux/\${UKI_NAME}"
OLD_SQ="\$PROBE_DIR/recovery.squashfs.old"
CUR_SQ="\$PROBE_DIR/recovery.squashfs"

mount -o remount,rw "\$PROBE_DIR" 2>/dev/null || exit 1
[ -s "\$OLD_UKI" ] && cp -f "\$OLD_UKI" "\$CUR_UKI"
