    msg_ok "REGISTER_LIMINE_OK|${CFG_UKI_NAME}"
    return 0
}

_resolve_ncui_source_dir() {
    local self_repo="" cand
    self_repo="$(realpath -e "$0" 2>/dev/null || true)"
    if [[ -n "$self_repo" ]]; then
        self_repo="${self_repo%/*/*/*/*/*}"
    fi
    for cand in "${NCUI_SRC_DIR:-}" "$self_repo" "/opt/ncui"; do
        [[ -n "$cand" ]] || continue
        if [[ -f "${cand}/packages/nc-ui-control-center/panels/control_center.py" && -d "${cand}/packages/nc-ui-core/ui" ]]; then
            printf '%s' "$cand"
            return 0
        fi
        if [[ -f "${cand}/panels/control_center.py" && -d "${cand}/ui" ]]; then
            printf '%s' "$cand"
            return 0
        fi
    done
    return 1
}

_write_recovery_origin_manifest() {
    local root_dir="$1"
    local dst_manifest="${root_dir}/etc/ncui/recovery-origin.env"
    if [[ -d "$UPPER_DIR" || -f "$RECOVERY_ORIGIN_FILE" ]]; then
        if [[ -f "$RECOVERY_ORIGIN_FILE" && ! -f "$dst_manifest" ]]; then
            install -m 0644 "$RECOVERY_ORIGIN_FILE" "$dst_manifest"
        fi
        return 0
    fi

    local orig_host="" orig_uuid="" root_src="" orig_vg="$CFG_VG_NAME"
    local orig_luks="" orig_luks_uuid="" orig_luks_partuuid=""
    local orig_esp="" orig_esp_uuid="" orig_esp_partuuid="" orig_created=""

    if [[ -r /etc/hostname ]]; then
        orig_host="$(tr -d '[:space:]' < /etc/hostname 2>/dev/null || true)"
    fi
    [[ -n "$orig_host" ]] || orig_host="$(uname -n 2>/dev/null | cut -d. -f1 || echo "linux")"
    if [[ -r /sys/class/dmi/id/product_uuid ]]; then
        orig_uuid="$(tr -d '[:space:]' < /sys/class/dmi/id/product_uuid 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
    fi

    root_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
    if [[ -n "$root_src" && -b "$root_src" ]]; then
        local det_vg=""
        det_vg="$(lvs --noheadings -o vg_name "$root_src" 2>/dev/null | tr -d '[:space:]' || true)"
        [[ -n "$det_vg" ]] && orig_vg="$det_vg"
        local anc_path anc_type anc_fs
        while read -r anc_path anc_type; do
            [[ -b "$anc_path" ]] || continue
            anc_fs="$(blkid -s TYPE -o value "$anc_path" 2>/dev/null || true)"
            if [[ "$anc_fs" == "crypto_LUKS" ]] || cryptsetup isLuks "$anc_path" 2>/dev/null; then
                orig_luks="$anc_path"
                break
            fi
        done < <(lsblk -snro PATH,TYPE "$root_src" 2>/dev/null || true)
    fi

    if [[ -n "$orig_luks" && -b "$orig_luks" ]]; then
        orig_luks_uuid="$(blkid -s UUID -o value "$orig_luks" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
        orig_luks_partuuid="$(blkid -s PARTUUID -o value "$orig_luks" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
    fi

    if [[ -n "${ESP_DEV:-}" && -b "${ESP_DEV}" ]]; then
        orig_esp="$ESP_DEV"
    else
        orig_esp="$(findmnt -n -o SOURCE "${CFG_ESP_MOUNT:-/boot}" 2>/dev/null || findmnt -n -o SOURCE /efi 2>/dev/null || findmnt -n -o SOURCE /boot 2>/dev/null || true)"
    fi
    if [[ -n "$orig_esp" && -b "$orig_esp" ]]; then
        orig_esp_uuid="$(blkid -s UUID -o value "$orig_esp" 2>/dev/null || true)"
        orig_esp_partuuid="$(blkid -s PARTUUID -o value "$orig_esp" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
    fi

    orig_created="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    cat > "$dst_manifest" <<EOF
# Auto-generated by NC-UI nc-rescue (identifies this rootfs as an NC-UI recovery image and records its host origin)
NC_RECOVERY_IMAGE="1"
NC_ORIGIN_HOSTNAME="${orig_host}"
NC_ORIGIN_HW_UUID="${orig_uuid}"
NC_ORIGIN_VG_NAME="${orig_vg}"
NC_ORIGIN_LUKS_UUID="${orig_luks_uuid}"
NC_ORIGIN_LUKS_PARTUUID="${orig_luks_partuuid}"
NC_ORIGIN_ESP_UUID="${orig_esp_uuid}"
NC_ORIGIN_ESP_PARTUUID="${orig_esp_partuuid}"
NC_ORIGIN_CREATED="${orig_created}"
EOF
    chmod 0644 "$dst_manifest"
}

_inject_ncui_into_rootfs() {
    local root_dir="$1" src_dir="$2"
    msg_step "Installing NC-UI & bundled resilience helpers into ${root_dir}/opt/ncui..."
    mkdir -p "${root_dir}/opt/ncui" "${root_dir}/usr/bin" "${root_dir}/usr/lib/ncui/sbin" "${root_dir}/etc/ncui" "${root_dir}/usr/share/applications"
    rsync -a --delete \
        --exclude='.git' --exclude='.gnome-panels' --exclude='.media' \
        --exclude='__pycache__' --exclude='*.pyc' --exclude='*.pkg.tar*' \
        "${src_dir}/" "${root_dir}/opt/ncui/"
    local h
    for h in \
        "${src_dir}"/libexec/ncui/nc-* \
        "${src_dir}"/packages/nc-resilience/libexec/ncui/nc-* \
        "${src_dir}"/packages/nc-ui-control-center/libexec/ncui/nc-*; do
        [[ -f "$h" ]] || continue
        install -m 0755 "$h" "${root_dir}/usr/lib/ncui/sbin/$(basename "$h")"
    done
    for cli in nc-chroot nc-rescue nc-golden nc-hanoi nc-vault nc-snap; do
        if [[ -f "${root_dir}/usr/lib/ncui/sbin/${cli}" ]]; then
            ln -sfn "/usr/lib/ncui/sbin/${cli}" "${root_dir}/usr/bin/${cli}"
        fi
    done
    local -A _wb_bins=(
        [nc-bar-agent]="/opt/ncui/packages/nc-ui-waybar/bin/nc-bar-agent"
        [nc-telegram-status]="/opt/ncui/packages/nc-ui-waybar/bin/nc-telegram-status"
        [nc-record-notification]="/opt/ncui/packages/nc-ui-notification/bin/nc-record-notification"
    )
    local wb_name wb_tgt
    for wb_name in "${!_wb_bins[@]}"; do
        wb_tgt="${_wb_bins[$wb_name]}"
        if [[ -f "${root_dir}${wb_tgt}" ]]; then
            ln -sfn "$wb_tgt" "${root_dir}/usr/bin/${wb_name}"
        fi
    done
    if [[ -f "$CONF_FILE" ]]; then
        install -m 0644 "$CONF_FILE" "${root_dir}/etc/ncui/resilience.toml"
    fi
    _write_recovery_origin_manifest "$root_dir"
    cat <<'EOF_CTL' > "${root_dir}/usr/bin/nc-ctl"
#!/usr/bin/env bash
if [[ -x /opt/ncui/packages/nc-ui-core/bin/nc-ctl ]]; then
    exec python3 /opt/ncui/packages/nc-ui-core/bin/nc-ctl "$@"
fi
exec python3 /opt/ncui/bin/nc-ctl "$@"
EOF_CTL
    cat <<'EOF_BIN' > "${root_dir}/usr/bin/ncui"
#!/usr/bin/env bash
if [[ $# -eq 0 ]]; then
    exec /usr/bin/nc-ctl settings
fi
exec /usr/bin/nc-ctl "$@"
EOF_BIN
    chmod 0755 "${root_dir}/usr/bin/ncui" "${root_dir}/usr/bin/nc-ctl"
    if [[ ! -f "${root_dir}/etc/sudoers.d/ncui-recovery" ]]; then
        mkdir -p -m 0750 "${root_dir}/etc/sudoers.d"
        cat <<'EOF_SUD' > "${root_dir}/etc/sudoers.d/ncui-recovery"
%wheel ALL=(ALL:ALL) NOPASSWD: /usr/lib/ncui/sbin/nc-rescue, /usr/lib/ncui/sbin/nc-chroot, /usr/lib/ncui/sbin/nc-golden, /usr/lib/ncui/sbin/nc-snap, /usr/lib/ncui/sbin/nc-vault, /usr/lib/ncui/sbin/nc-hanoi, /usr/lib/ncui/sbin/nc-disks
EOF_SUD
        chmod 0440 "${root_dir}/etc/sudoers.d/ncui-recovery"
    fi
    if [[ ! -f "${root_dir}/etc/profile.d/editor.sh" ]]; then
        local host_ed="${VISUAL:-${EDITOR:-}}" c_ed
        if [[ -z "$host_ed" ]]; then
            for c_ed in nvim vim vi; do
                if [[ -x "${root_dir}/usr/bin/${c_ed}" ]] || command -v "$c_ed" >/dev/null 2>&1; then
                    host_ed="$c_ed"
                    break
                fi
            done
        fi
        if [[ -n "$host_ed" ]]; then
            mkdir -p "${root_dir}/etc/profile.d"
            printf 'export EDITOR=%q\nexport VISUAL=%q\n' "$host_ed" "$host_ed" > "${root_dir}/etc/profile.d/editor.sh"
            chmod 0644 "${root_dir}/etc/profile.d/editor.sh"
        fi
    fi
    cat <<'EOF_DESK' > "${root_dir}/usr/share/applications/ncui.desktop"
[Desktop Entry]
Type=Application
Name=NC-UI Control Center
Exec=nc-ctl settings
Terminal=false
Categories=System;Settings;
EOF_DESK
    return 0
}

_ncui_pkg_list() {
    local profile="$1"
    case "$profile" in
        console)
            printf '%s\n' nc-ui-core nc-resilience nc-bootloader
            ;;
        minimal_gui)
            printf '%s\n' nc-ui-core nc-ui-control-center nc-ui-waybar nc-ui-notification nc-resilience nc-bootloader nc-nftables
            ;;
        full)
            printf '%s\n' nc-ui-core nc-ui-control-center nc-ui-waybar nc-ui-notification nc-ui-input-daemons \
                nc-resilience nc-bootloader nc-calendar nc-nftables nc-nut nc-print nc-asciifier nc-video-wallpaper
            if _arch_pacman_si nc-matrix || _arch_host_pacman_q nc-matrix || [[ -n "$(_find_local_ncui_pkg nc-matrix)" ]]; then
                printf '%s\n' nc-matrix
            fi
            ;;
    esac
}

_find_local_ncui_pkg() {
    local pkg_name="$1" src_dir="${2:-}" d cand best=""
    for d in "${NCUI_PKG_DIR:-}" "$src_dir" "/var/cache/pacman/pkg"; do
        [[ -n "$d" && -d "$d" ]] || continue
        for cand in "$d/${pkg_name}-"[0-9]*.pkg.tar*; do
            [[ -f "$cand" ]] || continue
            [[ "$cand" == *.sig ]] && continue
            if [[ -z "$best" || "$cand" -nt "$best" ]]; then
                best="$cand"
            fi
        done
    done
    if [[ -n "$best" ]]; then
        printf '%s' "$best"
        return 0
    fi
    return 1
}

_detect_ncui_pkg_tier() {
    local src_dir="${1:-}"
    if _arch_pacman_si nc-ui-core; then
        printf 'repo'
    elif [[ -n "$(_find_local_ncui_pkg nc-ui-core "$src_dir")" ]]; then
        printf 'local'
    elif _arch_host_pacman_q nc-ui-core; then
        printf 'host'
    elif [[ -n "$src_dir" ]]; then
        printf 'source'
    else
        printf 'none'
    fi
}

_resolve_ncui_pkg_tier_interactive() {
    local src_dir="${1:-}"
    RESOLVED_NCUI_PKG_TIER="$(_detect_ncui_pkg_tier "$src_dir")"
    case "$RESOLVED_NCUI_PKG_TIER" in
        repo|local|host) return 0 ;;
    esac

    msg_warn "No NC-UI Arch packages found in configured pacman repos, /var/cache/pacman/pkg, or installed host packages."
    if [[ ! -r /dev/tty ]]; then
        if [[ "$RESOLVED_NCUI_PKG_TIER" == "source" ]]; then
            msg_warn "Using last-resort source fallback (${src_dir} -> /opt/ncui)."
            return 0
        fi
        msg_err "Provide a package directory via NCUI_PKG_DIR or configure an NC-UI pacman repository."
        return 1
    fi

    while true; do
        ui_section "SRC" "NC-UI package source fallback"
        ui_opt "1" "Specify a directory containing nc-*.pkg.tar* packages"
        if [[ -n "$src_dir" ]]; then
            ui_opt "2" "Last-resort source fallback (rsync ${src_dir} -> /opt/ncui)"
        fi
        ui_opt "0" "Cancel"
        printf '\n'
        local sel="" pkg_dir=""
        read -r -e -p "$(_rl_prompt "Select option:")" sel </dev/tty || sel="0"
        case "$sel" in
            1)
                read -r -e -p "$(_rl_prompt "Directory with nc-*.pkg.tar* packages:")" pkg_dir </dev/tty || pkg_dir=""
                pkg_dir="${pkg_dir/#\~/$HOME}"
                if [[ -n "$pkg_dir" && -d "$pkg_dir" && -n "$(_find_local_ncui_pkg nc-ui-core "$pkg_dir")" ]]; then
                    export NCUI_PKG_DIR="$pkg_dir"
                    RESOLVED_NCUI_PKG_TIER="local"
                    return 0
                fi
                msg_warn "No nc-ui-core-*.pkg.tar* package found in '${pkg_dir:-<empty>}'."
                ;;
            2)
                if [[ -n "$src_dir" ]]; then
                    msg_warn "Proceeding with last-resort source fallback (${src_dir} -> /opt/ncui)."
                    RESOLVED_NCUI_PKG_TIER="source"
                    return 0
                fi
                ;;
            0|"")
                msg_info "Cancelled by user."
                return 1
                ;;
            *)
                msg_warn "Invalid choice: ${sel}"
                ;;
        esac
    done
}

