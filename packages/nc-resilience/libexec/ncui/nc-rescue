show_help() {
    local prog="${0##*/}"
    ui_header "${prog^^} — NC-UI RECOVERY MANAGER" "Live RAM SquashFS, Signed UKI & Limine Boot Tool"
    printf "\n  %sUsage:%s  %s%s%s %s<ACTION>%s\n" "$CLR_SCHEMA" "$CLR_RESET" "$CLR_VAL" "$prog" "$CLR_RESET" "$CLR_INTENT" "$CLR_RESET"
    ui_section "CMDS" "Actions"
    local -a rows=(
        "manage, --manage|Interactive Recovery Manager (create, chroot-edit, sync, UKI, delete)"
        "edit, chroot|Chroot into existing recovery.squashfs via OverlayFS & commit changes"
        "delete, --delete|Delete .old or active recovery artifacts (double confirmation for last copy)"
        "--build-recovery|Build a new Live RAM Recovery SquashFS + signed UKI on ESP"
        "--sync-ncui|Update NC-UI inside existing recovery.squashfs & rebuild UKI"
        "status|Human-readable recovery & ESP artifact summary"
        "status-env|Print machine-readable KEY=VALUE rescue telemetry"
        "check-health|Refresh ${STATE_DIR}/rescue-status.env and print it"
        "install-hooks|Install/update recovery-ram initramfs hook & nc-rollback"
        "build-uki|Build/rebuild Recovery UKI on ESP & register Limine entry"
        "commit, -c|Commit Live RAM OverlayFS into ESP recovery.squashfs"
        "commit-rebuild, -r|Rebuild Recovery UKI and commit Live RAM SquashFS"
        "commit-skip-uki, -s|Commit SquashFS ignoring UKI mismatch warnings"
        "rollback-esp|Restore .old recovery SquashFS/UKI artifacts on ESP"
        "limine-set-stdin|Update timeout or default_entry in ESP limine.conf"
        "config-stdin|Update [recovery] keys in ${CONF_FILE}"
        "-h, --help|Show this help"
    )
    local row k d
    for row in "${rows[@]}"; do
        k="${row%%|*}"
        d="${row#*|}"
        printf "  %s%-22s%s %s%s%s\n" "$CLR_INTENT" "$k" "$CLR_RESET" "$CLR_VAL" "$d" "$CLR_RESET"
    done
    echo ""
    exit 0
}

