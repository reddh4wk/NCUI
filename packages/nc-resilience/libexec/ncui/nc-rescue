    fi
    if [[ -d "${root_dir}/usr/bin" && ! -e "${root_dir}/usr/local/lib/nc-ui/bin" ]]; then
        mkdir -p "${root_dir}/usr/local/lib/nc-ui"
        ln -sfn "/usr/bin" "${root_dir}/usr/local/lib/nc-ui/bin"
    fi
    if [[ -f "$CONF_FILE" ]]; then
        install -m 0644 "$CONF_FILE" "${root_dir}/etc/ncui/resilience.toml"
    fi
    _write_recovery_origin_manifest "$root_dir"
    if [[ ! -e "${root_dir}/usr/bin/ncui" ]]; then
        cat <<'EOF_BIN' > "${root_dir}/usr/bin/ncui"
#!/usr/bin/env bash
if [[ $# -eq 0 ]]; then
    exec /usr/bin/nc-ctl settings
fi
exec /usr/bin/nc-ctl "$@"
EOF_BIN
        chmod 0755 "${root_dir}/usr/bin/ncui"
    fi
    if [[ ! -f "${root_dir}/etc/profile.d/editor.sh" ]]; then
        local host_ed="${VISUAL:-${EDITOR:-}}" c_ed
        if [[ -z "$host_ed" ]]; then
            for c_ed in nvim vim vi; do
                if [[ -x "${root_dir}/usr/bin/${c_ed}" ]] || command -v "$c_ed" >/dev/null 2>&1; then
                    host_ed="$c_ed"
                    break
                fi
            done
        fi
        if [[ -n "$host_ed" ]]; then
            mkdir -p "${root_dir}/etc/profile.d"
            printf 'export EDITOR=%q\nexport VISUAL=%q\n' "$host_ed" "$host_ed" > "${root_dir}/etc/profile.d/editor.sh"
            chmod 0644 "${root_dir}/etc/profile.d/editor.sh"
        fi
    fi
    cat <<'EOF_DESK' > "${root_dir}/usr/share/applications/ncui.desktop"
[Desktop Entry]
Type=Application
Name=NC-UI Control Center
Exec=nc-ctl settings
Terminal=false
Categories=System;Settings;
EOF_DESK
}

_install_ncui_into_rootfs() {
    local root_dir="$1" profile="${2:-minimal_gui}" src_dir="${3:-}"
    if [[ "$profile" == "auto" ]]; then
        if chroot "$root_dir" pacman -Q nc-print >/dev/null 2>&1 || chroot "$root_dir" pacman -Q nc-ui-input-daemons >/dev/null 2>&1; then
            profile="full"
        elif chroot "$root_dir" pacman -Q nc-ui-control-center >/dev/null 2>&1; then
            profile="minimal_gui"
        elif chroot "$root_dir" pacman -Q nc-ui-core >/dev/null 2>&1; then
            profile="console"
        else
            profile="minimal_gui"
        fi
    fi

    local -a target_pkgs=()
    mapfile -t target_pkgs < <(_ncui_pkg_list "$profile")
    local tier
    tier="$(_detect_ncui_pkg_tier "$src_dir")"

    if [[ "$tier" == "repo" ]]; then
        local -a repo_pkgs=()
        mapfile -t repo_pkgs < <(_filter_repo_pkgs "${target_pkgs[@]}")
        if (( ${#repo_pkgs[@]} > 0 )); then
            msg_step "Installing NC-UI packages from pacman repo (${profile}: ${#repo_pkgs[@]} pkgs)..."
            _arch_pacman_root_S "$root_dir" "${repo_pkgs[@]}"
            _post_install_ncui_glue "$root_dir"
            return 0
        fi
    fi

    if [[ "$tier" == "local" ]]; then
        local -a local_files=()
        local p f
        for p in "${target_pkgs[@]}"; do
            f="$(_find_local_ncui_pkg "$p" "$src_dir" || true)"
            [[ -n "$f" ]] && local_files+=("$f")
        done
        if (( ${#local_files[@]} > 0 )); then
            msg_step "Installing local NC-UI packages (${profile}: ${#local_files[@]} .pkg.tar* files)..."
            _arch_pacman_root_U "$root_dir" "${local_files[@]}"
            _post_install_ncui_glue "$root_dir"
            return 0
        fi
    fi

    if [[ "$tier" == "host" ]]; then
        local -a host_pkgs=()
        local p
        for p in "${target_pkgs[@]}"; do
            pacman -Q "$p" >/dev/null 2>&1 && host_pkgs+=("$p")
        done
        if (( ${#host_pkgs[@]} > 0 )); then
            if command -v bacman >/dev/null 2>&1; then
                local bdir="/var/tmp/ncui-bacman.$$"
                mkdir -p "$bdir"
                msg_step "Packaging host NC-UI modules via bacman (${#host_pkgs[@]} pkgs)..."
                local -a built_files=()
                for p in "${host_pkgs[@]}"; do
                    if PKGDEST="$bdir" bacman "$p" >/dev/null 2>&1; then
                        local bf
                        bf="$(_find_local_ncui_pkg "$p" "$bdir" || true)"
                        [[ -n "$bf" ]] && built_files+=("$bf")
                    fi
                done
                if (( ${#built_files[@]} > 0 )); then
                    pacman --noconfirm --root "$root_dir" -U "${built_files[@]}"
                    rm -rf "$bdir"
                    _post_install_ncui_glue "$root_dir"
                    return 0
                fi
                rm -rf "$bdir"
            fi

            msg_step "Cloning installed NC-UI packages from host (${profile}: ${#host_pkgs[@]} pkgs)..."
            mkdir -p "${root_dir}/var/lib/pacman/local"
            local flist="/var/tmp/ncui-pkg-files.$$"
            : > "$flist"
            for p in "${host_pkgs[@]}"; do
                local ver entry db_dir
                ver="$(pacman -Q "$p" 2>/dev/null | awk '{print $2}' || true)"
                while IFS= read -r entry; do
                    [[ "$entry" == */ ]] && continue
                    if [[ -e "$entry" || -L "$entry" ]]; then
                        printf '%s\0' "${entry#/}" >> "$flist"
                    fi
                done < <(pacman -Qlq "$p" 2>/dev/null || true)
                db_dir="/var/lib/pacman/local/${p}-${ver}"
                if [[ -n "$ver" && -d "$db_dir" ]]; then
                    rm -rf "${root_dir}/var/lib/pacman/local/${p}-${ver}"
                    cp -a "$db_dir" "${root_dir}/var/lib/pacman/local/"
                fi
            done
            if [[ -s "$flist" ]]; then
                tar -C / --no-recursion --null -T "$flist" -cf - | tar -C "$root_dir" --no-overwrite-dir -xf -
            fi
            rm -f "$flist"
            _post_install_ncui_glue "$root_dir"
            return 0
        fi
    fi

    if [[ -n "$src_dir" ]]; then
        msg_warn "Last-resort fallback: installing NC-UI from source directory (${src_dir} -> /opt/ncui)."
        _inject_ncui_into_rootfs "$root_dir" "$src_dir"
        return 0
    fi
    msg_err "No NC-UI packages or source repository found for installation."
    return 1
}

_detect_host_hw_pkgs() {
    local hw_mode="${1:-host}" kern_pkg="${2:-}" want_desktop="${3:-1}"
    DETECTED_UCODE_PKGS=()
    DETECTED_FW_PKGS=()
    DETECTED_GPU_PKGS=()

    local cpu_info pci_info usb_info all_hw
    cpu_info="$(lscpu 2>/dev/null || true)"
    pci_info="$(lspci -nn 2>/dev/null || true)"
    usb_info="$(lsusb 2>/dev/null || true)"
    all_hw="${pci_info}"$'\n'"${usb_info}"

    if grep -qiE 'AuthenticAMD|AMD' <<< "$cpu_info"; then
        _arch_pacman_si amd-ucode && DETECTED_UCODE_PKGS+=(amd-ucode)
    elif grep -qiE 'GenuineIntel|Intel' <<< "$cpu_info"; then
        _arch_pacman_si intel-ucode && DETECTED_UCODE_PKGS+=(intel-ucode)
    fi

    if [[ "$hw_mode" == "generic" ]] || ! _arch_pacman_si linux-firmware-whence; then
        _arch_pacman_si linux-firmware && DETECTED_FW_PKGS+=(linux-firmware)
    else
        local -a fw_cands=(linux-firmware-whence linux-firmware-other)
        if grep -qiE 'AuthenticAMD|AMD' <<< "$cpu_info" || grep -qi '1022:' <<< "$pci_info"; then
            fw_cands+=(linux-firmware-amd)
        fi
        if grep -qiE 'VGA|3D|Display' <<< "$pci_info" && grep -qi '1002:' <<< "$pci_info"; then
            fw_cands+=(linux-firmware-amdgpu)
            lsmod 2>/dev/null | grep -q '^radeon\b' && fw_cands+=(linux-firmware-radeon)
        fi
        if grep -qiE 'VGA|3D|Display' <<< "$pci_info" && grep -qi '10de:' <<< "$pci_info"; then
            fw_cands+=(linux-firmware-nvidia)
        fi
        if grep -qiE '8086:|8087:' <<< "$all_hw"; then
            fw_cands+=(linux-firmware-intel)
        fi
        if grep -qiE '10ec:|0bda:' <<< "$all_hw"; then
            fw_cands+=(linux-firmware-realtek)
        fi
        if grep -qiE '168c:|17cb:|0cf3:' <<< "$all_hw"; then
            fw_cands+=(linux-firmware-atheros)
        fi
        if grep -qiE '14c3:|1814:|0e8d:' <<< "$all_hw"; then
            fw_cands+=(linux-firmware-mediatek)
        fi
        if grep -qiE '14e4:|0a5c:' <<< "$all_hw"; then
            fw_cands+=(linux-firmware-broadcom)
        fi
        mapfile -t DETECTED_FW_PKGS < <(_filter_repo_pkgs "${fw_cands[@]}")
    fi

    if (( want_desktop == 1 )); then
        local -a gpu_cands=(mesa)
        if grep -qiE 'VGA|3D|Display' <<< "$pci_info" && grep -qi '10de:' <<< "$pci_info"; then
            if lsmod 2>/dev/null | grep -q '^nvidia' || _arch_host_pacman_q nvidia-utils; then
                local nv_kmod=""
                for nv_kmod in "${kern_pkg}-nvidia-open" "nvidia-open"; do
                    if [[ -n "$nv_kmod" ]] && _arch_pacman_si "$nv_kmod"; then
                        gpu_cands+=("$nv_kmod")
                        break
                    fi
                done
                gpu_cands+=(nvidia-utils)
            fi
        fi
        mapfile -t DETECTED_GPU_PKGS < <(_filter_repo_pkgs "${gpu_cands[@]}")
    fi
}

_colorize_shadow_line() {
    local line="$1" c_blk="$2" c_shd="$3" c_rst="$4"
    local i ch mode=0 out="" n="${#line}"
    for (( i = 0; i < n; i++ )); do
        ch="${line:i:1}"
        case "$ch" in
            '█')
                if (( mode != 1 )); then out+="$c_blk"; mode=1; fi
                ;;
            '╔'|'╗'|'╚'|'╝'|'═'|'║')
                if (( mode != 2 )); then out+="$c_shd"; mode=2; fi
                ;;
            *)
                if (( mode != 0 )); then out+="$c_rst"; mode=0; fi
                ;;
        esac
        out+="$ch"
    done
    (( mode != 0 )) && out+="$c_rst"
    printf '%s' "$out"
