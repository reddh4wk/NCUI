        seed_wb=""
    done
    if [[ -n "$seed_wb" ]]; then
        local f
        for f in config.jsonc style.css; do
            [[ -f "${r_cfg}/waybar/${f}" || ! -f "${seed_wb}/${f}" ]] || install -m 0644 "${seed_wb}/${f}" "${r_cfg}/waybar/${f}"
        done
    fi

    if (( want_desktop == 1 )) && [[ ! -f "${r_cfg}/niri/config.kdl" ]]; then
        cat <<EOF_NIRI > "${r_cfg}/niri/config.kdl"
input {
    keyboard {
        xkb {
            layout "${rec_kb:-us}"
        }
    }
}
spawn-at-startup "waybar"
spawn-at-startup "nc-ctl" "wallpaper" "restore"
spawn-at-startup "nc-ctl" "popup" "hotkeys"
binds {
    Mod+Return { spawn "ghostty"; }
    Mod+S { spawn "nc-ctl" "settings"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
}
EOF_NIRI
        chmod 0644 "${r_cfg}/niri/config.kdl"
    elif (( want_desktop == 1 )) && [[ -n "$rec_kb" && -f "${r_cfg}/niri/config.kdl" ]]; then
        python3 - "${r_cfg}/niri/config.kdl" "$rec_kb" <<'PY_SET_KB'
import re, sys
p, lay = sys.argv[1:3]
txt = open(p, "r", encoding="utf-8", errors="replace").read()
if re.search(r'\bxkb\s*\{[^}]*\blayout\s+"[^"]*"', txt, flags=re.S):
    txt = re.sub(r'(\bxkb\s*\{[^}]*\blayout\s+)"[^"]*"', rf'\1"{lay}"', txt, count=1, flags=re.S)
elif re.search(r'\bxkb\s*\{', txt):
    txt = re.sub(r'(\bxkb\s*\{)', rf'\1\n            layout "{lay}"', txt, count=1)
else:
    txt = f'input {{\n    keyboard {{\n        xkb {{\n            layout "{lay}"\n        }}\n    }}\n}}\n\n' + txt
with open(p, "w", encoding="utf-8") as f:
    f.write(txt)
PY_SET_KB
        chmod 0644 "${r_cfg}/niri/config.kdl"
    fi

    if [[ ! -f "${r_cfg}/ncui/zsh.toml" ]]; then
        cat <<'EOF_ZSH_TOML' > "${r_cfg}/ncui/zsh.toml"
# Managed by NC-UI Personalization -> Zsh
[zsh]
preset = "powerline_tonal"
accent_mode = "pure_mono"
show_git = true
show_exit = true
show_duration = true
show_clock = true
show_context = true
auto_sync_theme = true
hist_size = 10000
share_history = true
hist_ignore_dups = true
completion_menu = true
fix_keybindings = true
auto_cd = false
plugin_autosuggestions = true
plugin_syntax_highlighting = true
EOF_ZSH_TOML
        chmod 0644 "${r_cfg}/ncui/zsh.toml"
    fi

    chroot "$root_dir" chown -R "${rec_user}:${rec_user}" "${r_home}" 2>/dev/null || true

    _sync_recovery_user_themes "$root_dir" "$rec_user" "$want_desktop"

    if (( import_nm == 1 )) && [[ -d /etc/NetworkManager/system-connections ]]; then
        msg_step "Importing NetworkManager profiles (0600 root:root, host-active profiles take precedence)..."
        install -d -m 0700 -o root -g root "${root_dir}/etc/NetworkManager/system-connections"
        if [[ -f /etc/NetworkManager/NetworkManager.conf ]]; then
            install -m 0644 -o root -g root /etc/NetworkManager/NetworkManager.conf "${root_dir}/etc/NetworkManager/NetworkManager.conf"
        fi
        if [[ -d /etc/NetworkManager/conf.d ]]; then
            install -d -m 0755 -o root -g root "${root_dir}/etc/NetworkManager/conf.d"
            local nm_c
            for nm_c in /etc/NetworkManager/conf.d/*; do
                [[ -f "$nm_c" ]] || continue
                install -m 0644 -o root -g root "$nm_c" "${root_dir}/etc/NetworkManager/conf.d/$(basename "$nm_c")"
            done
        fi
        local nm_f nm_dst nm_uuid nm_cnt=0
        local -a nm_active=() nm_files=()
        local -A nm_seen=()
        mapfile -t nm_active < <(nmcli -t -f UUID connection show --active 2>/dev/null || true)
        for nm_f in /etc/NetworkManager/system-connections/*; do
            [[ -f "$nm_f" ]] || continue
            nm_files+=("$nm_f")
            nm_seen["$nm_f"]=1
        done
        while IFS= read -r nm_f; do
            [[ -n "$nm_f" && "$nm_f" != /run/* && -f "$nm_f" && -z "${nm_seen[$nm_f]:-}" ]] || continue
            nm_files+=("$nm_f")
            nm_seen["$nm_f"]=1
        done < <(nmcli -t -f FILENAME connection show 2>/dev/null || true)
        for nm_f in "${nm_files[@]}"; do
            nm_dst="${root_dir}/etc/NetworkManager/system-connections/$(basename "$nm_f")"
            install -m 0600 -o root -g root "$nm_f" "$nm_dst"
            nm_uuid="$(sed -n 's/^uuid=//p' "$nm_f" | head -n1)"
            if [[ -n "$nm_uuid" ]] && printf '%s\n' "${nm_active[@]}" | grep -qxF "$nm_uuid" && ! grep -q '^autoconnect-priority=' "$nm_dst"; then
                sed -i '/^\[connection\]/a autoconnect-priority=100' "$nm_dst"
                chmod 0600 "$nm_dst"
                chown root:root "$nm_dst"
            fi
            msg_info "Imported NM profile: $(basename "$nm_f")"
            nm_cnt=$(( nm_cnt + 1 ))
        done
        (( nm_cnt == 0 )) && msg_warn "No persistent NetworkManager profiles found to import."
        [[ -f /var/lib/NetworkManager/timestamps ]] && install -D -m 0600 /var/lib/NetworkManager/timestamps "${root_dir}/var/lib/NetworkManager/timestamps"
    fi
}

do_sync_ncui_squashfs() {
    load_rescue_config
    resolve_esp_mnt 1 || { msg_err "Unable to mount ESP read-write."; exit 1; }
    _ensure_arch_builder
    local src_dir=""
    src_dir="$(_resolve_ncui_source_dir 2>/dev/null || true)"
    local tier=""
    _resolve_ncui_pkg_tier_interactive "$src_dir" || return 1
    tier="$RESOLVED_NCUI_PKG_TIER"
    local cur_sq="${TARGET_MNT}/recovery.squashfs" bak_sq="${TARGET_MNT}/recovery.squashfs.old"
    [[ -s "$cur_sq" ]] || { msg_err "No existing ${cur_sq} on ESP. Run --build-recovery first."; exit 1; }

    local cur_sz esp_free_b req_b cur_h esp_h req_h
    cur_sz="$(stat -c%s "$cur_sq" 2>/dev/null || echo 0)"
    esp_free_b="$(df -PB1 "$TARGET_MNT" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
    req_b=$(( cur_sz + 367001600 )) # current squashfs size + ~350 MiB UKI/headroom
    if (( esp_free_b < req_b )); then
        cur_h="$(numfmt --to=iec-i --suffix=B "$cur_sz" 2>/dev/null || echo "${cur_sz}B")"
        esp_h="$(numfmt --to=iec-i --suffix=B "$esp_free_b" 2>/dev/null || echo "${esp_free_b}B")"
        req_h="$(numfmt --to=iec-i --suffix=B "$req_b" 2>/dev/null || echo "${req_b}B")"
        msg_err "Insufficient free space on ESP (${TARGET_MNT}) for safe atomic sync: free=${esp_h}, needed≈${req_h} (existing=${cur_h})."
        exit 1
    fi

    local sync_work_base
    sync_work_base="$(_pick_exec_work_base 3221225472)" || exit 1
    local work_dir="${sync_work_base}/ncui-sqfs-sync.$$"
    trap '_safe_rm_chroot_dir "'"$work_dir"'" || true; cleanup_rescue' EXIT INT TERM HUP
    msg_step "Unpacking ${cur_sq} into ${work_dir}..."
    _safe_rm_chroot_dir "$work_dir" || exit 1
    unsquashfs -d "$work_dir" "$cur_sq"

    if ! chroot "$work_dir" python3 -c "import gi; gi.require_version('Gtk','3.0'); gi.require_version('GtkLayerShell','0.1'); import ctypes; ctypes.CDLL('libvterm.so.0')" >/dev/null 2>&1; then
        msg_step "Installing missing NC-UI GTK3/LayerShell/libvterm dependencies inside recovery rootfs..."
        _arch_pacman_root_S "$work_dir" python python-gobject gtk3 gtk-layer-shell cairo pango gdk-pixbuf2 libvterm rsync || true
    fi
    _install_ncui_into_rootfs "$work_dir" "auto" "$src_dir"
    local -a sync_extra=()
    mapfile -t sync_extra < <(_filter_repo_pkgs swaync cpupower alsa-utils ttf-dejavu otf-font-awesome otf-ipafont zsh-autosuggestions zsh-syntax-highlighting)
    if (( ${#sync_extra[@]} > 0 )); then
        msg_step "Syncing optional/runtime dependencies inside recovery rootfs (${#sync_extra[@]} pkgs)..."
        _arch_pacman_root_S "$work_dir" "${sync_extra[@]}" || true
    fi
    local sync_desktop=0 u_dir u_name
    [[ -x "${work_dir}/usr/bin/niri" ]] && sync_desktop=1
    for u_dir in "${work_dir}/home"/*; do
        [[ -d "$u_dir" ]] || continue
        u_name="$(basename "$u_dir")"
        [[ "$u_name" == "lost+found" ]] && continue
        _sync_recovery_user_themes "$work_dir" "$u_name" "$sync_desktop"
    done
    write_recovery_hook_files_into "$work_dir"

    NEW_SQUASHFS="${TARGET_MNT}/recovery.squashfs.new"
    msg_step "Packing updated ${NEW_SQUASHFS} (zstd -19)..."
    mksquashfs "$work_dir" "$NEW_SQUASHFS" -comp zstd -Xcompression-level 19 -b 1M -noappend
    unsquashfs -s "$NEW_SQUASHFS" >/dev/null 2>&1 || { msg_err "SquashFS integrity check failed."; exit 1; }
    local nsz
    nsz="$(stat -c%s "$NEW_SQUASHFS")"
    (( nsz < 4294967295 )) || { msg_err "SquashFS exceeds 4 GiB FAT32 limit (${nsz} bytes)."; exit 1; }

    IN_FINAL_SWAP=1
    swap_pair_safe "$NEW_SQUASHFS" "$cur_sq" "$bak_sq" 1
    sync
    COMMIT_COMPLETED=1
    build_uki_from_rootfs "$work_dir"
    _safe_rm_chroot_dir "$work_dir"
    msg_ok "Synced NC-UI into ${cur_sq} and rebuilt signed UKI."
    return 0
}

_filter_repo_pkgs() {
    local p
    for p in "$@"; do
        [[ -n "$p" ]] || continue
        if _arch_pacman_si "$p"; then
            printf '%s\n' "$p"
        fi
    done
}

_parse_srcinfo_aur_deps() {
    local srcinfo="$1"
    [[ -f "$srcinfo" ]] || return 0
    awk -F' = ' '/^[[:space:]]*(depends|depends_x86_64|makedepends|makedepends_x86_64)[[:space:]]*=/{
        dep=$2
        sub(/[<>=:].*/, "", dep)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", dep)
        if (dep != "" && !seen[dep]++) print dep
    }' "$srcinfo"
}

_install_aur_helper_into_rootfs() {
    local root_dir="$1" helper_name="$2" rec_user="${3:-rescue}"
    local aur_pkg=""
    case "$helper_name" in
        paru)   aur_pkg="paru-bin" ;;
        yay)    aur_pkg="yay-bin" ;;
        pikaur) aur_pkg="pikaur" ;;
        trizen) aur_pkg="trizen" ;;
        *) return 0 ;;
    esac

    msg_step "Building AUR helper '${helper_name}' from AUR (${aur_pkg}) inside recovery rootfs..."
    local work_dir="${root_dir}/tmp/ncui-aur-build"
    rm -rf "$work_dir"
    mkdir -p "$work_dir"
    chroot "$root_dir" chown "${rec_user}:${rec_user}" /tmp/ncui-aur-build

    local rc=0
    _mount_chroot_api "$root_dir"
    if ! chroot "$root_dir" su -s /bin/bash "$rec_user" -c "git clone --depth 1 'https://aur.archlinux.org/${aur_pkg}.git' /tmp/ncui-aur-build/src"; then
        rc=1
    fi
    _umount_chroot_api "$root_dir" 0

    if (( rc != 0 )) || [[ ! -f "${work_dir}/src/PKGBUILD" ]]; then
        rm -rf "$work_dir"
        msg_warn "Failed to fetch '${aur_pkg}' from AUR (offline or unreachable); continuing without ${helper_name}."
        return 0
    fi

    local -a raw_deps=() repo_deps=()
    mapfile -t raw_deps < <(_parse_srcinfo_aur_deps "${work_dir}/src/.SRCINFO")
    if (( ${#raw_deps[@]} > 0 )); then
        mapfile -t repo_deps < <(_filter_repo_pkgs "${raw_deps[@]}")
        if (( ${#repo_deps[@]} > 0 )); then
            _arch_pacman_root_S "$root_dir" "${repo_deps[@]}" || rc=$?
        fi
    fi

    if (( rc == 0 )); then
        _mount_chroot_api "$root_dir"
        if ! chroot "$root_dir" su -s /bin/bash "$rec_user" -c "cd /tmp/ncui-aur-build/src && makepkg --noconfirm --nocheck"; then
            rc=1
        fi
        _umount_chroot_api "$root_dir" 0
    fi

    local -a built_pkgs=()
    local pf
    if (( rc == 0 )); then
        for pf in "${work_dir}"/src/*.pkg.tar*; do
            [[ -f "$pf" ]] || continue
            [[ "$(basename "$pf")" == *-debug-*.pkg.tar* ]] && continue
            built_pkgs+=("$pf")
        done
        if (( ${#built_pkgs[@]} == 0 )); then
            rc=1
        else
            _arch_pacman_root_U "$root_dir" "${built_pkgs[@]}" || rc=$?
        fi
    fi

    rm -rf "$work_dir"
    if (( rc != 0 )); then
        msg_warn "AUR build/install for '${aur_pkg}' failed; continuing without ${helper_name}."
        return 0
    fi
    msg_ok "Installed AUR helper '${helper_name}' (${aur_pkg}) into recovery rootfs."
    return 0
}

do_build_recovery_squashfs() {
    load_rescue_config
    resolve_esp_mnt 1 || { msg_err "Unable to mount ESP read-write."; exit 1; }
    command -v mksquashfs >/dev/null 2>&1 || { msg_err "mksquashfs not found (install squashfs-tools)."; exit 1; }
    command -v unsquashfs >/dev/null 2>&1 || { msg_err "unsquashfs not found (install squashfs-tools)."; exit 1; }
    _ensure_arch_builder
    local src_dir=""
    src_dir="$(_resolve_ncui_source_dir 2>/dev/null || true)"
    local pkg_tier=""
    _resolve_ncui_pkg_tier_interactive "$src_dir" || return 1
    pkg_tier="$RESOLVED_NCUI_PKG_TIER"

    local cur_sq="${TARGET_MNT}/recovery.squashfs" bak_sq="${TARGET_MNT}/recovery.squashfs.old"
    local esp_free_b esp_free_h
    esp_free_b="$(df -PB1 "$TARGET_MNT" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
    esp_free_h="$(numfmt --to=iec-i --suffix=B "$esp_free_b" 2>/dev/null || echo "${esp_free_b}B")"

    ui_header "NC-UI LIVE RECOVERY SQUASHFS + SIGNED UKI BUILDER" "Target ESP: ${TARGET_MNT} (${ESP_DEV:-unknown})"
    echo ""
    ui_kv "ESP Free" "$esp_free_h"
    ui_kv "Target UKI" "${TARGET_MNT}/EFI/Linux/${CFG_UKI_NAME}" "(sbctl=${CFG_SIGN_SBCTL})"
    if [[ -n "$ARCH_BOOTSTRAP_DIR" ]]; then
        ui_kv "Build Engine" "Arch Bootstrap" "(${ARCH_BOOTSTRAP_DIR})"
    else
        ui_kv "Build Engine" "Native Arch pacman/pacstrap"
    fi
    ui_kv "NC-UI Source" "$pkg_tier" "(${src_dir:-system packages})"

    if [[ -f "$cur_sq" ]]; then
        local cur_sz cur_h cur_mt bak_info="none"
        cur_sz="$(stat -c%s "$cur_sq" 2>/dev/null || echo 0)"
        cur_h="$(numfmt --to=iec-i --suffix=B "$cur_sz" 2>/dev/null || echo "${cur_sz}B")"
        cur_mt="$(date -r "$cur_sq" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '-')"
        if [[ -f "$bak_sq" ]]; then
            local b_sz b_h b_mt
            b_sz="$(stat -c%s "$bak_sq" 2>/dev/null || echo 0)"
            b_h="$(numfmt --to=iec-i --suffix=B "$b_sz" 2>/dev/null || echo "${b_sz}B")"
            b_mt="$(date -r "$bak_sq" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '-')"
            bak_info="${b_h} (${b_mt})"
        fi
        echo ""
        msg_warn "Existing recovery image found on ESP:"
        ui_kv "  Current" "$cur_sq" "(${cur_h}, ${cur_mt})"
        ui_kv "  Fallback" "$bak_sq" "(${bak_info})"
        msg_warn "Proceeding will demote current recovery.squashfs to recovery.squashfs.old (overwriting any existing .old)."
        if ! ui_confirm "Continue and rotate existing recovery to .old?" "n"; then
            msg_info "Build cancelled by user."
            return 0
        fi
    else
        echo ""
        msg_info "First-time build: no existing recovery.squashfs found on ESP."
    fi

    local profile_sel="1" ncui_profile="full" want_desktop=1
    ui_section "01" "Recovery Profile"
    ui_opt "1" "Full Wayland Desktop (all NC-UI packages + optional deps + desktop)" "Est. SquashFS: ~1.7-2.2 GiB | ESP needed: ~2.6 GiB | work dir: ~6 GiB"
    ui_opt "2" "Minimal Wayland Desktop (niri + waybar + ghostty + core NC-UI)" "Est. SquashFS: ~1.1-1.5 GiB | ESP needed: ~1.9 GiB | work dir: ~4 GiB"
    ui_opt "3" "Minimal Rescue Console (TTY only + core NC-UI CLI & resilience tools)" "Est. SquashFS: ~0.6-0.9 GiB | ESP needed: ~1.2 GiB | work dir: ~3 GiB"
    printf '\n'
    read -r -e -p "$(_rl_prompt "Select profile [1-3] (Enter=1, Ctrl+C to cancel):")" profile_sel </dev/tty || profile_sel="1"
    profile_sel="${profile_sel:-1}"
    case "$profile_sel" in
        1) ncui_profile="full"; want_desktop=1 ;;
        2) ncui_profile="minimal_gui"; want_desktop=1 ;;
        3) ncui_profile="console"; want_desktop=0 ;;
        *) msg_err "Invalid profile: ${profile_sel}"; exit 1 ;;
    esac

    local browser_pkg=""
    if (( want_desktop == 1 )); then
        local brave_cand="" has_ff=0 has_chr=0 def_br="2" br_ans=""
        if _arch_pacman_si brave-bin; then
            brave_cand="brave-bin"
        elif _arch_pacman_si brave; then
            brave_cand="brave"
        fi
        _arch_pacman_si firefox && has_ff=1
        _arch_pacman_si chromium && has_chr=1
        [[ -n "$brave_cand" ]] && def_br="1"

        ui_section "02" "Browser Selection (+~350 MiB ESP if selected)"
        if [[ -n "$brave_cand" ]]; then
            ui_opt "1" "Brave (${brave_cand})"
        else
            ui_opt "1" "Brave (not found in configured pacman repos)"
        fi
        ui_opt "2" "Firefox$( (( has_ff )) || printf ' (unavailable)' )"
        ui_opt "3" "Chromium$( (( has_chr )) || printf ' (unavailable)' )"
        ui_opt "4" "None (skip browser — smaller image)"
        printf '\n'
        read -r -e -p "$(_rl_prompt "Select browser [1-4 or custom pkg] (Enter=${def_br}):")" br_ans </dev/tty || br_ans=""
        br_ans="${br_ans:-$def_br}"
        case "$br_ans" in
            1)
                if [[ -n "$brave_cand" ]]; then
                    browser_pkg="$brave_cand"
                else
                    msg_err "Brave package not available in configured pacman repos."
                    exit 1
                fi
                ;;
            2) browser_pkg="firefox" ;;
            3) browser_pkg="chromium" ;;
            4|none|no) browser_pkg="" ;;
            *)
                if _arch_pacman_si "$br_ans"; then
                    browser_pkg="$br_ans"
                else
                    msg_err "Browser package '${br_ans}' not found in configured pacman repos."
                    exit 1
                fi
                ;;
        esac
    fi

    local aur_helper="" aur_in_repo=0 def_aur="5" aur_ans=""
    local has_paru=0 has_yay=0 has_pikaur=0 has_trizen=0
    _arch_pacman_si paru && has_paru=1
    _arch_pacman_si yay && has_yay=1
    _arch_pacman_si pikaur && has_pikaur=1
    _arch_pacman_si trizen && has_trizen=1
    if (( has_paru )) || command -v paru >/dev/null 2>&1; then
        def_aur="1"
    elif (( has_yay )) || command -v yay >/dev/null 2>&1; then
        def_aur="2"
    elif command -v pikaur >/dev/null 2>&1; then
        def_aur="3"
    elif command -v trizen >/dev/null 2>&1; then
        def_aur="4"
    fi

    ui_section "03" "AUR Helper Selection (+base-devel if selected)"
    ui_opt "1" "paru   ($( (( has_paru )) && printf 'in repo' || printf 'AUR: paru-bin' ))"
    ui_opt "2" "yay    ($( (( has_yay )) && printf 'in repo' || printf 'AUR: yay-bin' ))"
    ui_opt "3" "pikaur ($( (( has_pikaur )) && printf 'in repo' || printf 'AUR: pikaur' ))"
    ui_opt "4" "trizen ($( (( has_trizen )) && printf 'in repo' || printf 'AUR: trizen' ))"
    ui_opt "5" "None (do not install an AUR helper)"
    printf '\n'
    read -r -e -p "$(_rl_prompt "Select AUR helper [1-5] (Enter=${def_aur}):")" aur_ans </dev/tty || aur_ans=""
    aur_ans="${aur_ans:-$def_aur}"
    case "${aur_ans,,}" in
        1|paru)   aur_helper="paru";   aur_in_repo="$has_paru" ;;
        2|yay)    aur_helper="yay";    aur_in_repo="$has_yay" ;;
        3|pikaur) aur_helper="pikaur"; aur_in_repo="$has_pikaur" ;;
        4|trizen) aur_helper="trizen"; aur_in_repo="$has_trizen" ;;
        5|none|no) aur_helper=""; aur_in_repo=0 ;;
        *) msg_err "Invalid AUR helper selection: ${aur_ans}"; exit 1 ;;
    esac

    local kern_pkg="" k_cand
    if [[ -z "$ARCH_BOOTSTRAP_DIR" ]]; then
        for k_cand in \
            linux-cachyos-hardened linux-hardened linux-cachyos linux linux-lts linux-zen \
            $(pacman -Qoq "/usr/lib/modules/$(uname -r)/vmlinuz" /usr/lib/modules/*/vmlinuz 2>/dev/null || true); do
            if _arch_host_pacman_q "$k_cand" && _arch_pacman_si "$k_cand"; then
                kern_pkg="$k_cand"
                break
            fi
        done
    fi
    if [[ -z "$kern_pkg" ]]; then
        for k_cand in linux linux-lts linux-zen linux-hardened linux-cachyos; do
            _arch_pacman_si "$k_cand" && { kern_pkg="$k_cand"; break; }
        done
    fi
    [[ -n "$kern_pkg" ]] || { msg_err "No installable kernel package found in pacman repos."; exit 1; }

    _detect_host_hw_pkgs "host" "$kern_pkg" "$want_desktop"
    local -a host_preview=("${DETECTED_UCODE_PKGS[@]}" "${DETECTED_FW_PKGS[@]}" "${DETECTED_GPU_PKGS[@]}")
    ui_section "04" "Hardware Firmware & Drivers"
    ui_opt "1" "Current host hardware only" "${host_preview[*]:-none}"
    ui_opt "2" "Generic hardware (full linux-firmware, portable)" "+~400 MiB"
    printf '\n'
    local hw_sel="" hw_mode="host"
    read -r -e -p "$(_rl_prompt "Select hardware target [1/2] (Enter=1):")" hw_sel </dev/tty || hw_sel="1"
    if [[ "${hw_sel:-1}" == "2" ]]; then
        hw_mode="generic"
        _detect_host_hw_pkgs "generic" "$kern_pkg" "$want_desktop"
    fi

    local host_user="" import_ui=0 import_nm=0
    host_user="$(_resolve_host_desktop_user 2>/dev/null || true)"
    if [[ -n "$host_user" ]]; then
        ui_section "05" "Host Settings Import"
        ui_confirm "Import NC-UI, Waybar & Niri settings from '${host_user}'?" "y" && import_ui=1 || import_ui=0
        if [[ -d /etc/NetworkManager/system-connections ]]; then
            ui_confirm "Also import NetworkManager profiles? (ESP is UNENCRYPTED)" "n" && import_nm=1 || import_nm=0
        fi
    fi

    ui_section "06" "Recovery Identity & Account Setup"
    local rec_user="" rec_user_in=""
    while true; do
        read -r -e -p "$(_rl_prompt "Recovery username (Enter=${CFG_RECOVERY_USER}):")" rec_user_in </dev/tty || rec_user_in=""
        rec_user="${rec_user_in:-$CFG_RECOVERY_USER}"
        if _is_valid_recovery_user "$rec_user"; then
            break
        fi
        msg_warn "Invalid username '${rec_user}'. Use lowercase [a-z_][a-z0-9_-]* (max 32 chars, not 'root' or system accounts)."
    done
    ui_kv "Account" "${rec_user}" "(groups: wheel,sudo + root)"

    local def_rec_host="${CFG_HOSTNAME:-linux}-recovery" rec_host="" rec_host_in=""
    while true; do
        read -r -e -p "$(_rl_prompt "Recovery hostname (Enter=${def_rec_host}):")" rec_host_in </dev/tty || rec_host_in=""
        rec_host_in="${rec_host_in#"${rec_host_in%%[![:space:]]*}"}"
        rec_host_in="${rec_host_in%"${rec_host_in##*[![:space:]]}"}"
        rec_host="${rec_host_in:-$def_rec_host}"
        if [[ "$rec_host" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
            break
        fi
        msg_warn "Invalid hostname '${rec_host}'. Use letters, digits and internal hyphens (1-63 chars)."
    done
    ui_kv "Hostname" "${rec_host}"

    local rec_kb=""
    rec_kb="$(_detect_host_kb_layout "$host_user")"

    local pw1="" pw2=""
    while true; do
        IFS= read -r -s -p "  ${CLR_INTENT}›${CLR_RESET} ${CLR_FOCUS}Password for '${rec_user}' and 'root':${CLR_RESET} " pw1 </dev/tty
        echo "" >/dev/tty
        if [[ -z "$pw1" ]]; then
            msg_warn "Password cannot be empty."
            continue
        fi
        IFS= read -r -s -p "  ${CLR_INTENT}›${CLR_RESET} ${CLR_FOCUS}Confirm password:${CLR_RESET} " pw2 </dev/tty
        echo "" >/dev/tty
        if [[ "$pw1" == "$pw2" ]]; then
            unset pw2
            break
        fi
        msg_warn "Passwords do not match. Try again."
    done

    # Pre-flight ESP and exec-capable work dir space check (recovery.squashfs.new coexists with existing until swap)
    local req_esp_b=1288490188 req_tmp_b=3221225472 rec_tmp_b=4294967296
    case "$ncui_profile" in
        minimal_gui) req_esp_b=2040109465; req_tmp_b=3221225472; rec_tmp_b=4294967296 ;;
        full)        req_esp_b=2791728742; req_tmp_b=4294967296; rec_tmp_b=6442450944 ;;
        console)     req_esp_b=1288490188; req_tmp_b=2147483648; rec_tmp_b=3221225472 ;;
    esac
    [[ -n "$browser_pkg" ]] && req_esp_b=$(( req_esp_b + 367001600 ))
    [[ -n "$aur_helper" ]] && req_esp_b=$(( req_esp_b + 83886080 ))
    [[ "$hw_mode" == "generic" ]] && req_esp_b=$(( req_esp_b + 419430400 ))

    local req_esp_h
    req_esp_h="$(numfmt --to=iec-i --suffix=B "$req_esp_b" 2>/dev/null || echo "${req_esp_b}B")"
    ui_section "07" "Pre-Flight & Build Summary"
    ui_kv "Profile" "$ncui_profile" "(kernel=${kern_pkg}, user=${rec_user}, host=${rec_host}, kb=${rec_kb})"
    ui_kv "ESP Space" "free=${esp_free_h}" "(estimated needed=${req_esp_h})"
    if (( esp_free_b < req_esp_b )); then
        unset pw1
        msg_err "Insufficient free space on ESP (${TARGET_MNT}). Free: ${esp_free_h}, estimated needed: ${req_esp_h}."
        msg_err "Free up ESP space or choose Minimal Console / None browser / host-only firmware."
        exit 1
    fi

    local work_base tmp_free_b tmp_free_h req_tmp_h rec_tmp_h
    work_base="$(_pick_exec_work_base "$rec_tmp_b")" || { unset pw1; exit 1; }
    tmp_free_b="$(df -PB1 "$work_base" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
    tmp_free_h="$(numfmt --to=iec-i --suffix=B "$tmp_free_b" 2>/dev/null || echo "${tmp_free_b}B")"
    req_tmp_h="$(numfmt --to=iec-i --suffix=B "$req_tmp_b" 2>/dev/null || echo "${req_tmp_b}B")"
    rec_tmp_h="$(numfmt --to=iec-i --suffix=B "$rec_tmp_b" 2>/dev/null || echo "${rec_tmp_b}B")"
    ui_kv "Work Dir" "$work_base" "(free=${tmp_free_h})"
    echo ""
    if (( tmp_free_b < req_tmp_b )); then
        unset pw1
        msg_err "Insufficient free space in ${work_base} for rootfs build (${tmp_free_h}; at least ${req_tmp_h} required)."
        exit 1
    elif (( tmp_free_b < rec_tmp_b )); then
        msg_warn "Low free space in ${work_base} (${tmp_free_h}; >= ${rec_tmp_h} recommended)."
        if ! ui_confirm "Continue anyway?" "n"; then
            unset pw1
            msg_info "Build cancelled."
            return 0
        fi
    fi

    local pkgs=(
        base "$kern_pkg" "${DETECTED_UCODE_PKGS[@]}" "${DETECTED_FW_PKGS[@]}" mkinitcpio
        cryptsetup lvm2 btrfs-progs dosfstools e2fsprogs gptfdisk parted efibootmgr sbctl
        arch-install-scripts squashfs-tools pv zstd rsync cifs-utils nfs-utils openssh
        smartmontools nvme-cli networkmanager sudo polkit zsh btop neovim
        python python-gobject gtk3 gtk-layer-shell cairo pango gdk-pixbuf2 libvterm
    )
    local -a opt_pkgs=()
    mapfile -t opt_pkgs < <(_filter_repo_pkgs \
        zsh-autosuggestions zsh-syntax-highlighting \
        hdparm ddrescue testdisk iwd iproute2 iputils bind curl wget ethtool tcpdump \
        lsof pciutils usbutils strace tmux vim less jq git nvtop \
        nftables pipewire wireplumber pipewire-pulse wl-clipboard grim slurp cpupower alsa-utils \
    )
    (( ${#opt_pkgs[@]} > 0 )) && pkgs+=("${opt_pkgs[@]}")

    if [[ "$ncui_profile" == "full" ]]; then
        local -a full_opt_pkgs=()
        mapfile -t full_opt_pkgs < <(_filter_repo_pkgs \
            ffmpeg python-pillow libnotify satty playerctl wireguard-tools lm_sensors \
            bluez-utils cups cups-filters nut evtest brightnessctl usbguard \
            pacman-contrib flatpak awww yt-dlp yazi \
        )
        (( ${#full_opt_pkgs[@]} > 0 )) && pkgs+=("${full_opt_pkgs[@]}")
    fi

    if (( want_desktop == 1 )); then
        local -a desk_pkgs=()
        mapfile -t desk_pkgs < <(_filter_repo_pkgs \
            niri waybar ghostty fuzzel polkit-gnome ttf-jetbrains-mono-nerd noto-fonts xdg-utils \
            swaync gsfonts ttf-dejavu otf-font-awesome ttf-nerd-fonts-symbols otf-ipafont \
            "${DETECTED_GPU_PKGS[@]}" \
        )
        (( ${#desk_pkgs[@]} > 0 )) && pkgs+=("${desk_pkgs[@]}")
        [[ -n "$browser_pkg" ]] && pkgs+=("$browser_pkg")
    fi

    if [[ -n "$aur_helper" ]]; then
        local -a aur_base_pkgs=()
        mapfile -t aur_base_pkgs < <(_filter_repo_pkgs base-devel git)
        (( ${#aur_base_pkgs[@]} > 0 )) && pkgs+=("${aur_base_pkgs[@]}")
        (( aur_in_repo == 1 )) && pkgs+=("$aur_helper")
    fi

    local build_dir="${work_base}/ncui-sqfs-build.$$"
    trap '_safe_rm_chroot_dir "'"$build_dir"'" || true; cleanup_rescue' EXIT INT TERM HUP
    _safe_rm_chroot_dir "$build_dir" || exit 1
    mkdir -p "$build_dir"

    msg_step "Bootstrapping Live Recovery rootfs in ${build_dir} (profile=${ncui_profile}, user=${rec_user}, host=${rec_host}, kernel=${kern_pkg}${browser_pkg:+, browser=${browser_pkg}}${aur_helper:+, aur=${aur_helper}})..."
    _arch_pacstrap "$build_dir" "${pkgs[@]}"

    printf '%s\n' "$rec_host" > "${build_dir}/etc/hostname"
    printf '127.0.0.1\tlocalhost\n::1\t\tlocalhost\n127.0.1.1\t%s.localdomain %s\n' "$rec_host" "$rec_host" > "${build_dir}/etc/hosts"
    write_recovery_hook_files_into "$build_dir"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --root="$build_dir" enable NetworkManager.service >/dev/null 2>&1 || true
    else
        chroot "$build_dir" systemctl enable NetworkManager.service >/dev/null 2>&1 || true
    fi
    _install_ncui_into_rootfs "$build_dir" "$ncui_profile" "$src_dir"
    _configure_recovery_accounts "$build_dir" "$pw1" "$want_desktop" "$rec_user" "$rec_kb"
    unset pw1
    _write_recovery_issue "$build_dir" "$rec_user" "$want_desktop"
    (( want_desktop == 1 )) && _write_recovery_hid_rebind "$build_dir"
    if [[ -n "$aur_helper" ]] && (( aur_in_repo == 0 )); then
        _install_aur_helper_into_rootfs "$build_dir" "$aur_helper" "$rec_user"
    fi
    _import_host_settings_into_rootfs "$build_dir" "$host_user" "$import_ui" "$import_nm" "$want_desktop" "$rec_user" "$rec_kb"
    rm -rf "${build_dir}/var/cache/pacman/pkg"/* "${build_dir}/var/log/journal"/* 2>/dev/null || true

    NEW_SQUASHFS="${TARGET_MNT}/recovery.squashfs.new"
    msg_step "Compressing ${NEW_SQUASHFS} (zstd -19)..."
    mksquashfs "$build_dir" "$NEW_SQUASHFS" -comp zstd -Xcompression-level 19 -b 1M -noappend
    unsquashfs -s "$NEW_SQUASHFS" >/dev/null 2>&1 || { msg_err "SquashFS integrity check failed."; exit 1; }
    local nsz
    nsz="$(stat -c%s "$NEW_SQUASHFS")"
    (( nsz < 4294967295 )) || { msg_err "SquashFS exceeds 4 GiB FAT32 limit (${nsz} bytes)."; exit 1; }

    IN_FINAL_SWAP=1
    swap_pair_safe "$NEW_SQUASHFS" "$cur_sq" "$bak_sq" 1
    sync
    COMMIT_COMPLETED=1
    build_uki_from_rootfs "$build_dir"
    _safe_rm_chroot_dir "$build_dir"
    msg_ok "Live Recovery SquashFS + Signed UKI built successfully on ESP!"
    return 0
}

_umount_edit_tree() {
    local work_dir="$1"
    [[ -n "$work_dir" && -d "$work_dir" ]] || return 0
    local submounts=() _id _pid _maj _rt _mp _rest
    while read -r _id _pid _maj _rt _mp _rest; do
        [[ -n "$_mp" ]] || continue
        _mp="${_mp//\\040/ }"; _mp="${_mp//\\011/$'\t'}"; _mp="${_mp//\\134/\\}"
        if [[ "$_mp" == "$work_dir" || "$_mp" == "${work_dir}/"* ]]; then
            submounts+=("$_mp")
        fi
    done < /proc/self/mountinfo
    if (( ${#submounts[@]} > 0 )); then
        local rev=() m
        mapfile -t rev < <(printf '%s\n' "${submounts[@]}" | tac)
        for m in "${rev[@]}"; do
            umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
        done
    fi
    if ! grep -qF " ${work_dir}/" /proc/self/mountinfo 2>/dev/null; then
        rm -rf "$work_dir" 2>/dev/null || true
    fi
}

do_edit_recovery_squashfs() {
    if [[ -d "$UPPER_DIR" ]]; then
        msg_info "Already running inside Live RAM Recovery (${UPPER_DIR})."
        msg_info "Make any edits directly in this session, then run: nc-rescue commit"
        return 0
    fi
    load_rescue_config
    resolve_esp_mnt 1 || { msg_err "Unable to mount ESP read-write."; exit 1; }
    local cur_sq="${TARGET_MNT}/recovery.squashfs" bak_sq="${TARGET_MNT}/recovery.squashfs.old"
    [[ -s "$cur_sq" ]] || { msg_err "No recovery image found at ${cur_sq}. Run 'nc-rescue --build-recovery' first."; exit 1; }
    command -v mksquashfs >/dev/null 2>&1 || { msg_err "mksquashfs not found (install squashfs-tools)."; exit 1; }

    local edit_work_base
    edit_work_base="$(_pick_exec_work_base 1073741824)" || exit 1
    local work_dir="${edit_work_base}/ncui-sqfs-edit.$$"
    mkdir -p "${work_dir}/lower" "${work_dir}/upper" "${work_dir}/work" "${work_dir}/merged"
    _edit_cleanup() {
        _umount_edit_tree "$work_dir"
        cleanup_rescue
    }
    trap _edit_cleanup EXIT INT TERM HUP

    msg_step "Mounting ${cur_sq} read-only + OverlayFS..."
    mount -t squashfs -o ro,loop "$cur_sq" "${work_dir}/lower"
    mount -t overlay overlay -o "lowerdir=${work_dir}/lower,upperdir=${work_dir}/upper,workdir=${work_dir}/work" "${work_dir}/merged"

    local shell_bin="/bin/bash"
    [[ -x "${work_dir}/merged/bin/zsh" ]] && shell_bin="/bin/zsh"
    ui_header "NC-UI RECOVERY IMAGE CHROOT (OverlayFS)" "Target: ${cur_sq}"
    msg_info "Exit the shell ('exit' / Ctrl+D) when done to commit or discard changes."
    echo ""
    local chroot_rc=0
    if command -v arch-chroot >/dev/null 2>&1; then
        arch-chroot "${work_dir}/merged" "$shell_bin" </dev/tty >/dev/tty 2>/dev/tty || chroot_rc=$?
    else
        local merged="${work_dir}/merged"
        mount -t proc proc "${merged}/proc"
        mount -t sysfs sysfs "${merged}/sys"
        mount --rbind /dev "${merged}/dev"
        mount --make-rslave "${merged}/dev" 2>/dev/null || true
        mount --bind /run "${merged}/run"
        [[ -f /etc/resolv.conf ]] && cp -L /etc/resolv.conf "${merged}/etc/resolv.conf" 2>/dev/null || true
        chroot "$merged" "$shell_bin" </dev/tty >/dev/tty 2>/dev/tty || chroot_rc=$?
    fi
    if [[ -r /dev/tty ]] && command -v python3 >/dev/null 2>&1; then
        python3 -c 'import os, signal; signal.signal(signal.SIGTTOU, signal.SIG_IGN); fd = os.open("/dev/tty", os.O_RDWR); os.tcsetpgrp(fd, os.getpgrp()); os.close(fd)' 2>/dev/null || true
    fi
    (( chroot_rc != 0 )) && msg_warn "Chroot shell exited with status ${chroot_rc}."

    local has_changes=""
    has_changes="$(find "${work_dir}/upper" -mindepth 1 -print -quit 2>/dev/null || true)"
    if [[ -z "$has_changes" ]]; then
        msg_info "No changes made inside recovery chroot; closing cleanly."
        _umount_edit_tree "$work_dir"
        trap cleanup_rescue EXIT INT TERM HUP
        return 0
    fi

    if ! ui_confirm "Changes detected inside recovery chroot. Commit to recovery.squashfs (rotating current to .old)?" "n"; then
        msg_info "Changes discarded cleanly."
        _umount_edit_tree "$work_dir"
        trap cleanup_rescue EXIT INT TERM HUP
        return 0
    fi

    local cur_sz esp_free_b req_b cur_h esp_h req_h
    cur_sz="$(stat -c%s "$cur_sq" 2>/dev/null || echo 0)"
    esp_free_b="$(df -PB1 "$TARGET_MNT" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0)"
    req_b=$(( cur_sz + 367001600 ))
    if (( esp_free_b < req_b )); then
        cur_h="$(numfmt --to=iec-i --suffix=B "$cur_sz" 2>/dev/null || echo "${cur_sz}B")"
        esp_h="$(numfmt --to=iec-i --suffix=B "$esp_free_b" 2>/dev/null || echo "${esp_free_b}B")"
        req_h="$(numfmt --to=iec-i --suffix=B "$req_b" 2>/dev/null || echo "${req_b}B")"
        msg_err "Insufficient free space on ESP (${TARGET_MNT}): free=${esp_h}, needed≈${req_h} (current=${cur_h})."
        exit 1
    fi

    local kern_touched=0
    if [[ -d "${work_dir}/upper/usr/lib/modules" || -d "${work_dir}/upper/etc/initcpio" || -d "${work_dir}/upper/boot" ]]; then
        kern_touched=1
    fi

    NEW_SQUASHFS="${TARGET_MNT}/recovery.squashfs.new"
    msg_step "Packing edited recovery into ${NEW_SQUASHFS} (zstd -19)..."
    mksquashfs "${work_dir}/merged" "$NEW_SQUASHFS" -comp zstd -Xcompression-level 19 -b 1M -noappend
    unsquashfs -s "$NEW_SQUASHFS" >/dev/null 2>&1 || { msg_err "SquashFS integrity check failed."; exit 1; }
    local nsz
    nsz="$(stat -c%s "$NEW_SQUASHFS")"
    (( nsz < 4294967295 )) || { msg_err "SquashFS exceeds 4 GiB FAT32 limit (${nsz} bytes)."; exit 1; }

    IN_FINAL_SWAP=1
    swap_pair_safe "$NEW_SQUASHFS" "$cur_sq" "$bak_sq" 1
    sync
    COMMIT_COMPLETED=1

    _umount_edit_tree "$work_dir"
    trap cleanup_rescue EXIT INT TERM HUP

    local uki_path="" alt
    for alt in "$CFG_UKI_NAME" "nc-rescue.efi"; do
        [[ -n "$alt" && -f "${TARGET_MNT}/EFI/Linux/${alt}" ]] && { uki_path="${TARGET_MNT}/EFI/Linux/${alt}"; break; }
    done
    if (( kern_touched == 1 )) || [[ -z "$uki_path" ]]; then
        build_uki_standalone
    else
        collect_and_write_status >/dev/null
    fi
    msg_ok "Edited Recovery SquashFS committed atomically (previous saved as .old)."
    return 0
}

do_delete_recovery_artifacts() {
    load_rescue_config
    resolve_esp_mnt 1 || { msg_err "Unable to mount ESP read-write."; exit 1; }

    local cur_sq="${TARGET_MNT}/recovery.squashfs" bak_sq="${TARGET_MNT}/recovery.squashfs.old"
    local cur_uki="${TARGET_MNT}/EFI/Linux/${CFG_UKI_NAME}"
    if [[ ! -f "$cur_uki" && -f "${TARGET_MNT}/EFI/Linux/nc-rescue.efi" ]]; then
        cur_uki="${TARGET_MNT}/EFI/Linux/nc-rescue.efi"
    fi
    local bak_uki="${cur_uki}.old"

    if [[ ! -f "$cur_sq" && ! -f "$bak_sq" && ! -f "$cur_uki" && ! -f "$bak_uki" ]]; then
        msg_info "No recovery artifacts found on ESP (${TARGET_MNT})."
        return 0
    fi

    ui_header "DELETE RECOVERY ARTIFACTS" "ESP: ${TARGET_MNT}"
    ui_section "ESP" "Found Artifacts"
    local p szh
    for p in "$cur_sq" "$bak_sq" "$cur_uki" "$bak_uki"; do
        if [[ -f "$p" ]]; then
            szh="$(numfmt --to=iec-i --suffix=B "$(stat -c%s "$p" 2>/dev/null || echo 0)" 2>/dev/null || echo '?')"
            ui_kv "$(basename "$p")" "$p" "(${szh})"
        fi
    done
    echo ""
    [[ -f "$bak_sq" || -f "$bak_uki" ]] && ui_opt "1" "Delete only .old backup copy"
    [[ -f "$cur_sq" || -f "$cur_uki" ]] && ui_opt "2" "Delete active recovery image & UKI"
    [[ ( -f "$cur_sq" || -f "$cur_uki" ) && ( -f "$bak_sq" || -f "$bak_uki" ) ]] && ui_opt "3" "Delete ALL recovery copies (active + .old)"
    ui_opt "0" "Cancel"
    printf '\n'
    local sel=""
    read -r -e -p "$(_rl_prompt "Select option:")" sel </dev/tty || sel="0"
    local del_cur=0 del_bak=0
    case "$sel" in
        1) [[ -f "$bak_sq" || -f "$bak_uki" ]] && del_bak=1 ;;
        2) [[ -f "$cur_sq" || -f "$cur_uki" ]] && del_cur=1 ;;
        3) [[ -f "$cur_sq" || -f "$cur_uki" ]] && del_cur=1; [[ -f "$bak_sq" || -f "$bak_uki" ]] && del_bak=1 ;;
        *) msg_info "Cancelled."; return 0 ;;
    esac
    (( del_cur == 1 || del_bak == 1 )) || { msg_info "Nothing selected."; return 0; }

    local removes_last=0
    if (( del_cur == 1 )) && [[ ! -f "$bak_sq" || "$del_bak" -eq 1 ]]; then
        removes_last=1
    fi

    local c2=""
    if (( removes_last == 1 )); then
        msg_warn "WARNING: This will leave ZERO bootable recovery SquashFS images on your ESP!"
        ui_confirm "Are you sure you want to delete the last recovery copy?" "n" || { msg_info "Deletion cancelled."; return 0; }
        read -r -e -p "$(_rl_prompt "Type 'DELETE' to confirm permanent removal:")" c2 </dev/tty || c2=""
        [[ "$c2" == "DELETE" ]] || { msg_info "Confirmation mismatch; deletion cancelled."; return 0; }
    else
        ui_confirm "Confirm deletion of selected recovery artifact(s)?" "n" || { msg_info "Deletion cancelled."; return 0; }
    fi

    (( del_cur == 1 )) && rm -f "$cur_sq" "$cur_uki"
    (( del_bak == 1 )) && rm -f "$bak_sq" "$bak_uki"
    sync
    collect_and_write_status >/dev/null
    msg_ok "Selected recovery artifact(s) removed from ESP."
    return 0
}

do_manage_recovery() {
    while true; do
        load_rescue_config
        resolve_esp_mnt 0 || true
        local esp_free="-" sq_st="MISSING" old_st="NONE" uki_st="MISSING"
        if [[ -n "$TARGET_MNT" ]]; then
            esp_free="$(df -h "$TARGET_MNT" 2>/dev/null | awk 'NR==2 {print $4}' || echo '-')"
            [[ -f "${TARGET_MNT}/recovery.squashfs" ]] && sq_st="$(numfmt --to=iec-i --suffix=B "$(stat -c%s "${TARGET_MNT}/recovery.squashfs" 2>/dev/null || echo 0)")"
            [[ -f "${TARGET_MNT}/recovery.squashfs.old" ]] && old_st="$(numfmt --to=iec-i --suffix=B "$(stat -c%s "${TARGET_MNT}/recovery.squashfs.old" 2>/dev/null || echo 0)")"
            for alt in "$CFG_UKI_NAME" "nc-rescue.efi"; do
                if [[ -n "$alt" && -f "${TARGET_MNT}/EFI/Linux/${alt}" ]]; then
                    uki_st="${alt} ($(numfmt --to=iec-i --suffix=B "$(stat -c%s "${TARGET_MNT}/EFI/Linux/${alt}" 2>/dev/null || echo 0)"))"
                    break
                fi
            done
        fi

        ui_header "NC-UI RECOVERY IMAGE MANAGER" "ESP (${TARGET_MNT:-/boot}) · Free: ${esp_free}"
        ui_kv "SquashFS" "$sq_st" "(.old: ${old_st})"
        ui_kv "Recovery UKI" "$uki_st"
        ui_section "MENU" "Actions"
        ui_opt "1" "Build new Recovery Image (--build-recovery)"
        ui_opt "2" "Edit existing Recovery Image in chroot (edit)"
        ui_opt "3" "Sync NC-UI into existing Recovery Image (--sync-ncui)"
        ui_opt "4" "Rebuild & sign Recovery UKI (build-uki)"
        ui_opt "5" "Rollback to .old backup (rollback-esp)"
        ui_opt "6" "Delete Recovery Image / .old backup (delete)"
        ui_opt "0" "Exit"
        printf '\n'
        local ch=""
        read -r -e -p "$(_rl_prompt "Select action [0-6]:")" ch </dev/tty || break
        case "$ch" in
            1) ( do_build_recovery_squashfs ) || true ;;
            2) ( do_edit_recovery_squashfs ) || true ;;
            3) ( do_sync_ncui_squashfs ) || true ;;
            4) ( build_uki_standalone ) || true ;;
            5) ( do_rollback_esp ) || true ;;
            6) ( do_delete_recovery_artifacts ) || true ;;
            0|q|Q|"") break ;;
            *) msg_warn "Invalid choice: ${ch}" ;;
        esac
    done
    return 0
}

do_config_stdin() {
    local payload
    payload="$(cat)"
    mkdir -p "$(dirname "$CONF_FILE")"
    if [[ ! -f "$CONF_FILE" ]]; then
        cat <<'EOF_SEED' > "$CONF_FILE"
# NC-UI Resilience, Posture & Disaster Recovery Configuration

[recovery]
uki_name = "nc-rescue.efi"
sign_sbctl = true
golden_subdir = "images"
EOF_SEED
    fi
    local line k v
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" && "$line" == *"="* ]] || continue
        k="${line%%=*}"
        v="${line#*=}"
        k="$(printf '%s' "$k" | tr -d '[:space:]')"
        v="$(printf '%s' "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        case "$k" in
            uki_name)
                if [[ ! "$v" =~ ^[a-zA-Z0-9._-]{1,64}\.efi$ ]]; then
                    msg_err "Invalid uki_name: ${v}"
                    exit 1
                fi
                CFG_UKI_NAME="$v"
                ;;
            sign_sbctl)
                if [[ "$v" != "true" && "$v" != "false" ]]; then
                    msg_err "Invalid sign_sbctl: ${v}"
                    exit 1
                fi
                CFG_SIGN_SBCTL="$v"
                ;;
            golden_subdir)
                if [[ "$v" == *".."* || ! "$v" =~ ^[a-zA-Z0-9_./-]{1,80}$ ]]; then
                    msg_err "Invalid golden_subdir: ${v}"
                    exit 1
                fi
                CFG_GOLDEN_SUBDIR="$v"
                ;;
            *)
                msg_err "Unsupported [recovery] key: ${k}"
                exit 1
                ;;
        esac
    done <<< "$payload"

    local tmp_cfg="${CONF_FILE}.tmp.$$"
    awk -v sec_target="recovery" -v uki="$CFG_UKI_NAME" -v sb="$CFG_SIGN_SBCTL" -v gs="$CFG_GOLDEN_SUBDIR" '
        function emit_missing() {
            if (in_sec && !seen_uki) print "uki_name = \"" uki "\""
            if (in_sec && !seen_sb)  print "sign_sbctl = " sb
            if (in_sec && !seen_gs)  print "golden_subdir = \"" gs "\""
        }
        /^\[/ {
            if (in_sec) { emit_missing(); in_sec = 0 }
            if ($0 == "[" sec_target "]") { in_sec = 1; found_sec = 1 }
            print $0; next
        }
        in_sec && $0 ~ /^[[:space:]]*uki_name[[:space:]]*=/ { print "uki_name = \"" uki "\""; seen_uki = 1; next }
        in_sec && $0 ~ /^[[:space:]]*sign_sbctl[[:space:]]*=/ { print "sign_sbctl = " sb; seen_sb = 1; next }
        in_sec && $0 ~ /^[[:space:]]*golden_subdir[[:space:]]*=/ { print "golden_subdir = \"" gs "\""; seen_gs = 1; next }
        { print $0 }
        END {
            if (in_sec) { emit_missing() }
            else if (!found_sec) {
                print ""
                print "[recovery]"
                print "uki_name = \"" uki "\""
                print "sign_sbctl = " sb
                print "golden_subdir = \"" gs "\""
            }
        }
    ' "$CONF_FILE" > "$tmp_cfg"
    chown root:root "$tmp_cfg" 2>/dev/null || true
    chmod 0644 "$tmp_cfg"
    mv -f "$tmp_cfg" "$CONF_FILE"
    collect_and_write_status >/dev/null 2>&1 || true
    msg_ok "CONFIG_OK"
    return 0
}

ORIG_ARGS=("$@")
require_root() {
    [[ $EUID -eq 0 ]] && return 0
    if [[ -t 0 || -t 1 ]]; then
        local self_bin
        self_bin="$(realpath -e "$0" 2>/dev/null || printf '%s' "$0")"
        exec sudo "$self_bin" "${ORIG_ARGS[@]}"
    fi
    msg_err "Root privileges required."
    exit 1
}

ACTION="${1:-status}"
case "$ACTION" in
    -h|--help)
        show_help
        ;;
    status)
        out="$(collect_and_write_status)"
        ui_header "NC-UI RECOVERY STATUS" "$CONF_FILE"
        while IFS='=' read -r _sk _sv || [[ -n "${_sk:-}" ]]; do
            [[ -n "${_sk:-}" ]] || continue
            _sv_c="${_sv#\"}"; _sv_c="${_sv_c%\"}"
            case "$_sv_c" in
                1|true|YES|OK|signed)
                    printf "  %s%-22s%s %s%s%s\n" "$CLR_SCHEMA" "$_sk" "$CLR_RESET" "$CLR_OK" "$_sv" "$CLR_RESET"
                    ;;
                0|false|MISSING|NONE|NO|unsigned|"")
                    printf "  %s%-22s%s %s%s%s\n" "$CLR_SCHEMA" "$_sk" "$CLR_RESET" "$CLR_DIM" "$_sv" "$CLR_RESET"
                    ;;
                *)
                    printf "  %s%-22s%s %s%s%s\n" "$CLR_SCHEMA" "$_sk" "$CLR_RESET" "$CLR_VAL" "$_sv" "$CLR_RESET"
                    ;;
            esac
        done <<< "$out"
        echo ""
        ;;
    status-env|check-health|--check-health)
        collect_and_write_status
        ;;
    install-hooks)
        require_root
        load_rescue_config
        resolve_esp_mnt 1 || true
        write_recovery_hook_files
        msg_ok "Installed recovery-ram hooks and ${ROLLBACK_BIN}."
        ;;
    build-uki)
        require_root
        build_uki_standalone
        ;;
    commit|-c)
        require_root
        do_live_commit 0 0 0
        ;;
    commit-rebuild|-r|--rebuild)
        require_root
        do_live_commit 1 0 0
        ;;
    commit-skip-uki|-s|--skip-uki)
        require_root
        do_live_commit 0 0 1
        ;;
    rollback-esp)
        require_root
        do_rollback_esp
        ;;
    limine-set-stdin)
        require_root
        do_limine_set_stdin
        ;;
    limine-apply-stdin)
        require_root
        do_limine_apply_stdin
        ;;
    limine-wallpaper-stdin)
        require_root
        do_limine_wallpaper_stdin
        ;;
    register-limine)
        require_root
        do_register_limine
        ;;
    --sync-ncui)
        require_root
        do_sync_ncui_squashfs
        ;;
    --build-recovery)
        require_root
        do_build_recovery_squashfs
        ;;
    manage|--manage)
        require_root
        do_manage_recovery
        ;;
    edit|chroot|--edit|--chroot)
        require_root
        do_edit_recovery_squashfs
        ;;
    delete|--delete)
        require_root
        do_delete_recovery_artifacts
        ;;
    config-stdin)
        require_root
        load_rescue_config
        do_config_stdin
        ;;
    *)
        msg_err "Unknown action: ${ACTION}. Use --help."
        exit 1
        ;;
esac
