sync
umount "\$PROBE_DIR" 2>/dev/null || true
printf "Rolled back .old recovery artifacts on %s.\n" "\${ESP_FOUND}"
EOF_RB
    chmod 0755 "$rb_dst"
    if [[ -n "$TARGET_MNT" && -d "$TARGET_MNT" ]]; then
        cp -f "$rb_dst" "${TARGET_MNT}/nc-rollback.sh" 2>/dev/null || true
    fi
    return 0
}

write_recovery_hook_files() {
    write_recovery_hook_files_into ""
