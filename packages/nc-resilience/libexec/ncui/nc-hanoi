run_versions_tsv_stdin_mode() {
    export NC_NONINTERACTIVE=1
    local abs_p=""
    IFS= read -r abs_p || true
    abs_p="${abs_p//$'\r'/}"
    abs_p="$(printf '%s' "$abs_p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -n "$abs_p" && "$abs_p" == /* && "$abs_p" != *".."* ]] || { echo "VER_ERR|Invalid path" >&2; exit 2; }
    ensure_nas_mounted true || exit 2
    resolve_active_profile true
    index_all_nas_deltas
    resolve_nas_target_for_query "$abs_p" true
    local h_dir="$RESOLVED_QUERY_HIST"
    [[ -n "$h_dir" && -d "$h_dir" ]] || exit 0

    local found_backups=() p
    while IFS= read -r -d '' p; do
        [[ "$p" == *.bak ]] && found_backups+=("$p")
    done < <(LC_ALL=C find "$h_dir" -maxdepth 1 -type f -name '*.bak' -print0 2>/dev/null || true)
    local count=${#found_backups[@]}
    (( count > 0 )) || exit 0
    (( count > 1 )) && mapfile -d '' -t found_backups < <(printf '%s\0' "${found_backups[@]}" | sort -zr)
    (( count > 12 )) && found_backups=("${found_backups[@]:0:12}") && count=12

    local bak_epochs=() bak_humans=()
    batch_bak_epochs_from_files found_backups bak_epochs bak_humans
    local now_epoch; now_epoch_into now_epoch
    invalidate_local_cache "$abs_p"
    prefetch_local_paths_metadata true "$abs_p"
    local loc_sha=""
    [[ "${LOC_EXISTS[$abs_p]:-0}" == "1" ]] && calc_target_sha256_into loc_sha "$abs_p"

    local owner_alias="${RESOLVED_QUERY_OWNER:-$ACTIVE_ALIAS}"
    local i b_file b_payload base_name ev_label human_ts v_epoch slot_str author diff_s bak_sha
    for (( i=0; i<count; i++ )); do
        b_file="${found_backups[$i]}"
        resolve_bak_payload_into b_payload "$b_file"
        base_name="${b_file##*/}"; base_name="${base_name%.bak}"
        ev_label="MOD"
        [[ "$base_name" == *_d ]] && ev_label="DEL"
        inspect_bak_placeholder_cached "$b_file" && ev_label="${ev_label}[S]"
        human_ts="${bak_humans[$i]}"; v_epoch="${bak_epochs[$i]:-0}"
        describe_hanoi_slot_into slot_str "$v_epoch" "$i" "$now_epoch"
        load_origin_metadata "$b_file"
        author="${ORIG_LAST_UPDATED_BY:-$owner_alias}"

        diff_s="-"
        if [[ "${LOC_EXISTS[$abs_p]:-0}" != "1" ]]; then
            diff_s="ABSENT"
        elif [[ "$ENC_MODE" != "none" || "$b_payload" == *.enc* ]]; then
            if [[ -n "$ORIG_SHA256" && "$loc_sha" == "$ORIG_SHA256" ]]; then
                diff_s="IDENTICAL"
            else
                diff_s="ENCRYPTED"
            fi
        elif [[ "${LOC_TYPE[$abs_p]:-}" == "f" ]] && nas_is_regular_file "$b_payload"; then
            bak_sha="$ORIG_SHA256"
            [[ -z "$bak_sha" ]] && calc_target_sha256_into bak_sha "$b_payload"
            if [[ "$loc_sha" == "$bak_sha" ]]; then
                diff_s="IDENTICAL"
            else
                local st_a=0 st_r=0
                get_diff_summary_nums_into st_a st_r "$abs_p" "$b_payload"
                diff_s="+${st_a}/-${st_r}"
            fi
        else
            diff_s="${ORIG_TYPE:-item}"
        fi
        printf 'VER\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n' "$((i + 1))" "$human_ts" "$slot_str" "$ev_label" "$author" "$diff_s" "$b_file"
    done
    exit 0
}

run_restore_bak_stdin_mode() {
    export NC_NONINTERACTIVE=1
    local line="" orig_p="" bak_p="" mode_s="full"
    IFS= read -r line || true
    line="${line//$'\r'/}"
    IFS='|' read -r orig_p bak_p mode_s <<< "$line"
    orig_p="$(printf '%s' "$orig_p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    bak_p="$(printf '%s' "$bak_p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    mode_s="${mode_s:-full}"
    ensure_nas_mounted false
    resolve_active_profile true
    [[ -n "$orig_p" && "$orig_p" == /* && "$orig_p" != *".."* ]] || { echo "RB_ERR|Invalid path" >&2; exit 2; }
    [[ -n "$bak_p" && "$bak_p" == "${LINUX_ROOT%/}/"*".bak" && "$bak_p" != *".."* && -f "$bak_p" ]] || {
        echo "RB_ERR|Invalid snapshot file: $bak_p" >&2; exit 2
    }
    acquire_nas_lock
    index_all_nas_deltas
    load_origin_metadata "$bak_p"
    if [[ "${ENC_MODE:-none}" != "none" || "$bak_p" == *.enc ]]; then
        echo "RB_ERR|Encrypted snapshot requires terminal restore" >&2
        exit 3
    fi
    install_nas_item_to_local "$bak_p" "$orig_p"
    if [[ "$mode_s" == "full" ]]; then
        resolve_nas_target_for_query "$orig_p" true
        local owner_alias="${RESOLVED_QUERY_OWNER:-$ACTIVE_ALIAS}"
        local owner_delta="${SYS_DELTA_MAP[$owner_alias]:-$RESOLVED_DELTA_DIR}"
        local owner_bak="$LINUX_ROOT/${SYS_FOLDER_MAP[$owner_alias]:-$ACTIVE_FOLDER}/$BACKUP_DIR_NAME"
        local target_delta="${RESOLVED_QUERY_NAS:-$owner_delta/$RESOLVED_QUERY_REL}"
        local td; path_dirname_into td "$target_delta"
        [[ -d "$td" ]] || mkdir -p "$td"
        local ts_now now_sec; now_ts_into ts_now; now_epoch_into now_sec
        touch -h -d "@$now_sec" "$orig_p" 2>/dev/null || true
        invalidate_local_cache "$orig_p"
        push_local_item_to_nas "$orig_p" "$target_delta" "$ts_now" "$owner_delta" "$owner_bak" "$owner_alias"
        _vault_ssh_push_if_needed
    fi
    update_status_cache true
    printf 'RESTORE_BAK_OK|%s\n' "$orig_p"
    exit 0
}

run_diff_bak_mode() {
    local bak_p="${POSITIONAL_ARGS[0]:-}" orig_p="${POSITIONAL_ARGS[1]:-}"
    ensure_nas_mounted true || exit 2
    resolve_active_profile true
    [[ -n "$orig_p" && "$orig_p" == /* && "$orig_p" != *".."* ]] || { echo "Invalid target path" >&2; exit 2; }
    [[ -n "$bak_p" && "$bak_p" == "${LINUX_ROOT%/}/"*".bak" && "$bak_p" != *".."* && -f "$bak_p" ]] || {
        echo "Snapshot not found: $bak_p" >&2; exit 2
    }
    load_origin_metadata "$bak_p"
    local payload_src=""
    resolve_bak_payload_into payload_src "$bak_p"
    if [[ ! -e "$orig_p" && ! -L "$orig_p" ]]; then
        echo -e "${C_YELLOW}[!] Local file absent ($orig_p). Snapshot path: $payload_src${C_RESET}"
        exit 0
    fi
    if [[ "$ENC_MODE" != "none" || "$payload_src" == *.enc ]]; then
        get_work_tmp_dir
        local temp_dec="$WORK_TMP_DIR/bak_diff.dec"
        decrypt_payload "$payload_src" "$temp_dec" "$ORIG_MK_FP"
        render_full_diff "$orig_p" "$temp_dec" "$orig_p"
        rm -f "$temp_dec"
    else
        render_full_diff "$orig_p" "$payload_src" "$orig_p"
    fi
    exit 0
}

main() {
    local arg
    for arg in "$@"; do
        [[ "$arg" == "-h" || "$arg" == "--help" ]] && usage
    done

    MODE=""
    REVERSE_SYNC=false
    REVERSE_FORCED=false
    SECURE_ENCRYPT=false
    DEBUG_MODE=false
    CUSTOM_DIR=""
    SHARE_TARGETS_ARG=""
    CLI_PROFILE_OVERRIDE=""
    PRUNE_ALL_SYSTEMS=false
    SERVICE_ACTION=""
    POSITIONAL_ARGS=()

    local orig_args=("$@")
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --init)     MODE="init"; shift ;;
            -s|--sync)  MODE="sync"; shift ;;
            --reverse)  REVERSE_SYNC=true; shift ;;
            --reverse-forced) REVERSE_SYNC=true; REVERSE_FORCED=true; shift ;;
            -a|--add)   MODE="add"; shift ;;
            -r|--restore) MODE="restore"; shift ;;
            -H|--history) MODE="history"; shift ;;
            -u|--update)  MODE="update"; shift ;;
            -p|--prune)   MODE="prune"; shift ;;
            -l|--list|--status) MODE="list"; shift ;;
            list-tsv|--list-tsv) MODE="list_tsv"; shift ;;
            history-tsv|--history-tsv) MODE="history_tsv"; shift ;;
            sync-auto|--sync-auto) MODE="sync_auto"; shift ;;
            pull-auto|--pull-auto) MODE="pull_auto"; shift ;;
            prune-auto|--prune-auto) MODE="prune_auto"; shift ;;
            add-stdin|--add-stdin) MODE="add_stdin"; shift ;;
            push-one-stdin|--push-one-stdin) MODE="push_one_stdin"; shift ;;
            restore-stdin|--restore-stdin) MODE="restore_stdin"; shift ;;
            share-stdin|--share-stdin) MODE="share_stdin"; shift ;;
            versions-tsv-stdin|--versions-tsv-stdin) MODE="versions_tsv_stdin"; shift ;;
            restore-bak-stdin|--restore-bak-stdin) MODE="restore_bak_stdin"; shift ;;
            --diff-bak)
                [[ -z "${2:-}" || -z "${3:-}" ]] && { echo -e "${C_RED}[-]${C_RESET} --diff-bak requires <bak_path> <orig_path>." >&2; exit 1; }
                MODE="diff_bak"; POSITIONAL_ARGS+=("$2" "$3"); shift 3 ;;
            timer-on)   MODE="service"; SERVICE_ACTION="enable"; shift ;;
            timer-off)  MODE="service"; SERVICE_ACTION="disable"; shift ;;
            -d|--diff)
                [[ -z "${2:-}" ]] && { echo -e "${C_RED}[-]${C_RESET} Errore: --diff richiede un percorso come argomento." >&2; exit 1; }
                MODE="diff"; POSITIONAL_ARGS+=("$2"); shift 2 ;;
            --check) MODE="check"; shift ;;
            --service)
                [[ -z "${2:-}" ]] && { echo -e "${C_RED}[-]${C_RESET} Errore: --service richiede un argomento (enable|disable|status)." >&2; exit 1; }
                MODE="service"; SERVICE_ACTION="$2"; shift 2 ;;
            -S|--share)
                [[ -z "${2:-}" ]] && { echo -e "${C_RED}[-]${C_RESET} Errore: l'opzione $1 richiede i target (es. dc,wsl, all, local, o dc:nc,wsl)." >&2; exit 1; }
                SHARE_TARGETS_ARG="$2"; [[ -z "$MODE" ]] && MODE="share"; shift 2 ;;
            -P|--profile)
                [[ -z "${2:-}" ]] && { echo -e "${C_RED}[-]${C_RESET} Errore: l'opzione $1 richiede l'alias del profilo." >&2; exit 1; }
                CLI_PROFILE_OVERRIDE="${2,,}"; shift 2 ;;
            --all)         PRUNE_ALL_SYSTEMS=true; shift ;;
            -sec|--secure) SECURE_ENCRYPT=true; shift ;;
            --debug)       DEBUG_MODE=true; shift ;;
            -D|--dir|--directory)
                [[ -z "${2:-}" ]] && { echo -e "${C_RED}[-]${C_RESET} Errore: l'opzione $1 richiede un argomento." >&2; exit 1; }
                CUSTOM_DIR="$2"; shift 2 ;;
            -*)
                echo -e "${C_RED}[-]${C_RESET} Opzione sconosciuta: $1. Usa -h per l'aiuto." >&2; exit 1 ;;
            *)
                POSITIONAL_ARGS+=("$1"); shift ;;
        esac
    done

    if [[ "$REVERSE_SYNC" == true && "$MODE" != "sync" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: le opzioni --reverse e --reverse-forced possono essere usate solo insieme a -s / --sync." >&2
        exit 1
    fi
    if [[ -z "$MODE" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: specifica un'azione (-a, -s, -r, -H, -u, -S, -l, -p, -d, --init, --service o -h)." >&2
        exit 1
    fi

    # Auto-elevation trasparente (in --check solo non-interattiva se possibile, salvo test sandbox)
    if [[ $EUID -ne 0 && "${NC_TEST_LOCAL_NAS:-0}" != "1" ]]; then
        local self_bin
        self_bin="$(realpath -e "$0" 2>/dev/null || printf '%s' "$0")"
        if [[ "$MODE" == "check" ]]; then
            if sudo -n true 2>/dev/null; then
                exec sudo -n "$self_bin" "${orig_args[@]}"
            fi
            exit 0
        fi
        exec sudo "$self_bin" "${orig_args[@]}"
    fi

    detect_local_environment

    if [[ "$MODE" == "check" ]]; then
        update_status_cache false
        exit 0
    fi
    if [[ "$MODE" == "service" ]]; then
        manage_service "$SERVICE_ACTION"
    fi

    case "$MODE" in
        list_tsv|history_tsv|sync_auto|pull_auto|prune_auto|add_stdin|push_one_stdin|restore_stdin|share_stdin|versions_tsv_stdin|restore_bak_stdin)
            export NC_NONINTERACTIVE=1
            ;;
        *)
            ensure_nas_mounted false
            resolve_active_profile false
            ;;
    esac

    case "$MODE" in
        init)        init_master_key ;;
        add)         run_add_mode ;;
        share)       run_share_mode ;;
        sync)        run_sync_mode ;;
        restore)     run_restore_mode ;;
        history)     run_history_mode ;;
        update)      run_update_mode ;;
        prune)       run_prune_mode ;;
        list)        run_list_mode ;;
        diff)        run_diff_mode ;;
        list_tsv)    run_list_tsv_mode ;;
        history_tsv) run_history_tsv_mode ;;
        sync_auto)   run_sync_auto_mode ;;
        pull_auto)   run_pull_auto_mode ;;
        prune_auto)  run_prune_auto_mode ;;
        add_stdin)   run_add_stdin_mode ;;
        push_one_stdin)     run_push_one_stdin_mode ;;
        restore_stdin)      run_restore_stdin_mode ;;
        share_stdin)        run_share_stdin_mode ;;
        versions_tsv_stdin) run_versions_tsv_stdin_mode ;;
        restore_bak_stdin)  run_restore_bak_stdin_mode ;;
        diff_bak)           run_diff_bak_mode ;;
    esac
    return 0
}

if [[ "${NC_NAS_CONF_LIB_ONLY:-0}" != "1" ]]; then
    main "$@"
    exit 0
fi
