# ==============================================================================
# LIVELLO 9: SERVIZIO SYSTEMD, HOOK SHELL & ENTRYPOINT MAIN
# ==============================================================================
manage_service() {
    local action="${1:-}"
    local svc_file="/etc/systemd/system/nc-nas-conf.service"
    local tmr_file="/etc/systemd/system/nc-nas-conf.timer"
    local hook_file="/etc/profile.d/nc-nas-conf.sh"
    local zshrc_file="/etc/zsh/zshrc"

    case "$action" in
        enable)
            cat << 'EOF' > "$svc_file"
[Unit]
Description=nc-nas-conf Background Configuration Drift Checker
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/ncui/sbin/nc-hanoi --check
Nice=19
IOSchedulingClass=idle
EOF
            cat << 'EOF' > "$tmr_file"
[Unit]
Description=Periodic check for pending nc-nas-conf configuration changes

[Timer]
OnBootSec=2min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
EOF
            cat << 'EOF' > "$hook_file"
# /etc/profile.d/nc-nas-conf.sh - Promemoria modifiche pending all'avvio della shell
nc_nas_conf_shell_notify() {
    case "$-" in *i*) ;; *) return 0 ;; esac
    local status_file="/var/lib/nc-nas-conf/status.env"
    [ -r "$status_file" ] || return 0
    . "$status_file"

    local total=$(( ${NC_PUSH_TOTAL:-0} + ${NC_PULL_TOTAL:-0} ))
    [ "$total" -gt 0 ] || return 0

    local c_reset="\033[0m" c_cyan="\033[38;5;109m" c_yellow="\033[38;5;222m" c_muted="\033[38;5;244m"
    printf "\n%b[*] nc-nas-conf (%s)%b %b— Allineamento configurazioni:%b\n" "$c_cyan" "${NC_STATUS_SYS:-local}" "$c_reset" "$c_muted" "$c_reset"
    if [ "${NC_PUSH_TOTAL:-0}" -gt 0 ]; then
        printf "    %b↑%b %d file da sincronizzare sul NAS %b(di cui %d condivisi) -> usa 'nc-hanoi -s'%b\n" "$c_yellow" "$c_reset" "$NC_PUSH_TOTAL" "$c_muted" "${NC_PUSH_SHARED:-0}" "$c_reset"
    fi
    if [ "${NC_PULL_TOTAL:-0}" -gt 0 ]; then
        printf "    %b↓%b %d file condivisi aggiornati dalla sorgente %b-> usa 'nc-hanoi -l' o '-r'%b\n" "$c_cyan" "$c_reset" "$NC_PULL_TOTAL" "$c_muted" "$c_reset"
    fi
    printf "\n"
    return 0
}
nc_nas_conf_shell_notify
EOF
            chmod 0644 "$svc_file" "$tmr_file" "$hook_file"

            if [[ -f "$zshrc_file" ]] && ! grep -q "/etc/profile.d/nc-nas-conf.sh" "$zshrc_file" 2>/dev/null; then
                cat << 'EOF' >> "$zshrc_file"

# Hook notifica stato nc-nas-conf
[[ -r /etc/profile.d/nc-nas-conf.sh ]] && source /etc/profile.d/nc-nas-conf.sh
EOF
            fi

            systemctl daemon-reload
            systemctl enable --now nc-nas-conf.timer
            update_status_cache false
            echo -e "${C_GREEN}[+]${C_RESET} Timer systemd 'nc-nas-conf.timer' abilitato e hook shell installato."
            ;;
        disable)
            systemctl disable --now nc-nas-conf.timer 2>/dev/null || true
            rm -f "$svc_file" "$tmr_file" "$hook_file" "$LOCAL_STATUS_ENV"
            systemctl daemon-reload
            echo -e "${C_YELLOW}[-]${C_RESET} Timer systemd e hook di notifica shell rimossi."
            ;;
        status)
            systemctl status nc-nas-conf.timer --no-pager || true
            if [[ -f "$LOCAL_STATUS_ENV" ]]; then
                echo -e "\n${C_CYAN}[*]${C_RESET} Cache stato attuale ($LOCAL_STATUS_ENV):"
                cat "$LOCAL_STATUS_ENV"
            fi
            ;;
        *)
            echo -e "${C_RED}[-]${C_RESET} Errore: Specifica 'enable', 'disable' o 'status' per --service." >&2
            exit 1
            ;;
    esac
    exit 0
}

_strip_ansi() {
    printf '%s' "$1" | sed -E $'s/\x1b\\[[0-9;]*m//g'
}

_vault_ssh_push_if_needed() {
    if [[ -n "${NAS_ROOT:-}" && -f "${NAS_ROOT}/.ncui_ssh_mounted" && -x "$NC_NAS_MOUNT" ]]; then
        "$NC_NAS_MOUNT" ssh-push >/dev/null 2>&1 || true
    fi
}

run_list_tsv_mode() {
    export NC_NONINTERACTIVE=1
    ensure_nas_mounted true || exit 2
    resolve_active_profile true
    prefetch_active_profile_state
    MODE="sync"
    REVERSE_SYNC=false
    evaluate_profile_drift

    local count_real=$(( ${#DELTA_REAL_ITEMS[@]} + ${#DELTA_NEW_DIR_LOCAL_ITEMS[@]} ))
    local count_shared_ph=${#DELTA_SHARED_FILES[@]}
    write_status_env_from_counts "$EVAL_PUSH_TOTAL" "$EVAL_PUSH_SHARED" "$EVAL_PULL_TOTAL"

    printf 'SUMMARY\t%s\t%s\t%d\t%d\t%d\t%d\t%d\n' \
        "$ACTIVE_ALIAS" "$ACTIVE_FOLDER" "$count_real" "$count_shared_ph" \
        "$EVAL_PUSH_TOTAL" "$EVAL_PUSH_SHARED" "$EVAL_PULL_TOTAL"

    local -A dirty_seen=()
    local -a row_codes=() row_roles=() row_shs=() row_paths=()
    local n_rows=${#EVAL_ROW_STAT_STR[@]} i st_c role_c sh_c path_c st_code emitted=0
    for (( i=0; i<n_rows; i++ )); do
        st_c="$(_strip_ansi "${EVAL_ROW_STAT_STR[$i]}")"
        role_c="$(_strip_ansi "${EVAL_ROW_ROLE_STR[$i]}")"
        sh_c="$(_strip_ansi "${EVAL_ROW_SH_STR[$i]}")"
        path_c="$(_strip_ansi "${EVAL_ROW_PATH_STR[$i]}")"
        path_c="${path_c%% (*}"
        path_c="${path_c% \[SEC\]}"
        st_code="IN_SYNC"
        case "$st_c" in
            *"ALLINEATO"*)                             st_code="IN_SYNC" ;;
            *"DA SALVARE"*|*"CREA"*|*"PERM"*)          st_code="PUSH" ;;
            *"DA INSTALLARE"*|*"MANCA"*|*"AGGIORNA"*|*"AGG. DA"*) st_code="PULL" ;;
            *"CONFLITTO"*)                             st_code="CONFLICT" ;;
            *"ELIM."*)                                 st_code="DEL_LOC" ;;
            *"ASSENTE"*)                               st_code="MISSING" ;;
        esac
        dirty_seen["$path_c"]=1
        row_codes+=("$st_code")
        row_roles+=("${role_c:-$ACTIVE_ALIAS}")
        row_shs+=("${sh_c:--}")
        row_paths+=("$path_c")
    done

    for (( i=0; i<${#row_codes[@]} && emitted<500; i++ )); do
        [[ "${row_codes[$i]}" == "IN_SYNC" ]] && continue
        printf 'ITEM\t%s\t%s\t%s\t%s\n' "${row_codes[$i]}" "${row_roles[$i]}" "${row_shs[$i]}" "${row_paths[$i]}"
        emitted=$(( emitted + 1 ))
    done
    for (( i=0; i<${#row_codes[@]} && emitted<500; i++ )); do
        [[ "${row_codes[$i]}" == "IN_SYNC" ]] || continue
        printf 'ITEM\tIN_SYNC\t%s\t%s\t%s\n' "${row_roles[$i]}" "${row_shs[$i]}" "${row_paths[$i]}"
        emitted=$(( emitted + 1 ))
    done

    local mf rel_m rel_c src_p cons
    for mf in "${DELTA_REAL_ITEMS[@]}"; do
        (( emitted < 500 )) || break
        load_origin_metadata "$mf"
        rel_m="${mf#$RESOLVED_DELTA_DIR/}"
        strip_nas_rel_into rel_c "$rel_m"
        src_p="${ORIG_PATH:-/$rel_c}"
        [[ -n "${dirty_seen[$src_p]:-}" ]] && continue
        get_placeholder_consumers_into cons "$rel_c" "$ACTIVE_ALIAS"
        printf 'ITEM\tIN_SYNC\tSORGENTE (%s)\t%s\t%s\n' "$ACTIVE_ALIAS" "${cons:--}" "$src_p"
        emitted=$(( emitted + 1 ))
    done
    local ph_f
    for ph_f in "${DELTA_SHARED_FILES[@]}"; do
        (( emitted < 500 )) || break
        load_shared_placeholder "$ph_f" || continue
        [[ -n "${dirty_seen[$PH_ORIG_PATH]:-}" ]] && continue
        normalize_local_rel_into rel_c "$PH_ORIG_PATH"
        get_placeholder_consumers_into cons "$rel_c" "$PH_SHARED_SOURCE"
        printf 'ITEM\tIN_SYNC\tSHARED <- %s\t%s\t%s\n' "$PH_SHARED_SOURCE" "${cons:-$ACTIVE_ALIAS}" "$PH_ORIG_PATH"
        emitted=$(( emitted + 1 ))
    done
    exit 0
}

run_history_tsv_mode() {
    export NC_NONINTERACTIVE=1
    ensure_nas_mounted true || exit 2
    resolve_active_profile true
    index_all_nas_deltas

    local -A bak_cnt_map=() bak_max_map=()
    local hdirs=() bf h_dir bname prev_cnt
    if [[ -d "$RESOLVED_BAK_DIR" ]]; then
        while IFS= read -r -d '' bf; do
            h_dir="${bf%/*}"
            [[ "$h_dir" == *.hist ]] || continue
            bname="${bf##*/}"
            if [[ -z "${bak_cnt_map[$h_dir]:-}" ]]; then
                bak_cnt_map["$h_dir"]=1; bak_max_map["$h_dir"]="$bname"
                hdirs+=("$h_dir")
            else
                prev_cnt="${bak_cnt_map[$h_dir]}"
                bak_cnt_map["$h_dir"]=$(( prev_cnt + 1 ))
                [[ "$bname" > "${bak_max_map[$h_dir]}" ]] && bak_max_map["$h_dir"]="$bname"
            fi
        done < <(LC_ALL=C find "$RESOLVED_BAK_DIR" -type f -name "*.bak" -print0 2>/dev/null || true)
    fi
    (( ${#hdirs[@]} > 1 )) && sort_null_array hdirs

    local emitted=0 rel_h rel_c o_path latest_b l_date l_time active_f
    for h_dir in "${hdirs[@]}"; do
        (( emitted < 100 )) || break
        rel_h="${h_dir#$RESOLVED_BAK_DIR/}"; rel_h="${rel_h%.hist}"
        strip_nas_rel_into rel_c "$rel_h"
        o_path="/$rel_c"
        latest_b="${bak_max_map[$h_dir]%.bak}"; latest_b="${latest_b%_d}"
        l_date="${latest_b%_*}"; l_time="${latest_b#*_}"
        active_f=0
        if nas_path_exists_or_link "$RESOLVED_DELTA_DIR/$rel_c" || nas_path_exists_or_link "$RESOLVED_DELTA_DIR/${rel_c}.enc" || nas_path_exists_or_link "$RESOLVED_DELTA_DIR/${rel_c}.tar.gz.enc"; then
            active_f=1
        fi
        printf 'HIST\t%s\t%s\t%s %s\t%d\t%s\n' \
            "$ACTIVE_ALIAS" "${bak_cnt_map[$h_dir]}" "$l_date" "${l_time//-/:}" "$active_f" "$o_path"
        emitted=$(( emitted + 1 ))
    done
    exit 0
}

run_sync_auto_mode() {
    export NC_NONINTERACTIVE=1
    ensure_nas_mounted false
    resolve_active_profile true
    acquire_nas_lock
    local ts; now_ts_into ts
    [[ -d "$RESOLVED_DELTA_DIR" ]] || { echo "SYNC_ERR|delta missing" >&2; exit 1; }
    prefetch_active_profile_state
    NAS_STATE_MUTATED=false
    REVERSE_SYNC=false
    evaluate_profile_drift

    local pushed=0 skipped=0 conflicts=0 i total_dirs=${#EVAL_DIR_ACTIONS[@]}
    for (( i=0; i<total_dirs; i++ )); do
        local d_act="${EVAL_DIR_ACTIONS[$i]}" nas_dir="${EVAL_DIR_NAS[$i]}" local_dir="${EVAL_DIR_LOC[$i]}"
        load_origin_metadata "$nas_dir"
        if [[ "$d_act" == "SYNC_DIR_PERM" || "$d_act" == "HEAL_DIR_META" ]]; then
            local cur_m="${LOC_MTIME[$local_dir]:-0}"
            [[ "$ORIG_MTIME" != "$cur_m" ]] && { touch -d "@$cur_m" "$nas_dir" 2>/dev/null || true; invalidate_nas_cache "$nas_dir"; }
            local upd_by="$ACTIVE_ALIAS"
            [[ "$d_act" == "HEAL_DIR_META" ]] && upd_by="${ORIG_LAST_UPDATED_BY:-$ACTIVE_ALIAS}"
            save_origin_metadata "$local_dir" "${nas_dir}.origin.txt" "none" "" "$ACTIVE_ALIAS" "" "$upd_by"
            NAS_STATE_MUTATED=true
            [[ "$d_act" == "SYNC_DIR_PERM" ]] && pushed=$(( pushed + 1 ))
        fi
    done

    local total_items=${#EVAL_ITEM_ACTIONS[@]} act mirror_file source_file owner_alias t_delta_dir t_bak_dir
    for (( i=0; i<total_items; i++ )); do
        act="${EVAL_ITEM_ACTIONS[$i]}"
        mirror_file="${EVAL_ITEM_NAS[$i]}"
        source_file="${EVAL_ITEM_LOC[$i]}"
        owner_alias="${EVAL_ITEM_OWNERS[$i]}"
        t_delta_dir="${EVAL_ITEM_DELTAS[$i]}"
        t_bak_dir="${EVAL_ITEM_BAKS[$i]}"
        [[ "$act" != "PUSH_NEW_IN_DIR" ]] && load_origin_metadata "$mirror_file"

        case "$act" in
            PUSH_NEW_IN_DIR)
                ensure_local_stat "$source_file" || continue
                local new_m="${LOC_MTIME[$source_file]:-0}" new_sha=""
                if [[ "${LOC_TYPE[$source_file]:-}" == "d" ]]; then
                    mkdir -p "$mirror_file"
                    touch -d "@$new_m" "$mirror_file" 2>/dev/null || true
                elif [[ "${LOC_TYPE[$source_file]:-}" == "l" ]]; then
                    write_symlink_mirror "$source_file" "$mirror_file" "$new_m"
                else
                    atomic_copy_to_nas "$source_file" "$mirror_file" "$new_m"
                fi
                calc_target_sha256_into new_sha "$source_file"
                save_origin_metadata "$source_file" "${mirror_file}.origin.txt" "none" "" "$ACTIVE_ALIAS" "$new_sha" "$ACTIVE_ALIAS"
                NAS_STATE_MUTATED=true
                pushed=$(( pushed + 1 ))
                ;;
            SYNC_PERM_ORIGIN|HEAL_ORIGIN_SILENT)
                ensure_local_stat "$source_file" || true
                local local_mtime="${LOC_MTIME[$source_file]:-0}" sha_loc=""
                calc_target_sha256_into sha_loc "$source_file"
                [[ "${ORIG_MTIME:-0}" -ne "$local_mtime" ]] && { touch -h -d "@$local_mtime" "$mirror_file" 2>/dev/null || true; invalidate_nas_cache "$mirror_file"; }
                local upd_by="$ACTIVE_ALIAS"
                [[ "$act" == "HEAL_ORIGIN_SILENT" ]] && upd_by="${ORIG_LAST_UPDATED_BY:-$owner_alias}"
                save_origin_metadata "$source_file" "${mirror_file}.origin.txt" "$ENC_MODE" "$ORIG_MK_FP" "$owner_alias" "$sha_loc" "$upd_by"
                NAS_STATE_MUTATED=true
                [[ "$act" == "SYNC_PERM_ORIGIN" ]] && pushed=$(( pushed + 1 ))
                ;;
            PUSH_ITEM)
                if [[ "${ENC_MODE:-none}" == "custom_password" ]]; then
                    skipped=$(( skipped + 1 ))
                    continue
                fi
                push_local_item_to_nas "$source_file" "$mirror_file" "$ts" "$t_delta_dir" "$t_bak_dir" "$owner_alias"
                NAS_STATE_MUTATED=true
                pushed=$(( pushed + 1 ))
                ;;
            CONFLICT_SYNC)
                conflicts=$(( conflicts + 1 ))
                ;;
            DELETE_FROM_NAS)
                skipped=$(( skipped + 1 ))
                ;;
        esac
    done

    if [[ "$NAS_STATE_MUTATED" == true || "$pushed" -gt 0 ]]; then
        update_status_cache true
    else
        write_status_env_from_counts "$EVAL_PUSH_TOTAL" "$EVAL_PUSH_SHARED" "$EVAL_PULL_TOTAL"
    fi
    _vault_ssh_push_if_needed
    printf 'SYNC_OK|pushed=%d|skipped=%d|conflicts=%d\n' "$pushed" "$skipped" "$conflicts"
    exit 0
}

run_pull_auto_mode() {
    export NC_NONINTERACTIVE=1
    ensure_nas_mounted false
    resolve_active_profile true
    acquire_nas_lock
    prefetch_active_profile_state
    NAS_STATE_MUTATED=false
    REVERSE_SYNC=true
    REVERSE_FORCED=false
    evaluate_profile_drift

    local restored=0 skipped=0 conflicts=0 i total_dirs=${#EVAL_DIR_ACTIONS[@]} owner_spec
    for (( i=0; i<total_dirs; i++ )); do
        local d_act="${EVAL_DIR_ACTIONS[$i]}" nas_dir="${EVAL_DIR_NAS[$i]}" local_dir="${EVAL_DIR_LOC[$i]}"
        load_origin_metadata "$nas_dir"
        case "$d_act" in
            REV_DIR_CREATE|REV_DIR_PERM)
                resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
                [[ "$d_act" == "REV_DIR_CREATE" ]] && { rm -f "$local_dir" 2>/dev/null || true; mkdir -p "$local_dir"; }
                chown "$owner_spec" "$local_dir" 2>/dev/null || true
                [[ -n "$ORIG_MODE" && "$ORIG_MODE" != "lrwxrwxrwx" ]] && chmod "$ORIG_MODE" "$local_dir" 2>/dev/null || true
                [[ -n "$ORIG_MTIME" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -d "@$ORIG_MTIME" "$local_dir" 2>/dev/null || true
                invalidate_local_cache "$local_dir"
                NAS_STATE_MUTATED=true
                restored=$(( restored + 1 ))
                ;;
        esac
    done

    local total_items=${#EVAL_ITEM_ACTIONS[@]} act mirror_file source_file sh_note
    for (( i=0; i<total_items; i++ )); do
        act="${EVAL_ITEM_ACTIONS[$i]}"
        mirror_file="${EVAL_ITEM_NAS[$i]}"
        source_file="${EVAL_ITEM_LOC[$i]}"
        sh_note="${EVAL_ITEM_NOTES[$i]}"
        [[ "$act" != "REV_TOUCH_SILENT" ]] && load_origin_metadata "$mirror_file"
        case "$act" in
            REV_TOUCH_SILENT)
                touch -h -d "@$sh_note" "$source_file" 2>/dev/null || true
                LOC_MTIME["$source_file"]="$sh_note"
                ;;
            REV_FILE_PERM)
                ensure_local_stat "$source_file" || true
                resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
                chown -h "$owner_spec" "$source_file" 2>/dev/null || true
                [[ "${LOC_TYPE[$source_file]:-}" != "l" && "$ORIG_MODE" != "lrwxrwxrwx" ]] && chmod "$ORIG_MODE" "$source_file" 2>/dev/null || true
                [[ -n "${ORIG_MTIME:-}" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -h -d "@$ORIG_MTIME" "$source_file" 2>/dev/null || true
                invalidate_local_cache "$source_file"
                NAS_STATE_MUTATED=true
                restored=$(( restored + 1 ))
                ;;
            PULL_INSTALL|PULL_UPDATE)
                if [[ "${ENC_MODE:-none}" != "none" ]]; then
                    skipped=$(( skipped + 1 ))
                    continue
                fi
                install_nas_item_to_local "$mirror_file" "$source_file"
                restored=$(( restored + 1 ))
                ;;
            CONFLICT_REVERSE)
                conflicts=$(( conflicts + 1 ))
                ;;
        esac
    done

    REVERSE_SYNC=false
    update_status_cache true
    printf 'PULL_OK|restored=%d|skipped=%d|conflicts=%d\n' "$restored" "$skipped" "$conflicts"
    exit 0
}

