load_resilience_vault_identity() {
    [[ -r "$CONF_FILE" ]] || return 0
    local sec="" line k v
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -n "$line" ]] || continue
        if [[ "$line" =~ ^\[([a-zA-Z0-9_.-]+)\]$ ]]; then
            sec="${BASH_REMATCH[1]}"
            continue
        fi
        if [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\"$ ]]; then
            k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
            if [[ "$sec" == "identity" ]]; then
                case "$k" in
                    sys_alias)  CFG_IDENT_ALIAS="$v" ;;
                    sys_folder) CFG_IDENT_FOLDER="$v" ;;
                    hostname)   CFG_IDENT_HOST="$v" ;;
                    hw_uuid)    CFG_IDENT_UUID="${v,,}" ;;
                esac
            elif [[ "$sec" == "vault" ]]; then
                case "$k" in
                    protocol)           CFG_VAULT_PROTOCOL="${v,,}" ;;
                    mountpoint)         CFG_VAULT_MP="$v" ;;
                    backup_root_subdir) CFG_VAULT_BACKUP_SUBDIR="$v" ;;
                esac
            fi
        fi
    done < "$CONF_FILE"
    [[ -n "$CFG_IDENT_UUID" ]] && DEFAULT_HW_UUID="$CFG_IDENT_UUID"
    case "$CFG_VAULT_PROTOCOL" in
        smb|nfs|ssh|local) ;;
        *) CFG_VAULT_PROTOCOL="smb" ;;
    esac
    return 0
}
