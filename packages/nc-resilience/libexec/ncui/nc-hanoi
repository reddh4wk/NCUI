is_chroot_env() {
    [[ -e /proc/1/root && ! / -ef /proc/1/root ]]
}

detect_local_environment() {
    IS_CHROOT=false
    is_chroot_env && IS_CHROOT=true

    DETECTED_UUID=""
    if [[ -r /sys/class/dmi/id/product_uuid ]]; then
        IFS= read -r DETECTED_UUID < /sys/class/dmi/id/product_uuid 2>/dev/null || true
        DETECTED_UUID="${DETECTED_UUID//[[:space:]]/}"
        DETECTED_UUID="${DETECTED_UUID,,}"
    fi
    [[ -z "$DETECTED_UUID" ]] && DETECTED_UUID="unknown"

    DETECTED_IS_WSL="false"
    if [[ -r /proc/sys/kernel/osrelease ]]; then
        local osrel=""
        IFS= read -r osrel < /proc/sys/kernel/osrelease 2>/dev/null || true
        osrel="${osrel,,}"
        if [[ "$osrel" == *microsoft* || "$osrel" == *wsl* ]] && [[ "$IS_CHROOT" == false ]]; then
            DETECTED_IS_WSL="true"
        fi
    fi

    DETECTED_HOSTNAME=""
    if [[ -r /etc/hostname ]]; then
        IFS= read -r DETECTED_HOSTNAME < /etc/hostname 2>/dev/null || true
        DETECTED_HOSTNAME="${DETECTED_HOSTNAME//[[:space:]]/}"
        DETECTED_HOSTNAME="${DETECTED_HOSTNAME,,}"
    fi
    if [[ -z "${DETECTED_HOSTNAME:-}" ]]; then
        DETECTED_HOSTNAME=$(hostname 2>/dev/null || echo "unknown")
        DETECTED_HOSTNAME="${DETECTED_HOSTNAME,,}"
    fi

    PROFILE_LOADED=false
    NC_SYS_ALIAS="" NC_SYS_FOLDER="" NC_SYS_HOSTNAME=""
    NC_SYS_UUID="" NC_SYS_IS_WSL="" NC_NAS_MOUNTPOINT=""

    if [[ -f "$NC_PROFILE_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$NC_PROFILE_FILE" 2>/dev/null || true
    fi
    [[ -n "$NC_SYS_ALIAS" ]] || NC_SYS_ALIAS="$CFG_IDENT_ALIAS"
    [[ -n "$NC_SYS_FOLDER" ]] || NC_SYS_FOLDER="$CFG_IDENT_FOLDER"
    [[ -n "$NC_SYS_HOSTNAME" ]] || NC_SYS_HOSTNAME="$CFG_IDENT_HOST"
    [[ -n "$NC_SYS_UUID" ]] || NC_SYS_UUID="$CFG_IDENT_UUID"
    [[ -n "$NC_NAS_MOUNTPOINT" ]] || NC_NAS_MOUNTPOINT="$CFG_VAULT_MP"
    if [[ -n "$NC_SYS_ALIAS" && -n "$NC_SYS_FOLDER" ]]; then
        PROFILE_LOADED=true
    fi
    return 0
}

write_local_nc_profile() {
    local alias_id="$1" folder_name="$2" host_name="$3" hw_uuid="$4" is_wsl="$5" nas_mp="$6"
    cat << EOF > "$NC_PROFILE_FILE"
# /etc/nc.profile - Carta d'identità del sistema per gli script nc-*
NC_SYS_ALIAS="$alias_id"
NC_SYS_FOLDER="$folder_name"
NC_SYS_HOSTNAME="$host_name"
NC_SYS_UUID="$hw_uuid"
NC_SYS_IS_WSL="$is_wsl"
NC_NAS_MOUNTPOINT="$nas_mp"
EOF
    chmod 0644 "$NC_PROFILE_FILE"
    chown root:root "$NC_PROFILE_FILE" 2>/dev/null || true
    return 0
}

vault_root_is_ready() {
    local mp="$1"
    local sub="${CFG_VAULT_BACKUP_SUBDIR#/}"
    sub="${sub%/}"
    case "$CFG_VAULT_PROTOCOL" in
        local)
            [[ -d "$mp" && -w "$mp" ]]
            ;;
        ssh)
            mountpoint -q "$mp" 2>/dev/null || [[ -f "$mp/.ncui_ssh_mounted" ]]
            ;;
        smb|nfs|*)
            if [[ "${NC_TEST_LOCAL_NAS:-0}" == "1" && -d "$mp" ]]; then
                return 0
            fi
            if [[ -n "$sub" ]]; then
                local top="${sub%%/*}"
                mountpoint -q "$mp/$top" 2>/dev/null && return 0
            fi
            mountpoint -q "$mp/personal_folder" 2>/dev/null || mountpoint -q "$mp" 2>/dev/null
            ;;
    esac
}

ensure_nas_mounted() {
    local silent_mode="${1:-false}"

    if [[ -n "${NAS_TARGET:-}" ]]; then
        NAS_ROOT="$NAS_TARGET"
    elif [[ -n "${CFG_VAULT_MP:-}" ]]; then
        NAS_ROOT="$CFG_VAULT_MP"
    elif [[ -n "${NC_NAS_MOUNTPOINT:-}" && -d "${NC_NAS_MOUNTPOINT:-}" ]]; then
        NAS_ROOT="$NC_NAS_MOUNTPOINT"
    elif [[ "$DETECTED_IS_WSL" == "true" && ! -d "/nas" ]]; then
        NAS_ROOT="/run/nas"
    else
        NAS_ROOT="/nas"
    fi

    if vault_root_is_ready "$NAS_ROOT"; then
        return 0
    fi
    if [[ "$NAS_ROOT" != "/run/nas" ]] && vault_root_is_ready "/run/nas"; then
        NAS_ROOT="/run/nas"; return 0
    fi
    if [[ "$NAS_ROOT" != "/nas" ]] && vault_root_is_ready "/nas"; then
        NAS_ROOT="/nas"; return 0
    fi

    [[ "$silent_mode" == true ]] && return 1

    echo -e "${C_YELLOW}[*]${C_RESET} ${NAS_ROOT} non pronto (${CFG_VAULT_PROTOCOL}). Avvio nc-vault mount..."
    if [[ -x "$NC_NAS_MOUNT" ]]; then
        "$NC_NAS_MOUNT" mount
    elif command -v nc-nas-mount &>/dev/null; then
        nc-nas-mount
    else
        echo -e "${C_RED}[-]${C_RESET} Errore: eseguibile di mount assente ($NC_NAS_MOUNT)." >&2
        exit 1
    fi

    if vault_root_is_ready "$NAS_ROOT"; then
        return 0
    elif vault_root_is_ready "/run/nas"; then
        NAS_ROOT="/run/nas"; return 0
    elif vault_root_is_ready "/nas"; then
        NAS_ROOT="/nas"; return 0
    fi

    echo -e "${C_RED}[-]${C_RESET} Errore critico: vault (${NAS_ROOT}) non disponibile dopo il mount." >&2
    exit 1
}

declare -A SYS_FOLDER_MAP=()
declare -A SYS_DELTA_MAP=()
ALL_DISCOVERED_ALIASES=()

discover_nas_systems() {
    local sub="${CFG_VAULT_BACKUP_SUBDIR#/}"
    sub="${sub%/}"
    if [[ -z "$sub" ]]; then
        if [[ -d "$NAS_ROOT/personal_folder" ]]; then
            sub="personal_folder/Software/Linux"
        else
            sub="ncui-vault"
        fi
    fi
    LINUX_ROOT=$(realpath -s -m "$NAS_ROOT/$sub")
    SHARED_DIR="$LINUX_ROOT/shared"
    MASTER_KEY_FILE="$SHARED_DIR/master_key"

    [[ -d "$SHARED_DIR" ]] || mkdir -p "$SHARED_DIR"

    local legacy_mk="$LINUX_ROOT/nightcity-archlinux/master_key"
    if [[ ! -f "$MASTER_KEY_FILE" && -f "$legacy_mk" ]]; then
        cp -p "$legacy_mk" "$MASTER_KEY_FILE"
        chmod 600 "$MASTER_KEY_FILE" 2>/dev/null || true
    fi

    SYS_FOLDER_MAP=()
    SYS_DELTA_MAP=()
    ALL_DISCOVERED_ALIASES=()

    local nullglob_was_set=false
    shopt -q nullglob && nullglob_was_set=true
    shopt -s nullglob
    local delta_candidates=("$LINUX_ROOT"/*/*delta*)
    [[ "$nullglob_was_set" == false ]] && shopt -u nullglob

    (( ${#delta_candidates[@]} > 1 )) && sort_null_array delta_candidates

    local delta_path d_name sys_dir f_name alias_id
    for delta_path in "${delta_candidates[@]}"; do
        [[ -d "$delta_path" && ! -L "$delta_path" ]] || continue
        d_name="${delta_path##*/}"
        sys_dir="${delta_path%/*}"
        f_name="${sys_dir##*/}"

        if [[ "$d_name" == *-delta ]]; then
            alias_id="${d_name%-delta}"
        else
            alias_id="${f_name%%-*}"
        fi
        alias_id="${alias_id,,}"
        [[ -z "$alias_id" ]] && continue

        SYS_FOLDER_MAP["$alias_id"]="$f_name"
        SYS_DELTA_MAP["$alias_id"]="$delta_path"
        ALL_DISCOVERED_ALIASES+=("$alias_id")
    done
    return 0
}

check_time_drift_against() {
    local nas_time="$1"
    [[ "$NAS_TIME_VERIFIED" == true ]] && return 0
    [[ "$nas_time" =~ ^[0-9]+$ ]] || return 0
    (( nas_time == 0 )) && return 0

    local local_time
    now_epoch_into local_time
    NAS_TIME_VERIFIED=true

    local diff=$(( nas_time - local_time ))
    (( diff < 0 )) && diff=$(( -diff ))

    if (( diff > 5 )); then
        if [[ "${NC_NONINTERACTIVE:-0}" == "1" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Vault/system clock drift detected (${diff}s > 5s)." >&2
            exit 4
        fi
        local delta_human loc_str nas_str
        format_time_delta_into delta_human "$diff"
        printf -v loc_str '%(%Y-%m-%d %H:%M:%S)T' "$local_time"
        printf -v nas_str '%(%Y-%m-%d %H:%M:%S)T' "$nas_time"
        echo -e "\n${C_RED}[!] ALLERTA CRITICA DI SINCRONIZZAZIONE ORARIO (TIME DRIFT)!${C_RESET}"
        echo -e "    L'orologio del NAS e quello del sistema locale sono disallineati di ${C_BOLD}${delta_human}${C_RESET}."
        echo -e "    ${C_MUTED}Ora locale : ${loc_str}${C_RESET}"
        echo -e "    ${C_MUTED}Ora del NAS: ${nas_str}${C_RESET}"
        echo -e "    ${C_YELLOW}Procedere con orari disallineati causerà falsi allarmi e sovrascritture errate.${C_RESET}"

        read_single_key "${C_CYAN}[?]${C_RESET} Premi INVIO per interrompere (consigliato) o 'c' per continuare comunque: "
        if [[ "${REPLY_KEY,,}" != "c" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Operazione interrotta per sicurezza."
            exit 1
        fi
        confirm_double_or_exit "Sei sicuro di voler ignorare il disallineamento di ${delta_human}?" "Forzare l'esecuzione con orologi di sistema disallineati?"
    fi
    return 0
}

read_lock_info() {
    LOCK_INFO_PID=""
    LOCK_INFO_HOST="sconosciuto"
    LOCK_INFO_TS="0"
    if [[ -r "$LOCK_DIR/info" ]]; then
        local k v
        while IFS='=' read -r k v; do
            case "$k" in
                PID)  LOCK_INFO_PID="$v" ;;
                HOST) LOCK_INFO_HOST="$v" ;;
                TS)   LOCK_INFO_TS="$v" ;;
            esac
        done < "$LOCK_DIR/info" 2>/dev/null || true
    else
        [[ -r "$LOCK_DIR/pid" ]] && IFS= read -r LOCK_INFO_PID < "$LOCK_DIR/pid" 2>/dev/null || true
        [[ -r "$LOCK_DIR/host" ]] && IFS= read -r LOCK_INFO_HOST < "$LOCK_DIR/host" 2>/dev/null || true
        [[ -r "$LOCK_DIR/timestamp" ]] && IFS= read -r LOCK_INFO_TS < "$LOCK_DIR/timestamp" 2>/dev/null || true
    fi
    [[ "$LOCK_INFO_TS" =~ ^[0-9]+$ ]] || LOCK_INFO_TS=0
    return 0
}

acquire_nas_lock() {
    [[ "$LOCK_ACQUIRED" == true ]] && return 0
    [[ -d "$SHARED_DIR" ]] || mkdir -p "$SHARED_DIR"
    LOCK_DIR="$SHARED_DIR/sync.lock"
    local my_host="${ACTIVE_ALIAS:-$DETECTED_HOSTNAME}"
    local retries=15
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        read_lock_info
        local now_ts
        now_epoch_into now_ts
        if (( LOCK_INFO_TS > 0 && now_ts - LOCK_INFO_TS > 600 )); then
            # Non rimuovere il lock se appartiene a un processo vivo sullo stesso host
            if [[ ( "$LOCK_INFO_HOST" == "$my_host" || "$LOCK_INFO_HOST" == "$DETECTED_HOSTNAME" ) && "$LOCK_INFO_PID" =~ ^[0-9]+$ ]] && kill -0 "$LOCK_INFO_PID" 2>/dev/null; then
                echo -e "${C_RED}[-]${C_RESET} Archivi NAS bloccati da un processo locale ancora attivo (PID: $LOCK_INFO_PID, host: $LOCK_INFO_HOST)." >&2
                exit 1
            fi
            echo -e "${C_YELLOW}[!]${C_RESET} Rilevato lock orfano (>10 min). Rimozione forzata..."
            rm -rf "$LOCK_DIR" 2>/dev/null || true
            continue
        fi
        retries=$(( retries - 1 ))
        if (( retries <= 0 )); then
            echo -e "${C_RED}[-]${C_RESET} Errore: Archivi NAS bloccati da un'altra operazione in corso (host: ${LOCK_INFO_HOST}, PID: ${LOCK_INFO_PID:-?})." >&2
            exit 1
        fi
        sleep 1
    done

    local lock_now
    now_epoch_into lock_now
    printf 'PID=%s\nHOST=%s\nTS=%s\n' "$$" "$my_host" "$lock_now" > "$LOCK_DIR/info"
    LOCK_ACQUIRED=true

    local nas_clock
    nas_clock=$(stat -c "%Y" "$LOCK_DIR" 2>/dev/null || echo 0)
    check_time_drift_against "$nas_clock"
    return 0
}

run_onboarding_wizard() {
    echo -e "\n${C_YELLOW}[!]${C_RESET} Sistema corrente non associato a nessuna cartella delta in $LINUX_ROOT."
    echo -e "    Hostname rilevato : $DETECTED_HOSTNAME"
    echo -e "    Hardware UUID     : ${C_MUTED}$DETECTED_UUID${C_RESET}"
    echo -e "    Ambiente WSL      : ${C_MUTED}$DETECTED_IS_WSL${C_RESET}"

    confirm_enter "Vuoi configurare un nuovo profilo e la relativa cartella sul NAS?"

    local default_folder="${DETECTED_HOSTNAME}-archlinux"
    local default_alias="${DETECTED_HOSTNAME:0:3}"
    local new_folder="" new_alias=""

    read -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Nome della cartella sul NAS in Linux/ [$default_folder]: ")" new_folder </dev/tty
    new_folder="${new_folder:-$default_folder}"
    new_folder="${new_folder// /_}"

    while true; do
        read -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Alias breve per il sistema (es. nc, dc, wsl) [$default_alias]: ")" new_alias </dev/tty
        new_alias="${new_alias:-$default_alias}"
        new_alias="${new_alias,,}"
        new_alias="${new_alias//[^a-z0-9_-]/}"
        if [[ "$new_alias" == "all" || "$new_alias" == "local" || "$new_alias" == "none" ]]; then
            echo -e "${C_RED}[-]${C_RESET} L'alias '$new_alias' è una parola riservata."
            continue
        fi
        if [[ -n "${SYS_FOLDER_MAP[$new_alias]:-}" ]]; then
            echo -e "${C_RED}[-]${C_RESET} L'alias '$new_alias' è già associato a '${SYS_FOLDER_MAP[$new_alias]}'."
            continue
        fi
        break
    done

    confirm_double_or_exit "Confermi la creazione del profilo '$new_alias' ($new_folder)?" "Scrivere la nuova struttura su NAS e in $NC_PROFILE_FILE?"

    local new_sys_dir="$LINUX_ROOT/$new_folder"
    mkdir -p "$new_sys_dir/${new_alias}-delta" "$new_sys_dir/$BACKUP_DIR_NAME"
    write_local_nc_profile "$new_alias" "$new_folder" "$DETECTED_HOSTNAME" "$DETECTED_UUID" "$DETECTED_IS_WSL" "$NAS_ROOT"
    discover_nas_systems

    echo -e "${C_GREEN}[+]${C_RESET} Creato profilo '$new_alias' ($new_folder) e salvato in $NC_PROFILE_FILE."
    ACTIVE_ALIAS="$new_alias"
    ACTIVE_FOLDER="$new_folder"
    return 0
}

resolve_active_profile() {
    local silent_mode="${1:-false}"
    discover_nas_systems

    ACTIVE_ALIAS=""
    ACTIVE_FOLDER=""

    if [[ -n "${CLI_PROFILE_OVERRIDE:-}" ]]; then
        if [[ -n "${SYS_FOLDER_MAP[$CLI_PROFILE_OVERRIDE]:-}" ]]; then
            ACTIVE_ALIAS="$CLI_PROFILE_OVERRIDE"
            ACTIVE_FOLDER="${SYS_FOLDER_MAP[$CLI_PROFILE_OVERRIDE]}"
        else
            echo -e "${C_RED}[-]${C_RESET} Errore: Profilo '$CLI_PROFILE_OVERRIDE' non trovato sul NAS." >&2
            exit 1
        fi
    fi

    if [[ -z "$ACTIVE_ALIAS" && "$PROFILE_LOADED" == true ]]; then
        ACTIVE_ALIAS="$NC_SYS_ALIAS"
        ACTIVE_FOLDER="${SYS_FOLDER_MAP[$NC_SYS_ALIAS]:-$NC_SYS_FOLDER}"
        if [[ -z "${SYS_DELTA_MAP[$ACTIVE_ALIAS]:-}" ]]; then
            mkdir -p "$LINUX_ROOT/$ACTIVE_FOLDER/${ACTIVE_ALIAS}-delta" "$LINUX_ROOT/$ACTIVE_FOLDER/$BACKUP_DIR_NAME"
            discover_nas_systems
        fi
    fi

    if [[ -z "$ACTIVE_ALIAS" ]]; then
        if [[ "$DETECTED_IS_WSL" == "true" || "$DETECTED_HOSTNAME" == "tokyo"* ]]; then
            if [[ -n "${SYS_FOLDER_MAP[wsl]:-}" ]]; then
                ACTIVE_ALIAS="wsl"; ACTIVE_FOLDER="${SYS_FOLDER_MAP[wsl]}"
            fi
        elif [[ "$DETECTED_UUID" == "$DEFAULT_HW_UUID" || "$IS_CHROOT" == true ]]; then
            if [[ "$DETECTED_HOSTNAME" == "nightcity"* && -n "${SYS_FOLDER_MAP[nc]:-}" ]]; then
                ACTIVE_ALIAS="nc"; ACTIVE_FOLDER="${SYS_FOLDER_MAP[nc]}"
            elif [[ "$DETECTED_HOSTNAME" == "duskcity"* && -n "${SYS_FOLDER_MAP[dc]:-}" ]]; then
                ACTIVE_ALIAS="dc"; ACTIVE_FOLDER="${SYS_FOLDER_MAP[dc]}"
            fi
        fi

        if [[ -z "$ACTIVE_ALIAS" ]]; then
            local a f
            for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
                f="${SYS_FOLDER_MAP[$a]}"
                if [[ "$f" == "${DETECTED_HOSTNAME}"* ]]; then
                    ACTIVE_ALIAS="$a"; ACTIVE_FOLDER="$f"; break
                fi
            done
        fi

        if [[ -n "$ACTIVE_ALIAS" && ! -f "$NC_PROFILE_FILE" ]]; then
            write_local_nc_profile "$ACTIVE_ALIAS" "$ACTIVE_FOLDER" "$DETECTED_HOSTNAME" "$DETECTED_UUID" "$DETECTED_IS_WSL" "$NAS_ROOT"
        fi
    fi

    if [[ -z "$ACTIVE_ALIAS" ]]; then
        [[ "$silent_mode" == true ]] && exit 0
        run_onboarding_wizard
    fi

    if [[ "$IS_CHROOT" == true && "$silent_mode" == false ]]; then
        echo -e "${C_CYAN}[*]${C_RESET} Ambiente chroot rilevato: opero sul profilo '${C_BOLD}$ACTIVE_ALIAS${C_RESET}' ($ACTIVE_FOLDER)"
    fi

    BASE_DIR="$LINUX_ROOT/$ACTIVE_FOLDER"
    DELTA_DIR="${SYS_DELTA_MAP[$ACTIVE_ALIAS]:-$BASE_DIR/${ACTIVE_ALIAS}-delta}"
    BAK_DIR="$BASE_DIR/$BACKUP_DIR_NAME"

    [[ -d "$DELTA_DIR" ]] || mkdir -p "$DELTA_DIR"
    [[ -d "$BAK_DIR" ]] || mkdir -p "$BAK_DIR"
    [[ -d "$LOCAL_STATE_DIR" ]] || mkdir -p -m 0755 "$LOCAL_STATE_DIR"

    RESOLVED_LINUX_ROOT="$LINUX_ROOT"
    RESOLVED_BASE_DIR=$(realpath -s -m "$BASE_DIR")
    RESOLVED_DELTA_DIR=$(realpath -s -m "$DELTA_DIR")
    RESOLVED_BAK_DIR=$(realpath -s -m "$BAK_DIR")
    return 0
}

# ==============================================================================
# LIVELLO 3: CACHE PERSISTENTI NVMe, STAT/HASH BATCH, ATOMIC I/O, DIFF & DIR
# ==============================================================================
load_persistent_caches() {
    [[ "$PERSIST_CACHES_LOADED" == true ]] && return 0
    PERSIST_CACHES_LOADED=true

    local magic p s v
    if [[ -r "$LOCAL_SHA_CACHE_FILE" ]]; then
        {
            if IFS= read -r -d '' magic && [[ "$magic" == "LSHA1" ]]; then
                while IFS= read -r -d '' p && IFS= read -r -d '' s && IFS= read -r -d '' v; do
                    [[ -z "$p" || -z "$s" || -z "$v" ]] && continue
                    PERSIST_LOC_STAMP["$p"]="$s"
                    PERSIST_LOC_SHA["$p"]="$v"
                    SHA256_CACHE["$p"]="$v"
                    SHA256_STAMP["$p"]="$s"
                done
            fi
        } < "$LOCAL_SHA_CACHE_FILE" 2>/dev/null || true
    fi

    if [[ -r "$NAS_SIDECAR_CACHE_FILE" ]]; then
        {
            if IFS= read -r -d '' magic && [[ "$magic" == "NSCA1" ]]; then
                while IFS= read -r -d '' p && IFS= read -r -d '' s && IFS= read -r -d '' v; do
                    [[ -z "$p" || -z "$s" ]] && continue
                    PERSIST_SC_STAMP["$p"]="$s"
                    PERSIST_SC_RAW["$p"]="$v"
                done
            fi
        } < "$NAS_SIDECAR_CACHE_FILE" 2>/dev/null || true
    fi
    return 0
}

flush_persistent_caches() {
    [[ -d "$LOCAL_STATE_DIR" ]] || mkdir -p -m 0755 "$LOCAL_STATE_DIR" 2>/dev/null || return 0
    [[ -w "$LOCAL_STATE_DIR" ]] || return 0

    local k tmp_f
    if [[ "$LOCAL_SHA_CACHE_DIRTY" == true ]]; then
        tmp_f="$LOCAL_STATE_DIR/.local_sha.cache.tmp.$$"
        (
            umask 0077
            printf 'LSHA1\0' > "$tmp_f"
            for k in "${!PERSIST_LOC_SHA[@]}"; do
                [[ -n "${PERSIST_LOC_STAMP[$k]:-}" && -n "${PERSIST_LOC_SHA[$k]:-}" ]] || continue
                printf '%s\0%s\0%s\0' "$k" "${PERSIST_LOC_STAMP[$k]}" "${PERSIST_LOC_SHA[$k]}" >> "$tmp_f"
            done
        ) 2>/dev/null && chmod 0600 "$tmp_f" 2>/dev/null && mv -f "$tmp_f" "$LOCAL_SHA_CACHE_FILE" 2>/dev/null || rm -f "$tmp_f" 2>/dev/null || true
        LOCAL_SHA_CACHE_DIRTY=false
    fi

    if [[ "$NAS_SIDECAR_CACHE_DIRTY" == true ]]; then
        tmp_f="$LOCAL_STATE_DIR/.nas_sidecar.cache.tmp.$$"
        (
            umask 0077
            printf 'NSCA1\0' > "$tmp_f"
            for k in "${!PERSIST_SC_STAMP[@]}"; do
                [[ -n "${PERSIST_SC_STAMP[$k]:-}" ]] || continue
                printf '%s\0%s\0%s\0' "$k" "${PERSIST_SC_STAMP[$k]}" "${PERSIST_SC_RAW[$k]:-}" >> "$tmp_f"
            done
        ) 2>/dev/null && chmod 0600 "$tmp_f" 2>/dev/null && mv -f "$tmp_f" "$NAS_SIDECAR_CACHE_FILE" 2>/dev/null || rm -f "$tmp_f" 2>/dev/null || true
        NAS_SIDECAR_CACHE_DIRTY=false
    fi
    return 0
}

invalidate_local_cache() {
    local p="$1"
    [[ -z "$p" ]] && return 0
    unset 'LOC_EXISTS[$p]' 'LOC_TYPE[$p]' 'LOC_MODE[$p]' 'LOC_UID[$p]' 'LOC_OWNER[$p]' \
          'LOC_GID[$p]' 'LOC_GROUP[$p]' 'LOC_SIZE[$p]' 'LOC_MTIME[$p]' 'LOC_MTIME_HUMAN[$p]' \
          'LOC_STAT_STAMP[$p]' 'LOC_LINK[$p]' 'SHA256_CACHE[$p]' 'SHA256_STAMP[$p]'
    if [[ -n "${PERSIST_LOC_SHA[$p]:-}" ]]; then
        unset 'PERSIST_LOC_STAMP[$p]' 'PERSIST_LOC_SHA[$p]'
        LOCAL_SHA_CACHE_DIRTY=true
    fi
    return 0
}

invalidate_nas_cache() {
    local p="$1"
    [[ -z "$p" ]] && return 0
    local p_meta="${p}.origin.txt"
    unset 'NAS_TYPE[$p]' 'NAS_SIZE[$p]' 'NAS_MTIME[$p]' 'NAS_MTIME_HUMAN[$p]' 'NAS_FIND_STAMP[$p]' 'NAS_LINK[$p]' \
          'SHA256_CACHE[$p]' 'SHA256_STAMP[$p]' 'ORIGIN_RAW_CACHE[$p]' 'ORIGIN_RAW_CACHE[$p_meta]' \
          'SHARED_RAW_CACHE[$p]' 'BAK_IS_PH_CACHE[$p]' 'BAK_REF_CACHE[$p]' 'BAK_SHA_CACHE[$p]' \
          'ORIG_MEMO_READY[$p]' 'ORIG_MEMO_READY[$p_meta]' 'PH_MEMO_READY[$p]'
    if [[ -n "${PERSIST_SC_STAMP[$p]:-}" ]]; then
        unset 'PERSIST_SC_STAMP[$p]' 'PERSIST_SC_RAW[$p]'
        NAS_SIDECAR_CACHE_DIRTY=true
    fi
    if [[ -n "${PERSIST_SC_STAMP[$p_meta]:-}" ]]; then
        unset 'PERSIST_SC_STAMP[$p_meta]' 'PERSIST_SC_RAW[$p_meta]'
        NAS_SIDECAR_CACHE_DIRTY=true
    fi
    NAS_DIRTY_PATHS["$p"]=1
    NAS_DIRTY_PATHS["$p_meta"]=1
    return 0
}

is_path_in_indexed_deltas() {
    [[ "$NAS_DELTAS_INDEXED" == true ]] || return 1
    local p="$1" a d
    for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        d="${SYS_DELTA_MAP[$a]:-}"
        [[ -n "$d" && "$p" == "$d/"* ]] && return 0
    done
    return 1
}

ensure_nas_stat() {
    local p="$1"
    [[ -z "$p" ]] && return 1
    if [[ -z "${NAS_DIRTY_PATHS[$p]:-}" ]]; then
        if [[ -n "${NAS_TYPE[$p]:-}" ]]; then
            [[ "${NAS_TYPE[$p]}" != "missing" ]]
            return $?
        fi
        if is_path_in_indexed_deltas "$p"; then
            NAS_TYPE["$p"]="missing"
            return 1
        fi
    fi

    unset 'NAS_DIRTY_PATHS[$p]'
    local ftype="" fsize="" fmtime="" fhum="" fts_raw="" fts_norm="" flink=""
    if {
        IFS= read -r -d '' ftype &&
        IFS= read -r -d '' fsize &&
        IFS= read -r -d '' fmtime &&
        IFS= read -r -d '' fhum &&
        IFS= read -r -d '' fts_raw
    } < <(LC_ALL=C stat --printf='%F\0%s\0%Y\0%y\0%.Y\0' -- "$p" 2>/dev/null); then
        case "$ftype" in
            "regular file"|"regular empty file") NAS_TYPE["$p"]="f" ;;
            "directory") NAS_TYPE["$p"]="d" ;;
            "symbolic link")
                NAS_TYPE["$p"]="l"
                flink=$(readlink -- "$p" 2>/dev/null || true)
                NAS_LINK["$p"]="$flink"
                ;;
            *) NAS_TYPE["$p"]="o" ;;
        esac
        NAS_SIZE["$p"]="$fsize"
        NAS_MTIME["$p"]="$fmtime"
        NAS_MTIME_HUMAN["$p"]="${fhum%%.*}"
        norm_ts_into fts_norm "$fts_raw"
        NAS_FIND_STAMP["$p"]="${fts_norm}:${fsize}"
        return 0
    else
        NAS_TYPE["$p"]="missing"
        return 1
    fi
}

nas_path_exists_or_link() { ensure_nas_stat "$1"; }
nas_is_regular_file()     { ensure_nas_stat "$1" && [[ "${NAS_TYPE[$1]}" == "f" ]]; }
nas_is_dir()              { ensure_nas_stat "$1" && [[ "${NAS_TYPE[$1]}" == "d" ]]; }
nas_is_symlink()          { ensure_nas_stat "$1" && [[ "${NAS_TYPE[$1]}" == "l" ]]; }

batch_sha256_files() {
    (( $# == 0 )) && return 0
    load_persistent_caches
    local batch=() p stamp
    for p in "$@"; do
        [[ -z "$p" ]] && continue
        if [[ "${LOC_EXISTS[$p]:-0}" == "1" ]]; then
            stamp="${LOC_STAT_STAMP[$p]:-${LOC_MTIME[$p]:-0}:${LOC_SIZE[$p]:-0}}"
        elif [[ "${NAS_TYPE[$p]:-}" == "f" ]]; then
            stamp="${NAS_FIND_STAMP[$p]:-${NAS_MTIME[$p]:-0}:${NAS_SIZE[$p]:-0}}"
        else
            stamp=""
        fi
        if [[ -n "${SHA256_CACHE[$p]:-}" && -n "$stamp" && "${SHA256_STAMP[$p]:-}" == "$stamp" ]]; then
            continue
        fi
        batch+=("$p")
    done
    (( ${#batch[@]} == 0 )) && return 0

    local total=${#batch[@]} offset=0 chunk_size=400 line fpath fhash
    while (( offset < total )); do
        local chunk=("${batch[@]:offset:chunk_size}")
        offset=$(( offset + chunk_size ))
        while IFS= read -r -d '' line; do
            fhash="${line:0:64}"
            fpath="${line:66}"
            [[ -z "$fpath" ]] && continue
            SHA256_CACHE["$fpath"]="$fhash"
            if [[ "${LOC_EXISTS[$fpath]:-0}" == "1" ]]; then
                stamp="${LOC_STAT_STAMP[$fpath]:-${LOC_MTIME[$fpath]:-0}:${LOC_SIZE[$fpath]:-0}}"
                SHA256_STAMP["$fpath"]="$stamp"
                PERSIST_LOC_STAMP["$fpath"]="$stamp"
                PERSIST_LOC_SHA["$fpath"]="$fhash"
                LOCAL_SHA_CACHE_DIRTY=true
            elif [[ "${NAS_TYPE[$fpath]:-}" == "f" ]]; then
                SHA256_STAMP["$fpath"]="${NAS_FIND_STAMP[$fpath]:-${NAS_MTIME[$fpath]:-0}:${NAS_SIZE[$fpath]:-0}}"
            fi
        done < <(LC_ALL=C sha256sum -z -- "${chunk[@]}" 2>/dev/null || true)
    done
    return 0
}

prefetch_local_paths_metadata() {
    local compute_hashes="$1"
    shift
    (( $# == 0 )) && return 0

    load_persistent_caches

    local to_stat=()
    local -A seen_q=()
    local p
    for p in "$@"; do
        [[ -z "$p" || -n "${seen_q[$p]:-}" ]] && continue
        seen_q["$p"]=1
        if [[ -z "${LOC_EXISTS[$p]:-}" ]]; then
            LOC_EXISTS["$p"]="0"
            to_stat+=("$p")
        fi
    done

    local symlinks_to_read=()
    local reg_files_to_hash=()

    if (( ${#to_stat[@]} > 0 )); then
        local total=${#to_stat[@]} offset=0 chunk_size=400
        local fn ftype fmode fuid fowner fgid fgroup fsize fmtime fhum fstamp norm_m
        while (( offset < total )); do
            local chunk=("${to_stat[@]:offset:chunk_size}")
            offset=$(( offset + chunk_size ))
            while IFS= read -r -d '' fn &&
                  IFS= read -r -d '' ftype &&
                  IFS= read -r -d '' fmode &&
                  IFS= read -r -d '' fuid &&
                  IFS= read -r -d '' fowner &&
                  IFS= read -r -d '' fgid &&
                  IFS= read -r -d '' fgroup &&
                  IFS= read -r -d '' fsize &&
                  IFS= read -r -d '' fmtime &&
                  IFS= read -r -d '' fhum &&
                  IFS= read -r -d '' fstamp; do
                LOC_EXISTS["$fn"]="1"
                LOC_UID["$fn"]="$fuid"
                LOC_OWNER["$fn"]="$fowner"
                LOC_GID["$fn"]="$fgid"
                LOC_GROUP["$fn"]="$fgroup"
                LOC_SIZE["$fn"]="$fsize"
                LOC_MTIME["$fn"]="$fmtime"
                LOC_MTIME_HUMAN["$fn"]="${fhum%%.*}"
                LOC_STAT_STAMP["$fn"]="$fstamp"

                case "$ftype" in
                    "regular file"|"regular empty file")
                        LOC_TYPE["$fn"]="f"
                        normalize_octal_mode_into norm_m "$fmode"
                        LOC_MODE["$fn"]="$norm_m"
                        ;;
                    "directory")
                        LOC_TYPE["$fn"]="d"
                        normalize_octal_mode_into norm_m "$fmode"
                        LOC_MODE["$fn"]="$norm_m"
                        ;;
                    "symbolic link")
                        LOC_TYPE["$fn"]="l"
                        LOC_MODE["$fn"]="lrwxrwxrwx"
                        symlinks_to_read+=("$fn")
                        ;;
                    *)
                        LOC_TYPE["$fn"]="o"
                        normalize_octal_mode_into norm_m "$fmode"
                        LOC_MODE["$fn"]="$norm_m"
                        ;;
                esac
            done < <(LC_ALL=C stat --printf='%n\0%F\0%a\0%u\0%U\0%g\0%G\0%s\0%Y\0%y\0%d:%i:%z:%y:%s\0' -- "${chunk[@]}" 2>/dev/null || true)
        done

        for p in "${to_stat[@]}"; do
            if [[ "${LOC_EXISTS[$p]:-0}" == "0" && -n "${PERSIST_LOC_SHA[$p]:-}" ]]; then
                unset 'PERSIST_LOC_STAMP[$p]' 'PERSIST_LOC_SHA[$p]' 'SHA256_CACHE[$p]' 'SHA256_STAMP[$p]'
                LOCAL_SHA_CACHE_DIRTY=true
            fi
        done
    fi

    if (( ${#symlinks_to_read[@]} > 0 )); then
        local sl_total=${#symlinks_to_read[@]} sl_off=0 sl_chunk_sz=400 sl_chunk lnk_vals c_idx sp
        while (( sl_off < sl_total )); do
            sl_chunk=("${symlinks_to_read[@]:sl_off:sl_chunk_sz}")
            sl_off=$(( sl_off + sl_chunk_sz ))
            mapfile -d '' -t lnk_vals < <(readlink -z -- "${sl_chunk[@]}" 2>/dev/null || true)
            if (( ${#lnk_vals[@]} == ${#sl_chunk[@]} )); then
                for (( c_idx=0; c_idx<${#sl_chunk[@]}; c_idx++ )); do
                    LOC_LINK["${sl_chunk[$c_idx]}"]="${lnk_vals[$c_idx]}"
                done
            else
                for sp in "${sl_chunk[@]}"; do
                    LOC_LINK["$sp"]=$(readlink -- "$sp" 2>/dev/null || true)
                done
            fi
        done
    fi

    if [[ "$compute_hashes" == true ]]; then
        for p in "${!seen_q[@]}"; do
            if [[ "${LOC_EXISTS[$p]:-0}" == "1" && "${LOC_TYPE[$p]:-}" == "f" ]]; then
                reg_files_to_hash+=("$p")
            fi
        done
        if (( ${#reg_files_to_hash[@]} > 0 )); then
            batch_sha256_files "${reg_files_to_hash[@]}"
        fi
    fi
    return 0
}

ensure_local_stat() {
    local p="$1"
    [[ -z "$p" ]] && return 1
    [[ -z "${LOC_EXISTS[$p]:-}" ]] && prefetch_local_paths_metadata false "$p"
    [[ "${LOC_EXISTS[$p]:-0}" == "1" ]]
}

read_sidecar_raw_cached() {
    local __out_var="$1" __sc_path="$2" __kind="$3" __raw=""
    if [[ "$__kind" == "origin" && -n "${ORIGIN_RAW_CACHE[$__sc_path]+x}" ]]; then
        printf -v "$__out_var" '%s' "${ORIGIN_RAW_CACHE[$__sc_path]}"
        return 0
    elif [[ "$__kind" == "shared" && -n "${SHARED_RAW_CACHE[$__sc_path]+x}" ]]; then
        printf -v "$__out_var" '%s' "${SHARED_RAW_CACHE[$__sc_path]}"
        return 0
    fi

    local __stamp="${NAS_FIND_STAMP[$__sc_path]:-}"
    if [[ -n "$__stamp" && "${PERSIST_SC_STAMP[$__sc_path]:-}" == "$__stamp" ]]; then
        __raw="${PERSIST_SC_RAW[$__sc_path]:-}"
    else
        read_file_raw_into __raw "$__sc_path"
        if [[ -z "$__stamp" ]]; then
            ensure_nas_stat "$__sc_path" >/dev/null 2>&1 || true
            __stamp="${NAS_FIND_STAMP[$__sc_path]:-}"
        fi
        if [[ -n "$__stamp" ]]; then
            PERSIST_SC_STAMP["$__sc_path"]="$__stamp"
            PERSIST_SC_RAW["$__sc_path"]="$__raw"
            NAS_SIDECAR_CACHE_DIRTY=true
        fi
    fi

    if [[ "$__kind" == "origin" ]]; then
        ORIGIN_RAW_CACHE["$__sc_path"]="$__raw"
    else
        SHARED_RAW_CACHE["$__sc_path"]="$__raw"
    fi
    printf -v "$__out_var" '%s' "$__raw"
    return 0
}

index_all_nas_deltas() {
    load_persistent_caches

    NAS_TYPE=()
    NAS_SIZE=()
    NAS_MTIME=()
    NAS_MTIME_HUMAN=()
    NAS_FIND_STAMP=()
    NAS_LINK=()
    NAS_DIRTY_PATHS=()
    DELTA_ORIGIN_FILES=()
    DELTA_REAL_ITEMS=()
    DELTA_SHARED_FILES=()
    OTHER_DELTA_ORIGIN_FILES=()
    DELTA_DIRS=()
    DELTA_NEW_DIR_LOCAL_ITEMS=()
    DELTA_NEW_DIR_NAS_ITEMS=()
    CONSUMERS_CACHE=()
    ORIGIN_RAW_CACHE=()
    SHARED_RAW_CACHE=()
    ORIG_MEMO_READY=()
    PH_MEMO_READY=()
    CONSUMERS_INDEX_READY=false

    local all_deltas=() a d
    for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        d="${SYS_DELTA_MAP[$a]:-}"
        [[ -d "$d" ]] && all_deltas+=("$d")
    done

    local all_shared_files=()
    if (( ${#all_deltas[@]} > 0 )); then
        local p ftype fsize fhum fts fts_norm flink fstamp
        while IFS= read -r -d '' p &&
              IFS= read -r -d '' ftype &&
              IFS= read -r -d '' fsize &&
              IFS= read -r -d '' fhum &&
              IFS= read -r -d '' fts &&
              IFS= read -r -d '' flink; do
            norm_ts_into fts_norm "$fts"
            fstamp="${fts_norm}:${fsize}"
            NAS_TYPE["$p"]="$ftype"
            NAS_SIZE["$p"]="$fsize"
            NAS_MTIME["$p"]="${fts%%.*}"
            NAS_MTIME_HUMAN["$p"]="${fhum%%.*}"
            NAS_FIND_STAMP["$p"]="$fstamp"
            [[ "$ftype" == "l" ]] && NAS_LINK["$p"]="$flink"

            if [[ "$p" == "$RESOLVED_DELTA_DIR/"* ]]; then
                if [[ "$ftype" == "f" && "$p" == *.origin.txt ]]; then
                    DELTA_ORIGIN_FILES+=("$p")
                elif [[ "$ftype" == "f" && "$p" == *.shared ]]; then
                    DELTA_SHARED_FILES+=("$p")
                elif [[ "$ftype" == "d" ]]; then
                    DELTA_DIRS+=("$p")
                elif [[ ( "$ftype" == "f" || "$ftype" == "l" ) && "$p" != *.origin.txt && "$p" != *.shared ]]; then
                    DELTA_REAL_ITEMS+=("$p")
                fi
            else
                if [[ "$ftype" == "f" && "$p" == *.origin.txt ]]; then
                    OTHER_DELTA_ORIGIN_FILES+=("$p")
                fi
            fi

            if [[ "$ftype" == "f" && "$p" == *.shared ]]; then
                all_shared_files+=("$p")
                [[ "${PERSIST_SC_STAMP[$p]:-}" == "$fstamp" ]] && SHARED_RAW_CACHE["$p"]="${PERSIST_SC_RAW[$p]:-}"
            elif [[ "$ftype" == "f" && "$p" == *.origin.txt ]]; then
                [[ "${PERSIST_SC_STAMP[$p]:-}" == "$fstamp" ]] && ORIGIN_RAW_CACHE["$p"]="${PERSIST_SC_RAW[$p]:-}"
            fi
        done < <(LC_ALL=C find "${all_deltas[@]}" -mindepth 1 -printf '%p\0%y\0%s\0%TY-%Tm-%Td %TH:%TM:%TS\0%T@\0%l\0' 2>/dev/null || true)
    fi

    NAS_DELTAS_INDEXED=true

    sort_null_array DELTA_ORIGIN_FILES
    sort_null_array DELTA_REAL_ITEMS
    sort_null_array DELTA_SHARED_FILES
    (( ${#all_shared_files[@]} > 1 )) && sort_null_array all_shared_files

    local ph_path consumer_alias rel_part rel_clean ph_src ckey
    for ph_path in "${all_shared_files[@]}"; do
        consumer_alias="" rel_part=""
        for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
            d="${SYS_DELTA_MAP[$a]:-}"
            if [[ -n "$d" && "$ph_path" == "$d/"* ]]; then
                consumer_alias="$a"
                rel_part="${ph_path#$d/}"
                break
            fi
        done
        [[ -z "$consumer_alias" ]] && continue
        strip_nas_rel_into rel_clean "$rel_part"

        load_shared_placeholder "$ph_path" || continue
        ph_src="$PH_SHARED_SOURCE"
        [[ -z "$ph_src" || "$ph_src" == "$consumer_alias" ]] && continue
        ckey="${ph_src}|${rel_clean}"
        if [[ -z "${CONSUMERS_CACHE[$ckey]:-}" ]]; then
            CONSUMERS_CACHE["$ckey"]="$consumer_alias"
        elif [[ ",${CONSUMERS_CACHE[$ckey]}," != *",$consumer_alias,"* ]]; then
            CONSUMERS_CACHE["$ckey"]="${CONSUMERS_CACHE[$ckey]},$consumer_alias"
        fi
    done

    CONSUMERS_INDEX_READY=true
    return 0
}

symlink_sha256_into() {
    local __out_var="$1" __link_target="$2"
    if [[ -z "${SYMLINK_SHA_CACHE[$__link_target]+x}" ]]; then
        local __h_line=""
        IFS= read -r __h_line < <(printf "SYMLINK:%s" "$__link_target" | sha256sum)
        SYMLINK_SHA_CACHE["$__link_target"]="${__h_line:0:64}"
    fi
    printf -v "$__out_var" '%s' "${SYMLINK_SHA_CACHE[$__link_target]}"
    return 0
}

calc_target_sha256_into() {
    local __out_var="$1" __target="$2"
    if [[ -L "$__target" ]]; then
        local __lnk="${LOC_LINK[$__target]:-${NAS_LINK[$__target]:-}}"
        [[ -z "$__lnk" ]] && __lnk=$(readlink -- "$__target" 2>/dev/null || true)
        symlink_sha256_into "$__out_var" "$__lnk"
    elif [[ -f "$__target" ]]; then
        local __stamp=""
        if [[ "${LOC_EXISTS[$__target]:-0}" == "1" ]]; then
            __stamp="${LOC_STAT_STAMP[$__target]:-${LOC_MTIME[$__target]:-0}:${LOC_SIZE[$__target]:-0}}"
        elif [[ "${NAS_TYPE[$__target]:-}" == "f" ]]; then
            __stamp="${NAS_FIND_STAMP[$__target]:-${NAS_MTIME[$__target]:-0}:${NAS_SIZE[$__target]:-0}}"
        fi
        if [[ -z "${SHA256_CACHE[$__target]:-}" || -z "$__stamp" || "${SHA256_STAMP[$__target]:-}" != "$__stamp" ]]; then
            batch_sha256_files "$__target"
        fi
        printf -v "$__out_var" '%s' "${SHA256_CACHE[$__target]:-}"
    elif [[ -d "$__target" ]]; then
        local __rel_paths=() __files_to_hash=()
        local -A __d_type=() __d_link=()
        local __rp __yt __lnk __fp
        while IFS= read -r -d '' __rp &&
              IFS= read -r -d '' __yt &&
              IFS= read -r -d '' __lnk; do
            [[ -z "$__rp" ]] && continue
            __rel_paths+=("$__rp")
            __d_type["$__rp"]="$__yt"
            if [[ "$__yt" == "l" ]]; then
                __d_link["$__rp"]="$__lnk"
            elif [[ "$__yt" == "f" ]]; then
                __fp="$__target/${__rp#./}"
                __files_to_hash+=("$__fp")
            fi
        done < <(LC_ALL=C find "$__target/" -mindepth 1 ! -name "*.origin.txt" ! -name "*.shared" -printf './%P\0%y\0%l\0' 2>/dev/null || true)

        if (( ${#__files_to_hash[@]} > 0 )); then
            if [[ "$__target" != "${RESOLVED_LINUX_ROOT:-__NONE__}/"* && "$__target" != "${LINUX_ROOT:-__NONE__}/"* ]]; then
                prefetch_local_paths_metadata true "${__files_to_hash[@]}"
            else
                batch_sha256_files "${__files_to_hash[@]}"
            fi
        fi

        (( ${#__rel_paths[@]} > 1 )) && sort_null_array __rel_paths

        local __manifest="" __h_line=""
        for __rp in "${__rel_paths[@]}"; do
            case "${__d_type[$__rp]}" in
                l) __manifest+="L:${__rp}:${__d_link[$__rp]}"$'\n' ;;
                f) __fp="$__target/${__rp#./}"; __manifest+="F:${__rp}:${SHA256_CACHE[$__fp]:-}"$'\n' ;;
                d) __manifest+="D:${__rp}"$'\n' ;;
            esac
        done
        IFS= read -r __h_line < <(printf '%s' "$__manifest" | sha256sum)
        printf -v "$__out_var" '%s' "${__h_line:0:64}"
    else
        printf -v "$__out_var" '%s' ""
    fi
    return 0
}

calc_dir_stats() {
    local dir_path="$1"
    DIR_SUBDIRS=0 DIR_FILES=0 DIR_SYMLINKS=0 DIR_SIZE_BYTES=0 DIR_SIZE_HUMAN="0B"
    local yt sz
    while IFS= read -r -d '' yt && IFS= read -r -d '' sz; do
        case "$yt" in
            d) DIR_SUBDIRS=$(( DIR_SUBDIRS + 1 )) ;;
            l) DIR_SYMLINKS=$(( DIR_SYMLINKS + 1 ))
               DIR_SIZE_BYTES=$(( DIR_SIZE_BYTES + ${sz:-0} )) ;;
            f) DIR_FILES=$(( DIR_FILES + 1 ))
               DIR_SIZE_BYTES=$(( DIR_SIZE_BYTES + ${sz:-0} )) ;;
        esac
    done < <(LC_ALL=C find "$dir_path/" -mindepth 1 ! -name "*.origin.txt" ! -name "*.shared" -printf '%y\0%s\0' 2>/dev/null || true)

    if command -v numfmt &>/dev/null; then
        DIR_SIZE_HUMAN=$(numfmt --to=iec --suffix=B "$DIR_SIZE_BYTES" 2>/dev/null || echo "${DIR_SIZE_BYTES}B")
    else
        DIR_SIZE_HUMAN="${DIR_SIZE_BYTES}B"
    fi
    return 0
}

load_passwd_group_cache() {
    if [[ -r /etc/passwd ]]; then
        local u _ uid _rest
        while IFS=: read -r u _ uid _rest; do
            [[ -z "$u" ]] && continue
            USER_EXISTS_CACHE["$u"]="1"
            USER_UID_CACHE["$u"]="$uid"
        done < /etc/passwd
    fi
    if [[ -r /etc/group ]]; then
        local g _ gid _rest
        while IFS=: read -r g _ gid _rest; do
            [[ -z "$g" ]] && continue
            GROUP_EXISTS_CACHE["$g"]="1"
            GROUP_GID_CACHE["$g"]="$gid"
        done < /etc/group
    fi
    PASSWD_GROUP_LOADED=true
    return 0
}

user_exists_cached() {
    local u="$1"
    [[ -n "$u" ]] || return 1
    [[ "$PASSWD_GROUP_LOADED" == true ]] || load_passwd_group_cache
    if [[ -n "${USER_EXISTS_CACHE[$u]:-}" ]]; then
        [[ "${USER_EXISTS_CACHE[$u]}" == "1" ]]
        return $?
    fi
    local uid=""
    if uid=$(id -u "$u" 2>/dev/null); then
        USER_EXISTS_CACHE["$u"]="1"; USER_UID_CACHE["$u"]="$uid"; return 0
    fi
    USER_EXISTS_CACHE["$u"]="0"; return 1
}

group_exists_cached() {
    local g="$1"
    [[ -n "$g" ]] || return 1
    [[ "$PASSWD_GROUP_LOADED" == true ]] || load_passwd_group_cache
    if [[ -n "${GROUP_EXISTS_CACHE[$g]:-}" ]]; then
        [[ "${GROUP_EXISTS_CACHE[$g]}" == "1" ]]
        return $?
    fi
    local line="" gid=""
    if line=$(getent group "$g" 2>/dev/null); then
        gid="${line#*:*:}"; gid="${gid%%:*}"
        GROUP_EXISTS_CACHE["$g"]="1"; GROUP_GID_CACHE["$g"]="$gid"; return 0
    fi
    GROUP_EXISTS_CACHE["$g"]="0"; return 1
}

resolve_owner_group_spec_into() {
    local __out_var="$1" __u_name="${2:-}" __u_id="${3:-}" __g_name="${4:-}" __g_id="${5:-}"
    local __final_u="root" __final_g="root"
    if [[ -n "$__u_name" ]] && user_exists_cached "$__u_name"; then
        __final_u="$__u_name"
    elif [[ -n "$__u_id" && "$__u_id" =~ ^[0-9]+$ ]]; then
        __final_u="$__u_id"
    elif [[ -n "$__u_name" ]]; then
        __final_u="$__u_name"
    fi
    if [[ -n "$__g_name" ]] && group_exists_cached "$__g_name"; then
        __final_g="$__g_name"
    elif [[ -n "$__g_id" && "$__g_id" =~ ^[0-9]+$ ]]; then
        __final_g="$__g_id"
    elif [[ -n "$__g_name" ]]; then
        __final_g="$__g_name"
    fi
    printf -v "$__out_var" '%s:%s' "$__final_u" "$__final_g"
    return 0
}

atomic_install_file() {
    local src_file="$1" dst_file="$2" owner_spec="${3:-root:root}" mode="${4:-0644}" mtime="${5:-}"
    local dst_dir="" dst_base=""
    path_dirname_into dst_dir "$dst_file"
    path_basename_into dst_base "$dst_file"
    [[ -d "$dst_dir" ]] || mkdir -p "$dst_dir"

    local tmp_dst="$dst_dir/.nc_atomic_$$_${dst_base}"
    LOCAL_TMP_FILES["$tmp_dst"]=1
    cp -fp "$src_file" "$tmp_dst" 2>/dev/null || cp -f "$src_file" "$tmp_dst"
    [[ -n "$owner_spec" ]] && chown "$owner_spec" "$tmp_dst" 2>/dev/null || true
    [[ -n "$mode" && "$mode" != "lrwxrwxrwx" ]] && chmod "$mode" "$tmp_dst" 2>/dev/null || true
    [[ -n "$mtime" && "$mtime" =~ ^[0-9]+$ ]] && touch -d "@$mtime" "$tmp_dst" 2>/dev/null || true
    mv -f "$tmp_dst" "$dst_file"
    unset 'LOCAL_TMP_FILES[$tmp_dst]'
    invalidate_local_cache "$dst_file"
    return 0
}

atomic_copy_to_nas() {
    local src_file="$1" nas_dst="$2" src_mtime="${3:-}"
    local nas_dir=""
    path_dirname_into nas_dir "$nas_dst"
    [[ -d "$nas_dir" ]] || mkdir -p "$nas_dir"

    local tmp_nas="${nas_dst}.tmp.$$"
    NAS_TMP_FILES["$tmp_nas"]=1
    cp -fp "$src_file" "$tmp_nas" 2>/dev/null || cp -f "$src_file" "$tmp_nas"
    [[ -n "$src_mtime" && "$src_mtime" =~ ^[0-9]+$ ]] && touch -d "@$src_mtime" "$tmp_nas" 2>/dev/null || true
    mv -f "$tmp_nas" "$nas_dst"
    unset 'NAS_TMP_FILES[$tmp_nas]'
    invalidate_nas_cache "$nas_dst"
    return 0
}

get_diff_summary_nums_into() {
    local __a_var="$1" __r_var="$2" __f1="$3" __f2="$4"
    local __stats __a_cnt __r_cnt
    __stats=$({ diff -a -u -Z -U 0 "$__f1" "$__f2" 2>/dev/null || true; } | awk '
        NR <= 2 { next }
        /^\+/ { a++ }
        /^-/  { r++ }
        END { printf "%d %d", a+0, r+0 }
    ')
    read -r __a_cnt __r_cnt <<< "$__stats"
    printf -v "$__a_var" '%s' "${__a_cnt:-0}"
    printf -v "$__r_var" '%s' "${__r_cnt:-0}"
    return 0
}

get_diff_summary() {
    local added removed
    get_diff_summary_nums_into added removed "$1" "$2"
    echo -e "${C_GREEN}+${added}${C_RESET} / ${C_RED}-${removed}${C_RESET} righe ${C_MUTED}(NAS rispetto a Locale)${C_RESET}"
    return 0
}

render_full_diff() {
    local local_file="$1" nas_file="$2" disp_path="$3"
    echo -e "\n${C_SLATE}==============================================================================${C_RESET}"
    echo -e " ${C_BOLD}DIFF:${C_RESET} ${disp_path}"
    echo -e " ${C_MUTED}Legenda: [- Presente solo in Locale]  [+ Presente solo su NAS]${C_RESET}"
    echo -e "${C_SLATE}------------------------------------------------------------------------------${C_RESET}"
    printf " ${C_MUTED}%4s %4s │ %s${C_RESET}\n" "LOC" "NAS" "CONTENUTO"
    echo -e "${C_SLATE}───────────┼──────────────────────────────────────────────────────────────────${C_RESET}"
    { diff -a -u -U 999999 "$local_file" "$nas_file" 2>/dev/null || true; } | awk \
        -v c_red="$C_RED" -v c_green="$C_GREEN" -v c_muted="$C_MUTED" -v c_ctx="$C_CTX" -v c_reset="$C_RESET" '
        NR <= 2 || /^@@/ || /^\\/ { next }
        {
            prefix = substr($0, 1, 1); content = substr($0, 2); sub(/\r$/, "", content)
            if (prefix == "-") { old_ln++; printf " %s%4d    - │ - %s%s\n", c_red, old_ln, content, c_reset }
            else if (prefix == "+") { new_ln++; printf " %s   + %4d │ + %s%s\n", c_green, new_ln, content, c_reset }
            else { old_ln++; new_ln++; printf " %s%4d %4d │%s   %s%s\n", c_muted, old_ln, new_ln, c_ctx, content, c_reset }
        }
    '
    echo -e "${C_SLATE}==============================================================================${C_RESET}\n"
    return 0
}

# ==============================================================================
# LIVELLO 4: METADATI CANONICI (.origin.txt), PLACEHOLDER (.shared) & ALBERI
# ==============================================================================
infer_source_alias_from_nas_path_into() {
    local __out_var="$1" __nas_path="$2" __a __d __b
    for __a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        __d="${SYS_DELTA_MAP[$__a]:-}"
        __b="$LINUX_ROOT/${SYS_FOLDER_MAP[$__a]:-}/$BACKUP_DIR_NAME"
        if [[ ( -n "$__d" && "$__nas_path" == "$__d/"* ) || ( -n "$__b" && "$__nas_path" == "$__b/"* ) ]]; then
            printf -v "$__out_var" '%s' "$__a"
            return 0
        fi
    done
    printf -v "$__out_var" '%s' ""
    return 0
}

get_placeholder_consumers_into() {
    local __out_var="$1" __rel_clean="" __source_alias="${3:-$ACTIVE_ALIAS}"
    strip_nas_rel_into __rel_clean "$2"

    if [[ "$CONSUMERS_INDEX_READY" == true ]]; then
        printf -v "$__out_var" '%s' "${CONSUMERS_CACHE[${__source_alias}|${__rel_clean}]:-}"
        return 0
    fi

    local __consumers=() __a __d __ph_f
    for __a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        [[ "$__a" == "$__source_alias" ]] && continue
        __d="${SYS_DELTA_MAP[$__a]:-}"
        __ph_f="$__d/${__rel_clean}.shared"
        if [[ -n "$__d" ]] && nas_is_regular_file "$__ph_f"; then
            load_shared_placeholder "$__ph_f" || continue
            if [[ -z "$PH_SHARED_SOURCE" || "$PH_SHARED_SOURCE" == "$__source_alias" ]]; then
                __consumers+=("$__a")
            fi
        fi
    done

    if (( ${#__consumers[@]} > 0 )); then
        local __joined
        printf -v __joined '%s,' "${__consumers[@]}"
        printf -v "$__out_var" '%s' "${__joined%,}"
    else
        printf -v "$__out_var" '%s' ""
    fi
    return 0
}

find_existing_source_owner() {
    local rel_clean=""
    strip_nas_rel_into rel_clean "$1"

    local active_ph="$RESOLVED_DELTA_DIR/${rel_clean}.shared"
    if nas_is_regular_file "$active_ph"; then
        load_shared_placeholder "$active_ph" || true
        if [[ -n "$PH_SHARED_SOURCE" ]]; then
            echo "$PH_SHARED_SOURCE"; return 0
        fi
    fi

    local cand
    for cand in "$RESOLVED_DELTA_DIR/$rel_clean" "$RESOLVED_DELTA_DIR/${rel_clean}.enc" "$RESOLVED_DELTA_DIR/${rel_clean}.tar.gz.enc"; do
        if nas_path_exists_or_link "$cand"; then
            echo "$ACTIVE_ALIAS"; return 0
        fi
    done

    local a d others
    for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        [[ "$a" == "$ACTIVE_ALIAS" ]] && continue
        d="${SYS_DELTA_MAP[$a]:-}"
        [[ -z "$d" ]] && continue
        for cand in "$d/$rel_clean" "$d/${rel_clean}.enc" "$d/${rel_clean}.tar.gz.enc"; do
            if nas_path_exists_or_link "$cand"; then
                get_placeholder_consumers_into others "$rel_clean" "$a"
                if [[ -n "$others" ]]; then
                    echo "$a"; return 0
                fi
            fi
        done
    done
    echo ""
    return 0
}

write_shared_placeholder() {
    local target_alias="$1" orig_abs_path="$2" source_alias="$3" source_rel_item="$4"
    local target_delta="${SYS_DELTA_MAP[$target_alias]:-}"
    [[ -z "$target_delta" ]] && return 0

    local rel_clean=""
    normalize_local_rel_into rel_clean "$orig_abs_path"
    local ph_file="$target_delta/${rel_clean}.shared"
    local src_folder="${SYS_FOLDER_MAP[$source_alias]:-}"
    local src_delta_name=""
    path_basename_into src_delta_name "${SYS_DELTA_MAP[$source_alias]:-${source_alias}-delta}"

    local ph_dir=""
    path_dirname_into ph_dir "$ph_file"
    [[ -d "$ph_dir" ]] || mkdir -p "$ph_dir"

    local content=""
    content+="# NC-NAS-CONF SHARED PLACEHOLDER"$'\n'
    content+="ORIG_PATH=${orig_abs_path}"$'\n'
    content+="ORIG_TYPE=shared_placeholder"$'\n'
    content+="SHARED_SOURCE=${source_alias}"$'\n'
    content+="SOURCE_DELTA_DIR=${src_folder}/${src_delta_name}"$'\n'
    content+="SOURCE_REL_ITEM=${source_rel_item}"$'\n'

    local tmp_ph="${ph_file}.tmp.$$"
    NAS_TMP_FILES["$tmp_ph"]=1
    printf '%s' "$content" > "$tmp_ph"
    mv -f "$tmp_ph" "$ph_file"
    unset 'NAS_TMP_FILES[$tmp_ph]'

    invalidate_nas_cache "$ph_file"
    ensure_nas_stat "$ph_file" >/dev/null 2>&1 || true
    SHARED_RAW_CACHE["$ph_file"]="$content"
    if [[ -n "${NAS_FIND_STAMP[$ph_file]:-}" ]]; then
        PERSIST_SC_STAMP["$ph_file"]="${NAS_FIND_STAMP[$ph_file]}"
        PERSIST_SC_RAW["$ph_file"]="$content"
        NAS_SIDECAR_CACHE_DIRTY=true
    fi
    CONSUMERS_INDEX_READY=false
    NAS_STATE_MUTATED=true
    return 0
}

load_shared_placeholder() {
    local ph_file="$1"
    PH_ORIG_PATH="" PH_SHARED_SOURCE="" PH_SOURCE_DELTA_DIR=""
    PH_SOURCE_REL_ITEM="" PH_RESOLVED_SOURCE_FILE=""

    nas_is_regular_file "$ph_file" || return 1

    if [[ -z "${PH_MEMO_READY[$ph_file]:-}" ]]; then
        local raw_ph="" rem line k v p_path="" p_src="" p_ddir="" p_ritem=""
        read_sidecar_raw_cached raw_ph "$ph_file" "shared"
        rem="$raw_ph"
        while [[ -n "$rem" ]]; do
            if [[ "$rem" == *$'\n'* ]]; then
                line="${rem%%$'\n'*}"; rem="${rem#*$'\n'}"
            else
                line="$rem"; rem=""
            fi
            line="${line%$'\r'}"
            [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
            k="${line%%=*}"; v="${line#*=}"
            case "$k" in
                ORIG_PATH)        p_path="$v" ;;
                SHARED_SOURCE)    p_src="$v" ;;
                SOURCE_DELTA_DIR) p_ddir="$v" ;;
                SOURCE_REL_ITEM)  p_ritem="$v" ;;
            esac
        done
        if [[ -z "$p_path" ]]; then
            local rel="${ph_file#$RESOLVED_DELTA_DIR/}"
            p_path="/${rel%.shared}"
        fi
        PH_MEMO_PATH["$ph_file"]="$p_path"
        PH_MEMO_SRC["$ph_file"]="$p_src"
        PH_MEMO_DDIR["$ph_file"]="$p_ddir"
        PH_MEMO_RITEM["$ph_file"]="$p_ritem"
        PH_MEMO_READY["$ph_file"]="1"
    fi

    PH_ORIG_PATH="${PH_MEMO_PATH[$ph_file]}"
    PH_SHARED_SOURCE="${PH_MEMO_SRC[$ph_file]}"
    PH_SOURCE_DELTA_DIR="${PH_MEMO_DDIR[$ph_file]}"
    PH_SOURCE_REL_ITEM="${PH_MEMO_RITEM[$ph_file]}"

    local src_delta=""
    if [[ -n "$PH_SHARED_SOURCE" && -n "${SYS_DELTA_MAP[$PH_SHARED_SOURCE]:-}" ]]; then
        src_delta="${SYS_DELTA_MAP[$PH_SHARED_SOURCE]}"
    elif [[ -n "$PH_SOURCE_DELTA_DIR" && -d "$LINUX_ROOT/$PH_SOURCE_DELTA_DIR" ]]; then
        src_delta="$LINUX_ROOT/$PH_SOURCE_DELTA_DIR"
    fi

    if [[ -n "$src_delta" ]]; then
        local rel_clean
        normalize_local_rel_into rel_clean "$PH_ORIG_PATH"
        if [[ -n "$PH_SOURCE_REL_ITEM" ]] && nas_path_exists_or_link "$src_delta/$PH_SOURCE_REL_ITEM"; then
            PH_RESOLVED_SOURCE_FILE="$src_delta/$PH_SOURCE_REL_ITEM"
        else
            local cand
            for cand in "$src_delta/$rel_clean" "$src_delta/${rel_clean}.enc" "$src_delta/${rel_clean}.tar.gz.enc"; do
                if nas_path_exists_or_link "$cand"; then
                    PH_RESOLVED_SOURCE_FILE="$cand"
                    break
                fi
            done
        fi
    fi
    return 0
}

# Scrittura canonica unificata di .origin.txt
write_origin_file_content() {
    local meta_file="$1" nas_payload="$2" out="$3"
    local meta_dir
    path_dirname_into meta_dir "$meta_file"
    [[ -d "$meta_dir" ]] || mkdir -p "$meta_dir"

    local tmp_meta="${meta_file}.tmp.$$"
    NAS_TMP_FILES["$tmp_meta"]=1
    printf '%s' "$out" > "$tmp_meta"
    mv -f "$tmp_meta" "$meta_file"
    unset 'NAS_TMP_FILES[$tmp_meta]'
    if [[ -e "$nas_payload" || -L "$nas_payload" ]]; then
        touch -r "$nas_payload" "$meta_file" 2>/dev/null || true
    fi

    invalidate_nas_cache "$nas_payload"
    invalidate_nas_cache "$meta_file"
    ensure_nas_stat "$meta_file" >/dev/null 2>&1 || true
    ORIGIN_RAW_CACHE["$meta_file"]="$out"
    if [[ -n "${NAS_FIND_STAMP[$meta_file]:-}" ]]; then
        PERSIST_SC_STAMP["$meta_file"]="${NAS_FIND_STAMP[$meta_file]}"
        PERSIST_SC_RAW["$meta_file"]="$out"
        NAS_SIDECAR_CACHE_DIRTY=true
    fi
    NAS_STATE_MUTATED=true
    return 0
}

format_origin_payload() {
    local __out_var="$1" __o_path="$2" __o_name="$3" __o_type="$4" __o_sym="$5"
    local __o_mode="$6" __o_uid="$7" __o_owner="$8" __o_gid="$9" __o_group="${10}"
    local __o_size="${11}" __o_sha="${12}" __o_enc="${13}" __o_mkfp="${14}"
    local __o_src="${15}" __o_tgts="${16}" __o_upd="${17}"
    local __d_szh="${18:-}" __d_szb="${19:-}" __d_sub="${20:-}" __d_fil="${21:-}" __d_slk="${22:-}"

    local __out=""
    __out+="ORIG_PATH=${__o_path}"$'\n'
    __out+="ORIG_NAME=${__o_name}"$'\n'
    __out+="ORIG_TYPE=${__o_type}"$'\n'
    [[ "$__o_type" == "symlink" ]] && __out+="ORIG_SYMLINK_TARGET=${__o_sym}"$'\n'
    __out+="ORIG_MODE=${__o_mode:-0644}"$'\n'
    __out+="ORIG_UID=${__o_uid:-0}"$'\n'
    __out+="ORIG_OWNER=${__o_owner:-root}"$'\n'
    __out+="ORIG_GID=${__o_gid:-0}"$'\n'
    __out+="ORIG_GROUP=${__o_group:-root}"$'\n'
    [[ "$__o_type" == "file" ]] && __out+="ORIG_SIZE=${__o_size:-0}"$'\n'
    [[ -n "$__o_sha" ]] && __out+="ORIG_SHA256=${__o_sha}"$'\n'
    __out+="ENC_MODE=${__o_enc:-none}"$'\n'
    [[ -n "$__o_mkfp" ]] && __out+="MASTER_KEY_FP=${__o_mkfp}"$'\n'
    __out+="SHARED_SOURCE=${__o_src:-$ACTIVE_ALIAS}"$'\n'
    __out+="SHARED_TARGETS=${__o_tgts:-none}"$'\n'
    __out+="LAST_UPDATED_BY=${__o_upd:-${__o_src:-$ACTIVE_ALIAS}}"$'\n'
    if [[ "$__o_type" == "directory" ]]; then
        __out+="ORIG_SIZE_HUMAN=${__d_szh}"$'\n'
        __out+="ORIG_SIZE_BYTES=${__d_szb}"$'\n'
        __out+="ORIG_SUBDIRS=${__d_sub}"$'\n'
        __out+="ORIG_FILES=${__d_fil}"$'\n'
        __out+="ORIG_SYMLINKS=${__d_slk}"$'\n'
    fi
    printf -v "$__out_var" '%s' "$__out"
    return 0
}

save_origin_metadata() {
    local src_path="$1" meta_file="$2" enc_mode="${3:-none}" mk_fp="${4:-}"
    local source_host="${5:-$ACTIVE_ALIAS}" forced_sha="${6:-}" last_updated_by="${7:-$ACTIVE_ALIAS}"

    ensure_local_stat "$src_path" || true
    local loc_t="${LOC_TYPE[$src_path]:-f}" obj_type="file"
    [[ "$loc_t" == "d" ]] && obj_type="directory"
    [[ "$loc_t" == "l" ]] && obj_type="symlink"

    local item_sha="$forced_sha"
    [[ -z "$item_sha" ]] && calc_target_sha256_into item_sha "$src_path"

    local item_sym=""
    if [[ "$obj_type" == "symlink" ]]; then
        item_sym="${LOC_LINK[$src_path]:-}"
        [[ -z "$item_sym" ]] && item_sym=$(readlink -- "$src_path" 2>/dev/null || true)
    fi

    local src_base consumers=""
    path_basename_into src_base "$src_path"
    get_placeholder_consumers_into consumers "$src_path" "$source_host"

    local d_szh="" d_szb="" d_sub="" d_fil="" d_slk=""
    if [[ "$obj_type" == "directory" ]]; then
        calc_dir_stats "$src_path"
        d_szh="$DIR_SIZE_HUMAN" d_szb="$DIR_SIZE_BYTES"
        d_sub="$DIR_SUBDIRS" d_fil="$DIR_FILES" d_slk="$DIR_SYMLINKS"
    fi

    local out=""
    format_origin_payload out "$src_path" "$src_base" "$obj_type" "$item_sym" \
        "${LOC_MODE[$src_path]:-0644}" "${LOC_UID[$src_path]:-0}" "${LOC_OWNER[$src_path]:-root}" \
        "${LOC_GID[$src_path]:-0}" "${LOC_GROUP[$src_path]:-root}" "${LOC_SIZE[$src_path]:-0}" \
        "$item_sha" "$enc_mode" "$mk_fp" "$source_host" "${consumers:-none}" "$last_updated_by" \
        "$d_szh" "$d_szb" "$d_sub" "$d_fil" "$d_slk"

    write_origin_file_content "$meta_file" "${meta_file%.origin.txt}" "$out"
    return 0
}

# Salva i metadati di un intero albero in O(N) senza ricalcoli quadratici su sottocartelle
save_tree_metadata_recursive() {
    local src_root="$1" dst_root="$2" source_host="${3:-$ACTIVE_ALIAS}"

    local tree_items=("$src_root") tree_rel=(".")
    local -A t_type=() t_link=()
    t_type["$src_root"]="d"

    local rp yt lnk full_p
    while IFS= read -r -d '' rp && IFS= read -r -d '' yt && IFS= read -r -d '' lnk; do
        [[ -z "$rp" ]] && continue
        full_p="$src_root/${rp#./}"
        tree_items+=("$full_p")
        tree_rel+=("$rp")
        t_type["$full_p"]="$yt"
        [[ "$yt" == "l" ]] && t_link["$full_p"]="$lnk"
    done < <(LC_ALL=C find "$src_root/" -mindepth 1 -printf './%P\0%y\0%l\0' 2>/dev/null || true)

    prefetch_local_paths_metadata true "${tree_items[@]}"

    local total=${#tree_items[@]} idx item rel dst_item consumers="" item_sym item_sha
    local d_sub d_fil d_slk d_bytes d_szh manifest h_line out
    local -a dir_touch_items=() dir_touch_mtimes=()

    for (( idx=0; idx<total; idx++ )); do
        item="${tree_items[$idx]}"
        rel="${tree_rel[$idx]}"
        if (( idx == 0 )); then
            dst_item="$dst_root"
        else
            dst_item="$dst_root/${rel#./}"
        fi

        local obj_type="file"
        [[ "${t_type[$item]}" == "d" ]] && obj_type="directory"
        [[ "${t_type[$item]}" == "l" ]] && obj_type="symlink"

        item_sym=""
        d_szh="" d_bytes="" d_sub="" d_fil="" d_slk=""
        if [[ "$obj_type" == "symlink" ]]; then
            item_sym="${t_link[$item]:-${LOC_LINK[$item]:-}}"
            symlink_sha256_into item_sha "$item_sym"
        elif [[ "$obj_type" == "file" ]]; then
            item_sha="${SHA256_CACHE[$item]:-}"
            [[ -z "$item_sha" ]] && calc_target_sha256_into item_sha "$item"
        else
            # Calcola stats & SHA directory in RAM sui figli già raccolti (O(1) syscall!)
            d_sub=0 d_fil=0 d_slk=0 d_bytes=0
            local sub_rels=() j c_item c_rel c_prefix
            [[ "$item" == "$src_root" ]] && c_prefix="$src_root/" || c_prefix="$item/"
            for (( j=idx+1; j<total; j++ )); do
                c_item="${tree_items[$j]}"
                [[ "$c_item" == "$c_prefix"* ]] || continue
                c_rel="./${c_item#$c_prefix}"
                sub_rels+=("$c_rel")
                case "${t_type[$c_item]}" in
                    d) d_sub=$(( d_sub + 1 )) ;;
                    l) d_slk=$(( d_slk + 1 )); d_bytes=$(( d_bytes + ${LOC_SIZE[$c_item]:-0} )) ;;
                    f) d_fil=$(( d_fil + 1 )); d_bytes=$(( d_bytes + ${LOC_SIZE[$c_item]:-0} )) ;;
                esac
            done
            (( ${#sub_rels[@]} > 1 )) && sort_null_array sub_rels
            manifest=""
            for c_rel in "${sub_rels[@]}"; do
                c_item="${c_prefix}${c_rel#./}"
                case "${t_type[$c_item]}" in
                    l) manifest+="L:${c_rel}:${t_link[$c_item]:-}"$'\n' ;;
                    f) manifest+="F:${c_rel}:${SHA256_CACHE[$c_item]:-}"$'\n' ;;
                    d) manifest+="D:${c_rel}"$'\n' ;;
                esac
            done
            IFS= read -r h_line < <(printf '%s' "$manifest" | sha256sum)
            item_sha="${h_line:0:64}"
            if command -v numfmt &>/dev/null; then
                d_szh=$(numfmt --to=iec --suffix=B "$d_bytes" 2>/dev/null || echo "${d_bytes}B")
            else
                d_szh="${d_bytes}B"
            fi
        fi

        local item_base
        path_basename_into item_base "$item"
        get_placeholder_consumers_into consumers "$item" "$source_host"

        if [[ "$obj_type" != "directory" && -n "${LOC_MTIME[$item]:-}" && ( -e "$dst_item" || -L "$dst_item" ) ]]; then
            touch -h -d "@${LOC_MTIME[$item]}" "$dst_item" 2>/dev/null || true
        elif [[ "$obj_type" == "directory" && -n "${LOC_MTIME[$item]:-}" ]]; then
            dir_touch_items+=("$dst_item")
            dir_touch_mtimes+=("${LOC_MTIME[$item]}")
        fi

        format_origin_payload out "$item" "$item_base" "$obj_type" "$item_sym" \
            "${LOC_MODE[$item]:-0644}" "${LOC_UID[$item]:-0}" "${LOC_OWNER[$item]:-root}" \
            "${LOC_GID[$item]:-0}" "${LOC_GROUP[$item]:-root}" "${LOC_SIZE[$item]:-0}" \
            "$item_sha" "none" "" "$source_host" "${consumers:-none}" "$ACTIVE_ALIAS" \
            "$d_szh" "$d_bytes" "$d_sub" "$d_fil" "$d_slk"
        write_origin_file_content "${dst_item}.origin.txt" "$dst_item" "$out"
    done

    # Ripristino mtime delle directory bottom-up dopo la scrittura di tutti i .origin.txt figli
    local dt_tot=${#dir_touch_items[@]} d_i
    for (( d_i=dt_tot-1; d_i>=0; d_i-- )); do
        touch -d "@${dir_touch_mtimes[$d_i]}" "${dir_touch_items[$d_i]}" 2>/dev/null || true
        touch -r "${dir_touch_items[$d_i]}" "${dir_touch_items[$d_i]}.origin.txt" 2>/dev/null || true
        invalidate_nas_cache "${dir_touch_items[$d_i]}"
    done
    return 0
}

apply_tree_metadata_recursive() {
    local nas_dir="$1" restored_dir="$2"

    local -A nas_item_mtimes=()
    local meta_files=() p ft fts
    while IFS= read -r -d '' p && IFS= read -r -d '' ft && IFS= read -r -d '' fts; do
        nas_item_mtimes["$p"]="${fts%%.*}"
        [[ "$ft" == "f" && "$p" == *.origin.txt ]] && meta_files+=("$p")
    done < <(LC_ALL=C find "$nas_dir" -mindepth 1 -printf '%p\0%y\0%T@\0' 2>/dev/null || true)

    (( ${#meta_files[@]} > 1 )) && sort_null_array meta_files

    local all_target_items=() all_target_mtimes=()
    local -A chmod_idx_groups=() chown_idx_groups=()
    local item_idx=0 meta rel_meta rel_item nas_item target_item owner_spec t_dir m_mtime

    for meta in "${meta_files[@]}"; do
        rel_meta="${meta#$nas_dir/}"
        rel_item="${rel_meta%.origin.txt}"
        nas_item="$nas_dir/$rel_item"
        target_item="$restored_dir/$rel_item"
        if [[ -e "$target_item" || -L "$target_item" ]]; then
            load_origin_metadata "$nas_item"
            m_mtime="${nas_item_mtimes[$nas_item]:-}"
            all_target_items+=("$target_item")
            all_target_mtimes+=("$m_mtime")

            if [[ "$ORIG_TYPE" == "symlink" && -n "$ORIG_SYMLINK_TARGET" ]]; then
                path_dirname_into t_dir "$target_item"
                [[ -d "$t_dir" ]] || mkdir -p "$t_dir"
                rm -f "$target_item"
                ln -s "$ORIG_SYMLINK_TARGET" "$target_item"
            elif [[ -n "$ORIG_MODE" && "$ORIG_MODE" != "lrwxrwxrwx" ]]; then
                chmod_idx_groups["$ORIG_MODE"]+="${item_idx} "
            fi

            resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
            chown_idx_groups["$owner_spec"]+="${item_idx} "
            item_idx=$(( item_idx + 1 ))
        fi
    done

    local grp_key idx_list idx paths_batch=()
    for grp_key in "${!chmod_idx_groups[@]}"; do
        paths_batch=()
        read -r -a idx_list <<< "${chmod_idx_groups[$grp_key]}"
        for idx in "${idx_list[@]}"; do
            paths_batch+=("${all_target_items[$idx]}")
            if (( ${#paths_batch[@]} >= 400 )); then
                chmod "$grp_key" -- "${paths_batch[@]}" 2>/dev/null || true
                paths_batch=()
            fi
        done
        (( ${#paths_batch[@]} > 0 )) && chmod "$grp_key" -- "${paths_batch[@]}" 2>/dev/null || true
    done

    for grp_key in "${!chown_idx_groups[@]}"; do
        paths_batch=()
        read -r -a idx_list <<< "${chown_idx_groups[$grp_key]}"
        for idx in "${idx_list[@]}"; do
            paths_batch+=("${all_target_items[$idx]}")
            if (( ${#paths_batch[@]} >= 400 )); then
                chown -h "$grp_key" -- "${paths_batch[@]}" 2>/dev/null || true
                paths_batch=()
            fi
        done
        (( ${#paths_batch[@]} > 0 )) && chown -h "$grp_key" -- "${paths_batch[@]}" 2>/dev/null || true
    done

    for (( idx=item_idx-1; idx>=0; idx-- )); do
        m_mtime="${all_target_mtimes[$idx]}"
        target_item="${all_target_items[$idx]}"
        [[ -n "$m_mtime" && "$m_mtime" =~ ^[0-9]+$ ]] && touch -h -d "@$m_mtime" "$target_item" 2>/dev/null || true
        invalidate_local_cache "$target_item"
    done
    return 0
}

# Verifica placeholder deduplicazione .bak in Hanoi
inspect_bak_placeholder_cached() {
    local bf="$1"
    [[ -z "$bf" ]] && return 1
    if [[ -n "${BAK_IS_PH_CACHE[$bf]:-}" ]]; then
        [[ "${BAK_IS_PH_CACHE[$bf]}" == "1" ]]
        return $?
    fi
    if ! nas_is_regular_file "$bf"; then
        BAK_IS_PH_CACHE["$bf"]="0"; return 1
    fi
    local bsize="${NAS_SIZE[$bf]:-0}"
    if (( bsize > 512 || bsize < 20 )); then
        BAK_IS_PH_CACHE["$bf"]="0"; return 1
    fi

    local l1="" l2="" l3=""
    {
        IFS= read -r l1 || true
        l1="${l1%$'\r'}"
        if [[ "$l1" == "# NC-NAS-CONF BACKUP PLACEHOLDER" ]]; then
            IFS= read -r l2 || true; l2="${l2%$'\r'}"
            IFS= read -r l3 || true; l3="${l3%$'\r'}"
        fi
    } < "$bf" 2>/dev/null || true

    if [[ "$l1" == "# NC-NAS-CONF BACKUP PLACEHOLDER" ]]; then
        BAK_IS_PH_CACHE["$bf"]="1"
        for l2 in "$l2" "$l3"; do
            case "$l2" in
                REF_BAK=*)    BAK_REF_CACHE["$bf"]="${l2#REF_BAK=}" ;;
                REF_SHA256=*) BAK_SHA_CACHE["$bf"]="${l2#REF_SHA256=}" ;;
            esac
        done
        return 0
    fi
    BAK_IS_PH_CACHE["$bf"]="0"; return 1
}

resolve_bak_payload_into() {
    local __out_var="$1" __current="$2"
    if [[ "$__current" != *.bak ]]; then
        printf -v "$__out_var" '%s' "$__current"; return 0
    fi
    local __depth=0 __ref_name __cur_dir __candidate
    while (( __depth < 5 )) && inspect_bak_placeholder_cached "$__current"; do
        __ref_name="${BAK_REF_CACHE[$__current]:-}"
        [[ -z "$__ref_name" ]] && break
        path_dirname_into __cur_dir "$__current"
        __candidate="$__cur_dir/$__ref_name"
        [[ "$__candidate" == "$__current" ]] && break
        __current="$__candidate"
        __depth=$(( __depth + 1 ))
    done
    printf -v "$__out_var" '%s' "$__current"
    return 0
}

# Carica i metadati da .origin.txt con memoizzazione in RAM e rilevamento OOB
load_origin_metadata() {
    local nas_file="$1"
    local meta_file="${nas_file}.origin.txt"

    ORIG_PATH="" ORIG_NAME="" ORIG_TYPE="" ORIG_MODE="" ORIG_UID="" ORIG_OWNER=""
    ORIG_GID="" ORIG_GROUP="" ORIG_SIZE="" ORIG_MTIME="" ORIG_MTIME_HUMAN=""
    ORIG_SYMLINK_TARGET="" ORIG_SHA256="" ENC_MODE="none" ORIG_MK_FP=""
    ORIG_SHARED_SOURCE="" ORIG_SHARED_TARGETS="none" ORIG_LAST_UPDATED_BY=""
    ORIG_SIZE_HUMAN="" ORIG_SIZE_BYTES="" ORIG_SUBDIRS="" ORIG_FILES="" ORIG_SYMLINKS=""
    ORIGIN_HAS_LEGACY_KEYS=false NAS_MODIFIED_OUT_OF_BAND=false
    ORIGIN_LEGACY_REASONS=() NAS_OOB_REASONS=()

    local meta_exists=false
    if nas_is_regular_file "$meta_file"; then
        meta_exists=true
        if [[ -z "${ORIG_MEMO_READY[$meta_file]:-}" ]]; then
            local raw_meta="" rem line k v
            local m_path="" m_name="" m_type="" m_mode="" m_uid="" m_owner="" m_gid="" m_group=""
            local m_size="" m_sym="" m_sha="" m_enc="none" m_mkfp="" m_src="" m_tgt="none" m_upd=""
            local m_szh="" m_szb="" m_sub="" m_fil="" m_slk="" m_leg="0" m_lreasons=""

            read_sidecar_raw_cached raw_meta "$meta_file" "origin"
            rem="$raw_meta"
            while [[ -n "$rem" ]]; do
                if [[ "$rem" == *$'\n'* ]]; then
                    line="${rem%%$'\n'*}"; rem="${rem#*$'\n'}"
                else
                    line="$rem"; rem=""
                fi
                line="${line%$'\r'}"
                [[ -z "$line" ]] && continue
                if [[ "$line" == *=* ]]; then
                    k="${line%%=*}"; v="${line#*=}"
                else
                    k="$line"; v=""
                fi
                case "$k" in
                    ORIG_PATH)  m_path="$v" ;;
                    ORIG_NAME)  m_name="$v" ;;
                    ORIG_TYPE)  m_type="$v" ;;
                    ORIG_MODE)
                        if [[ "$v" != "lrwxrwxrwx" && ${#v} -lt 4 ]]; then
                            m_leg="1"; m_lreasons+="ORIG_MODE_non_4_cifre($v);"
                        fi
                        normalize_octal_mode_into m_mode "$v"
                        ;;
                    ORIG_UID)             m_uid="$v" ;;
                    ORIG_OWNER)           m_owner="$v" ;;
                    ORIG_GID)             m_gid="$v" ;;
                    ORIG_GROUP)           m_group="$v" ;;
                    ORIG_SIZE)            m_size="$v" ;;
                    ORIG_SYMLINK_TARGET)  m_sym="$v" ;;
                    ORIG_SHA256)          m_sha="$v" ;;
                    ENC_MODE)             m_enc="$v" ;;
                    MASTER_KEY_FP)        m_mkfp="$v" ;;
                    SHARED_SOURCE)        m_src="$v" ;;
                    SHARED_TARGETS)       m_tgt="$v" ;;
                    LAST_UPDATED_BY)      m_upd="$v" ;;
                    ORIG_SIZE_HUMAN)      m_szh="$v" ;;
                    ORIG_SIZE_BYTES)      m_szb="$v" ;;
                    ORIG_SUBDIRS)         m_sub="$v" ;;
                    ORIG_FILES)           m_fil="$v" ;;
                    ORIG_SYMLINKS)        m_slk="$v" ;;
                    ORIG_MTIME|ORIG_MTIME_HUMAN|ORIGIN_HOST|BACKUP_DATE)
                        m_leg="1"; m_lreasons+="chiave_legacy($k);" ;;
                    "Origine assoluta"*)
                        m_path="${k#Origine assoluta: }"
                        m_leg="1"; m_lreasons+="formato_legacy_origine_assoluta;" ;;
                esac
            done

            ORIG_MEMO_PATH["$meta_file"]="$m_path"
            ORIG_MEMO_NAME["$meta_file"]="$m_name"
            ORIG_MEMO_TYPE["$meta_file"]="$m_type"
            ORIG_MEMO_MODE["$meta_file"]="$m_mode"
            ORIG_MEMO_UID["$meta_file"]="$m_uid"
            ORIG_MEMO_OWNER["$meta_file"]="$m_owner"
            ORIG_MEMO_GID["$meta_file"]="$m_gid"
            ORIG_MEMO_GROUP["$meta_file"]="$m_group"
            ORIG_MEMO_SIZE["$meta_file"]="$m_size"
            ORIG_MEMO_SYM["$meta_file"]="$m_sym"
            ORIG_MEMO_SHA["$meta_file"]="$m_sha"
            ORIG_MEMO_ENC["$meta_file"]="$m_enc"
            ORIG_MEMO_MKFP["$meta_file"]="$m_mkfp"
            ORIG_MEMO_SRC["$meta_file"]="$m_src"
            ORIG_MEMO_TGT["$meta_file"]="$m_tgt"
            ORIG_MEMO_UPD["$meta_file"]="$m_upd"
            ORIG_MEMO_SZH["$meta_file"]="$m_szh"
            ORIG_MEMO_SZB["$meta_file"]="$m_szb"
            ORIG_MEMO_SUB["$meta_file"]="$m_sub"
            ORIG_MEMO_FIL["$meta_file"]="$m_fil"
            ORIG_MEMO_SLK["$meta_file"]="$m_slk"
            ORIG_MEMO_LEGACY["$meta_file"]="$m_leg"
            ORIG_MEMO_LREASONS["$meta_file"]="$m_lreasons"
            ORIG_MEMO_READY["$meta_file"]="1"
        fi

        ORIG_PATH="${ORIG_MEMO_PATH[$meta_file]}"
        ORIG_NAME="${ORIG_MEMO_NAME[$meta_file]}"
        ORIG_TYPE="${ORIG_MEMO_TYPE[$meta_file]}"
        ORIG_MODE="${ORIG_MEMO_MODE[$meta_file]}"
        ORIG_UID="${ORIG_MEMO_UID[$meta_file]}"
        ORIG_OWNER="${ORIG_MEMO_OWNER[$meta_file]}"
        ORIG_GID="${ORIG_MEMO_GID[$meta_file]}"
        ORIG_GROUP="${ORIG_MEMO_GROUP[$meta_file]}"
        ORIG_SIZE="${ORIG_MEMO_SIZE[$meta_file]}"
        ORIG_SYMLINK_TARGET="${ORIG_MEMO_SYM[$meta_file]}"
        ORIG_SHA256="${ORIG_MEMO_SHA[$meta_file]}"
        ENC_MODE="${ORIG_MEMO_ENC[$meta_file]}"
        ORIG_MK_FP="${ORIG_MEMO_MKFP[$meta_file]}"
        ORIG_SHARED_SOURCE="${ORIG_MEMO_SRC[$meta_file]}"
        ORIG_SHARED_TARGETS="${ORIG_MEMO_TGT[$meta_file]}"
        ORIG_LAST_UPDATED_BY="${ORIG_MEMO_UPD[$meta_file]}"
        ORIG_SIZE_HUMAN="${ORIG_MEMO_SZH[$meta_file]}"
        ORIG_SIZE_BYTES="${ORIG_MEMO_SZB[$meta_file]}"
        ORIG_SUBDIRS="${ORIG_MEMO_SUB[$meta_file]}"
        ORIG_FILES="${ORIG_MEMO_FIL[$meta_file]}"
        ORIG_SYMLINKS="${ORIG_MEMO_SLK[$meta_file]}"
        if [[ "${ORIG_MEMO_LEGACY[$meta_file]}" == "1" ]]; then
            ORIGIN_HAS_LEGACY_KEYS=true
            local _lr="${ORIG_MEMO_LREASONS[$meta_file]}"
            IFS=';' read -r -a ORIGIN_LEGACY_REASONS <<< "${_lr%;}"
        fi
    fi

    local inferred_src=""
    infer_source_alias_from_nas_path_into inferred_src "$nas_file"
    if [[ -n "$inferred_src" ]]; then
        if [[ "$ORIG_SHARED_SOURCE" != "$inferred_src" ]]; then
            if [[ "$meta_exists" == true ]]; then
                ORIGIN_HAS_LEGACY_KEYS=true
                ORIGIN_LEGACY_REASONS+=("SHARED_SOURCE_mismatch(meta='$ORIG_SHARED_SOURCE'!=inferred='$inferred_src')")
            fi
            ORIG_SHARED_SOURCE="$inferred_src"
        fi
    elif [[ -z "$ORIG_SHARED_SOURCE" ]]; then
        ORIG_SHARED_SOURCE="$ACTIVE_ALIAS"
    fi

    if [[ -z "$ORIG_LAST_UPDATED_BY" ]]; then
        ORIG_LAST_UPDATED_BY="$ORIG_SHARED_SOURCE"
        if [[ "$meta_exists" == true ]]; then
            ORIGIN_HAS_LEGACY_KEYS=true
            ORIGIN_LEGACY_REASONS+=("LAST_UPDATED_BY_mancante")
        fi
    fi

    local nas_exists=false nas_t=""
    if ensure_nas_stat "$nas_file"; then
        nas_exists=true
        nas_t="${NAS_TYPE[$nas_file]}"
    fi

    # Fallback symlink placeholder se .origin.txt mancasse o fosse incompleto
    if [[ -z "$ORIG_SYMLINK_TARGET" && "$nas_t" == "f" && "${NAS_SIZE[$nas_file]:-9999}" -lt 512 ]]; then
        local sl1="" sl2=""
        {
            IFS= read -r sl1 || true; sl1="${sl1%$'\r'}"
            if [[ "$sl1" == "# NC-NAS-CONF SYMLINK PLACEHOLDER" ]]; then
                IFS= read -r sl2 || true; sl2="${sl2%$'\r'}"
                if [[ "$sl2" == SYMLINK_TARGET=* ]]; then
                    ORIG_SYMLINK_TARGET="${sl2#SYMLINK_TARGET=}"
                    ORIG_TYPE="symlink"
                    [[ -z "$ORIG_MODE" ]] && ORIG_MODE="lrwxrwxrwx"
                fi
            fi
        } < "$nas_file" 2>/dev/null || true
    fi

    if [[ -z "$ORIG_TYPE" ]]; then
        if [[ "$nas_t" == "l" || "$ORIG_MODE" == "lrwxrwxrwx" || -n "$ORIG_SYMLINK_TARGET" ]]; then
            ORIG_TYPE="symlink"
        elif [[ "$nas_t" == "d" || "$nas_file" == *.tar.gz.enc ]]; then
            ORIG_TYPE="directory"
        else
            ORIG_TYPE="file"
        fi
    fi

    if [[ -z "$ORIG_PATH" ]]; then
        local a d b rel without_bak hist_dir_path
        for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
            d="${SYS_DELTA_MAP[$a]:-}"
            b="$LINUX_ROOT/${SYS_FOLDER_MAP[$a]:-}/$BACKUP_DIR_NAME"
            if [[ -n "$d" && "$nas_file" == "$d/"* ]]; then
                rel="${nas_file#$d/}"
                strip_nas_rel_into rel "$rel"
                ORIG_PATH="/$rel"
                break
            elif [[ -n "$b" && "$nas_file" == "$b/"* ]]; then
                without_bak="${nas_file#$b/}"
                hist_dir_path="${without_bak%/*}"
                rel="${hist_dir_path%.hist}"
                strip_nas_rel_into rel "$rel"
                ORIG_PATH="/$rel"
                break
            fi
        done
    fi

    if [[ -z "$ORIG_NAME" ]]; then
        if [[ -n "$ORIG_PATH" ]]; then
            path_basename_into ORIG_NAME "$ORIG_PATH"
        else
            local base
            path_basename_into base "$nas_file"
            base="${base%.tar.gz.enc}"
            base="${base%.enc}"
            ORIG_NAME="$base"
        fi
    fi

    # Risoluzione UID/GID mancanti solo se appartenente al sistema corrente (non contaminare altri nodi)
    if [[ "$ORIG_SHARED_SOURCE" == "$ACTIVE_ALIAS" ]]; then
        if [[ -z "$ORIG_UID" && -n "$ORIG_OWNER" ]]; then
            user_exists_cached "$ORIG_OWNER" && ORIG_UID="${USER_UID_CACHE[$ORIG_OWNER]:-}"
            if [[ "$meta_exists" == true ]]; then
                ORIGIN_HAS_LEGACY_KEYS=true
                ORIGIN_LEGACY_REASONS+=("ORIG_UID_mancante")
            fi
        fi
        if [[ -z "$ORIG_GID" && -n "$ORIG_GROUP" ]]; then
            if group_exists_cached "$ORIG_GROUP"; then
                ORIG_GID="${GROUP_GID_CACHE[$ORIG_GROUP]:-}"
            elif [[ -n "$ORIG_OWNER" ]] && user_exists_cached "$ORIG_OWNER"; then
                ORIG_GID=$(id -g "$ORIG_OWNER" 2>/dev/null || true)
            fi
            if [[ "$meta_exists" == true ]]; then
                ORIGIN_HAS_LEGACY_KEYS=true
                ORIGIN_LEGACY_REASONS+=("ORIG_GID_mancante")
            fi
        fi
    fi

    if [[ "$nas_exists" == true ]]; then
        ORIG_MTIME="${NAS_MTIME[$nas_file]:-0}"
        ORIG_MTIME_HUMAN="${NAS_MTIME_HUMAN[$nas_file]:-}"
    else
        ORIG_MTIME="0"
        ORIG_MTIME_HUMAN=""
    fi

    if [[ "$nas_file" != *.bak && "$meta_exists" == true && "$nas_t" == "f" && "$ENC_MODE" == "none" && "$ORIG_TYPE" == "file" ]]; then
        local current_nas_size="${NAS_SIZE[$nas_file]:-0}"
        if [[ -z "$ORIG_SIZE" ]]; then
            ORIGIN_HAS_LEGACY_KEYS=true
            ORIGIN_LEGACY_REASONS+=("ORIG_SIZE_mancante(type=file)")
        fi
        local meta_mtime="${NAS_MTIME[$meta_file]:-0}"
        if [[ -n "$ORIG_SIZE" && "$current_nas_size" != "$ORIG_SIZE" ]]; then
            NAS_MODIFIED_OUT_OF_BAND=true
            NAS_OOB_REASONS+=("size_mismatch(nas=$current_nas_size!=orig=$ORIG_SIZE)")
        elif (( ORIG_MTIME != meta_mtime )); then
            local actual_sha=""
            calc_target_sha256_into actual_sha "$nas_file"
            if [[ -n "$ORIG_SHA256" && "$actual_sha" != "$ORIG_SHA256" ]]; then
                NAS_MODIFIED_OUT_OF_BAND=true
                NAS_OOB_REASONS+=("mtime_and_sha_mismatch(nas_mtime=$ORIG_MTIME!=meta_mtime=$meta_mtime)")
            fi
        fi
    fi
    return 0
}

get_true_nas_sha256_from_loaded_into() {
    local __out_var="$1" __nas_file="$2"
    local __meta_file="${__nas_file}.origin.txt" __payload_file=""
    resolve_bak_payload_into __payload_file "$__nas_file"

    if [[ "$__nas_file" == *.enc || "$__payload_file" == *.enc || "$ENC_MODE" != "none" ]]; then
        printf -v "$__out_var" '%s' "$ORIG_SHA256"
    elif [[ "$ORIG_TYPE" == "symlink" && -n "$ORIG_SYMLINK_TARGET" ]]; then
        symlink_sha256_into "$__out_var" "$ORIG_SYMLINK_TARGET"
    elif [[ "$__nas_file" != *.bak && "$ORIG_TYPE" == "file" && "$NAS_MODIFIED_OUT_OF_BAND" == false && -n "$ORIG_SHA256" && -n "$ORIG_SIZE" && "${NAS_SIZE[$__nas_file]:-}" == "$ORIG_SIZE" && "${NAS_MTIME[$__meta_file]:-x}" == "$ORIG_MTIME" ]]; then
        printf -v "$__out_var" '%s' "$ORIG_SHA256"
    elif [[ "$__nas_file" == *.bak && -n "$ORIG_SHA256" ]]; then
        printf -v "$__out_var" '%s' "$ORIG_SHA256"
    elif [[ "$__nas_file" == *.bak ]] && inspect_bak_placeholder_cached "$__nas_file" && [[ -n "${BAK_SHA_CACHE[$__nas_file]:-}" ]]; then
        printf -v "$__out_var" '%s' "${BAK_SHA_CACHE[$__nas_file]}"
    else
        calc_target_sha256_into "$__out_var" "$__payload_file"
    fi
    return 0
}

get_true_nas_sha256_into() {
    load_origin_metadata "$2"
    get_true_nas_sha256_from_loaded_into "$1" "$2"
    return 0
}

sanitize_origin_file_on_nas() {
    local nas_file="$1" meta_file="${1}.origin.txt"
    nas_is_regular_file "$meta_file" || return 0
    nas_path_exists_or_link "$nas_file" || return 0

    load_origin_metadata "$nas_file"
    local real_sha="$ORIG_SHA256"
    if [[ "$ENC_MODE" == "none" ]]; then
        if [[ "$ORIG_TYPE" == "symlink" && -n "$ORIG_SYMLINK_TARGET" ]]; then
            symlink_sha256_into real_sha "$ORIG_SYMLINK_TARGET"
        else
            calc_target_sha256_into real_sha "$nas_file"
        fi
    fi

    local consumers="" effective_updater="${ORIG_LAST_UPDATED_BY:-${ORIG_SHARED_SOURCE:-$ACTIVE_ALIAS}}"
    get_placeholder_consumers_into consumers "$ORIG_PATH" "$ORIG_SHARED_SOURCE"
    local d_szh="$ORIG_SIZE_HUMAN" d_szb="$ORIG_SIZE_BYTES" d_sub="$ORIG_SUBDIRS" d_fil="$ORIG_FILES" d_slk="$ORIG_SYMLINKS"
    if [[ "$ORIG_TYPE" == "directory" && -d "$nas_file" ]]; then
        calc_dir_stats "$nas_file"
        d_szh="$DIR_SIZE_HUMAN" d_szb="$DIR_SIZE_BYTES" d_sub="$DIR_SUBDIRS" d_fil="$DIR_FILES" d_slk="$DIR_SYMLINKS"
    fi

    local out=""
    format_origin_payload out "$ORIG_PATH" "$ORIG_NAME" "$ORIG_TYPE" "$ORIG_SYMLINK_TARGET" \
        "${ORIG_MODE:-0644}" "${ORIG_UID:-0}" "${ORIG_OWNER:-root}" "${ORIG_GID:-0}" "${ORIG_GROUP:-root}" \
        "${NAS_SIZE[$nas_file]:-0}" "$real_sha" "${ENC_MODE:-none}" "$ORIG_MK_FP" \
        "${ORIG_SHARED_SOURCE:-$ACTIVE_ALIAS}" "${consumers:-none}" "$effective_updater" \
        "$d_szh" "$d_szb" "$d_sub" "$d_fil" "$d_slk"
    write_origin_file_content "$meta_file" "$nas_file" "$out"
    return 0
}

# Pre-indicizza tutti i delta NAS, scopre nuovi file in cartelle tracciate, e fa prefetch locale batch
prefetch_active_profile_state() {
    index_all_nas_deltas

    local local_paths=()
    local nas_oob_candidates=()
    local tracked_roots=()
    local dir_meta nas_dir loc_dir mirror_file rel_mirror rel_clean source_file ph_file

    # 1. Directory tracciate + individuazione radici top-level non cifrate
    local candidate_dirs=()
    for dir_meta in "${DELTA_ORIGIN_FILES[@]}"; do
        nas_dir="${dir_meta%.origin.txt}"
        [[ "${NAS_TYPE[$nas_dir]:-}" == "d" ]] || continue
        candidate_dirs+=("$nas_dir")
        load_origin_metadata "$nas_dir"
        loc_dir="${ORIG_PATH:-/${nas_dir#$RESOLVED_DELTA_DIR/}}"
        local_paths+=("$loc_dir")
    done

    local d_prev="" d_cur
    for d_cur in "${candidate_dirs[@]}"; do
        if [[ -z "$d_prev" || "$d_cur" != "$d_prev/"* ]]; then
            tracked_roots+=("$d_cur")
            d_prev="$d_cur"
        fi
    done

    for nas_dir in "${tracked_roots[@]}"; do
        load_origin_metadata "$nas_dir"
        loc_dir="${ORIG_PATH:-/${nas_dir#$RESOLVED_DELTA_DIR/}}"
        [[ "$loc_dir" == "$RESOLVED_LINUX_ROOT" || "$loc_dir" == "$RESOLVED_LINUX_ROOT/"* ]] && continue
        if [[ -d "$loc_dir" && ! -L "$loc_dir" ]]; then
            local loc_sub sub_rel nas_sub
            while IFS= read -r -d '' loc_sub; do
                sub_rel="${loc_sub#$loc_dir/}"
                nas_sub="$nas_dir/$sub_rel"
                if [[ -z "${NAS_TYPE[$nas_sub]:-}" || "${NAS_TYPE[$nas_sub]}" == "missing" ]]; then
                    DELTA_NEW_DIR_LOCAL_ITEMS+=("$loc_sub")
                    DELTA_NEW_DIR_NAS_ITEMS["$loc_sub"]="$nas_sub"
                    local_paths+=("$loc_sub")
                fi
            done < <(LC_ALL=C find "$loc_dir" -mindepth 1 \( -type f -o -type d -o -type l \) -print0 2>/dev/null || true)
        fi
    done

    # 2. File reali nel delta attivo
    for mirror_file in "${DELTA_REAL_ITEMS[@]}"; do
        local mf="${mirror_file}.origin.txt"
        if [[ "${NAS_TYPE[$mirror_file]:-}" == "f" && "${NAS_TYPE[$mf]:-}" == "f" ]]; then
            [[ "${NAS_MTIME[$mirror_file]:-0}" != "${NAS_MTIME[$mf]:-1}" ]] && nas_oob_candidates+=("$mirror_file")
        elif [[ "${NAS_TYPE[$mirror_file]:-}" == "f" && "$mirror_file" != *.enc ]]; then
            nas_oob_candidates+=("$mirror_file")
        fi
    done

    # 3. Placeholder .shared nel delta attivo (singolo passaggio)
    local -a resolved_shared_sources=()
    for ph_file in "${DELTA_SHARED_FILES[@]}"; do
        load_shared_placeholder "$ph_file" || continue
        [[ -n "$PH_ORIG_PATH" ]] && local_paths+=("$PH_ORIG_PATH")
        if [[ -n "$PH_RESOLVED_SOURCE_FILE" && "${NAS_TYPE[$PH_RESOLVED_SOURCE_FILE]:-}" == "f" ]]; then
            resolved_shared_sources+=("$PH_RESOLVED_SOURCE_FILE")
            local smf="${PH_RESOLVED_SOURCE_FILE}.origin.txt"
            if [[ "${NAS_TYPE[$smf]:-}" == "f" ]]; then
                [[ "${NAS_MTIME[$PH_RESOLVED_SOURCE_FILE]:-0}" != "${NAS_MTIME[$smf]:-1}" ]] && nas_oob_candidates+=("$PH_RESOLVED_SOURCE_FILE")
            elif [[ "$PH_RESOLVED_SOURCE_FILE" != *.enc ]]; then
                nas_oob_candidates+=("$PH_RESOLVED_SOURCE_FILE")
            fi
        fi
    done

    (( ${#nas_oob_candidates[@]} > 0 )) && batch_sha256_files "${nas_oob_candidates[@]}"

    local legacy_missing_sha=()
    for mirror_file in "${DELTA_REAL_ITEMS[@]}"; do
        load_origin_metadata "$mirror_file"
        rel_mirror="${mirror_file#$RESOLVED_DELTA_DIR/}"
        strip_nas_rel_into rel_clean "$rel_mirror"
        source_file="${ORIG_PATH:-/$rel_clean}"
        local_paths+=("$source_file")
        if [[ "${NAS_TYPE[$mirror_file]:-}" == "f" && "$ENC_MODE" == "none" && ( -z "$ORIG_SHA256" || -z "$ORIG_SIZE" || "$NAS_MODIFIED_OUT_OF_BAND" == true ) ]]; then
            legacy_missing_sha+=("$mirror_file")
        fi
    done

    local src_f
    for src_f in "${resolved_shared_sources[@]}"; do
        load_origin_metadata "$src_f"
        if [[ "$ENC_MODE" == "none" && ( -z "$ORIG_SHA256" || -z "$ORIG_SIZE" || "$NAS_MODIFIED_OUT_OF_BAND" == true ) ]]; then
            legacy_missing_sha+=("$src_f")
        fi
    done

    if (( ${#legacy_missing_sha[@]} > 0 )); then
        batch_sha256_files "${legacy_missing_sha[@]}"
    fi
    if (( ${#local_paths[@]} > 0 )); then
        prefetch_local_paths_metadata true "${local_paths[@]}"
    fi
    PREFETCH_DONE=true
    return 0
}

# ==============================================================================
# LIVELLO 5: CRITTOGRAFIA ASIMMETRICA CONDIVISA (Linux/shared/master_key)
# ==============================================================================
get_master_key_fp() {
    [[ -r "$MASTER_KEY_FILE" ]] || return 1
    local line
    while IFS= read -r line; do
        line="${line%$'\r'}"
        if [[ "$line" == "# MASTER_KEY_FP="* ]]; then
            printf '%s\n' "${line#\# MASTER_KEY_FP=}"
            return 0
        fi
    done < "$MASTER_KEY_FILE"
    return 1
}

extract_master_pub() {
    sed -n '/-----BEGIN PUBLIC KEY-----/,/-----END PUBLIC KEY-----/p' "$MASTER_KEY_FILE" > "$1"
    [[ -s "$1" ]]
}

extract_master_priv() {
    sed -n '/-----BEGIN ENCRYPTED PRIVATE KEY-----/,/-----END ENCRYPTED PRIVATE KEY-----/p' "$MASTER_KEY_FILE" > "$1"
    [[ -s "$1" ]]
}

init_master_key() {
    acquire_nas_lock
    echo -e "${C_CYAN}[*]${C_RESET} Inizializzazione master_key asimmetrica condivisa (RSA-4096 + AES-256-CBC) in $MASTER_KEY_FILE."
    if [[ -f "$MASTER_KEY_FILE" ]]; then
        echo -e "${C_YELLOW}[!]${C_RESET} Esiste già una master_key in $MASTER_KEY_FILE."
        confirm_double_or_exit "Vuoi sovrascriverla? (I vecchi file cifrati non saranno più decifrabili)" "Sovrascrivere irreversibilmente la master_key condivisa sul NAS?"
    fi

    local init_pass="" init_pass_conf=""
    read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Inserisci la password segreta per proteggere la master_key: ")" init_pass </dev/tty
    echo
    read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Conferma la password: ")" init_pass_conf </dev/tty
    echo
    touch_lock_heartbeat

    if [[ -z "$init_pass" || "$init_pass" != "$init_pass_conf" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: le password non coincidono o sono vuote." >&2
        exit 1
    fi

    echo -e "${C_CYAN}[*]${C_RESET} Generazione coppia di chiavi RSA-4096 in corso..."
    umask 0077
    get_work_tmp_dir
    local priv_tmp="$WORK_TMP_DIR/init_priv.pem" pub_tmp="$WORK_TMP_DIR/init_pub.pem"

    NC_PASS="$init_pass" openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 \
        -aes-256-cbc -pass env:NC_PASS -out "$priv_tmp" 2>/dev/null
    NC_PASS="$init_pass" openssl pkey -in "$priv_tmp" -passin env:NC_PASS -pubout -out "$pub_tmp" 2>/dev/null

    local fp_line=""
    IFS= read -r fp_line < <(openssl pkey -pubin -in "$pub_tmp" -outform DER 2>/dev/null | sha256sum)
    local fp="${fp_line:0:64}" created_str
    printf -v created_str '%(%Y-%m-%d %H:%M:%S)T' -1

    local mk_dir
    path_dirname_into mk_dir "$MASTER_KEY_FILE"
    [[ -d "$mk_dir" ]] || mkdir -p "$mk_dir"
    {
        printf '# NC-NAS-CONF ASYMMETRIC SHARED MASTER KEY\n'
        printf '# MASTER_KEY_FP=%s\n' "$fp"
        printf '# CREATED=%s\n' "$created_str"
        cat "$pub_tmp" "$priv_tmp"
    } > "$MASTER_KEY_FILE"
    chmod 600 "$MASTER_KEY_FILE"
    rm -f "$priv_tmp" "$pub_tmp"
    echo -e "${C_GREEN}[+]${C_RESET} master_key inizializzata con successo (Fingerprint: ${fp:0:16}...)"
    exit 0
}

encrypt_payload() {
    local in_file="$1" out_file="$2" mode="$3" custom_pass="${4:-}"
    umask 0077
    get_work_tmp_dir
    local tmp_out="${out_file}.tmp.$$"
    NAS_TMP_FILES["$tmp_out"]=1

    if [[ "$mode" == "master_key" ]]; then
        local pub_tmp="$WORK_TMP_DIR/enc_pub.pem"
        local sess_key_bin="$WORK_TMP_DIR/enc_sess.bin"
        local enc_key_bin="$WORK_TMP_DIR/enc_sess.enc"
        local enc_body="$WORK_TMP_DIR/enc_body.enc"

        if ! extract_master_pub "$pub_tmp"; then
            echo -e "${C_RED}[-]${C_RESET} Errore: master_key non valida o assente ($MASTER_KEY_FILE)." >&2
            echo -e "${C_MUTED}    Esegui 'nc-hanoi --init' per inizializzarla.${C_RESET}" >&2
            exit 1
        fi

        local sess_pass
        sess_pass=$(openssl rand -hex 32)
        printf "%s" "$sess_pass" > "$sess_key_bin"

        openssl pkeyutl -encrypt -pubin -inkey "$pub_tmp" \
            -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 \
            -in "$sess_key_bin" -out "$enc_key_bin"

        NC_PASS="$sess_pass" openssl enc -aes-256-cbc -salt -pbkdf2 \
            -in "$in_file" -out "$enc_body" -pass env:NC_PASS

        {
            printf "%s" "$MAGIC_HEADER"
            cat "$enc_key_bin" "$enc_body"
        } > "$tmp_out"

        rm -f "$pub_tmp" "$sess_key_bin" "$enc_key_bin" "$enc_body"
    else
        NC_PASS="$custom_pass" openssl enc -aes-256-cbc -salt -pbkdf2 \
            -in "$in_file" -out "$tmp_out" -pass env:NC_PASS
    fi
    mv -f "$tmp_out" "$out_file"
    unset 'NAS_TMP_FILES[$tmp_out]'
    invalidate_nas_cache "$out_file"
    NAS_STATE_MUTATED=true
    return 0
}

decrypt_payload() {
    local in_file="$1" out_file="$2" expected_fp="${3:-}"
    if [[ ! -r "$in_file" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: impossibile leggere il file cifrato '$in_file'." >&2
        exit 1
    fi
    umask 0077
    get_work_tmp_dir
    local header=""
    header=$(head -c 8 "$in_file" 2>/dev/null || true)

    if [[ "$header" == "$MAGIC_HEADER" ]]; then
        if [[ ! -f "$MASTER_KEY_FILE" ]]; then
            logger -t nc-nas-conf -p user.err "ERRORE CRITICO RESTORE: master_key assente sul NAS per $in_file"
            echo -e "${C_RED}[-]${C_RESET} ERRORE CRITICO: master_key non trovata sul NAS ($MASTER_KEY_FILE)." >&2
            exit 1
        fi

        local current_fp
        current_fp=$(get_master_key_fp || true)
        if [[ -n "$expected_fp" && "$current_fp" != "$expected_fp" ]]; then
            logger -t nc-nas-conf -p user.err "ALLERTA SICUREZZA RESTORE: master_key attuale ($current_fp) diversa da originale ($expected_fp)"
            echo -e "${C_RED}[-]${C_RESET} ALLERTA SICUREZZA: La master_key sul NAS non corrisponde a quella con cui è stato cifrato il file!" >&2
            exit 1
        fi

        local priv_tmp="$WORK_TMP_DIR/dec_priv.pem"
        if ! extract_master_priv "$priv_tmp"; then
            echo -e "${C_RED}[-]${C_RESET} Errore: Chiave privata assente in $MASTER_KEY_FILE." >&2
            exit 1
        fi

        local mk_pass=""
        read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Inserisci la password segreta della master_key per decifrare: ")" mk_pass </dev/tty
        echo
        touch_lock_heartbeat
        if [[ -z "$mk_pass" ]]; then
            rm -f "$priv_tmp"
            echo -e "${C_RED}[-]${C_RESET} Errore: La password è obbligatoria per decifrare." >&2
            exit 1
        fi

        local enc_key_bin="$WORK_TMP_DIR/dec_sess.enc"
        local dec_key_bin="$WORK_TMP_DIR/dec_sess.bin"
        dd if="$in_file" bs=512 iflag=skip_bytes,count_bytes skip=8 count=512 of="$enc_key_bin" 2>/dev/null

        if ! NC_PASS="$mk_pass" openssl pkeyutl -decrypt -inkey "$priv_tmp" -passin env:NC_PASS \
            -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 \
            -in "$enc_key_bin" -out "$dec_key_bin" 2>/dev/null; then
            echo -e "${C_RED}[-]${C_RESET} ERRORE CRITICO: Password della master_key errata!" >&2
            rm -f "$priv_tmp" "$enc_key_bin" "$dec_key_bin"
            exit 1
        fi

        local sess_pass=""
        read_file_raw_into sess_pass "$dec_key_bin"
        while [[ "$sess_pass" == *$'\n' || "$sess_pass" == *$'\r' ]]; do
            sess_pass="${sess_pass%$'\n'}"; sess_pass="${sess_pass%$'\r'}"
        done
        rm -f "$priv_tmp" "$enc_key_bin" "$dec_key_bin"

        if ! tail -c +521 "$in_file" | NC_PASS="$sess_pass" openssl enc -d -aes-256-cbc -pbkdf2 \
            -out "$out_file" -pass env:NC_PASS 2>/dev/null; then
            echo -e "${C_RED}[-]${C_RESET} ERRORE CRITICO: Payload cifrato corrotto!" >&2
            rm -f "$out_file"
            exit 1
        fi
    else
        local file_pass=""
        read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Inserisci la password di decifratura del file: ")" file_pass </dev/tty
        echo
        touch_lock_heartbeat
        if [[ -z "$file_pass" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Errore: Password vuota non ammessa." >&2
            exit 1
        fi

        if ! NC_PASS="$file_pass" openssl enc -d -aes-256-cbc -pbkdf2 \
            -in "$in_file" -out "$out_file" -pass env:NC_PASS 2>/dev/null; then
            echo -e "${C_RED}[-]${C_RESET} ERRORE CRITICO: Password errata o file corrotto!" >&2
            rm -f "$out_file"
            exit 1
        fi
    fi
    return 0
}

# ==============================================================================
# LIVELLO 6: STORICIZZAZIONE HANOI E GESTIONE PLACEHOLDER TRA DELTA
# ==============================================================================
read_origin_sha_enc_fast() {
    local meta_f="$1"
    FAST_ORIG_SHA=""
    FAST_ORIG_ENC="none"
    nas_is_regular_file "$meta_f" || return 0
    if [[ -n "${ORIG_MEMO_READY[$meta_f]:-}" ]]; then
        FAST_ORIG_SHA="${ORIG_MEMO_SHA[$meta_f]}"
        FAST_ORIG_ENC="${ORIG_MEMO_ENC[$meta_f]}"
        return 0
    fi
    local raw_m="" rem line
    read_sidecar_raw_cached raw_m "$meta_f" "origin"
    rem="$raw_m"
    while [[ -n "$rem" ]]; do
        if [[ "$rem" == *$'\n'* ]]; then
            line="${rem%%$'\n'*}"; rem="${rem#*$'\n'}"
        else
            line="$rem"; rem=""
        fi
        line="${line%$'\r'}"
        case "$line" in
            ORIG_SHA256=*) FAST_ORIG_SHA="${line#ORIG_SHA256=}" ;;
            ENC_MODE=*)    FAST_ORIG_ENC="${line#ENC_MODE=}" ;;
        esac
    done
    return 0
}

archive_single_file_to_hist_dedup() {
    local src_payload="$1" h_dir="$2" bak_filename="$3" cand_sha="$4" cand_enc_mode="${5:-none}"
    [[ -d "$h_dir" ]] || mkdir -p "$h_dir"
    local dst_bak="$h_dir/$bak_filename"

    [[ -z "$cand_sha" ]] && calc_target_sha256_into cand_sha "$src_payload"

    local matched_ref=""
    if [[ -n "$cand_sha" ]]; then
        local nullglob_was_set=false
        shopt -q nullglob && nullglob_was_set=true
        shopt -s nullglob
        local existing_baks=("$h_dir"/*.bak)
        [[ "$nullglob_was_set" == false ]] && shopt -u nullglob

        (( ${#existing_baks[@]} > 1 )) && sort_null_array existing_baks

        local existing_bak ex_sha ex_enc
        for existing_bak in "${existing_baks[@]}"; do
            [[ "$existing_bak" == "$dst_bak" || ! -f "$existing_bak" ]] && continue
            inspect_bak_placeholder_cached "$existing_bak" && continue

            read_origin_sha_enc_fast "${existing_bak}.origin.txt"
            ex_sha="$FAST_ORIG_SHA"
            ex_enc="$FAST_ORIG_ENC"
            [[ -z "$ex_sha" && "$ex_enc" == "none" ]] && calc_target_sha256_into ex_sha "$existing_bak"

            # SHA-256 già verificato su 256 bit: evita cmp -s byte-per-byte via SMB
            if [[ "$cand_sha" == "$ex_sha" && "$cand_enc_mode" == "$ex_enc" ]]; then
                path_basename_into matched_ref "$existing_bak"
                break
            fi
        done
    fi

    if [[ -n "$matched_ref" ]]; then
        printf '# NC-NAS-CONF BACKUP PLACEHOLDER\nREF_BAK=%s\nREF_SHA256=%s\n' "$matched_ref" "$cand_sha" > "$dst_bak"
        touch -r "$src_payload" "$dst_bak" 2>/dev/null || true
        invalidate_nas_cache "$dst_bak"
        BAK_IS_PH_CACHE["$dst_bak"]="1"
        BAK_REF_CACHE["$dst_bak"]="$matched_ref"
        BAK_SHA_CACHE["$dst_bak"]="$cand_sha"
    else
        cp -p "$src_payload" "$dst_bak" 2>/dev/null || cp -f "$src_payload" "$dst_bak"
        invalidate_nas_cache "$dst_bak"
        BAK_IS_PH_CACHE["$dst_bak"]="0"
    fi
    NAS_STATE_MUTATED=true
    return 0
}

archive_delta_item_to_bak() {
    local item_in_delta="$1" sys_delta_dir="$2" sys_bak_dir="$3" ts="$4" is_deletion="${5:-false}"
    [[ -e "$item_in_delta" || -L "$item_in_delta" ]] || return 0
    [[ "$item_in_delta" == *.shared ]] && return 0

    local rel_item="${item_in_delta#$sys_delta_dir/}" suffix=".bak"
    [[ "$is_deletion" == true ]] && suffix="_d.bak"

    if [[ -d "$item_in_delta" && ! -L "$item_in_delta" ]]; then
        local subf sub_rel h_dir
        while IFS= read -r -d '' subf; do
            sub_rel="${subf#$sys_delta_dir/}"
            h_dir="$sys_bak_dir/${sub_rel}.hist"
            read_origin_sha_enc_fast "${subf}.origin.txt"
            archive_single_file_to_hist_dedup "$subf" "$h_dir" "${ts}${suffix}" "$FAST_ORIG_SHA" "$FAST_ORIG_ENC"
            if [[ -f "${subf}.origin.txt" ]]; then
                cp -p "${subf}.origin.txt" "$h_dir/${ts}${suffix}.origin.txt" 2>/dev/null || cp -f "${subf}.origin.txt" "$h_dir/${ts}${suffix}.origin.txt"
                invalidate_nas_cache "$h_dir/${ts}${suffix}.origin.txt"
            fi
        done < <(find "$item_in_delta" -type f ! -name "*.origin.txt" ! -name "*.shared" -print0)
    else
        local h_dir="$sys_bak_dir/${rel_item}.hist"
        read_origin_sha_enc_fast "${item_in_delta}.origin.txt"
        archive_single_file_to_hist_dedup "$item_in_delta" "$h_dir" "${ts}${suffix}" "$FAST_ORIG_SHA" "$FAST_ORIG_ENC"
        if [[ -f "${item_in_delta}.origin.txt" ]]; then
            if [[ "$is_deletion" == true ]]; then
                mv -f "${item_in_delta}.origin.txt" "$h_dir/${ts}${suffix}.origin.txt"
                invalidate_nas_cache "${item_in_delta}.origin.txt"
            else
                cp -p "${item_in_delta}.origin.txt" "$h_dir/${ts}${suffix}.origin.txt" 2>/dev/null || cp -f "${item_in_delta}.origin.txt" "$h_dir/${ts}${suffix}.origin.txt"
            fi
            invalidate_nas_cache "$h_dir/${ts}${suffix}.origin.txt"
        fi
    fi
    return 0
}

archive_local_item_to_bak() {
    local local_item="$1" nas_mirror_item="$2" sys_delta_dir="$3" sys_bak_dir="$4" ts="$5" source_owner_alias="${6:-$ACTIVE_ALIAS}"
    [[ -e "$local_item" || -L "$local_item" ]] || return 0

    load_origin_metadata "$nas_mirror_item"
    local enc_mode="${ENC_MODE:-none}" mk_fp="${ORIG_MK_FP:-}"
    local rel_item="${nas_mirror_item#$sys_delta_dir/}"

    if [[ -d "$local_item" && ! -L "$local_item" && "$nas_mirror_item" != *.tar.gz.enc ]]; then
        local sub_files=() subf
        while IFS= read -r -d '' subf; do sub_files+=("$subf"); done < <(find "$local_item" -type f -print0)
        (( ${#sub_files[@]} > 0 )) && prefetch_local_paths_metadata true "${sub_files[@]}"

        local sub_rel h_dir s_sha
        for subf in "${sub_files[@]}"; do
            sub_rel="${subf#$local_item/}"
            h_dir="$sys_bak_dir/${rel_item}/${sub_rel}.hist"
            calc_target_sha256_into s_sha "$subf"
            archive_single_file_to_hist_dedup "$subf" "$h_dir" "${ts}.bak" "$s_sha" "none"
            save_origin_metadata "$subf" "$h_dir/${ts}.bak.origin.txt" "none" "" "$source_owner_alias" "$s_sha" "$ACTIVE_ALIAS"
        done
    else
        ensure_local_stat "$local_item" || true
        local h_dir="$sys_bak_dir/${rel_item}.hist" loc_sha="" loc_mtime="${LOC_MTIME[$local_item]:-}"
        calc_target_sha256_into loc_sha "$local_item"
        [[ -z "$loc_mtime" ]] && now_epoch_into loc_mtime
        get_work_tmp_dir

        if [[ "$nas_mirror_item" == *.enc && "$enc_mode" == "master_key" ]]; then
            local tmp_enc="$WORK_TMP_DIR/loc_bak.enc"
            if [[ -d "$local_item" && ! -L "$local_item" ]]; then
                local fname ldir tar_temp
                path_basename_into fname "$local_item"
                path_dirname_into ldir "$local_item"
                tar_temp="$WORK_TMP_DIR/${fname}.tar.gz"
                tar -czf "$tar_temp" --numeric-owner -p -C "$ldir" "$fname"
                encrypt_payload "$tar_temp" "$tmp_enc" "master_key" ""
                rm -f "$tar_temp"
            else
                encrypt_payload "$local_item" "$tmp_enc" "master_key" ""
            fi
            touch -d "@$loc_mtime" "$tmp_enc" 2>/dev/null || true
            archive_single_file_to_hist_dedup "$tmp_enc" "$h_dir" "${ts}.bak" "$loc_sha" "master_key"
            rm -f "$tmp_enc"
            save_origin_metadata "$local_item" "$h_dir/${ts}.bak.origin.txt" "master_key" "$mk_fp" "$source_owner_alias" "$loc_sha" "$ACTIVE_ALIAS"
        elif [[ -L "$local_item" ]]; then
            local tmp_sym="$WORK_TMP_DIR/sym_bak"
            printf '# NC-NAS-CONF SYMLINK PLACEHOLDER\nSYMLINK_TARGET=%s\n' "${LOC_LINK[$local_item]:-$(readlink -- "$local_item" 2>/dev/null || true)}" > "$tmp_sym"
            touch -d "@$loc_mtime" "$tmp_sym" 2>/dev/null || true
            archive_single_file_to_hist_dedup "$tmp_sym" "$h_dir" "${ts}.bak" "$loc_sha" "none"
            rm -f "$tmp_sym"
            save_origin_metadata "$local_item" "$h_dir/${ts}.bak.origin.txt" "none" "" "$source_owner_alias" "$loc_sha" "$ACTIVE_ALIAS"
        elif [[ -f "$local_item" ]]; then
            archive_single_file_to_hist_dedup "$local_item" "$h_dir" "${ts}.bak" "$loc_sha" "none"
            save_origin_metadata "$local_item" "$h_dir/${ts}.bak.origin.txt" "none" "" "$source_owner_alias" "$loc_sha" "$ACTIVE_ALIAS"
        fi
    fi
    return 0
}

apply_placeholders_for_source_item() {
    local source_alias="$1" source_delta_item="$2" target_spec="$3" ts="$4"
    local source_delta="${SYS_DELTA_MAP[$source_alias]}"
    local source_rel_item="${source_delta_item#$source_delta/}" rel_clean
    strip_nas_rel_into rel_clean "$source_rel_item"
    local orig_abs_path="/$rel_clean"

    local -A wanted_targets=()
    if [[ "$target_spec" == "all" ]]; then
        local a
        for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
            [[ "$a" != "$source_alias" ]] && wanted_targets["$a"]=1
        done
    elif [[ "$target_spec" != "local" && "$target_spec" != "none" && -n "$target_spec" ]]; then
        local IFS=',' t
        for t in $target_spec; do
            t="${t,,}"; t="${t//[^a-z0-9_-]/}"
            [[ -z "$t" || "$t" == "$source_alias" ]] && continue
            if [[ -z "${SYS_DELTA_MAP[$t]:-}" ]]; then
                echo -e "${C_YELLOW}[!]${C_RESET} Attenzione: sistema '$t' non trovato sul NAS (ignorato)." >&2
                continue
            fi
            wanted_targets["$t"]=1
        done
    fi

    local created_list=() removed_list=() a t_delta t_bak ph_path cand ph_dir
    for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        [[ "$a" == "$source_alias" ]] && continue
        t_delta="${SYS_DELTA_MAP[$a]}"
        t_bak="$LINUX_ROOT/${SYS_FOLDER_MAP[$a]}/$BACKUP_DIR_NAME"
        ph_path="$t_delta/${rel_clean}.shared"

        if [[ -n "${wanted_targets[$a]:-}" ]]; then
            for cand in "$t_delta/$rel_clean" "$t_delta/${rel_clean}.enc" "$t_delta/${rel_clean}.tar.gz.enc"; do
                if nas_path_exists_or_link "$cand"; then
                    archive_delta_item_to_bak "$cand" "$t_delta" "$t_bak" "$ts" false
                    rm -rf "$cand" "${cand}.origin.txt"
                    invalidate_nas_cache "$cand"
                    invalidate_nas_cache "${cand}.origin.txt"
                fi
            done
            write_shared_placeholder "$a" "$orig_abs_path" "$source_alias" "$source_rel_item"
            created_list+=("$a")
        else
            if nas_is_regular_file "$ph_path"; then
                load_shared_placeholder "$ph_path" || true
                if [[ -z "$PH_SHARED_SOURCE" || "$PH_SHARED_SOURCE" == "$source_alias" ]]; then
                    if confirm_double "Il nodo '$a' non è più nei target. Rimuovere il placeholder da '$a'?" "Confermi la rimozione di ${rel_clean}.shared dal delta di '$a'?"; then
                        rm -f "$ph_path"
                        invalidate_nas_cache "$ph_path"
                        CONSUMERS_INDEX_READY=false
                        NAS_STATE_MUTATED=true
                        path_dirname_into ph_dir "$ph_path"
                        rmdir --ignore-fail-on-non-empty -p "$ph_dir" 2>/dev/null || true
                        [[ -d "$t_delta" ]] || mkdir -p "$t_delta"
                        removed_list+=("$a")
                    fi
                fi
            fi
        fi
    done

    sanitize_origin_file_on_nas "$source_delta_item"

    if (( ${#created_list[@]} > 0 )); then
        local c_joined; printf -v c_joined '%s,' "${created_list[@]}"
        echo -e "    ${C_MUTED}-> Placeholder .shared impostati in: ${c_joined%,} (sorgente: $source_alias)${C_RESET}"
    fi
    if (( ${#removed_list[@]} > 0 )); then
        local r_joined; printf -v r_joined '%s,' "${removed_list[@]}"
        echo -e "    ${C_MUTED}-> Placeholder .shared rimossi da: ${r_joined%,}${C_RESET}"
    fi
    return 0
}

remove_all_placeholders_for_item() {
    local rel_clean="" source_alias="${2:-$ACTIVE_ALIAS}"
    strip_nas_rel_into rel_clean "$1"
    local a t_delta ph_path
    for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
        [[ "$a" == "$source_alias" ]] && continue
        t_delta="${SYS_DELTA_MAP[$a]:-}"
        ph_path="$t_delta/${rel_clean}.shared"
        if nas_is_regular_file "$ph_path"; then
            rm -f "$ph_path"
            invalidate_nas_cache "$ph_path"
            CONSUMERS_INDEX_READY=false
            NAS_STATE_MUTATED=true
            echo -e "    ${C_MUTED}-> Rimosso placeholder orfano da '$a': ${rel_clean}.shared${C_RESET}"
        fi
    done
    return 0
}

# ==============================================================================
# LIVELLO 7: MOTORE DI CONFRONTO UNIFICATO & OPERAZIONI CORE
# ==============================================================================
eval_queue_item() {
    EVAL_ITEM_ACTIONS+=("$1")
    EVAL_ITEM_NAS+=("$2")
    EVAL_ITEM_LOC+=("$3")
    EVAL_ITEM_OWNERS+=("$4")
    EVAL_ITEM_DELTAS+=("$5")
    EVAL_ITEM_BAKS+=("$6")
    EVAL_ITEM_NOTES+=("$7")
    return 0
}

eval_queue_row() {
    EVAL_ROW_STAT_COL+=("$1")
    EVAL_ROW_STAT_STR+=("$2")
    EVAL_ROW_ROLE_COL+=("$3")
    EVAL_ROW_ROLE_STR+=("$4")
    EVAL_ROW_SH_STR+=("$5")
    EVAL_ROW_PATH_STR+=("$6")
    return 0
}

# Valuta il drift di tutti gli elementi tracciati/condivisi una sola volta in RAM
evaluate_profile_drift() {
    [[ "$PREFETCH_DONE" == true ]] || prefetch_active_profile_state

    EVAL_PUSH_TOTAL=0 EVAL_PUSH_SHARED=0 EVAL_PULL_TOTAL=0
    EVAL_CONFLICT_COUNT=0 EVAL_NON_CONFLICT_WORK=0
    EVAL_DIR_ACTIONS=() EVAL_DIR_NAS=() EVAL_DIR_LOC=()
    EVAL_ITEM_ACTIONS=() EVAL_ITEM_NAS=() EVAL_ITEM_LOC=()
    EVAL_ITEM_OWNERS=() EVAL_ITEM_DELTAS=() EVAL_ITEM_BAKS=() EVAL_ITEM_NOTES=()
    EVAL_ROW_STAT_COL=() EVAL_ROW_STAT_STR=() EVAL_ROW_ROLE_COL=() EVAL_ROW_ROLE_STR=()
    EVAL_ROW_SH_STR=() EVAL_ROW_PATH_STR=()

    local dir_meta nas_dir local_dir mirror_file mirror_meta rel_mirror rel_clean source_file
    local consumers sh_col shared_note sec_tag role_str

    # A. Directory tracciate
    for dir_meta in "${DELTA_ORIGIN_FILES[@]}"; do
        nas_dir="${dir_meta%.origin.txt}"
        [[ "${NAS_TYPE[$nas_dir]:-}" == "d" ]] || continue
        load_origin_metadata "$nas_dir"
        local_dir="${ORIG_PATH:-/${nas_dir#$RESOLVED_DELTA_DIR/}}"
        [[ "$local_dir" == "$RESOLVED_LINUX_ROOT" || "$local_dir" == "$RESOLVED_LINUX_ROOT/"* ]] && continue

        if [[ "$REVERSE_SYNC" == false ]]; then
            if [[ "${LOC_EXISTS[$local_dir]:-0}" == "1" && "${LOC_TYPE[$local_dir]:-}" == "d" ]]; then
                if [[ "$ORIG_MODE" != "${LOC_MODE[$local_dir]:-0755}" || "$ORIG_OWNER" != "${LOC_OWNER[$local_dir]:-root}" || "$ORIG_GROUP" != "${LOC_GROUP[$local_dir]:-root}" || "$ORIG_UID" != "${LOC_UID[$local_dir]:-0}" || "$ORIG_GID" != "${LOC_GID[$local_dir]:-0}" ]]; then
                    EVAL_DIR_ACTIONS+=("SYNC_DIR_PERM"); EVAL_DIR_NAS+=("$nas_dir"); EVAL_DIR_LOC+=("$local_dir")
                    EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                    EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
                    eval_queue_row "$C_CYAN" "[~] PERM CARTELLA" "" "SORGENTE ($ACTIVE_ALIAS)" "-" "${local_dir}/"
                elif [[ "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
                    EVAL_DIR_ACTIONS+=("HEAL_DIR_META"); EVAL_DIR_NAS+=("$nas_dir"); EVAL_DIR_LOC+=("$local_dir")
                fi
            fi
        else
            if [[ "${LOC_EXISTS[$local_dir]:-0}" != "1" || "${LOC_TYPE[$local_dir]:-}" != "d" ]]; then
                EVAL_DIR_ACTIONS+=("REV_DIR_CREATE"); EVAL_DIR_NAS+=("$nas_dir"); EVAL_DIR_LOC+=("$local_dir")
                EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                eval_queue_row "$C_CYAN" "[↓] CREA CARTELLA" "" "SORGENTE ($ACTIVE_ALIAS)" "-" "${local_dir}/"
            elif [[ -n "$ORIG_MODE" && ( "$ORIG_MODE" != "${LOC_MODE[$local_dir]:-0755}" || "$ORIG_OWNER" != "${LOC_OWNER[$local_dir]:-root}" || "$ORIG_GROUP" != "${LOC_GROUP[$local_dir]:-root}" ) ]]; then
                EVAL_DIR_ACTIONS+=("REV_DIR_PERM"); EVAL_DIR_NAS+=("$nas_dir"); EVAL_DIR_LOC+=("$local_dir")
                EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                eval_queue_row "$C_CYAN" "[~] PERM CARTELLA" "" "SORGENTE ($ACTIVE_ALIAS)" "-" "${local_dir}/"
            fi
        fi
    done

    # A2. Nuovi file/symlink/cartelle creati localmente dentro cartelle tracciate in chiaro
    if [[ "$REVERSE_SYNC" == false ]] && (( ${#DELTA_NEW_DIR_LOCAL_ITEMS[@]} > 0 )); then
        local new_loc new_nas
        for new_loc in "${DELTA_NEW_DIR_LOCAL_ITEMS[@]}"; do
            [[ "$new_loc" == "$RESOLVED_LINUX_ROOT" || "$new_loc" == "$RESOLVED_LINUX_ROOT/"* ]] && continue
            [[ "${LOC_EXISTS[$new_loc]:-0}" == "1" ]] || continue
            new_nas="${DELTA_NEW_DIR_NAS_ITEMS[$new_loc]}"
            EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
            EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
            eval_queue_item "PUSH_NEW_IN_DIR" "$new_nas" "$new_loc" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" ""
            eval_queue_row "$C_YELLOW" "[↑] DA SALVARE" "" "SORGENTE ($ACTIVE_ALIAS)" "-" "$new_loc"
        done
    fi

    # B. File reali e symlink nel delta attivo
    for mirror_file in "${DELTA_REAL_ITEMS[@]}"; do
        mirror_meta="${mirror_file}.origin.txt"
        load_origin_metadata "$mirror_file"
        rel_mirror="${mirror_file#$RESOLVED_DELTA_DIR/}"
        strip_nas_rel_into rel_clean "$rel_mirror"
        source_file="${ORIG_PATH:-/$rel_clean}"
        [[ "$source_file" == "$RESOLVED_LINUX_ROOT" || "$source_file" == "$RESOLVED_LINUX_ROOT/"* ]] && continue

        get_placeholder_consumers_into consumers "$rel_clean" "$ACTIVE_ALIAS"
        sh_col="${consumers:--}"
        shared_note=""
        [[ -n "$consumers" ]] && shared_note=" ${C_MUTED}[sorgente per: $consumers]${C_RESET}"
        sec_tag=""
        [[ "$ENC_MODE" != "none" ]] && sec_tag=" [SEC]"
        role_str="SORGENTE ($ACTIVE_ALIAS)"

        local is_sh=false
        [[ -n "$consumers" ]] && is_sh=true

        if [[ "$REVERSE_SYNC" == false ]]; then
            if [[ "${LOC_EXISTS[$source_file]:-0}" == "1" ]]; then
                local sha_loc="" sha_nas=""
                calc_target_sha256_into sha_loc "$source_file"
                get_true_nas_sha256_from_loaded_into sha_nas "$mirror_file"

                local local_mtime="${LOC_MTIME[$source_file]:-0}" local_mode="${LOC_MODE[$source_file]:-0644}"
                local local_uid="${LOC_UID[$source_file]:-0}" local_owner="${LOC_OWNER[$source_file]:-root}"
                local local_gid="${LOC_GID[$source_file]:-0}" local_group="${LOC_GROUP[$source_file]:-root}"
                local local_size="0" nas_mtime="${ORIG_MTIME:-0}"
                [[ "${LOC_TYPE[$source_file]:-}" == "f" ]] && local_size="${LOC_SIZE[$source_file]:-0}"

                if [[ -n "$sha_loc" && "$sha_loc" == "$sha_nas" ]]; then
                    if [[ "$ORIG_MODE" != "$local_mode" || "$ORIG_OWNER" != "$local_owner" || "$ORIG_GROUP" != "$local_group" ]]; then
                        eval_queue_item "SYNC_PERM_ORIGIN" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
                        [[ "$is_sh" == true ]] && EVAL_PUSH_SHARED=$(( EVAL_PUSH_SHARED + 1 ))
                        eval_queue_row "$C_CYAN" "[~] PERM/ORIGIN" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    elif [[ "${NAS_TYPE[$mirror_meta]:-missing}" != "f" || "$ORIGIN_HAS_LEGACY_KEYS" == true || "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIG_UID" != "$local_uid" || "$ORIG_GID" != "$local_gid" || "$ORIG_SHA256" != "$sha_loc" || "$ORIG_SHARED_TARGETS" != "${consumers:-none}" || "$ORIG_SHARED_SOURCE" != "$ACTIVE_ALIAS" || ( "$ORIG_TYPE" == "file" && "$ORIG_SIZE" != "$local_size" ) || "$nas_mtime" -ne "$local_mtime" ]]; then
                        eval_queue_item "HEAL_ORIGIN_SILENT" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                        [[ "${MODE:-}" == "list" ]] && eval_queue_row "$C_CYAN" "[~] PERM/ORIGIN" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    else
                        [[ "${MODE:-}" == "list" ]] && eval_queue_row "$C_GREEN" "[=] ALLINEATO" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    fi
                else
                    if (( nas_mtime > local_mtime )) || [[ "$NAS_MODIFIED_OUT_OF_BAND" == true && "$sha_loc" == "$ORIG_SHA256" ]]; then
                        if [[ -n "$ORIG_LAST_UPDATED_BY" && "$ORIG_LAST_UPDATED_BY" != "$ACTIVE_ALIAS" && "$NAS_MODIFIED_OUT_OF_BAND" == false ]]; then
                            eval_queue_item "SKIP_PEER_UPDATED" "$mirror_file" "$source_file" "$ORIG_LAST_UPDATED_BY" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                            EVAL_PULL_TOTAL=$(( EVAL_PULL_TOTAL + 1 ))
                            eval_queue_row "$C_CYAN" "[↓] AGG. DA ${ORIG_LAST_UPDATED_BY}" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                        else
                            local t_gap=$(( nas_mtime - local_mtime )) d_str=""
                            (( t_gap < 0 )) && t_gap=$(( -t_gap ))
                            format_time_delta_into d_str "$t_gap"
                            EVAL_CONFLICT_COUNT=$(( EVAL_CONFLICT_COUNT + 1 ))
                            EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
                            [[ "$is_sh" == true ]] && EVAL_PUSH_SHARED=$(( EVAL_PUSH_SHARED + 1 ))
                            eval_queue_item "CONFLICT_SYNC" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                            local p_disp="${source_file}${sec_tag}"
                            [[ "${MODE:-}" != "list" ]] && p_disp+=" ${C_MUTED}(NAS +${d_str})${C_RESET}"
                            eval_queue_row "$C_RED" "[!] CONFLITTO NAS+" "" "$role_str" "$sh_col" "$p_disp"
                        fi
                    else
                        eval_queue_item "PUSH_ITEM" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
                        [[ "$is_sh" == true ]] && EVAL_PUSH_SHARED=$(( EVAL_PUSH_SHARED + 1 ))
                        eval_queue_row "$C_YELLOW" "[↑] DA SALVARE" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    fi
                fi
            else
                eval_queue_item "DELETE_FROM_NAS" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$consumers"
                EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
                [[ "$is_sh" == true ]] && EVAL_PUSH_SHARED=$(( EVAL_PUSH_SHARED + 1 ))
                eval_queue_row "$C_RED" "[✕] ELIM. LOCALE" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
            fi
        else
            if [[ "${LOC_EXISTS[$source_file]:-0}" != "1" ]]; then
                eval_queue_item "PULL_INSTALL" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                eval_queue_row "$C_CYAN" "[↓] DA INSTALLARE" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
            else
                local sha_loc="" sha_nas=""
                calc_target_sha256_into sha_loc "$source_file"
                get_true_nas_sha256_from_loaded_into sha_nas "$mirror_file"
                local local_mtime="${LOC_MTIME[$source_file]:-0}" local_mode="${LOC_MODE[$source_file]:-0644}"
                local local_owner="${LOC_OWNER[$source_file]:-root}" local_group="${LOC_GROUP[$source_file]:-root}"
                local nas_mtime="${ORIG_MTIME:-0}"

                if [[ -n "$sha_nas" && "$sha_loc" == "$sha_nas" ]]; then
                    if [[ -n "$ORIG_MODE" && ( "$ORIG_MODE" != "$local_mode" || "$ORIG_OWNER" != "$local_owner" || "$ORIG_GROUP" != "$local_group" ) ]]; then
                        eval_queue_item "REV_FILE_PERM" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        eval_queue_row "$C_CYAN" "[~] PERM LOCALI" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    elif [[ -n "$nas_mtime" && "$nas_mtime" =~ ^[0-9]+$ && "$local_mtime" -ne "$nas_mtime" ]]; then
                        eval_queue_item "REV_TOUCH_SILENT" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$nas_mtime"
                    fi
                else
                    if (( local_mtime > nas_mtime )); then
                        local t_gap=$(( local_mtime - nas_mtime )) d_str=""
                        format_time_delta_into d_str "$t_gap"
                        if [[ "$REVERSE_FORCED" == true ]]; then
                            EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                            eval_queue_item "PULL_FORCE_OVERWRITE" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                            eval_queue_row "$C_RED" "[⇊] FORZA SU LOC+" "" "$role_str" "$sh_col" "${source_file}${sec_tag} ${C_MUTED}(LOC +${d_str})${C_RESET}"
                        else
                            EVAL_CONFLICT_COUNT=$(( EVAL_CONFLICT_COUNT + 1 ))
                            eval_queue_item "CONFLICT_REVERSE" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                            eval_queue_row "$C_RED" "[!] CONFLITTO LOC+" "" "$role_str" "$sh_col" "${source_file}${sec_tag} ${C_MUTED}(LOC +${d_str})${C_RESET}"
                        fi
                    else
                        eval_queue_item "PULL_UPDATE" "$mirror_file" "$source_file" "$ACTIVE_ALIAS" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        eval_queue_row "$C_YELLOW" "[↓] DA AGGIORNARE" "" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    fi
                fi
            fi
        fi
    done

    # C. Placeholder .shared nel delta attivo
    local ph_file all_peers owner_delta owner_bak
    for ph_file in "${DELTA_SHARED_FILES[@]}"; do
        load_shared_placeholder "$ph_file" || continue
        normalize_local_rel_into rel_clean "$PH_ORIG_PATH"
        get_placeholder_consumers_into all_peers "$rel_clean" "$PH_SHARED_SOURCE"
        sh_col="${all_peers:-$ACTIVE_ALIAS}"
        role_str="SHARED <- $PH_SHARED_SOURCE"
        shared_note=" ${C_MUTED}[shared <- $PH_SHARED_SOURCE]${C_RESET}"

        if [[ -z "$PH_RESOLVED_SOURCE_FILE" ]]; then
            eval_queue_row "$C_RED" "[!] SORG. ASSENTE" "$C_MUTED" "$role_str" "$sh_col" "$PH_ORIG_PATH"
            continue
        fi

        mirror_file="$PH_RESOLVED_SOURCE_FILE"
        source_file="$PH_ORIG_PATH"
        [[ "$source_file" == "$RESOLVED_LINUX_ROOT" || "$source_file" == "$RESOLVED_LINUX_ROOT/"* ]] && continue

        owner_delta="${SYS_DELTA_MAP[$PH_SHARED_SOURCE]:-$RESOLVED_DELTA_DIR}"
        owner_bak="$LINUX_ROOT/${SYS_FOLDER_MAP[$PH_SHARED_SOURCE]:-$ACTIVE_FOLDER}/$BACKUP_DIR_NAME"
        load_origin_metadata "$mirror_file"
        sec_tag=""
        [[ "$ENC_MODE" != "none" ]] && sec_tag=" [SEC]"

        if [[ "$REVERSE_SYNC" == false ]]; then
            if [[ "${LOC_EXISTS[$source_file]:-0}" != "1" ]]; then
                eval_queue_item "SKIP_SHARED_MISSING_LOC" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                EVAL_PULL_TOTAL=$(( EVAL_PULL_TOTAL + 1 ))
                local st_lbl="[↓] MANCA IN LOCALE"
                [[ "${MODE:-}" == "list" ]] && st_lbl="[↓] DA INSTALLARE"
                eval_queue_row "$C_CYAN" "$st_lbl" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
            else
                local sha_loc="" sha_nas=""
                calc_target_sha256_into sha_loc "$source_file"
                get_true_nas_sha256_from_loaded_into sha_nas "$mirror_file"
                local local_mtime="${LOC_MTIME[$source_file]:-0}" nas_mtime="${ORIG_MTIME:-0}"

                if [[ -n "$sha_nas" && "$sha_loc" != "$sha_nas" ]]; then
                    if (( local_mtime > nas_mtime )); then
                        eval_queue_item "PUSH_ITEM" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        EVAL_PUSH_TOTAL=$(( EVAL_PUSH_TOTAL + 1 ))
                        EVAL_PUSH_SHARED=$(( EVAL_PUSH_SHARED + 1 ))
                        eval_queue_row "$C_YELLOW" "[↑] DA SALVARE" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    else
                        if [[ -n "$ORIG_LAST_UPDATED_BY" && "$ORIG_LAST_UPDATED_BY" != "$ACTIVE_ALIAS" && "$NAS_MODIFIED_OUT_OF_BAND" == false ]]; then
                            eval_queue_item "SKIP_PEER_UPDATED" "$mirror_file" "$source_file" "$ORIG_LAST_UPDATED_BY" "$owner_delta" "$owner_bak" "$shared_note"
                            EVAL_PULL_TOTAL=$(( EVAL_PULL_TOTAL + 1 ))
                            local st_lbl="[↓] AGG. DA ${ORIG_LAST_UPDATED_BY}"
                            [[ "${MODE:-}" == "list" ]] && st_lbl="[↓] DA AGGIORNARE"
                            eval_queue_row "$C_CYAN" "$st_lbl" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                        else
                            local t_gap=$(( nas_mtime - local_mtime )) d_str=""
                            (( t_gap < 0 )) && t_gap=$(( -t_gap ))
                            format_time_delta_into d_str "$t_gap"
                            EVAL_CONFLICT_COUNT=$(( EVAL_CONFLICT_COUNT + 1 ))
                            EVAL_PULL_TOTAL=$(( EVAL_PULL_TOTAL + 1 ))
                            eval_queue_item "CONFLICT_SYNC" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                            local p_disp="${source_file}${sec_tag}"
                            [[ "${MODE:-}" != "list" ]] && p_disp+=" ${C_MUTED}(NAS +${d_str})${C_RESET}"
                            eval_queue_row "$C_RED" "[!] CONFLITTO NAS+" "$C_MUTED" "$role_str" "$sh_col" "$p_disp"
                        fi
                    fi
                elif [[ "${MODE:-}" == "list" ]]; then
                    eval_queue_row "$C_GREEN" "[=] ALLINEATO" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                fi
            fi
        else
            if [[ "${LOC_EXISTS[$source_file]:-0}" != "1" ]]; then
                eval_queue_item "PULL_INSTALL" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                eval_queue_row "$C_CYAN" "[↓] DA INSTALLARE" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
            else
                local sha_loc="" sha_nas=""
                calc_target_sha256_into sha_loc "$source_file"
                get_true_nas_sha256_from_loaded_into sha_nas "$mirror_file"
                local local_mtime="${LOC_MTIME[$source_file]:-0}" local_mode="${LOC_MODE[$source_file]:-0644}"
                local local_owner="${LOC_OWNER[$source_file]:-root}" local_group="${LOC_GROUP[$source_file]:-root}"
                local nas_mtime="${ORIG_MTIME:-0}"

                if [[ -n "$sha_nas" && "$sha_loc" == "$sha_nas" ]]; then
                    if [[ -n "$ORIG_MODE" && ( "$ORIG_MODE" != "$local_mode" || "$ORIG_OWNER" != "$local_owner" || "$ORIG_GROUP" != "$local_group" ) ]]; then
                        eval_queue_item "REV_FILE_PERM" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        eval_queue_row "$C_CYAN" "[~] PERM LOCALI" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    elif [[ -n "$nas_mtime" && "$nas_mtime" =~ ^[0-9]+$ && "$local_mtime" -ne "$nas_mtime" ]]; then
                        eval_queue_item "REV_TOUCH_SILENT" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$nas_mtime"
                    fi
                else
                    if (( local_mtime > nas_mtime )); then
                        local t_gap=$(( local_mtime - nas_mtime )) d_str=""
                        format_time_delta_into d_str "$t_gap"
                        if [[ "$REVERSE_FORCED" == true ]]; then
                            EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                            eval_queue_item "PULL_FORCE_OVERWRITE" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                            eval_queue_row "$C_RED" "[⇊] FORZA SU LOC+" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag} ${C_MUTED}(LOC +${d_str})${C_RESET}"
                        else
                            EVAL_CONFLICT_COUNT=$(( EVAL_CONFLICT_COUNT + 1 ))
                            eval_queue_item "CONFLICT_REVERSE" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                            eval_queue_row "$C_RED" "[!] CONFLITTO LOC+" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag} ${C_MUTED}(LOC +${d_str})${C_RESET}"
                        fi
                    else
                        eval_queue_item "PULL_UPDATE" "$mirror_file" "$source_file" "$PH_SHARED_SOURCE" "$owner_delta" "$owner_bak" "$shared_note"
                        EVAL_NON_CONFLICT_WORK=$(( EVAL_NON_CONFLICT_WORK + 1 ))
                        eval_queue_row "$C_YELLOW" "[↓] DA AGGIORNARE" "$C_MUTED" "$role_str" "$sh_col" "${source_file}${sec_tag}"
                    fi
                fi
            fi
        fi
    done
    return 0
}

prompt_conflict_diff_and_choice() {
    local context_label="$1" local_file="$2" nas_file="$3" local_mtime="$4"
    local nas_mtime="$5" nas_mtime_human="$6" enc_mode="$7" oob_flag="$8" shared_note="${9:-}"

    CONFLICT_CHOICE="SKIP"
    local time_gap=$(( local_mtime - nas_mtime ))
    (( time_gap < 0 )) && time_gap=$(( -time_gap ))
    local delta_str local_mtime_human payload_nas
    format_time_delta_into delta_str "$time_gap"
    printf -v local_mtime_human '%(%Y-%m-%d %H:%M:%S)T' "$local_mtime" 2>/dev/null || local_mtime_human="$local_mtime"
    resolve_bak_payload_into payload_nas "$nas_file"

    echo -e "\n${C_YELLOW}[!]${C_RESET} Conflitto di versione (${context_label}) per: ${C_BOLD}${local_file}${C_RESET}${shared_note}"
    if (( nas_mtime > local_mtime )); then
        if [[ "$oob_flag" == true ]]; then
            echo -e "${C_RED}    [!!] ATTENZIONE: IL FILE SUL NAS È STATO MODIFICATO DIRETTAMENTE (PIÙ RECENTE DI ${delta_str})!${C_RESET}"
        else
            echo -e "${C_RED}    [!!] ATTENZIONE: IL FILE SUL NAS È PIÙ RECENTE DEL LOCALE DI ${delta_str}!${C_RESET}"
        fi
    elif (( local_mtime > nas_mtime )); then
        echo -e "${C_RED}    [!!] ATTENZIONE: IL FILE LOCALE È PIÙ RECENTE DEL NAS DI ${delta_str}!${C_RESET}"
    fi

    echo -e "    Ultima modifica LOCALE [-]: ${C_MUTED}${local_mtime_human}${C_RESET}"
    echo -e "    Ultima modifica NAS    [+]: ${C_MUTED}${nas_mtime_human}${C_RESET}"
    if [[ -f "$local_file" && -f "$payload_nas" && "$enc_mode" == "none" && "$payload_nas" != *.enc && ! -L "$local_file" && ! -L "$payload_nas" ]]; then
        echo -e "    Variazione contenuto      : $(get_diff_summary "$local_file" "$payload_nas")"
    fi

    echo -e "    Opzioni iniziali:"
    echo -e "      [s / INVIO] Salta questo file               ${C_MUTED}(Non sovrascrivere nulla ora) [Predefinita]${C_RESET}"
    echo -e "      [d]         Mostra le differenze (Diff)     ${C_MUTED}(Esamina le modifiche per scegliere quale copia tenere)${C_RESET}"

    while true; do
        read_single_key "${C_CYAN}[?]${C_RESET} Scegli opzione [INVIO/s=Salta | d=Mostra differenze]: "
        case "${REPLY_KEY,,}" in
            ""|s|n|q) CONFLICT_CHOICE="SKIP"; return 0 ;;
            d) break ;;
            *) echo -e "${C_YELLOW}[!]${C_RESET} Premi INVIO/s per saltare oppure 'd' per esaminare le differenze." ;;
        esac
    done

    if [[ -L "$local_file" || -L "$payload_nas" || "$ORIG_TYPE" == "symlink" ]]; then
        echo -e "\n${C_SLATE}==============================================================================${C_RESET}"
        echo -e " ${C_BOLD}CONFRONTO SYMLINK:${C_RESET} $local_file"
        echo -e " ${C_RED}- Target LOCALE : $(readlink "$local_file" 2>/dev/null || echo 'N/A')${C_RESET}"
        echo -e " ${C_GREEN}+ Target NAS    : ${ORIG_SYMLINK_TARGET:-$(readlink "$payload_nas" 2>/dev/null || echo 'N/A')}${C_RESET}"
        echo -e "${C_SLATE}==============================================================================${C_RESET}\n"
    elif [[ -d "$local_file" || -d "$payload_nas" || "$ORIG_TYPE" == "directory" ]]; then
        echo -e "\n${C_SLATE}==============================================================================${C_RESET}"
        echo -e " ${C_BOLD}CONFRONTO CARTELLA:${C_RESET} $local_file"
        if [[ -d "$local_file" ]]; then
            calc_dir_stats "$local_file"
            echo -e " ${C_RED}- Struttura LOCALE : $DIR_SIZE_HUMAN ($DIR_FILES file, $DIR_SUBDIRS sottocartelle)${C_RESET}"
        fi
        echo -e " ${C_GREEN}+ Struttura NAS    : ${ORIG_SIZE_HUMAN:-?} (${ORIG_FILES:-?} file, ${ORIG_SUBDIRS:-?} sottocartelle)${C_RESET}"
        echo -e "${C_SLATE}==============================================================================${C_RESET}\n"
    elif [[ "$enc_mode" != "none" || "$payload_nas" == *.enc ]]; then
        echo -e "${C_CYAN}[*]${C_RESET} Decifrazione temporanea del file NAS per mostrare il diff..."
        get_work_tmp_dir
        local tmp_dec="$WORK_TMP_DIR/conf_diff.dec"
        decrypt_payload "$payload_nas" "$tmp_dec" "$ORIG_MK_FP"
        render_full_diff "$local_file" "$tmp_dec" "$local_file"
        rm -f "$tmp_dec"
    else
        render_full_diff "$local_file" "$payload_nas" "$local_file"
    fi

    while true; do
        echo -e "    Quale versione vuoi mantenere per ${C_BOLD}${local_file}${C_RESET}?"
        echo -e "      ${C_RED}[1] Mantieni la copia LOCALE [-]${C_RESET} ${C_MUTED}(Sovrascrive il NAS; la copia NAS scartata viene salvata nei backup)${C_RESET}"
        echo -e "      ${C_GREEN}[2] Mantieni la copia del NAS [+]${C_RESET} ${C_MUTED}(Sovrascrive il locale; la copia locale scartata viene salvata nei backup)${C_RESET}"
        echo -e "      [3 / INVIO] Salta                 ${C_MUTED}(Lascia invariati sia il file locale sia il NAS)${C_RESET}"

        read_single_key "${C_CYAN}[?]${C_RESET} Scegli quale versione tenere [${C_RED}1=LOCALE${C_RESET} | ${C_GREEN}2=NAS${C_RESET} | 3/INVIO=Salta]: "
        local confirm_word=""
        case "${REPLY_KEY,,}" in
            1)
                read -r -p "$(echo -e "${C_RED}[!!] CONFERMA SOVRASCRITTURA NAS:${C_RESET} Digita '${C_BOLD}LOCAL${C_RESET}' e premi INVIO per mantenere la copia locale: ")" confirm_word </dev/tty
                touch_lock_heartbeat
                if [[ "$confirm_word" == "LOCAL" ]]; then CONFLICT_CHOICE="LOCAL"; return 0; fi
                echo -e "${C_YELLOW}[!]${C_RESET} Parola di conferma non valida (richiesto 'LOCAL'). Ritorno al menu di scelta."
                ;;
            2)
                read -r -p "$(echo -e "${C_GREEN}[!!] CONFERMA SOVRASCRITTURA LOCALE:${C_RESET} Digita '${C_BOLD}NAS${C_RESET}' e premi INVIO per mantenere la copia del NAS: ")" confirm_word </dev/tty
                touch_lock_heartbeat
                if [[ "$confirm_word" == "NAS" ]]; then CONFLICT_CHOICE="NAS"; return 0; fi
                echo -e "${C_YELLOW}[!]${C_RESET} Parola di conferma non valida (richiesto 'NAS'). Ritorno al menu di scelta."
                ;;
            ""|3|s|q) CONFLICT_CHOICE="SKIP"; return 0 ;;
            *) echo -e "${C_YELLOW}[!]${C_RESET} Tasto non valido. Premi 1, 2 oppure 3/INVIO." ;;
        esac
    done
    return 0
}

# Sync incrementale directory non cifrata Locale -> NAS (evita rm -rf + ricopia integrale)
sync_dir_incremental_to_nas() {
    local src_dir="$1" dst_dir="$2" ts="$3" sys_delta="$4" sys_bak="$5"
    mkdir -p "$dst_dir"

    local -A src_rel_type=()
    local src_files=() rp yt lnk
    while IFS= read -r -d '' rp && IFS= read -r -d '' yt && IFS= read -r -d '' lnk; do
        [[ -z "$rp" ]] && continue
        rp="${rp#./}"
        src_rel_type["$rp"]="$yt"
        [[ "$yt" == "f" ]] && src_files+=("$src_dir/$rp")
    done < <(LC_ALL=C find "$src_dir/" -mindepth 1 -printf './%P\0%y\0%l\0' 2>/dev/null || true)

    (( ${#src_files[@]} > 0 )) && prefetch_local_paths_metadata true "${src_files[@]}"

    # Rimuovi dal NAS gli elementi cancellati localmente
    local nas_existing=() np nr
    while IFS= read -r -d '' np; do
        nas_existing+=("$np")
    done < <(LC_ALL=C find "$dst_dir" -mindepth 1 ! -name "*.origin.txt" ! -name "*.shared" -depth -print0 2>/dev/null || true)

    for np in "${nas_existing[@]}"; do
        nr="${np#$dst_dir/}"
        if [[ -z "${src_rel_type[$nr]:-}" ]]; then
            if [[ -d "$np" && ! -L "$np" ]]; then
                rm -f "${np}.origin.txt"
                rmdir "$np" 2>/dev/null || true
            else
                archive_delta_item_to_bak "$np" "$sys_delta" "$sys_bak" "$ts" true
                rm -f "$np" "${np}.origin.txt"
            fi
            invalidate_nas_cache "$np"
        fi
    done

    # Crea/aggiorna file, dir e symlink modificati o nuovi
    local s_item d_item l_sha n_sha
    for rp in "${!src_rel_type[@]}"; do
        s_item="$src_dir/$rp"
        d_item="$dst_dir/$rp"
        yt="${src_rel_type[$rp]}"
        if [[ "$yt" == "d" ]]; then
            if [[ -e "$d_item" && ! -d "$d_item" ]]; then
                rm -rf "$d_item" "${d_item}.origin.txt"
            fi
            [[ -d "$d_item" ]] || mkdir -p "$d_item"
        elif [[ "$yt" == "l" ]]; then
            [[ -d "$d_item" ]] && rm -rf "$d_item"
            printf '# NC-NAS-CONF SYMLINK PLACEHOLDER\nSYMLINK_TARGET=%s\n' "$(readlink -- "$s_item" 2>/dev/null || true)" > "$d_item"
            invalidate_nas_cache "$d_item"
        else
            [[ -d "$d_item" ]] && rm -rf "$d_item"
            ensure_local_stat "$s_item" || true
            l_sha="${SHA256_CACHE[$s_item]:-}"
            [[ -z "$l_sha" ]] && calc_target_sha256_into l_sha "$s_item"
            n_sha=""
            if [[ -f "$d_item" ]]; then
                calc_target_sha256_into n_sha "$d_item"
            fi
            if [[ "$l_sha" != "$n_sha" || ! -f "$d_item" ]]; then
                atomic_copy_to_nas "$s_item" "$d_item" "${LOC_MTIME[$s_item]:-}"
            elif [[ "${LOC_MTIME[$s_item]:-0}" != "${NAS_MTIME[$d_item]:-0}" ]]; then
                touch -d "@${LOC_MTIME[$s_item]}" "$d_item" 2>/dev/null || true
                invalidate_nas_cache "$d_item"
            fi
        fi
    done
    invalidate_nas_cache "$dst_dir"
    NAS_STATE_MUTATED=true
    return 0
}

write_symlink_mirror() {
    local src_link="$1" mirror_file="$2" local_mtime="$3"
    local lnk_target="${LOC_LINK[$src_link]:-$(readlink -- "$src_link" 2>/dev/null || true)}"
    rm -rf "$mirror_file"
    printf '# NC-NAS-CONF SYMLINK PLACEHOLDER\nSYMLINK_TARGET=%s\n' "$lnk_target" > "$mirror_file"
    touch -d "@$local_mtime" "$mirror_file" 2>/dev/null || true
    invalidate_nas_cache "$mirror_file"
    NAS_STATE_MUTATED=true
    return 0
}

run_add_mode() {
    if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: Nessun file o cartella specificata da aggiungere." >&2
        exit 1
    fi

    acquire_nas_lock
    index_all_nas_deltas

    local ts; now_ts_into ts
    local target_dir="$RESOLVED_DELTA_DIR" is_custom_dir=false

    if [[ -n "$CUSTOM_DIR" && "$CUSTOM_DIR" != "/" ]]; then
        local clean_custom="${CUSTOM_DIR#/}" resolved_target
        resolved_target=$(realpath -s -m "$RESOLVED_BASE_DIR/$clean_custom")
        if [[ "$resolved_target" != "$RESOLVED_BASE_DIR/"* ]]; then
            logger -t nc-nas-conf -p user.err "TENTATIVO DI VIOLAZIONE: Path traversal intercettato con -D $CUSTOM_DIR"
            echo -e "${C_RED}[-]${C_RESET} ERRORE DI SICUREZZA: Percorso esterno non consentito: $CUSTOM_DIR" >&2
            exit 1
        fi
        if [[ "$resolved_target" == "$RESOLVED_DELTA_DIR" || "$resolved_target" == "$RESOLVED_DELTA_DIR/"* ]]; then
            echo -e "${C_RED}[-]${C_RESET} ERRORE: Non è consentito usare -D puntando a 'delta'." >&2
            exit 1
        fi
        target_dir="$resolved_target"; is_custom_dir=true
    elif [[ "$CUSTOM_DIR" == "/" ]]; then
        target_dir="$RESOLVED_BASE_DIR"; is_custom_dir=true
    fi

    [[ -d "$target_dir" ]] || mkdir -p "$target_dir"

    local encrypt_pass="" enc_mode_used="none" mk_fp_used=""
    if [[ "$SECURE_ENCRYPT" == true ]]; then
        if [[ "${NC_AUTO_MASTER_KEY:-0}" != "1" ]]; then
            read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Password dedicata di cifratura (INVIO = usa chiave pubblica master_key): ")" encrypt_pass </dev/tty
            echo
            touch_lock_heartbeat
        fi
        if [[ -z "$encrypt_pass" ]]; then
            if [[ ! -f "$MASTER_KEY_FILE" ]] || ! grep -q "BEGIN PUBLIC KEY" "$MASTER_KEY_FILE" 2>/dev/null; then
                echo -e "${C_RED}[-]${C_RESET} Errore: master_key non trovata ($MASTER_KEY_FILE). Esegui 'sudo ${0##*/} --init'." >&2
                exit 1
            fi
            enc_mode_used="master_key"
            mk_fp_used=$(get_master_key_fp)
            echo -e "${C_CYAN}[*]${C_RESET} Cifratura asimmetrica con master_key condivisa."
        else
            local encrypt_pass_conf=""
            read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Conferma la password dedicata: ")" encrypt_pass_conf </dev/tty
            echo
            touch_lock_heartbeat
            if [[ "$encrypt_pass" != "$encrypt_pass_conf" ]]; then
                echo -e "${C_RED}[-]${C_RESET} Errore: le password non coincidono." >&2
                exit 1
            fi
            enc_mode_used="custom_password"
        fi
    fi

    local resolved_args=() arg abs_p
    for arg in "${POSITIONAL_ARGS[@]}"; do
        abs_p=$(realpath -s -m "$arg")
        resolved_args+=("$abs_p")
    done
    prefetch_local_paths_metadata true "${resolved_args[@]}"

    local abs_path filename rel_path dest_parent
    for abs_path in "${resolved_args[@]}"; do
        if [[ "${LOC_EXISTS[$abs_path]:-0}" != "1" ]]; then
            echo -e "${C_YELLOW}[!]${C_RESET} Elemento non trovato, ignorato: $abs_path" >&2
            continue
        fi
        if [[ "$abs_path" == "$RESOLVED_LINUX_ROOT" || "$abs_path" == "$RESOLVED_LINUX_ROOT/"* ]]; then
            echo -e "${C_YELLOW}[!]${C_RESET} Impossibile aggiungere un elemento già residente sul NAS ($abs_path)." >&2
            continue
        fi

        path_basename_into filename "$abs_path"
        rel_path="${abs_path#/}"

        if [[ "$is_custom_dir" == false ]]; then
            local existing_owner
            existing_owner=$(find_existing_source_owner "$rel_path")
            if [[ -n "$existing_owner" && "$existing_owner" != "$ACTIVE_ALIAS" ]]; then
                echo -e "${C_RED}[-]${C_RESET} BLOCCO: '$abs_path' è un file condiviso la cui sorgente è '${C_BOLD}$existing_owner${C_RESET}'." >&2
                echo -e "    ${C_MUTED}Aggiornalo con '-s', oppure trasferisci la sorgente con: nc-hanoi -S ${ACTIVE_ALIAS}:... $abs_path${C_RESET}" >&2
                continue
            fi
        fi

        if [[ "${LOC_TYPE[$abs_path]:-}" == "d" ]]; then
            calc_dir_stats "$abs_path"
            echo -e "${C_YELLOW}[!]${C_RESET} Stai per salvare sul NAS un'intera CARTELLA:"
            echo -e "    Percorso origine : $abs_path"
            echo -e "    Dimensione tot   : ${C_MUTED}$DIR_SIZE_HUMAN ($DIR_SIZE_BYTES byte)${C_RESET}"
            echo -e "    Struttura        : ${C_MUTED}$DIR_SUBDIRS sottocartelle, $DIR_FILES file, $DIR_SYMLINKS symlink${C_RESET}"
            if [[ "${NC_AUTO_CONFIRM_ADD:-0}" != "1" ]]; then
                confirm_double "Confermi il salvataggio dell'intera cartella?" "Avviare la copia ricorsiva della cartella '$abs_path' sul NAS?" || continue
            fi
        fi

        local dest_base=""
        if [[ "$is_custom_dir" == true ]]; then
            dest_base="$target_dir/$filename"
        else
            dest_base="$RESOLVED_DELTA_DIR/$rel_path"
            path_dirname_into dest_parent "$dest_base"
            [[ -d "$dest_parent" ]] || mkdir -p "$dest_parent"
        fi

        local target_file="$dest_base"
        if [[ "$SECURE_ENCRYPT" == true ]]; then
            [[ "${LOC_TYPE[$abs_path]:-}" == "d" ]] && target_file="${dest_base}.tar.gz.enc" || target_file="${dest_base}.enc"
        fi

        local existing_nas_item="" cand
        for cand in "$dest_base" "${dest_base}.enc" "${dest_base}.tar.gz.enc"; do
            if nas_path_exists_or_link "$cand"; then existing_nas_item="$cand"; break; fi
        done

        local local_sha="" local_mtime="${LOC_MTIME[$abs_path]:-}"
        calc_target_sha256_into local_sha "$abs_path"
        [[ -z "$local_mtime" ]] && now_epoch_into local_mtime

        if [[ -n "$existing_nas_item" ]]; then
            local nas_real_sha="" time_gap=0
            get_true_nas_sha256_into nas_real_sha "$existing_nas_item"
            if [[ -n "$ORIG_MTIME" ]]; then
                time_gap=$(( local_mtime - ORIG_MTIME ))
                (( time_gap < 0 )) && time_gap=$(( -time_gap ))
            fi

            if [[ "$local_sha" == "$nas_real_sha" && "$existing_nas_item" == "$target_file" ]]; then
                if [[ "$ENC_MODE" == "none" && "$ORIG_MTIME" -ne "$local_mtime" ]]; then
                    touch -h -d "@$local_mtime" "$target_file" 2>/dev/null || true
                    invalidate_nas_cache "$target_file"
                fi
                if [[ "${LOC_TYPE[$abs_path]:-}" == "d" && "$SECURE_ENCRYPT" == false ]]; then
                    save_tree_metadata_recursive "$abs_path" "$target_file" "$ACTIVE_ALIAS"
                else
                    save_origin_metadata "$abs_path" "${target_file}.origin.txt" "$ENC_MODE" "$ORIG_MK_FP" "$ACTIVE_ALIAS" "$local_sha"
                fi
                echo -e "${C_GREEN}[=]${C_RESET} Contenuto identico già presente sul NAS (metadati origin riallineati): $abs_path"
                if [[ -n "$SHARE_TARGETS_ARG" && "$is_custom_dir" == false ]]; then
                    apply_placeholders_for_source_item "$ACTIVE_ALIAS" "$target_file" "${SHARE_TARGETS_ARG#*:}" "$ts"
                fi
                continue
            fi

            if [[ -n "$ORIG_MTIME" ]] && (( ORIG_MTIME > local_mtime )); then
                prompt_conflict_diff_and_choice "ADD (NAS più recente)" "$abs_path" "$existing_nas_item" "$local_mtime" "$ORIG_MTIME" "$ORIG_MTIME_HUMAN" "$ENC_MODE" "$NAS_MODIFIED_OUT_OF_BAND" ""
                if [[ "$CONFLICT_CHOICE" == "SKIP" ]]; then
                    [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]] && sanitize_origin_file_on_nas "$existing_nas_item"
                    echo -e "${C_MUTED}[*] Operazione saltata per: $abs_path${C_RESET}"; continue
                elif [[ "$CONFLICT_CHOICE" == "NAS" ]]; then
                    [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]] && sanitize_origin_file_on_nas "$existing_nas_item"
                    [[ "$is_custom_dir" == false ]] && archive_local_item_to_bak "$abs_path" "$existing_nas_item" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$ts" "$ACTIVE_ALIAS"
                    install_nas_item_to_local "$existing_nas_item" "$abs_path"
                    echo -e "${C_GREEN}[+]${C_RESET} Mantenuta copia del NAS e applicata in locale (copia locale storicizzata in $BACKUP_DIR_NAME): $abs_path"
                    continue
                fi
            else
                if (( time_gap > 3600 )); then
                    local delta_str; format_time_delta_into delta_str "$time_gap"
                    echo -e "${C_YELLOW}[!]${C_RESET} Differenza temporale tra file locale e NAS per '$abs_path': ${delta_str}."
                fi
                if [[ "${NC_AUTO_CONFIRM_ADD:-0}" != "1" ]]; then
                    confirm_double "Il file '$abs_path' esiste già sul NAS ed è differente. Vuoi aggiornarlo?" "Sovrascrivere la copia sul NAS (storicizzando la precedente in $BACKUP_DIR_NAME)?" || continue
                fi
            fi

            if [[ "$is_custom_dir" == false ]]; then
                archive_delta_item_to_bak "$existing_nas_item" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$ts" false
                if [[ "$existing_nas_item" != "$target_file" ]]; then
                    rm -rf "$existing_nas_item" "${existing_nas_item}.origin.txt"
                    invalidate_nas_cache "$existing_nas_item"
                fi
            fi
        fi

        if [[ "$SECURE_ENCRYPT" == true ]]; then
            if [[ "${LOC_TYPE[$abs_path]:-}" == "d" ]]; then
                get_work_tmp_dir
                local tar_temp="$WORK_TMP_DIR/${filename}.tar.gz" abs_dir
                path_dirname_into abs_dir "$abs_path"
                tar -czf "$tar_temp" --numeric-owner -p -C "$abs_dir" "$filename"
                encrypt_payload "$tar_temp" "$target_file" "$enc_mode_used" "$encrypt_pass"
                rm -f "$tar_temp"
            else
                encrypt_payload "$abs_path" "$target_file" "$enc_mode_used" "$encrypt_pass"
            fi
            touch -d "@$local_mtime" "$target_file" 2>/dev/null || true
            invalidate_nas_cache "$target_file"
            save_origin_metadata "$abs_path" "${target_file}.origin.txt" "$enc_mode_used" "$mk_fp_used" "$ACTIVE_ALIAS" "$local_sha"
            echo -e "${C_GREEN}[+]${C_RESET} Aggiunto e cifrato: $target_file"
        else
            if [[ "${LOC_TYPE[$abs_path]:-}" == "l" ]]; then
                write_symlink_mirror "$abs_path" "$target_file" "$local_mtime"
                save_origin_metadata "$abs_path" "${target_file}.origin.txt" "none" "" "$ACTIVE_ALIAS" "$local_sha"
                echo -e "${C_GREEN}[+]${C_RESET} Aggiunto symlink in delta: /$rel_path -> ${LOC_LINK[$abs_path]:-}"
            elif [[ "${LOC_TYPE[$abs_path]:-}" == "d" ]]; then
                sync_dir_incremental_to_nas "$abs_path" "$target_file" "$ts" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR"
                save_tree_metadata_recursive "$abs_path" "$target_file" "$ACTIVE_ALIAS"
                echo -e "${C_GREEN}[+]${C_RESET} Aggiunta cartella in delta: /$rel_path"
            else
                atomic_copy_to_nas "$abs_path" "$target_file" "$local_mtime"
                save_origin_metadata "$abs_path" "${target_file}.origin.txt" "none" "" "$ACTIVE_ALIAS" "$local_sha"
                echo -e "${C_GREEN}[+]${C_RESET} Aggiunto in delta: /$rel_path"
            fi
        fi

        if [[ "$is_custom_dir" == false && -n "$SHARE_TARGETS_ARG" ]]; then
            apply_placeholders_for_source_item "$ACTIVE_ALIAS" "$target_file" "${SHARE_TARGETS_ARG#*:}" "$ts"
        fi
    done

    update_status_cache true
    return 0
}

run_share_mode() {
    if [[ -z "$SHARE_TARGETS_ARG" || ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: Specifica i target di condivisione e almeno un percorso." >&2
        echo -e "${C_MUTED}    Esempio: nc-hanoi -S dc,wsl /etc/zsh/zshrc  oppure  -S dc:nc,wsl /percorso/file${C_RESET}" >&2
        exit 1
    fi

    acquire_nas_lock
    index_all_nas_deltas

    local ts; now_ts_into ts
    local explicit_source="" target_list_spec="$SHARE_TARGETS_ARG"
    if [[ "$SHARE_TARGETS_ARG" == *:* ]]; then
        explicit_source="${SHARE_TARGETS_ARG%%:*}"
        explicit_source="${explicit_source,,}"
        target_list_spec="${SHARE_TARGETS_ARG#*:}"
        if [[ -z "${SYS_DELTA_MAP[$explicit_source]:-}" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Errore: Il sistema sorgente '$explicit_source' non esiste sul NAS." >&2
            exit 1
        fi
    fi

    local arg abs_path rel_clean a d
    for arg in "${POSITIONAL_ARGS[@]}"; do
        abs_path=$(realpath -s -m "$arg")
        normalize_local_rel_into rel_clean "$abs_path"
        for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
            d="${SYS_DELTA_MAP[$a]}"
            if [[ "$abs_path" == "$d/"* ]]; then
                strip_nas_rel_into rel_clean "${abs_path#$d/}"
                break
            fi
        done

        local current_owner; current_owner=$(find_existing_source_owner "$rel_clean")
        local desired_source="${explicit_source:-${current_owner:-$ACTIVE_ALIAS}}"
        local desired_delta="${SYS_DELTA_MAP[$desired_source]}"

        local real_item="" real_owner="" check_alias check_d cand
        for check_alias in "$desired_source" "$current_owner" "${ALL_DISCOVERED_ALIASES[@]}"; do
            [[ -z "$check_alias" ]] && continue
            check_d="${SYS_DELTA_MAP[$check_alias]:-}"
            [[ -z "$check_d" ]] && continue
            for cand in "$check_d/$rel_clean" "$check_d/${rel_clean}.enc" "$check_d/${rel_clean}.tar.gz.enc"; do
                if nas_path_exists_or_link "$cand"; then
                    real_item="$cand"; real_owner="$check_alias"; break 2
                fi
            done
        done

        if [[ -z "$real_item" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Elemento reale non trovato nei delta del NAS per: /$rel_clean" >&2
            echo -e "${C_MUTED}    Aggiungilo prima dal sistema sorgente con: nc-hanoi -a /$rel_clean -S $target_list_spec${C_RESET}" >&2
            continue
        fi

        if [[ "$real_owner" != "$desired_source" ]]; then
            confirm_double "Vuoi trasferire la sorgente di '/$rel_clean' da '$real_owner' a '$desired_source'?" "Spostare il file reale nel delta di '$desired_source'?" || continue
            local rel_from_old="${real_item#${SYS_DELTA_MAP[$real_owner]}/}"
            local new_real_item="$desired_delta/$rel_from_old" new_dir
            rm -f "$desired_delta/${rel_clean}.shared"
            invalidate_nas_cache "$desired_delta/${rel_clean}.shared"
            CONSUMERS_INDEX_READY=false
            path_dirname_into new_dir "$new_real_item"
            [[ -d "$new_dir" ]] || mkdir -p "$new_dir"
            mv -f "$real_item" "$new_real_item"
            invalidate_nas_cache "$real_item"
            invalidate_nas_cache "$new_real_item"
            if [[ -f "${real_item}.origin.txt" ]]; then
                mv -f "${real_item}.origin.txt" "${new_real_item}.origin.txt"
                invalidate_nas_cache "${real_item}.origin.txt"
                invalidate_nas_cache "${new_real_item}.origin.txt"
            fi
            real_item="$new_real_item"
            sanitize_origin_file_on_nas "$real_item"
            NAS_STATE_MUTATED=true
            echo -e "${C_CYAN}[*]${C_RESET} Sorgente di '/$rel_clean' trasferita: $real_owner -> ${C_BOLD}$desired_source${C_RESET}"
        fi

        echo -e "${C_CYAN}[*]${C_RESET} Aggiornamento condivisione per '/$rel_clean' (Sorgente: ${C_BOLD}$desired_source${C_RESET})"
        apply_placeholders_for_source_item "$desired_source" "$real_item" "$target_list_spec" "$ts"
    done

    update_status_cache true
    return 0
}

push_local_item_to_nas() {
    local source_file="$1" mirror_file="$2" ts="$3"
    local target_delta_dir="${4:-$RESOLVED_DELTA_DIR}" target_bak_dir="${5:-$RESOLVED_BAK_DIR}" source_owner_alias="${6:-$ACTIVE_ALIAS}"

    load_origin_metadata "$mirror_file"
    local enc_mode="${ENC_MODE:-none}" mk_fp="${ORIG_MK_FP:-}"

    ensure_local_stat "$source_file" || true
    local local_sha="" local_mtime="${LOC_MTIME[$source_file]:-}"
    calc_target_sha256_into local_sha "$source_file"
    [[ -z "$local_mtime" ]] && now_epoch_into local_mtime

    archive_delta_item_to_bak "$mirror_file" "$target_delta_dir" "$target_bak_dir" "$ts" false

    if [[ "$mirror_file" == *.enc ]]; then
        local pass_to_use=""
        if [[ "$enc_mode" == "custom_password" ]]; then
            echo -e "${C_CYAN}[*]${C_RESET} Il file cifrato '$source_file' richiede la password dedicata per essere aggiornato."
            read -s -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Inserisci la password: ")" pass_to_use </dev/tty
            echo
            touch_lock_heartbeat
        else
            mk_fp=$(get_master_key_fp)
        fi
        if [[ "$mirror_file" == *.tar.gz.enc ]]; then
            get_work_tmp_dir
            local fname sdir tar_temp
            path_basename_into fname "$source_file"
            path_dirname_into sdir "$source_file"
            tar_temp="$WORK_TMP_DIR/${fname}.tar.gz"
            tar -czf "$tar_temp" --numeric-owner -p -C "$sdir" "$fname"
            encrypt_payload "$tar_temp" "$mirror_file" "$enc_mode" "$pass_to_use"
            rm -f "$tar_temp"
        else
            encrypt_payload "$source_file" "$mirror_file" "$enc_mode" "$pass_to_use"
        fi
        touch -d "@$local_mtime" "$mirror_file" 2>/dev/null || true
        invalidate_nas_cache "$mirror_file"
    elif [[ "${LOC_TYPE[$source_file]:-}" == "l" ]]; then
        write_symlink_mirror "$source_file" "$mirror_file" "$local_mtime"
    elif [[ "${LOC_TYPE[$source_file]:-}" == "d" ]]; then
        sync_dir_incremental_to_nas "$source_file" "$mirror_file" "$ts" "$target_delta_dir" "$target_bak_dir"
        save_tree_metadata_recursive "$source_file" "$mirror_file" "$source_owner_alias"
    else
        atomic_copy_to_nas "$source_file" "$mirror_file" "$local_mtime"
    fi

    save_origin_metadata "$source_file" "${mirror_file}.origin.txt" "$enc_mode" "$mk_fp" "$source_owner_alias" "$local_sha" "$ACTIVE_ALIAS"
    NAS_STATE_MUTATED=true
    if [[ "$source_owner_alias" != "$ACTIVE_ALIAS" ]]; then
        echo -e "${C_GREEN}[~]${C_RESET} Aggiornato condiviso sul NAS (Locale '$ACTIVE_ALIAS' -> Delta '$source_owner_alias'): $source_file"
    else
        echo -e "${C_GREEN}[~]${C_RESET} Aggiornato in delta (Locale -> NAS): $source_file"
    fi
    return 0
}

cleanup_empty_delta_dirs_in_ram() {
    (( ${#DELTA_DIRS[@]} == 0 )) && return 0
    local -A has_child=()
    local p parent

    for p in "${!NAS_TYPE[@]}"; do
        [[ "$p" == "$RESOLVED_DELTA_DIR/"* && "${NAS_TYPE[$p]}" != "missing" ]] || continue
        path_dirname_into parent "$p"
        has_child["$parent"]=1
    done

    local sorted_dirs=("${DELTA_DIRS[@]}")
    (( ${#sorted_dirs[@]} > 1 )) && mapfile -d '' -t sorted_dirs < <(printf '%s\0' "${sorted_dirs[@]}" | LC_ALL=C sort -zr)

    local d rel_dir dir_hist ts="$1"
    for d in "${sorted_dirs[@]}"; do
        [[ "${NAS_TYPE[$d]:-}" == "d" ]] || continue
        [[ -n "${has_child[$d]:-}" ]] && continue
        rel_dir="${d#$RESOLVED_DELTA_DIR/}"
        if [[ ! -d "/$rel_dir" ]]; then
            if nas_is_regular_file "${d}.origin.txt"; then
                dir_hist="$RESOLVED_BAK_DIR/${rel_dir}.hist"
                mkdir -p "$dir_hist"
                mv "${d}.origin.txt" "$dir_hist/${ts}_d.bak.origin.txt" 2>/dev/null || true
                invalidate_nas_cache "${d}.origin.txt"
            fi
            if rmdir "$d" 2>/dev/null; then
                invalidate_nas_cache "$d"
                NAS_STATE_MUTATED=true
                # Controlla se anche la madre è ora vuota
                path_dirname_into parent "$d"
                if [[ "$parent" == "$RESOLVED_DELTA_DIR/"* ]]; then
                    local any_left=""
                    for p in "${!NAS_TYPE[@]}"; do
                        if [[ "$p" == "$parent/"* && "$p" != "$parent/"*/* && "${NAS_TYPE[$p]}" != "missing" ]]; then
                            any_left=1; break
                        fi
                    done
                    [[ -z "$any_left" ]] && unset 'has_child[$parent]'
                fi
            fi
        fi
    done
    return 0
}

run_sync_mode() {
    acquire_nas_lock
    local ts; now_ts_into ts

    if [[ ! -d "$RESOLVED_DELTA_DIR" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: La directory delta non esiste: $RESOLVED_DELTA_DIR" >&2
        exit 1
    fi

    prefetch_active_profile_state
    NAS_STATE_MUTATED=false

    # In --reverse, sanifica preventivamente eventuali .origin.txt legacy/OOB
    local origins_healed=0
    if [[ "$REVERSE_SYNC" == true ]]; then
        local mf
        for mf in "${DELTA_REAL_ITEMS[@]}"; do
            load_origin_metadata "$mf"
            if [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
                sanitize_origin_file_on_nas "$mf"
                origins_healed=$(( origins_healed + 1 ))
            fi
        done
        local dir_m nas_d
        for dir_m in "${DELTA_ORIGIN_FILES[@]}"; do
            nas_d="${dir_m%.origin.txt}"
            [[ "${NAS_TYPE[$nas_d]:-}" == "d" ]] || continue
            load_origin_metadata "$nas_d"
            if [[ "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
                sanitize_origin_file_on_nas "$nas_d"
                origins_healed=$(( origins_healed + 1 ))
            fi
        done
        local ph_f
        for ph_f in "${DELTA_SHARED_FILES[@]}"; do
            load_shared_placeholder "$ph_f" || continue
            [[ -n "$PH_RESOLVED_SOURCE_FILE" ]] || continue
            load_origin_metadata "$PH_RESOLVED_SOURCE_FILE"
            if [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
                sanitize_origin_file_on_nas "$PH_RESOLVED_SOURCE_FILE"
                origins_healed=$(( origins_healed + 1 ))
            fi
        done
    fi

    evaluate_profile_drift

    if [[ "$REVERSE_SYNC" == true ]]; then
        if (( ${#EVAL_ROW_STAT_STR[@]} == 0 )); then
            # Applica eventuali touch silenti
            local ti
            for (( ti=0; ti<${#EVAL_ITEM_ACTIONS[@]}; ti++ )); do
                if [[ "${EVAL_ITEM_ACTIONS[$ti]}" == "REV_TOUCH_SILENT" ]]; then
                    touch -h -d "@${EVAL_ITEM_NOTES[$ti]}" "${EVAL_ITEM_LOC[$ti]}" 2>/dev/null || true
                    LOC_MTIME["${EVAL_ITEM_LOC[$ti]}"]="${EVAL_ITEM_NOTES[$ti]}"
                fi
            done
            write_status_env_from_counts 0 0 0
            (( origins_healed > 0 )) && echo -e "${C_CYAN}[~]${C_RESET} Normalizzati e riallineati $origins_healed file .origin.txt allo schema canonico."
            echo -e "${C_GREEN}[=]${C_RESET} Nessun file da ripristinare. Il sistema locale '$ACTIVE_ALIAS' è già allineato col NAS."
            exit 0
        fi

        if [[ "$REVERSE_FORCED" == true ]]; then
            render_4col_table "NC-NAS-CONF — RIEPILOGO SYNC REVERSE FORCED (NAS -> Locale): ${ACTIVE_ALIAS} (${ACTIVE_FOLDER})" \
                "Delta Attivo: $RESOLVED_DELTA_DIR | Elementi coinvolti: ${#EVAL_ROW_STAT_STR[@]}" \
                "AZIONE PREVISTA" "RUOLO NODO" "CONDIVISO" "PERCORSO ELEMENTO" \
                EVAL_ROW_STAT_COL EVAL_ROW_STAT_STR EVAL_ROW_ROLE_COL EVAL_ROW_ROLE_STR EVAL_ROW_SH_STR EVAL_ROW_PATH_STR
            echo -e "\n${C_RED}[!!] ATTENZIONE — MODALITÀ --reverse-forced (NAS -> Locale) SUL PROFILO '${C_BOLD}$ACTIVE_ALIAS${C_RESET}${C_RED}':${C_RESET}"
            echo -e "     Questa operazione forzerà sul sistema locale tutti i ${C_BOLD}${EVAL_NON_CONFLICT_WORK}${C_RESET} elementi elencati nella tabella."
            echo -e "     Eventuali file locali più recenti verranno ${C_BOLD}SOVRASCRITTI SENZA ULTERIORI DIALOGHI${C_RESET}"
            echo -e "     ${C_MUTED}(le copie locali più recenti sostituite verranno comunque storicizzate in $BACKUP_DIR_NAME).${C_RESET}"
            confirm_enter "Vuoi procedere con la sincronizzazione inversa forzata?"
            local ack_input=""
            read -r -p "$(echo -e "${C_RED}[!!] CONFERMA DEFINITIVA:${C_RESET} Digita '${C_BOLD}AKNOWLEDGED${C_RESET}' e premi INVIO per avviare la forzatura: ")" ack_input </dev/tty
            touch_lock_heartbeat
            if [[ "$ack_input" != "AKNOWLEDGED" && "$ack_input" != "ACKNOWLEDGED" ]]; then
                echo -e "${C_RED}[-]${C_RESET} Conferma non valida. Operazione annullata."
                exit 0
            fi
        else
            render_4col_table "NC-NAS-CONF — RIEPILOGO SYNC REVERSE (NAS -> Locale): ${ACTIVE_ALIAS} (${ACTIVE_FOLDER})" \
                "Delta Attivo: $RESOLVED_DELTA_DIR | Elementi coinvolti: ${#EVAL_ROW_STAT_STR[@]}" \
                "AZIONE PREVISTA" "RUOLO NODO" "CONDIVISO" "PERCORSO ELEMENTO" \
                EVAL_ROW_STAT_COL EVAL_ROW_STAT_STR EVAL_ROW_ROLE_COL EVAL_ROW_ROLE_STR EVAL_ROW_SH_STR EVAL_ROW_PATH_STR
            if (( EVAL_NON_CONFLICT_WORK > 0 )); then
                echo -e "\n${C_YELLOW}[!]${C_RESET} Modalità ${C_BOLD}--sync --reverse (NAS -> Locale)${C_RESET} sul profilo '${C_BOLD}$ACTIVE_ALIAS${C_RESET}':"
                echo -e "    Verranno allineati sul sistema locale ${C_BOLD}${EVAL_NON_CONFLICT_WORK}${C_RESET} elementi privi di conflitto (inclusi i .shared)."
                (( EVAL_CONFLICT_COUNT > 0 )) && echo -e "    I ${C_BOLD}${EVAL_CONFLICT_COUNT}${C_RESET} file in conflitto verranno poi esaminati singolarmente."
                echo -e "    ${C_MUTED}Nessun file extra presente solo sul sistema locale verrà eliminato.${C_RESET}"
                confirm_double_or_exit "Vuoi procedere con l'allineamento dal NAS al sistema locale?" "Scrivere le configurazioni del NAS sul filesystem locale di '$ACTIVE_ALIAS'?"
            fi
        fi
    else
        if (( ${#EVAL_ROW_STAT_STR[@]} > 0 )); then
            render_4col_table "NC-NAS-CONF — RIEPILOGO SYNC (Locale -> NAS): ${ACTIVE_ALIAS} (${ACTIVE_FOLDER})" \
                "Delta Attivo: $RESOLVED_DELTA_DIR | Elementi coinvolti: ${#EVAL_ROW_STAT_STR[@]}" \
                "AZIONE PREVISTA" "RUOLO NODO" "CONDIVISO" "PERCORSO ELEMENTO" \
                EVAL_ROW_STAT_COL EVAL_ROW_STAT_STR EVAL_ROW_ROLE_COL EVAL_ROW_ROLE_STR EVAL_ROW_SH_STR EVAL_ROW_PATH_STR
        fi
    fi

    # PASSO 3: ESECUZIONE AZIONI PIANIFICATE
    local changes_detected=0 deletions_detected=0 restored_count=0 perms_fixed_count=0
    local total_dirs=${#EVAL_DIR_ACTIONS[@]} i d_act nas_dir local_dir dir_meta owner_spec

    for (( i=0; i<total_dirs; i++ )); do
        d_act="${EVAL_DIR_ACTIONS[$i]}"
        nas_dir="${EVAL_DIR_NAS[$i]}"
        local_dir="${EVAL_DIR_LOC[$i]}"
        dir_meta="${nas_dir}.origin.txt"
        load_origin_metadata "$nas_dir"

        case "$d_act" in
            SYNC_DIR_PERM)
                local cur_d_mode="${LOC_MODE[$local_dir]:-0755}" cur_d_owner="${LOC_OWNER[$local_dir]:-root}" cur_d_group="${LOC_GROUP[$local_dir]:-root}" cur_d_mtime="${LOC_MTIME[$local_dir]:-0}"
                if [[ "$ORIG_MTIME" != "$cur_d_mtime" ]]; then
                    touch -d "@$cur_d_mtime" "$nas_dir" 2>/dev/null || true
                    invalidate_nas_cache "$nas_dir"
                fi
                save_origin_metadata "$local_dir" "$dir_meta" "none" "" "$ACTIVE_ALIAS" "" "$ACTIVE_ALIAS"
                changes_detected=1
                echo -e "${C_CYAN}[~]${C_RESET} Aggiornati permessi cartella in origin (${ORIG_OWNER}:${ORIG_GROUP} ${ORIG_MODE} -> ${cur_d_owner}:${cur_d_group} ${cur_d_mode}): $local_dir"
                ;;
            HEAL_DIR_META)
                local cur_d_mtime="${LOC_MTIME[$local_dir]:-0}"
                if [[ "$ORIG_MTIME" != "$cur_d_mtime" ]]; then
                    touch -d "@$cur_d_mtime" "$nas_dir" 2>/dev/null || true
                    invalidate_nas_cache "$nas_dir"
                fi
                save_origin_metadata "$local_dir" "$dir_meta" "none" "" "$ACTIVE_ALIAS" "" "${ORIG_LAST_UPDATED_BY:-$ACTIVE_ALIAS}"
                origins_healed=$(( origins_healed + 1 ))
                ;;
            REV_DIR_CREATE)
                resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
                rm -f "$local_dir" 2>/dev/null || true
                mkdir -p "$local_dir"
                chown "$owner_spec" "$local_dir" 2>/dev/null || true
                [[ -n "$ORIG_MODE" && "$ORIG_MODE" != "lrwxrwxrwx" ]] && chmod "$ORIG_MODE" "$local_dir" 2>/dev/null || true
                [[ -n "$ORIG_MTIME" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -d "@$ORIG_MTIME" "$local_dir" 2>/dev/null || true
                invalidate_local_cache "$local_dir"
                restored_count=$(( restored_count + 1 ))
                NAS_STATE_MUTATED=true
                echo -e "${C_GREEN}[+]${C_RESET} Creata cartella tracciata (NAS -> Locale): $local_dir"
                ;;
            REV_DIR_PERM)
                resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
                local cur_d_mode="${LOC_MODE[$local_dir]:-0755}" cur_d_owner="${LOC_OWNER[$local_dir]:-root}" cur_d_group="${LOC_GROUP[$local_dir]:-root}"
                chown "$owner_spec" "$local_dir" 2>/dev/null || true
                [[ "$ORIG_MODE" != "lrwxrwxrwx" ]] && chmod "$ORIG_MODE" "$local_dir" 2>/dev/null || true
                [[ -n "$ORIG_MTIME" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -d "@$ORIG_MTIME" "$local_dir" 2>/dev/null || true
                invalidate_local_cache "$local_dir"
                perms_fixed_count=$(( perms_fixed_count + 1 ))
                NAS_STATE_MUTATED=true
                echo -e "${C_CYAN}[~]${C_RESET} Riallineati permessi cartella locale (${cur_d_owner}:${cur_d_group} ${cur_d_mode} -> ${ORIG_OWNER}:${ORIG_GROUP} ${ORIG_MODE}): $local_dir"
                ;;
        esac
    done

    local total_items=${#EVAL_ITEM_ACTIONS[@]} act mirror_file source_file owner_alias t_delta_dir t_bak_dir sh_note
    for (( i=0; i<total_items; i++ )); do
        act="${EVAL_ITEM_ACTIONS[$i]}"
        mirror_file="${EVAL_ITEM_NAS[$i]}"
        source_file="${EVAL_ITEM_LOC[$i]}"
        owner_alias="${EVAL_ITEM_OWNERS[$i]}"
        t_delta_dir="${EVAL_ITEM_DELTAS[$i]}"
        t_bak_dir="${EVAL_ITEM_BAKS[$i]}"
        sh_note="${EVAL_ITEM_NOTES[$i]}"

        [[ "$act" != "PUSH_NEW_IN_DIR" && "$act" != "REV_TOUCH_SILENT" ]] && load_origin_metadata "$mirror_file"

        case "$act" in
            PUSH_NEW_IN_DIR)
                ensure_local_stat "$source_file" || continue
                local new_m="${LOC_MTIME[$source_file]:-0}" new_sha=""
                if [[ "${LOC_TYPE[$source_file]:-}" == "d" ]]; then
                    mkdir -p "$mirror_file"
                    touch -d "@$new_m" "$mirror_file" 2>/dev/null || true
                    calc_target_sha256_into new_sha "$source_file"
                elif [[ "${LOC_TYPE[$source_file]:-}" == "l" ]]; then
                    write_symlink_mirror "$source_file" "$mirror_file" "$new_m"
                    calc_target_sha256_into new_sha "$source_file"
                else
                    atomic_copy_to_nas "$source_file" "$mirror_file" "$new_m"
                    calc_target_sha256_into new_sha "$source_file"
                fi
                save_origin_metadata "$source_file" "${mirror_file}.origin.txt" "none" "" "$ACTIVE_ALIAS" "$new_sha" "$ACTIVE_ALIAS"
                changes_detected=1
                echo -e "${C_GREEN}[+]${C_RESET} Nuovo elemento in cartella tracciata salvato sul NAS: $source_file"
                ;;
            SYNC_PERM_ORIGIN)
                ensure_local_stat "$source_file" || true
                local local_mtime="${LOC_MTIME[$source_file]:-0}" local_mode="${LOC_MODE[$source_file]:-0644}"
                local local_owner="${LOC_OWNER[$source_file]:-root}" local_group="${LOC_GROUP[$source_file]:-root}" sha_loc=""
                calc_target_sha256_into sha_loc "$source_file"
                if [[ "${ORIG_MTIME:-0}" -ne "$local_mtime" ]]; then
                    touch -h -d "@$local_mtime" "$mirror_file" 2>/dev/null || true
                    invalidate_nas_cache "$mirror_file"
                fi
                save_origin_metadata "$source_file" "${mirror_file}.origin.txt" "$ENC_MODE" "$ORIG_MK_FP" "$owner_alias" "$sha_loc" "$ACTIVE_ALIAS"
                changes_detected=1
                echo -e "${C_CYAN}[~]${C_RESET} Aggiornati permessi in origin (${ORIG_OWNER}:${ORIG_GROUP} ${ORIG_MODE} -> ${local_owner}:${local_group} ${local_mode}): ${source_file}${sh_note}"
                ;;
            HEAL_ORIGIN_SILENT)
                ensure_local_stat "$source_file" || true
                local local_mtime="${LOC_MTIME[$source_file]:-0}" sha_loc=""
                calc_target_sha256_into sha_loc "$source_file"
                if [[ "${ORIG_MTIME:-0}" -ne "$local_mtime" ]]; then
                    touch -h -d "@$local_mtime" "$mirror_file" 2>/dev/null || true
                    invalidate_nas_cache "$mirror_file"
                fi
                save_origin_metadata "$source_file" "${mirror_file}.origin.txt" "$ENC_MODE" "$ORIG_MK_FP" "$owner_alias" "$sha_loc" "${ORIG_LAST_UPDATED_BY:-$owner_alias}"
                origins_healed=$(( origins_healed + 1 ))
                ;;
            REV_TOUCH_SILENT)
                touch -h -d "@$sh_note" "$source_file" 2>/dev/null || true
                LOC_MTIME["$source_file"]="$sh_note"
                ;;
            SKIP_PEER_UPDATED)
                echo -e "${C_MUTED}[i] Aggiornato sul NAS da '${owner_alias}': $source_file (salto invio -> usa '${C_MUTED_CMD}nc-hanoi -r $source_file${C_MUTED}' per allinearlo)${C_RESET}"
                ;;
            SKIP_SHARED_MISSING_LOC)
                echo -e "${C_MUTED}[i] Condiviso assente in locale: $source_file (sorgente: $owner_alias -> usa '${C_MUTED_CMD}nc-hanoi -r $source_file${C_MUTED}' per installarlo)${C_RESET}"
                ;;
            CONFLICT_SYNC)
                ensure_local_stat "$source_file" || true
                local local_mtime="${LOC_MTIME[$source_file]:-0}" nas_mtime="${ORIG_MTIME:-0}"
                prompt_conflict_diff_and_choice "SYNC (NAS più recente)" "$source_file" "$mirror_file" "$local_mtime" "$nas_mtime" "$ORIG_MTIME_HUMAN" "$ENC_MODE" "$NAS_MODIFIED_OUT_OF_BAND" "$sh_note"
                if [[ "$CONFLICT_CHOICE" == "LOCAL" ]]; then
                    changes_detected=1
                    push_local_item_to_nas "$source_file" "$mirror_file" "$ts" "$t_delta_dir" "$t_bak_dir" "$owner_alias"
                elif [[ "$CONFLICT_CHOICE" == "NAS" ]]; then
                    if [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
                        sanitize_origin_file_on_nas "$mirror_file"; origins_healed=$(( origins_healed + 1 ))
                    fi
                    archive_local_item_to_bak "$source_file" "$mirror_file" "$t_delta_dir" "$t_bak_dir" "$ts" "$owner_alias"
                    install_nas_item_to_local "$mirror_file" "$source_file"
                    restored_count=$(( restored_count + 1 ))
                    echo -e "${C_GREEN}[~]${C_RESET} Mantenuta copia del NAS e applicata in locale (copia locale storicizzata in $BACKUP_DIR_NAME): ${source_file}${sh_note}"
                else
                    if [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
                        sanitize_origin_file_on_nas "$mirror_file"; origins_healed=$(( origins_healed + 1 ))
                        [[ "$NAS_MODIFIED_OUT_OF_BAND" == true ]] && echo -e "${C_CYAN}[~]${C_RESET} Riallineato .origin.txt sul NAS per riflettere la modifica diretta di: $source_file"
                    fi
                    echo -e "${C_MUTED}[*] Conflitto saltato per: $source_file${C_RESET}"
                fi
                ;;
            PUSH_ITEM)
                ensure_local_stat "$source_file" || true
                local local_mtime="${LOC_MTIME[$source_file]:-0}" nas_mtime="${ORIG_MTIME:-0}"
                local time_gap=$(( local_mtime - nas_mtime ))
                (( time_gap < 0 )) && time_gap=$(( -time_gap ))
                if (( time_gap > 3600 )); then
                    local delta_str; format_time_delta_into delta_str "$time_gap"
                    echo -e "${C_YELLOW}[!]${C_RESET} Differenza temporale tra copia locale e NAS per '$source_file': ${delta_str}."
                fi
                changes_detected=1
                push_local_item_to_nas "$source_file" "$mirror_file" "$ts" "$t_delta_dir" "$t_bak_dir" "$owner_alias"
                ;;
            DELETE_FROM_NAS)
                local del_rel; normalize_local_rel_into del_rel "$source_file"
                if [[ -n "$sh_note" ]]; then
                    echo -e "\n${C_YELLOW}[!]${C_RESET} Il file sorgente '${C_BOLD}$source_file${C_RESET}' non esiste più localmente, ma è condiviso con: ${C_BOLD}$sh_note${C_RESET}"
                    if ! confirm_double "Vuoi rimuoverlo dal NAS e pulire i placeholder in '$sh_note'?" "Eliminare definitivamente '$source_file' dal delta e rimuovere i placeholder da '$sh_note'?"; then
                        echo -e "${C_MUTED}[*] Rimozione annullata (usa '${C_MUTED_CMD}nc-hanoi -r $source_file${C_MUTED}' se vuoi ripristinarlo).${C_RESET}"
                        continue
                    fi
                    remove_all_placeholders_for_item "$del_rel" "$ACTIVE_ALIAS"
                else
                    echo -e "\n${C_YELLOW}[!]${C_RESET} Il file '${C_BOLD}$source_file${C_RESET}' non è più presente sul filesystem locale."
                    if ! confirm_double "Vuoi rimuoverlo dal delta del NAS (storicizzandolo in $BACKUP_DIR_NAME)?" "Confermi la rimozione di '$source_file' dal delta attivo?"; then
                        echo -e "${C_MUTED}[*] Rimozione saltata per: $source_file${C_RESET}"
                        continue
                    fi
                fi
                deletions_detected=1
                archive_delta_item_to_bak "$mirror_file" "$RESOLVED_DELTA_DIR" "$RESOLVED_BAK_DIR" "$ts" true
                rm -f "$mirror_file" "${mirror_file}.origin.txt"
                invalidate_nas_cache "$mirror_file"
                NAS_STATE_MUTATED=true
                echo -e "${C_YELLOW}[-]${C_RESET} Rimosso da delta (non più presente su /): $source_file"
                ;;
            PULL_INSTALL)
                install_nas_item_to_local "$mirror_file" "$source_file"
                restored_count=$(( restored_count + 1 ))
                echo -e "${C_GREEN}[+]${C_RESET} Installato in locale (NAS -> Locale): ${source_file}${sh_note}"
                ;;
            PULL_UPDATE)
                install_nas_item_to_local "$mirror_file" "$source_file"
                restored_count=$(( restored_count + 1 ))
                echo -e "${C_GREEN}[~]${C_RESET} Aggiornato in locale (NAS -> Locale): ${source_file}${sh_note}"
                ;;
            PULL_FORCE_OVERWRITE)
                archive_local_item_to_bak "$source_file" "$mirror_file" "$t_delta_dir" "$t_bak_dir" "$ts" "$owner_alias"
                install_nas_item_to_local "$mirror_file" "$source_file"
                restored_count=$(( restored_count + 1 ))
                echo -e "${C_GREEN}[⇊]${C_RESET} Forzato in locale (NAS -> Locale, versione locale storicizzata): ${source_file}${sh_note}"
                ;;
            REV_FILE_PERM)
                ensure_local_stat "$source_file" || true
                resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
                local local_mode="${LOC_MODE[$source_file]:-0644}" local_owner="${LOC_OWNER[$source_file]:-root}" local_group="${LOC_GROUP[$source_file]:-root}" nas_mtime="${ORIG_MTIME:-0}"
                chown -h "$owner_spec" "$source_file" 2>/dev/null || true
                [[ "${LOC_TYPE[$source_file]:-}" != "l" && "$ORIG_MODE" != "lrwxrwxrwx" ]] && chmod "$ORIG_MODE" "$source_file" 2>/dev/null || true
                [[ -n "$nas_mtime" && "$nas_mtime" =~ ^[0-9]+$ ]] && touch -h -d "@$nas_mtime" "$source_file" 2>/dev/null || true
                invalidate_local_cache "$source_file"
                perms_fixed_count=$(( perms_fixed_count + 1 ))
                NAS_STATE_MUTATED=true
                echo -e "${C_CYAN}[~]${C_RESET} Riallineati permessi locali (${local_owner}:${local_group} ${local_mode} -> ${ORIG_OWNER}:${ORIG_GROUP} ${ORIG_MODE}): ${source_file}${sh_note}"
                ;;
            CONFLICT_REVERSE)
                ensure_local_stat "$source_file" || true
                local local_mtime="${LOC_MTIME[$source_file]:-0}" nas_mtime="${ORIG_MTIME:-0}"
                prompt_conflict_diff_and_choice "REVERSE (Locale più recente)" "$source_file" "$mirror_file" "$local_mtime" "$nas_mtime" "$ORIG_MTIME_HUMAN" "$ENC_MODE" "$NAS_MODIFIED_OUT_OF_BAND" "$sh_note"
                if [[ "$CONFLICT_CHOICE" == "NAS" ]]; then
                    archive_local_item_to_bak "$source_file" "$mirror_file" "$t_delta_dir" "$t_bak_dir" "$ts" "$owner_alias"
                    install_nas_item_to_local "$mirror_file" "$source_file"
                    restored_count=$(( restored_count + 1 ))
                    echo -e "${C_GREEN}[~]${C_RESET} Sovrascritto in locale con copia NAS (copia locale storicizzata in $BACKUP_DIR_NAME): ${source_file}${sh_note}"
                elif [[ "$CONFLICT_CHOICE" == "LOCAL" ]]; then
                    changes_detected=1
                    push_local_item_to_nas "$source_file" "$mirror_file" "$ts" "$t_delta_dir" "$t_bak_dir" "$owner_alias"
                    echo -e "${C_GREEN}[~]${C_RESET} Mantenuta copia locale e inviata al NAS (copia NAS storicizzata in $BACKUP_DIR_NAME): ${source_file}${sh_note}"
                else
                    echo -e "${C_MUTED}[*] Conflitto saltato per: $source_file (versione locale preservata)${C_RESET}"
                fi
                ;;
        esac
    done

    if [[ "$REVERSE_SYNC" == false ]]; then
        cleanup_empty_delta_dirs_in_ram "$ts"

        # Verifica globale degli .origin.txt degli altri nodi in RAM grazie a nas_sidecar.cache
        local other_meta other_payload
        for other_meta in "${OTHER_DELTA_ORIGIN_FILES[@]}"; do
            other_payload="${other_meta%.origin.txt}"
            nas_path_exists_or_link "$other_payload" || continue
            load_origin_metadata "$other_payload"
            if [[ "$ORIGIN_HAS_LEGACY_KEYS" == true || "$NAS_MODIFIED_OUT_OF_BAND" == true ]]; then
                debug_log "[Step4-OtherDelta] $other_payload -> legacy=$ORIGIN_HAS_LEGACY_KEYS (${ORIGIN_LEGACY_REASONS[*]:-none}) | oob=$NAS_MODIFIED_OUT_OF_BAND (${NAS_OOB_REASONS[*]:-none})"
                sanitize_origin_file_on_nas "$other_payload"
                origins_healed=$(( origins_healed + 1 ))
            fi
        done

        if [[ "$NAS_STATE_MUTATED" == true ]]; then
            update_status_cache true
        else
            write_status_env_from_counts "$EVAL_PUSH_TOTAL" "$EVAL_PUSH_SHARED" "$EVAL_PULL_TOTAL"
        fi
        (( origins_healed > 0 )) && echo -e "${C_CYAN}[~]${C_RESET} Normalizzati e riallineati $origins_healed file .origin.txt allo schema canonico."
        [[ $changes_detected -eq 1 ]] && echo -e "${C_GREEN}[+]${C_RESET} Modifiche e metadati sincronizzati sul NAS."
        (( restored_count > 0 )) && echo -e "${C_GREEN}[+]${C_RESET} Applicati in locale $restored_count file prelevati dal NAS."
        [[ $deletions_detected -eq 1 ]] && echo -e "${C_GREEN}[+]${C_RESET} Eliminazioni storicizzate in $BACKUP_DIR_NAME."
        if [[ $changes_detected -eq 0 && $deletions_detected -eq 0 && $origins_healed -eq 0 && $restored_count -eq 0 ]]; then
            echo -e "${C_GREEN}[=]${C_RESET} Nessuna modifica locale da inviare. Mirror '$ACTIVE_ALIAS' allineato."
        fi
    else
        if [[ "$NAS_STATE_MUTATED" == true ]]; then
            update_status_cache true
        else
            write_status_env_from_counts "$EVAL_PUSH_TOTAL" "$EVAL_PUSH_SHARED" "$EVAL_PULL_TOTAL"
        fi
        (( origins_healed > 0 )) && echo -e "${C_CYAN}[~]${C_RESET} Normalizzati e riallineati $origins_healed file .origin.txt allo schema canonico."
        (( perms_fixed_count > 0 )) && echo -e "${C_CYAN}[~]${C_RESET} Permessi e proprietari riallineati su $perms_fixed_count elementi locali."
        (( restored_count > 0 )) && echo -e "${C_GREEN}[+]${C_RESET} Allineamento --sync --reverse completato: $restored_count elementi installati/aggiornati dal NAS."
        [[ $changes_detected -eq 1 ]] && echo -e "${C_GREEN}[+]${C_RESET} Copie locali mantenute e sincronizzate sul NAS."
        if (( restored_count == 0 && perms_fixed_count == 0 && changes_detected == 0 )); then
            echo -e "${C_GREEN}[=]${C_RESET} Nessuna modifica applicata al sistema locale."
        fi
    fi
    exit 0
}

install_nas_item_to_local() {
    local mirror_file="$1" dest_path="$2"

    load_origin_metadata "$mirror_file"
    local payload_file="" owner_spec="" dest_parent=""
    resolve_bak_payload_into payload_file "$mirror_file"
    resolve_owner_group_spec_into owner_spec "$ORIG_OWNER" "$ORIG_UID" "$ORIG_GROUP" "$ORIG_GID"
    path_dirname_into dest_parent "$dest_path"

    if [[ ! -d "$dest_parent" ]]; then
        mkdir -p "$dest_parent"
        chown "$owner_spec" "$dest_parent" 2>/dev/null || true
    fi

    if [[ "$mirror_file" == *.enc || "$payload_file" == *.enc || "$ENC_MODE" != "none" ]]; then
        get_work_tmp_dir
        local temp_dec="$WORK_TMP_DIR/restore.dec"
        decrypt_payload "$payload_file" "$temp_dec" "$ORIG_MK_FP"

        if [[ "$mirror_file" == *.tar.gz.enc || "$payload_file" == *.tar.gz.enc || "$ORIG_TYPE" == "directory" ]]; then
            local temp_ext="$WORK_TMP_DIR/extract"
            rm -rf "$temp_ext"
            mkdir -p "$temp_ext"
            tar -xzf "$temp_dec" --same-owner --same-permissions -C "$temp_ext"
            rm -f "$temp_dec"
            mkdir -p "$dest_path"
            cp -rfpT --remove-destination "$temp_ext/$ORIG_NAME" "$dest_path"
            rm -rf "$temp_ext"
            chown "$owner_spec" "$dest_path" 2>/dev/null || true
            [[ -n "$ORIG_MODE" ]] && chmod "$ORIG_MODE" "$dest_path" 2>/dev/null || true
            [[ -n "$ORIG_MTIME" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -d "@$ORIG_MTIME" "$dest_path" 2>/dev/null || true
            invalidate_local_cache "$dest_path"
        else
            # Verifica integrità end-to-end del payload decifrato contro ORIG_SHA256
            if [[ -n "$ORIG_SHA256" ]]; then
                local dec_sha_line="" dec_sha=""
                IFS= read -r dec_sha_line < <(sha256sum "$temp_dec")
                dec_sha="${dec_sha_line:0:64}"
                if [[ "$dec_sha" != "$ORIG_SHA256" ]]; then
                    rm -f "$temp_dec"
                    echo -e "${C_RED}[-]${C_RESET} ERRORE DI INTEGRITÀ: Lo SHA-256 decifrato ($dec_sha) non coincide con ORIG_SHA256 ($ORIG_SHA256) per '$dest_path'." >&2
                    exit 1
                fi
            fi
            atomic_install_file "$temp_dec" "$dest_path" "$owner_spec" "$ORIG_MODE" "$ORIG_MTIME"
            rm -f "$temp_dec"
        fi
    elif [[ "$ORIG_TYPE" == "symlink" && -n "$ORIG_SYMLINK_TARGET" ]]; then
        rm -f "$dest_path"
        ln -s "$ORIG_SYMLINK_TARGET" "$dest_path"
        chown -h "$owner_spec" "$dest_path" 2>/dev/null || true
        [[ -n "$ORIG_MTIME" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -h -d "@$ORIG_MTIME" "$dest_path" 2>/dev/null || true
        invalidate_local_cache "$dest_path"
    elif [[ -d "$payload_file" ]]; then
        mkdir -p "$dest_path"
        tar -cf - --exclude='*.origin.txt' --exclude='*.shared' -C "$payload_file" . | tar -xf - --unlink-first -C "$dest_path"
        chown -R "$owner_spec" "$dest_path" 2>/dev/null || true
        [[ -n "$ORIG_MODE" ]] && chmod "$ORIG_MODE" "$dest_path" 2>/dev/null || true
        apply_tree_metadata_recursive "$payload_file" "$dest_path"
        [[ -n "$ORIG_MTIME" && "$ORIG_MTIME" =~ ^[0-9]+$ ]] && touch -d "@$ORIG_MTIME" "$dest_path" 2>/dev/null || true
        invalidate_local_cache "$dest_path"
    else
        atomic_install_file "$payload_file" "$dest_path" "$owner_spec" "$ORIG_MODE" "$ORIG_MTIME"
    fi
    NAS_STATE_MUTATED=true
    return 0
}

describe_hanoi_slot_into() {
    local __out_var="$1" __v_epoch="$2" __idx="$3" __now_epoch="$4"
    local __d30_epoch=$(( __now_epoch - (30 * 86400) ))
    if (( __v_epoch <= 0 )); then
        printf -v "$__out_var" '%s' "Slot sconosciuto"; return 0
    fi
    local __tz=0 __n=$(( __v_epoch / 86400 ))
    if (( __n > 0 )); then
        while (( (__n & 1) == 0 )); do
            __tz=$(( __tz + 1 ))
            __n=$(( __n >> 1 ))
        done
    fi
    if (( __idx == 0 || __v_epoch > __d30_epoch )); then
        printf -v "$__out_var" "Recente (<30gg, T#%d)" "$__tz"
    else
        local __span=$(( 1 << __tz ))
        printf -v "$__out_var" "Nastro #%d (%dgg)" "$__tz" "$__span"
    fi
    return 0
}

batch_bak_epochs_from_files() {
    local -n __baks_ref="$1" __epochs_out="$2" __humans_out="$3"
    __epochs_out=(); __humans_out=()
    local __total=${#__baks_ref[@]}
    (( __total == 0 )) && return 0

    local __date_input="" __i __bf __base __clean_ts __d_part __t_part __h_ts
    for (( __i=0; __i<__total; __i++ )); do
        __bf="${__baks_ref[$__i]}"
        __base="${__bf##*/}"; __base="${__base%.bak}"; __clean_ts="${__base%_d}"
        __d_part="${__clean_ts%_*}"; __t_part="${__clean_ts#*_}"; __t_part="${__t_part//-/:}"
        __h_ts="$__d_part $__t_part"
        __humans_out+=("$__h_ts")
        __date_input+="${__h_ts}"$'\n'
    done

    mapfile -t __epochs_out < <(printf '%s' "$__date_input" | date -f - +%s 2>/dev/null || true)
    if (( ${#__epochs_out[@]} != __total )); then
        __epochs_out=()
        local __ep
        for (( __i=0; __i<__total; __i++ )); do
            __ep=$(date -d "${__humans_out[$__i]}" +%s 2>/dev/null || echo 0)
            __epochs_out+=("$__ep")
        done
    fi
    return 0
}

inspect_and_restore_hist_dir() {
    local hist_dir="$1" owner_alias="$2" selection_only="${3:-false}"
    SELECTED_BAK_SRC=""
    local found_backups=() p fsize fhum fts
    while IFS= read -r -d '' p && IFS= read -r -d '' fsize && IFS= read -r -d '' fhum && IFS= read -r -d '' fts; do
        NAS_TYPE["$p"]="f"; NAS_SIZE["$p"]="$fsize"
        NAS_MTIME["$p"]="${fts%%.*}"; NAS_MTIME_HUMAN["$p"]="${fhum%%.*}"
        unset 'NAS_DIRTY_PATHS[$p]'
        [[ "$p" == *.bak ]] && found_backups+=("$p")
    done < <(LC_ALL=C find "$hist_dir" -maxdepth 1 -type f -printf '%p\0%s\0%TY-%Tm-%Td %TH:%TM:%TS\0%T@\0' 2>/dev/null || true)

    local count=${#found_backups[@]}
    if (( count == 0 )); then
        echo -e "${C_RED}[-]${C_RESET} Nessuno snapshot .bak trovato in: $hist_dir" >&2
        return 1
    fi
    (( count > 1 )) && mapfile -d '' -t found_backups < <(printf '%s\0' "${found_backups[@]}" | sort -zr)

    local bak_epochs=() bak_humans=()
    batch_bak_epochs_from_files found_backups bak_epochs bak_humans

    local owner_bak_root="$LINUX_ROOT/${SYS_FOLDER_MAP[$owner_alias]:-$ACTIVE_FOLDER}/$BACKUP_DIR_NAME"
    local owner_delta_root="${SYS_DELTA_MAP[$owner_alias]:-$RESOLVED_DELTA_DIR}"
    local rel_hist="${hist_dir#$owner_bak_root/}"; rel_hist="${rel_hist%.hist}"
    local rel_clean; strip_nas_rel_into rel_clean "$rel_hist"

    load_origin_metadata "${found_backups[0]}"
    local orig_target="${ORIG_PATH:-/$rel_clean}"

    local active_delta_item="" cand
    for cand in "$owner_delta_root/$rel_clean" "$owner_delta_root/${rel_clean}.enc" "$owner_delta_root/${rel_clean}.tar.gz.enc"; do
        if nas_path_exists_or_link "$cand"; then active_delta_item="$cand"; break; fi
    done

    local now_epoch; now_epoch_into now_epoch
    # Cache persistente lungo tutta la revisione dello storico (evita diff duplicati via rete)
    local -A hist_diff_cache=()

    while true; do
        invalidate_local_cache "$orig_target"
        prefetch_local_paths_metadata true "$orig_target"

        local loc_state_str="Assente sul filesystem locale"
        if [[ "${LOC_EXISTS[$orig_target]:-0}" == "1" ]]; then
            loc_state_str="Presente (modificato: ${LOC_MTIME_HUMAN[$orig_target]:-}, ${LOC_SIZE[$orig_target]:-0} byte)"
        fi
        local delta_state_str="Assente nel delta (file eliminato)"
        if [[ -n "$active_delta_item" ]] && ensure_nas_stat "$active_delta_item"; then
            delta_state_str="Presente in ${owner_alias}-delta (modificato: ${NAS_MTIME_HUMAN[$active_delta_item]:-})"
        fi

        echo -e "\n${C_SLATE}============================================================================================${C_RESET}"
        echo -e " ${C_BOLD}REVISIONE STORICO HANOI:${C_RESET} ${orig_target} ${C_MUTED}(Nodo archivio: $owner_alias | Versioni: $count)${C_RESET}"
        echo -e " ${C_MUTED}Stato Locale : $loc_state_str${C_RESET}"
        echo -e " ${C_MUTED}Stato Delta  : $delta_state_str${C_RESET}"
        echo -e "${C_SLATE}============================================================================================${C_RESET}"
        printf " ${C_MUTED}%3s │ %-19s │ %-20s │ %-12s │ %-6s │ %s${C_RESET}\n" "#" "DATA SNAPSHOT" "SLOT HANOI" "EVENTO" "AUTORE" "CONFRONTO vs LOCALE"
        echo -e "${C_SLATE}─────┼─────────────────────┼──────────────────────┼──────────────┼────────┼───────────────────${C_RESET}"

        local loc_sha=""
        [[ "${LOC_EXISTS[$orig_target]:-0}" == "1" ]] && calc_target_sha256_into loc_sha "$orig_target"

        local i b_file b_payload base_name ev_label ev_col human_ts v_epoch slot_str author diff_vs_loc bak_sha dkey
        for (( i=0; i<count; i++ )); do
            b_file="${found_backups[$i]}"
            resolve_bak_payload_into b_payload "$b_file"
            base_name="${b_file##*/}"; base_name="${base_name%.bak}"
            ev_label="Modifica"; ev_col="$C_CYAN"
            if [[ "$base_name" == *_d ]]; then ev_label="Eliminaz."; ev_col="$C_RED"; fi
            inspect_bak_placeholder_cached "$b_file" && ev_label="${ev_label}[↪]"
            human_ts="${bak_humans[$i]}"; v_epoch="${bak_epochs[$i]:-0}"
            describe_hanoi_slot_into slot_str "$v_epoch" "$i" "$now_epoch"

            load_origin_metadata "$b_file"
            author="${ORIG_LAST_UPDATED_BY:-$owner_alias}"

            diff_vs_loc=""
            if [[ "${LOC_EXISTS[$orig_target]:-0}" != "1" ]]; then
                diff_vs_loc="${C_MUTED}(assente in locale)${C_RESET}"
            elif [[ "$ENC_MODE" != "none" || "$b_payload" == *.enc* || "$rel_hist" == *.enc ]]; then
                if [[ -n "$ORIG_SHA256" && "$loc_sha" == "$ORIG_SHA256" ]]; then
                    diff_vs_loc="${C_GREEN}[= Identico a Locale]${C_RESET}"
                else
                    diff_vs_loc="${C_YELLOW}[Cifrato - differente]${C_RESET}"
                fi
            elif [[ "${LOC_TYPE[$orig_target]:-}" == "f" ]] && nas_is_regular_file "$b_payload"; then
                bak_sha="$ORIG_SHA256"
                [[ -z "$bak_sha" ]] && calc_target_sha256_into bak_sha "$b_payload"
                if [[ "$loc_sha" == "$bak_sha" ]]; then
                    diff_vs_loc="${C_GREEN}[= Identico a Locale]${C_RESET}"
                else
                    dkey="${loc_sha}|${bak_sha:-$b_payload}"
                    if [[ -n "${hist_diff_cache[$dkey]:-}" ]]; then
                        diff_vs_loc="${hist_diff_cache[$dkey]}"
                    else
                        local st_a st_r
                        get_diff_summary_nums_into st_a st_r "$orig_target" "$b_payload"
                        diff_vs_loc="${C_GREEN}+${st_a}${C_RESET} / ${C_RED}-${st_r}${C_RESET} righe"
                        hist_diff_cache["$dkey"]="$diff_vs_loc"
                    fi
                fi
            else
                diff_vs_loc="${C_MUTED}(${ORIG_TYPE:-elemento})${C_RESET}"
            fi

            printf " %3d │ %-19s │ %-20s │ %b%-12s%b │ %-6s │ %b\n" \
                "$((i + 1))" "$human_ts" "$slot_str" "$ev_col" "$ev_label" "$C_RESET" "$author" "$diff_vs_loc"
        done
        echo -e "${C_SLATE}============================================================================================${C_RESET}"

        local sel_idx=""
        read -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Seleziona il numero dello snapshot da esaminare (1-${count}, INVIO=1, 'q'=esci): ")" sel_idx </dev/tty
        touch_lock_heartbeat
        [[ "${sel_idx,,}" == "q" ]] && return 1
        [[ -z "$sel_idx" ]] && sel_idx=1
        if [[ ! "$sel_idx" =~ ^[0-9]+$ ]] || (( sel_idx < 1 || sel_idx > count )); then
            echo -e "${C_YELLOW}[!]${C_RESET} Selezione non valida."
            continue
        fi

        local chosen_idx=$(( sel_idx - 1 ))
        local chosen_bak="${found_backups[$chosen_idx]}" chosen_payload="" chosen_base
        resolve_bak_payload_into chosen_payload "$chosen_bak"
        chosen_base="${chosen_bak##*/}"; chosen_base="${chosen_base%.bak}"; chosen_base="${chosen_base%_d}"
        load_origin_metadata "$chosen_bak"

        while true; do
            echo -e "\n${C_CYAN}[*]${C_RESET} Snapshot selezionato: ${C_BOLD}#${sel_idx} (${chosen_base})${C_RESET} — Autore: ${ORIG_LAST_UPDATED_BY:-$owner_alias} | Permessi: ${ORIG_OWNER:-root}:${ORIG_GROUP:-root} ${ORIG_MODE:-0644}"
            echo -e "    Opzioni di revisione:"
            echo -e "      [1 / INVIO] Procedi al ripristino di questo snapshot"
            echo -e "      [d]         Diff rispetto al file Locale attuale ($orig_target)"
            [[ -n "$active_delta_item" ]] && echo -e "      [D]         Diff rispetto alla versione attuale nel Delta NAS"
            echo -e "      [v]         Visualizza contenuto integrale dello snapshot"
            echo -e "      [b]         Torna alla tabella delle versioni Hanoi"
            echo -e "      [q]         Annulla ed esci"

            read_single_key "${C_CYAN}[?]${C_RESET} Scegli azione [1/INVIO=Ripristina | d=Diff Loc | D=Diff NAS | v=Vista | b=Indietro | q=Esci]: "
            case "$REPLY_KEY" in
                ""|1)
                    SELECTED_BAK_SRC="$chosen_bak"
                    [[ "$selection_only" == true ]] && return 0

                    echo -e "\n    Modalità di applicazione dello snapshot ${C_BOLD}#${sel_idx}${C_RESET}:"
                    echo -e "      [1 / INVIO] Rollback Completo (Ripristina in Locale + Allinea subito il Delta sul NAS) ${C_MUTED}[Consigliata]${C_RESET}"
                    echo -e "      [2]         Ripristino Solo Locale (Lascia invariato il Delta sul NAS per test temporaneo)"
                    read_single_key "${C_CYAN}[?]${C_RESET} Scegli modalità [1/INVIO=Completa | 2=Solo Locale | altro=Indietro]: "

                    local apply_mode=""
                    if [[ -z "$REPLY_KEY" || "$REPLY_KEY" == "1" ]]; then apply_mode="full"
                    elif [[ "$REPLY_KEY" == "2" ]]; then apply_mode="local_only"
                    else continue; fi

                    confirm_double "Confermi il ripristino dello snapshot #${sel_idx} (${chosen_base}) in '$orig_target'?" "Sovrascrivere '$orig_target' con la versione storica selezionata?" || continue

                    if [[ "$apply_mode" == "full" ]]; then
                        acquire_nas_lock
                    fi

                    install_nas_item_to_local "$chosen_bak" "$orig_target"

                    if [[ "$apply_mode" == "full" ]]; then
                        local ts_now now_sec; now_ts_into ts_now; now_epoch_into now_sec
                        touch -h -d "@$now_sec" "$orig_target" 2>/dev/null || true
                        invalidate_local_cache "$orig_target"

                        local target_delta_file="$active_delta_item"
                        if [[ -z "$target_delta_file" ]]; then
                            target_delta_file="$owner_delta_root/$rel_hist"
                            local td_dir; path_dirname_into td_dir "$target_delta_file"
                            [[ -d "$td_dir" ]] || mkdir -p "$td_dir"
                            if [[ -f "${chosen_bak}.origin.txt" && ! -f "${target_delta_file}.origin.txt" ]]; then
                                cp -fp "${chosen_bak}.origin.txt" "${target_delta_file}.origin.txt" 2>/dev/null || cp -f "${chosen_bak}.origin.txt" "${target_delta_file}.origin.txt"
                                invalidate_nas_cache "${target_delta_file}.origin.txt"
                            fi
                        fi
                        push_local_item_to_nas "$orig_target" "$target_delta_file" "$ts_now" "$owner_delta_root" "$owner_bak_root" "$owner_alias"
                        echo -e "${C_GREEN}[+]${C_RESET} Rollback completo eseguito: '$orig_target' ripristinato e allineato sul NAS."
                    else
                        echo -e "${C_GREEN}[+]${C_RESET} Snapshot ripristinato solo localmente in: $orig_target"
                    fi

                    update_status_cache true
                    return 0
                    ;;
                d)
                    if [[ ! -f "$orig_target" || -L "$orig_target" ]]; then
                        echo -e "${C_YELLOW}[!]${C_RESET} Il file locale '$orig_target' non esiste (o è un symlink)."
                    elif [[ "$ENC_MODE" != "none" || "$rel_hist" == *.enc ]]; then
                        get_work_tmp_dir
                        local tmp_dec="$WORK_TMP_DIR/hdiff.dec"
                        decrypt_payload "$chosen_payload" "$tmp_dec" "$ORIG_MK_FP"
                        render_full_diff "$orig_target" "$tmp_dec" "$orig_target (Locale vs Snapshot #${sel_idx})"
                        rm -f "$tmp_dec"
                    else
                        render_full_diff "$orig_target" "$chosen_payload" "$orig_target (Locale vs Snapshot #${sel_idx})"
                    fi
                    ;;
                D)
                    if [[ -z "$active_delta_item" || ! -f "$active_delta_item" ]]; then
                        echo -e "${C_YELLOW}[!]${C_RESET} Nessuna versione attiva presente nel Delta NAS."
                    elif [[ "$ENC_MODE" != "none" || "$rel_hist" == *.enc ]]; then
                        get_work_tmp_dir
                        local tmp_dec_bak="$WORK_TMP_DIR/hbak.dec" tmp_dec_nas="$WORK_TMP_DIR/hnas.dec"
                        decrypt_payload "$chosen_payload" "$tmp_dec_bak" "$ORIG_MK_FP"
                        decrypt_payload "$active_delta_item" "$tmp_dec_nas" "$ORIG_MK_FP"
                        render_full_diff "$tmp_dec_nas" "$tmp_dec_bak" "$orig_target (Delta NAS vs Snapshot #${sel_idx})"
                        rm -f "$tmp_dec_bak" "$tmp_dec_nas"
                    else
                        render_full_diff "$active_delta_item" "$chosen_payload" "$orig_target (Delta NAS vs Snapshot #${sel_idx})"
                    fi
                    ;;
                v|V)
                    echo -e "\n${C_SLATE}─── CONTENUTO SNAPSHOT #${sel_idx} (${chosen_base}): ${orig_target} ───${C_RESET}"
                    if [[ "$ENC_MODE" != "none" || "$rel_hist" == *.enc ]]; then
                        get_work_tmp_dir
                        local tmp_dec="$WORK_TMP_DIR/hview.dec"
                        decrypt_payload "$chosen_payload" "$tmp_dec" "$ORIG_MK_FP"
                        nl -ba "$tmp_dec"
                        rm -f "$tmp_dec"
                    else
                        nl -ba "$chosen_payload"
                    fi
                    echo -e "${C_SLATE}──────────────────────────────────────────────────────────────────────────────${C_RESET}"
                    ;;
                b|B) break ;;
                q|Q) echo -e "${C_RED}[-]${C_RESET} Revisione storico terminata."; exit 0 ;;
                *) echo -e "${C_YELLOW}[!]${C_RESET} Tasto non valido." ;;
            esac
        done
    done
}

run_history_mode() {
    # Lazy lock: non acquisisce il lock in sola consultazione/diff
    index_all_nas_deltas

    local filter_query="${POSITIONAL_ARGS[0]:-}" filter_clean=""
    [[ -n "$filter_query" ]] && strip_nas_rel_into filter_clean "$filter_query"

    local hist_dirs=() hist_owners=() hist_orig_paths=() hist_counts=()
    local hist_latest_ts=() hist_status_str=() hist_status_col=()
    local -A seen_hist=()

    if [[ -d "$RESOLVED_BAK_DIR" ]]; then
        local -A bak_cnt_map=() bak_max_map=()
        local discovered_hdirs=() bf h_dir bname prev_cnt
        while IFS= read -r -d '' bf; do
            h_dir="${bf%/*}"
            [[ "$h_dir" == *.hist ]] || continue
            bname="${bf##*/}"
            if [[ -z "${bak_cnt_map[$h_dir]:-}" ]]; then
                bak_cnt_map["$h_dir"]=1; bak_max_map["$h_dir"]="$bname"
                discovered_hdirs+=("$h_dir")
            else
                prev_cnt="${bak_cnt_map[$h_dir]}"
                bak_cnt_map["$h_dir"]=$(( prev_cnt + 1 ))
                [[ "$bname" > "${bak_max_map[$h_dir]}" ]] && bak_max_map["$h_dir"]="$bname"
            fi
        done < <(LC_ALL=C find "$RESOLVED_BAK_DIR" -type f -name "*.bak" -print0 2>/dev/null || true)

        (( ${#discovered_hdirs[@]} > 1 )) && sort_null_array discovered_hdirs

        local rel_h rel_c o_path latest_b l_date l_time
        for h_dir in "${discovered_hdirs[@]}"; do
            rel_h="${h_dir#$RESOLVED_BAK_DIR/}"; rel_h="${rel_h%.hist}"
            strip_nas_rel_into rel_c "$rel_h"
            o_path="/$rel_c"
            if [[ -n "$filter_clean" && "$o_path" != *"$filter_clean"* && "$rel_c" != *"$filter_clean"* ]]; then
                continue
            fi

            seen_hist["$h_dir"]=1
            hist_dirs+=("$h_dir"); hist_owners+=("$ACTIVE_ALIAS"); hist_orig_paths+=("$o_path")
            hist_counts+=("${bak_cnt_map[$h_dir]}")
            latest_b="${bak_max_map[$h_dir]%.bak}"; latest_b="${latest_b%_d}"
            l_date="${latest_b%_*}"; l_time="${latest_b#*_}"
            hist_latest_ts+=("$l_date ${l_time//-/:}")

            if nas_path_exists_or_link "$RESOLVED_DELTA_DIR/$rel_c" || nas_path_exists_or_link "$RESOLVED_DELTA_DIR/${rel_c}.enc" || nas_path_exists_or_link "$RESOLVED_DELTA_DIR/${rel_c}.tar.gz.enc"; then
                hist_status_str+=("[=] Attivo ($ACTIVE_ALIAS)"); hist_status_col+=("$C_GREEN")
            else
                hist_status_str+=("[✕] Eliminato"); hist_status_col+=("$C_RED")
            fi
        done
    fi

    local ph_file rel_c o_path src_bak_root h_cand
    local nullglob_was_set=false
    shopt -q nullglob && nullglob_was_set=true
    shopt -s nullglob
    for ph_file in "${DELTA_SHARED_FILES[@]}"; do
        load_shared_placeholder "$ph_file" || continue
        [[ -z "$PH_SHARED_SOURCE" ]] && continue
        normalize_local_rel_into rel_c "$PH_ORIG_PATH"
        o_path="/$rel_c"
        if [[ -n "$filter_clean" && "$o_path" != *"$filter_clean"* && "$rel_c" != *"$filter_clean"* ]]; then
            continue
        fi

        src_bak_root="$LINUX_ROOT/${SYS_FOLDER_MAP[$PH_SHARED_SOURCE]:-}/$BACKUP_DIR_NAME"
        for h_cand in "$src_bak_root/${rel_c}.hist" "$src_bak_root/${rel_c}.enc.hist" "$src_bak_root/${rel_c}.tar.gz.enc.hist"; do
            if [[ -d "$h_cand" && -z "${seen_hist[$h_cand]:-}" ]]; then
                local b_list=("$h_cand"/*.bak)
                (( ${#b_list[@]} == 0 )) && continue
                local max_b="" b_it bn
                for b_it in "${b_list[@]}"; do
                    bn="${b_it##*/}"
                    [[ -z "$max_b" || "$bn" > "$max_b" ]] && max_b="$bn"
                done

                seen_hist["$h_cand"]=1
                hist_dirs+=("$h_cand"); hist_owners+=("$PH_SHARED_SOURCE"); hist_orig_paths+=("$o_path")
                hist_counts+=("${#b_list[@]}")
                local latest_b="${max_b%.bak}"; latest_b="${latest_b%_d}"
                local l_date="${latest_b%_*}" l_time="${latest_b#*_}"
                hist_latest_ts+=("$l_date ${l_time//-/:}")
                hist_status_str+=("[⇄] Shared ($PH_SHARED_SOURCE)"); hist_status_col+=("$C_CYAN")
            fi
        done
    done
    [[ "$nullglob_was_set" == false ]] && shopt -u nullglob

    local total_h=${#hist_dirs[@]}
    if (( total_h == 0 )); then
        if [[ -n "$filter_query" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Nessuno storico Hanoi trovato per il filtro: $filter_query" >&2
        else
            echo -e "${C_MUTED}[*] Nessun archivio storico (.hist) presente per il profilo '$ACTIVE_ALIAS'.${C_RESET}"
        fi
        exit 0
    fi

    if (( total_h == 1 )); then
        inspect_and_restore_hist_dir "${hist_dirs[0]}" "${hist_owners[0]}" false || true
        exit 0
    fi

    while true; do
        echo -e "\n${C_SLATE}============================================================================================${C_RESET}"
        echo -e " ${C_BOLD}ARCHIVI STORICI HANOI DISPONIBILI — PROFILO:${C_RESET} ${ACTIVE_ALIAS} (${total_h} file trovati)"
        echo -e "${C_SLATE}============================================================================================${C_RESET}"
        printf " ${C_MUTED}%3s │ %-18s │ %-8s │ %-19s │ %s${C_RESET}\n" "ID" "STATO DELTA" "VERSIONI" "ULTIMO SNAPSHOT" "PERCORSO FILE"
        echo -e "${C_SLATE}─────┼────────────────────┼──────────┼─────────────────────┼────────────────────────────────${C_RESET}"

        local i
        for (( i=0; i<total_h; i++ )); do
            printf " %3d │ %b%-18s%b │ %8d │ %-19s │ %s\n" \
                "$((i + 1))" "${hist_status_col[$i]}" "${hist_status_str[$i]}" "$C_RESET" \
                "${hist_counts[$i]}" "${hist_latest_ts[$i]}" "${hist_orig_paths[$i]}"
        done
        echo -e "${C_SLATE}============================================================================================${C_RESET}"

        local sel_id=""
        read -r -p "$(echo -e "${C_CYAN}[?]${C_RESET} Seleziona l'ID del file da ispezionare (1-${total_h}, 'q' per uscire): ")" sel_id </dev/tty
        if [[ "${sel_id,,}" == "q" || -z "$sel_id" ]]; then
            echo -e "${C_MUTED}[*] Uscita dallo storico Hanoi.${C_RESET}"
            exit 0
        fi
        if [[ ! "$sel_id" =~ ^[0-9]+$ ]] || (( sel_id < 1 || sel_id > total_h )); then
            echo -e "${C_YELLOW}[!]${C_RESET} ID non valido."
            continue
        fi
        inspect_and_restore_hist_dir "${hist_dirs[$(( sel_id - 1 ))]}" "${hist_owners[$(( sel_id - 1 ))]}" false || true
    done
    return 0
}

search_in_bakup_auto() {
    local search_bak_dir="$1" rel_query="$2" owner_label="$3"
    local matched_hist="" hist_cand
    for hist_cand in "$search_bak_dir/${rel_query}.hist" "$search_bak_dir/${rel_query}.enc.hist" "$search_bak_dir/${rel_query}.tar.gz.enc.hist"; do
        if [[ -d "$hist_cand" ]]; then matched_hist="$hist_cand"; break; fi
    done
    if [[ -z "$matched_hist" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Nessuna copia storica di '/$rel_query' trovata in $BACKUP_DIR_NAME ($owner_label)." >&2
        exit 1
    fi
    if ! inspect_and_restore_hist_dir "$matched_hist" "$owner_label" true; then
        echo -e "${C_RED}[-]${C_RESET} Selezione dallo storico annullata."
        exit 0
    fi
    return 0
}

# Resolver unificato dei percorsi su NAS per --diff e --restore
resolve_nas_target_for_query() {
    local raw_query="$1" allow_cross_delta="${2:-false}"
    RESOLVED_QUERY_LOCAL=$(realpath -s -m "$raw_query")
    RESOLVED_QUERY_NAS=""
    RESOLVED_QUERY_OWNER="$ACTIVE_ALIAS"
    RESOLVED_QUERY_HIST=""
    RESOLVED_QUERY_SHARED_MISS=false
    RESOLVED_QUERY_REL=""

    if [[ "$RESOLVED_QUERY_LOCAL" == "$RESOLVED_LINUX_ROOT/"* ]]; then
        local q_nas="$RESOLVED_QUERY_LOCAL"
        [[ "$q_nas" == *.origin.txt ]] && q_nas="${q_nas%.origin.txt}"
        if [[ "$q_nas" == *.shared ]] && nas_is_regular_file "$q_nas"; then
            load_shared_placeholder "$q_nas"
            RESOLVED_QUERY_OWNER="$PH_SHARED_SOURCE"
            normalize_local_rel_into RESOLVED_QUERY_REL "$PH_ORIG_PATH"
            local src_bak="$LINUX_ROOT/${SYS_FOLDER_MAP[$PH_SHARED_SOURCE]:-}/$BACKUP_DIR_NAME" hc
            for hc in "$src_bak/${RESOLVED_QUERY_REL}.hist" "$src_bak/${RESOLVED_QUERY_REL}.enc.hist" "$src_bak/${RESOLVED_QUERY_REL}.tar.gz.enc.hist"; do
                [[ -d "$hc" ]] && { RESOLVED_QUERY_HIST="$hc"; break; }
            done
            if [[ -n "$PH_RESOLVED_SOURCE_FILE" ]]; then
                RESOLVED_QUERY_NAS="$PH_RESOLVED_SOURCE_FILE"
            else
                RESOLVED_QUERY_SHARED_MISS=true
            fi
        elif nas_path_exists_or_link "$q_nas"; then
            RESOLVED_QUERY_NAS="$q_nas"
        fi
        return 0
    fi

    normalize_local_rel_into RESOLVED_QUERY_REL "$RESOLVED_QUERY_LOCAL"
    local candidate_delta="$RESOLVED_DELTA_DIR/$RESOLVED_QUERY_REL" hc

    if nas_is_regular_file "${candidate_delta}.shared"; then
        load_shared_placeholder "${candidate_delta}.shared"
        RESOLVED_QUERY_OWNER="$PH_SHARED_SOURCE"
        local src_bak="$LINUX_ROOT/${SYS_FOLDER_MAP[$PH_SHARED_SOURCE]:-}/$BACKUP_DIR_NAME"
        for hc in "$src_bak/${RESOLVED_QUERY_REL}.hist" "$src_bak/${RESOLVED_QUERY_REL}.enc.hist" "$src_bak/${RESOLVED_QUERY_REL}.tar.gz.enc.hist"; do
            [[ -d "$hc" ]] && { RESOLVED_QUERY_HIST="$hc"; break; }
        done
        if [[ -n "$PH_RESOLVED_SOURCE_FILE" ]]; then
            RESOLVED_QUERY_NAS="$PH_RESOLVED_SOURCE_FILE"
        else
            RESOLVED_QUERY_SHARED_MISS=true
        fi
        return 0
    fi

    for hc in "$RESOLVED_BAK_DIR/${RESOLVED_QUERY_REL}.hist" "$RESOLVED_BAK_DIR/${RESOLVED_QUERY_REL}.enc.hist" "$RESOLVED_BAK_DIR/${RESOLVED_QUERY_REL}.tar.gz.enc.hist"; do
        [[ -d "$hc" ]] && { RESOLVED_QUERY_HIST="$hc"; break; }
    done

    local cand
    for cand in "$candidate_delta" "${candidate_delta}.enc" "${candidate_delta}.tar.gz.enc"; do
        if nas_path_exists_or_link "$cand"; then
            RESOLVED_QUERY_NAS="$cand"; return 0
        fi
    done

    if [[ "$allow_cross_delta" == true ]]; then
        local a d
        for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
            d="${SYS_DELTA_MAP[$a]:-}"
            [[ -z "$d" ]] && continue
            if nas_is_regular_file "$d/${RESOLVED_QUERY_REL}.shared"; then
                load_shared_placeholder "$d/${RESOLVED_QUERY_REL}.shared"
                [[ -n "$PH_RESOLVED_SOURCE_FILE" ]] && { RESOLVED_QUERY_NAS="$PH_RESOLVED_SOURCE_FILE"; RESOLVED_QUERY_OWNER="$PH_SHARED_SOURCE"; return 0; }
            fi
            for cand in "$d/$RESOLVED_QUERY_REL" "$d/${RESOLVED_QUERY_REL}.enc" "$d/${RESOLVED_QUERY_REL}.tar.gz.enc"; do
                if nas_path_exists_or_link "$cand"; then
                    RESOLVED_QUERY_NAS="$cand"; RESOLVED_QUERY_OWNER="$a"; return 0
                fi
            done
        done
    fi
    return 0
}

run_diff_mode() {
    if [[ ${#POSITIONAL_ARGS[@]} -eq 0 ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: specifica il percorso del file di cui vuoi vedere le differenze." >&2
        echo -e "${C_MUTED}    Uso: nc-hanoi --diff <percorso_locale_o_nas>${C_RESET}" >&2
        exit 1
    fi

    local raw_target="${POSITIONAL_ARGS[0]}"
    resolve_nas_target_for_query "$raw_target" true
    local nas_src="$RESOLVED_QUERY_NAS"

    if [[ -z "$nas_src" ]] || ! nas_path_exists_or_link "$nas_src"; then
        echo -e "${C_RED}[-]${C_RESET} Impossibile trovare la versione corrispondente sul NAS per: $raw_target" >&2
        exit 1
    fi

    load_origin_metadata "$nas_src"
    local payload_src=""
    resolve_bak_payload_into payload_src "$nas_src"
    local local_target="${ORIG_PATH:-$RESOLVED_QUERY_LOCAL}"

    if [[ ! -e "$local_target" && ! -L "$local_target" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Il file locale non esiste sul filesystem: $local_target" >&2
        exit 1
    fi
    if [[ -L "$local_target" || -L "$payload_src" || "$ORIG_TYPE" == "symlink" ]]; then
        echo -e "${C_YELLOW}[!]${C_RESET} Impossibile mostrare il diff testuale per i symlink."
        echo -e "    Locale target : $(readlink "$local_target" 2>/dev/null || echo 'N/A')"
        echo -e "    NAS target    : ${ORIG_SYMLINK_TARGET:-N/A}"
        exit 0
    fi
    if [[ -d "$local_target" || -d "$payload_src" || "$ORIG_TYPE" == "directory" || "$payload_src" == *.tar.gz.enc ]]; then
        echo -e "${C_SLATE}==============================================================================${C_RESET}"
        echo -e " ${C_BOLD}CONFRONTO CARTELLA:${C_RESET} $local_target"
        if [[ -d "$local_target" ]]; then
            calc_dir_stats "$local_target"
            echo -e " ${C_RED}- Struttura LOCALE : $DIR_SIZE_HUMAN ($DIR_FILES file, $DIR_SUBDIRS sottocartelle)${C_RESET}"
        fi
        echo -e " ${C_GREEN}+ Struttura NAS    : ${ORIG_SIZE_HUMAN:-?} (${ORIG_FILES:-?} file, ${ORIG_SUBDIRS:-?} sottocartelle)${C_RESET}"
        echo -e "${C_SLATE}==============================================================================${C_RESET}"
        exit 0
    fi

    if [[ "$ENC_MODE" != "none" || "$payload_src" == *.enc ]]; then
        echo -e "${C_YELLOW}[!]${C_RESET} Il file sul NAS è cifrato. Decifrazione temporanea per il confronto..."
        get_work_tmp_dir
        local temp_dec="$WORK_TMP_DIR/diff.dec"
        decrypt_payload "$payload_src" "$temp_dec" "$ORIG_MK_FP"
        render_full_diff "$local_target" "$temp_dec" "$local_target"
        rm -f "$temp_dec"
    else
        render_full_diff "$local_target" "$payload_src" "$local_target"
    fi
    exit 0
}

run_restore_mode() {
    if [[ ${#POSITIONAL_ARGS[@]} -lt 1 || ${#POSITIONAL_ARGS[@]} -gt 2 ]]; then
        echo -e "${C_RED}[-]${C_RESET} Errore: specifica il percorso sorgente (ed eventualmente la destinazione)." >&2
        echo -e "${C_MUTED}    Uso: nc-hanoi -r <percorso_sorgente> [percorso_destinazione]${C_RESET}" >&2
        exit 1
    fi

    acquire_nas_lock
    local ts; now_ts_into ts
    local raw_src="${POSITIONAL_ARGS[0]}"

    resolve_nas_target_for_query "$raw_src" false
    local nas_src="$RESOLVED_QUERY_NAS"
    local resolved_src="$RESOLVED_QUERY_LOCAL"
    local effective_source_host="$RESOLVED_QUERY_OWNER"
    local avail_hist_dir="$RESOLVED_QUERY_HIST"

    if [[ "$RESOLVED_QUERY_SHARED_MISS" == true ]]; then
        local src_bak="$LINUX_ROOT/${SYS_FOLDER_MAP[$effective_source_host]:-}/$BACKUP_DIR_NAME"
        echo -e "${C_YELLOW}[!]${C_RESET} Il file sorgente indicato dal placeholder ($effective_source_host) non è più nel delta attivo."
        confirm_enter "Vuoi cercarlo nello storico $BACKUP_DIR_NAME di '$effective_source_host'?"
        search_in_bakup_auto "$src_bak" "$RESOLVED_QUERY_REL" "$effective_source_host"
        nas_src="$SELECTED_BAK_SRC"
    elif [[ -z "$nas_src" ]]; then
        if [[ "$resolved_src" == "$RESOLVED_LINUX_ROOT/"* ]]; then
            echo -e "${C_RED}[-]${C_RESET} Errore: Elemento non trovato sul NAS: $resolved_src" >&2
            exit 1
        fi
        echo -e "${C_YELLOW}[!]${C_RESET} '$resolved_src' non è presente nel mirror delta di '$ACTIVE_ALIAS'."
        confirm_enter "Vuoi cercare nello storico dei backup automatici ($BACKUP_DIR_NAME)?"
        search_in_bakup_auto "$RESOLVED_BAK_DIR" "$RESOLVED_QUERY_REL" "$ACTIVE_ALIAS"
        nas_src="$SELECTED_BAK_SRC"
    elif [[ "$effective_source_host" != "$ACTIVE_ALIAS" ]]; then
        echo -e "${C_CYAN}[*]${C_RESET} Placeholder risolto (sorgente: ${C_BOLD}$effective_source_host${C_RESET}) -> $nas_src"
    else
        echo -e "${C_GREEN}[+]${C_RESET} Elemento individuato nel delta ($ACTIVE_ALIAS): $nas_src"
    fi

    load_origin_metadata "$nas_src"
    if [[ -z "$ORIG_PATH" && "$resolved_src" != "$RESOLVED_LINUX_ROOT/"* ]]; then
        ORIG_PATH="$resolved_src"
    fi
    if [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
        sanitize_origin_file_on_nas "$nas_src"
        [[ "$NAS_MODIFIED_OUT_OF_BAND" == true ]] && echo -e "${C_CYAN}[i]${C_RESET} Rilevata modifica diretta sul NAS: metadati .origin.txt riallineati automaticamente al file."
        load_origin_metadata "$nas_src"
    fi

    local final_dest_path=""
    if [[ ${#POSITIONAL_ARGS[@]} -eq 2 ]]; then
        local raw_dest="${POSITIONAL_ARGS[1]}" resolved_dest rbase
        resolved_dest=$(realpath -s -m "$raw_dest")
        path_basename_into rbase "$resolved_dest"
        if [[ -d "$resolved_dest" || "$raw_dest" == */ || "$rbase" != "$ORIG_NAME" ]]; then
            final_dest_path=$(realpath -s -m "$resolved_dest/$ORIG_NAME")
        else
            final_dest_path="$resolved_dest"
        fi
    else
        if [[ -z "$ORIG_PATH" ]]; then
            echo -e "${C_RED}[-]${C_RESET} Errore: Impossibile determinare il percorso originale. Specifica la destinazione." >&2
            exit 1
        fi
        final_dest_path=$(realpath -s -m "$ORIG_PATH")
    fi

    if [[ "$final_dest_path" == "$RESOLVED_LINUX_ROOT" || "$final_dest_path" == "$RESOLVED_LINUX_ROOT/"* ]]; then
        echo -e "${C_RED}[-]${C_RESET} ERRORE DI SICUREZZA: Non è consentito ripristinare file dentro la cartella del NAS ($LINUX_ROOT)." >&2
        exit 1
    fi

    local dest_parent; path_dirname_into dest_parent "$final_dest_path"
    prefetch_local_paths_metadata true "$final_dest_path" "$dest_parent"

    if [[ -z "$ORIG_OWNER" || -z "$ORIG_GROUP" ]]; then
        if [[ "${LOC_EXISTS[$final_dest_path]:-0}" == "1" ]]; then
            ORIG_OWNER="${LOC_OWNER[$final_dest_path]:-root}"; ORIG_GROUP="${LOC_GROUP[$final_dest_path]:-root}"
            ORIG_UID="${LOC_UID[$final_dest_path]:-0}"; ORIG_GID="${LOC_GID[$final_dest_path]:-0}"
        elif [[ "${LOC_EXISTS[$dest_parent]:-0}" == "1" ]]; then
            ORIG_OWNER="${LOC_OWNER[$dest_parent]:-root}"; ORIG_GROUP="${LOC_GROUP[$dest_parent]:-root}"
            ORIG_UID="${LOC_UID[$dest_parent]:-0}"; ORIG_GID="${LOC_GID[$dest_parent]:-0}"
        else
            ORIG_OWNER="${SUDO_USER:-root}"; ORIG_GROUP="${SUDO_USER:-root}"
            user_exists_cached "$ORIG_OWNER" && ORIG_UID="${USER_UID_CACHE[$ORIG_OWNER]:-0}" || ORIG_UID="0"
            if group_exists_cached "$ORIG_GROUP"; then ORIG_GID="${GROUP_GID_CACHE[$ORIG_GROUP]:-0}"
            elif user_exists_cached "$ORIG_OWNER"; then ORIG_GID=$(id -g "$ORIG_OWNER" 2>/dev/null || echo "0")
            else ORIG_GID="0"; fi
        fi
    fi
    if [[ -z "$ORIG_MODE" ]]; then
        if [[ "${LOC_EXISTS[$final_dest_path]:-0}" == "1" ]]; then ORIG_MODE="${LOC_MODE[$final_dest_path]:-0600}"
        elif [[ "$ORIG_TYPE" == "directory" ]]; then ORIG_MODE="0755"
        else ORIG_MODE="0600"; fi
    fi

    local uid_gid_info=""
    [[ -n "$ORIG_UID" || -n "$ORIG_GID" ]] && uid_gid_info=" [UID:${ORIG_UID:-?} GID:${ORIG_GID:-?}]"

    local hist_count=0
    if [[ -n "$avail_hist_dir" && -d "$avail_hist_dir" ]]; then
        local nullglob_was_set=false; shopt -q nullglob && nullglob_was_set=true; shopt -s nullglob
        local h_baks=("$avail_hist_dir"/*.bak)
        [[ "$nullglob_was_set" == false ]] && shopt -u nullglob
        hist_count=${#h_baks[@]}
    fi

    local owner_alias="${ORIG_SHARED_SOURCE:-$effective_source_host}"
    local owner_delta_dir="${SYS_DELTA_MAP[$owner_alias]:-$RESOLVED_DELTA_DIR}"
    local owner_bak_dir="$LINUX_ROOT/${SYS_FOLDER_MAP[$owner_alias]:-$ACTIVE_FOLDER}/$BACKUP_DIR_NAME"

    if [[ "$ORIG_TYPE" == "directory" || -d "$nas_src" || "$nas_src" == *.tar.gz.enc ]]; then
        if [[ -d "$nas_src" && -z "$ORIG_FILES" ]]; then
            calc_dir_stats "$nas_src"
            ORIG_SIZE_HUMAN="$DIR_SIZE_HUMAN"; ORIG_SIZE_BYTES="$DIR_SIZE_BYTES"
            ORIG_SUBDIRS="$DIR_SUBDIRS"; ORIG_FILES="$DIR_FILES"; ORIG_SYMLINKS="$DIR_SYMLINKS"
        fi
        echo -e "\n${C_YELLOW}[!]${C_RESET} ATTENZIONE: Stai per ripristinare un'intera CARTELLA:"
        echo -e "    Sorgente NAS   : $nas_src ${C_MUTED}(nodo sorgente: $owner_alias, ultimo agg.: ${ORIG_LAST_UPDATED_BY:-$owner_alias})${C_RESET}"
        echo -e "    Destinazione   : $final_dest_path"
        echo -e "    Proprietario   : ${C_MUTED}${ORIG_OWNER}:${ORIG_GROUP}${uid_gid_info} (permessi radice: $ORIG_MODE)${C_RESET}"
        [[ -n "$ORIG_SIZE_HUMAN" ]] && echo -e "    Dimensione tot : ${C_MUTED}$ORIG_SIZE_HUMAN (${ORIG_SIZE_BYTES:-?} byte)${C_RESET}"
        [[ -n "$ORIG_FILES" ]] && echo -e "    Struttura      : ${C_MUTED}${ORIG_SUBDIRS:-0} sottocartelle, ${ORIG_FILES:-0} file, ${ORIG_SYMLINKS:-0} symlink${C_RESET}"
    else
        echo -e "\n${C_CYAN}[*]${C_RESET} Riepilogo ripristino (${ORIG_TYPE}):"
        echo -e "    Sorgente NAS : $nas_src ${C_MUTED}(nodo sorgente: $owner_alias, ultimo agg.: ${ORIG_LAST_UPDATED_BY:-$owner_alias})${C_RESET}"
        echo -e "    Destinazione : $final_dest_path"
        echo -e "    Proprietario : ${C_MUTED}${ORIG_OWNER}:${ORIG_GROUP}${uid_gid_info} (permessi: $ORIG_MODE)${C_RESET}"
        (( hist_count > 0 )) && echo -e "    Storico Hanoi: ${C_MUTED}${hist_count} snapshot precedenti disponibili${C_RESET}"
    fi

    if [[ "${LOC_EXISTS[$final_dest_path]:-0}" == "1" ]]; then
        local dest_sha="" nas_true_sha=""
        calc_target_sha256_into dest_sha "$final_dest_path"
        get_true_nas_sha256_from_loaded_into nas_true_sha "$nas_src"
        local dest_mtime="${LOC_MTIME[$final_dest_path]:-0}" dest_owner="${LOC_OWNER[$final_dest_path]:-root}"
        local dest_group="${LOC_GROUP[$final_dest_path]:-root}" dest_mode="${LOC_MODE[$final_dest_path]:-0644}"

        if [[ -n "$nas_true_sha" && "$dest_sha" == "$nas_true_sha" ]]; then
            if [[ "$dest_mode" != "$ORIG_MODE" || "$dest_owner" != "$ORIG_OWNER" || "$dest_group" != "$ORIG_GROUP" ]]; then
                echo -e "${C_YELLOW}[!]${C_RESET} Contenuto identico, ma permessi locali differenti (${dest_owner}:${dest_group} ${dest_mode} vs NAS ${ORIG_OWNER}:${ORIG_GROUP} ${ORIG_MODE})."
            else
                echo -e "${C_GREEN}[=]${C_RESET} Il file locale è già IDENTICO per contenuto e permessi alla versione sul NAS."
            fi
            confirm_double_or_exit "Vuoi procedere comunque per riapplicare il file e i metadati?" "Sovrascrivere '$final_dest_path' riapplicando permessi e metadati?"
        else
            prompt_conflict_diff_and_choice "RESTORE" "$final_dest_path" "$nas_src" "$dest_mtime" "${ORIG_MTIME:-0}" "$ORIG_MTIME_HUMAN" "$ENC_MODE" "$NAS_MODIFIED_OUT_OF_BAND" ""
            if [[ "$CONFLICT_CHOICE" == "SKIP" ]]; then
                echo -e "${C_RED}[-]${C_RESET} Ripristino annullato/saltato per: $final_dest_path"; exit 0
            elif [[ "$CONFLICT_CHOICE" == "LOCAL" ]]; then
                if [[ "$nas_src" == "$owner_delta_dir/"* ]]; then
                    push_local_item_to_nas "$final_dest_path" "$nas_src" "$ts" "$owner_delta_dir" "$owner_bak_dir" "$owner_alias"
                    update_status_cache true
                    echo -e "${C_GREEN}[+]${C_RESET} Mantenuta copia locale e inviata sul NAS (copia NAS storicizzata in $BACKUP_DIR_NAME): $final_dest_path"
                else
                    echo -e "${C_GREEN}[=]${C_RESET} Mantenuta copia locale invariata: $final_dest_path"
                fi
                exit 0
            elif [[ "$CONFLICT_CHOICE" == "NAS" ]]; then
                [[ "$nas_src" == "$owner_delta_dir/"* ]] && archive_local_item_to_bak "$final_dest_path" "$nas_src" "$owner_delta_dir" "$owner_bak_dir" "$ts" "$owner_alias"
            fi
        fi
    else
        confirm_double_or_exit "Confermi il ripristino in '$final_dest_path'?" "Scrivere definitivamente '$final_dest_path' sul sistema locale?"
    fi

    install_nas_item_to_local "$nas_src" "$final_dest_path"
    update_status_cache true
    echo -e "${C_GREEN}[+]${C_RESET} Ripristinato con successo in: $final_dest_path"
    exit 0
}

run_update_mode() {
    acquire_nas_lock
    local ts; now_ts_into ts

    local self_path
    self_path=$(realpath -e "$0" 2>/dev/null || realpath -s "$0" 2>/dev/null || echo "/usr/lib/ncui/sbin/nc-hanoi")
    [[ ! -f "$self_path" && -f "/usr/lib/ncui/sbin/nc-hanoi" ]] && self_path="/usr/lib/ncui/sbin/nc-hanoi"

    local rel_self q_rel cand nas_src="" src_owner="$ACTIVE_ALIAS"
    normalize_local_rel_into rel_self "$self_path"

    for q_rel in "$rel_self" "usr/lib/ncui/sbin/nc-hanoi"; do
        cand="$RESOLVED_DELTA_DIR/$q_rel"
        if nas_is_regular_file "${cand}.shared"; then
            load_shared_placeholder "${cand}.shared"
            if [[ -n "$PH_RESOLVED_SOURCE_FILE" ]] && nas_is_regular_file "$PH_RESOLVED_SOURCE_FILE"; then
                nas_src="$PH_RESOLVED_SOURCE_FILE"; src_owner="$PH_SHARED_SOURCE"; break
            fi
        elif nas_is_regular_file "$cand"; then
            nas_src="$cand"; src_owner="$ACTIVE_ALIAS"; break
        elif nas_is_regular_file "${cand}.enc"; then
            nas_src="${cand}.enc"; src_owner="$ACTIVE_ALIAS"; break
        fi
    done

    if [[ -z "$nas_src" ]]; then
        local newest_mtime=0 a d m
        for a in "${ALL_DISCOVERED_ALIASES[@]}"; do
            d="${SYS_DELTA_MAP[$a]:-}"
            [[ -z "$d" ]] && continue
            for q_rel in "$rel_self" "usr/lib/ncui/sbin/nc-hanoi"; do
                cand="$d/$q_rel"
                if nas_is_regular_file "$cand"; then
                    m="${NAS_MTIME[$cand]:-0}"
                    if (( m > newest_mtime )); then
                        newest_mtime=$m; nas_src="$cand"; src_owner="$a"
                    fi
                fi
            done
        done
    fi

    if [[ -z "$nas_src" || ! -f "$nas_src" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Impossibile trovare una copia tracciata di '$self_path' nei delta del NAS." >&2
        exit 1
    fi

    load_origin_metadata "$nas_src"
    if [[ "$NAS_MODIFIED_OUT_OF_BAND" == true || "$ORIGIN_HAS_LEGACY_KEYS" == true ]]; then
        sanitize_origin_file_on_nas "$nas_src"
        load_origin_metadata "$nas_src"
    fi

    local target_local="${ORIG_PATH:-$self_path}"
    [[ -f "$target_local" ]] || target_local="$self_path"
    prefetch_local_paths_metadata true "$target_local"

    local sha_loc="" sha_nas=""
    calc_target_sha256_into sha_loc "$target_local"
    get_true_nas_sha256_from_loaded_into sha_nas "$nas_src"

    if [[ -n "$sha_nas" && "$sha_loc" == "$sha_nas" ]]; then
        echo -e "${C_GREEN}[=]${C_RESET} Lo script '$target_local' è già aggiornato all'ultima versione disponibile sul NAS (sorgente: $src_owner)."
        exit 0
    fi

    local local_mtime="${LOC_MTIME[$target_local]:-0}" nas_mtime="${ORIG_MTIME:-0}"
    local owner_delta_dir="${SYS_DELTA_MAP[$src_owner]:-$RESOLVED_DELTA_DIR}"
    local owner_bak_dir="$LINUX_ROOT/${SYS_FOLDER_MAP[$src_owner]:-$ACTIVE_FOLDER}/$BACKUP_DIR_NAME"

    prompt_conflict_diff_and_choice "UPDATE SCRIPT (sorgente: $src_owner)" "$target_local" "$nas_src" "$local_mtime" "$nas_mtime" "$ORIG_MTIME_HUMAN" "$ENC_MODE" "$NAS_MODIFIED_OUT_OF_BAND" ""

    if [[ "$CONFLICT_CHOICE" == "SKIP" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Aggiornamento dello script saltato."; exit 0
    elif [[ "$CONFLICT_CHOICE" == "LOCAL" ]]; then
        if ! bash -n "$target_local" 2>/dev/null; then
            echo -e "${C_RED}[-]${C_RESET} ERRORE CRITICO: Lo script locale ($target_local) contiene errori di sintassi Bash! Invio al NAS bloccato." >&2
            exit 1
        fi
        push_local_item_to_nas "$target_local" "$nas_src" "$ts" "$owner_delta_dir" "$owner_bak_dir" "$src_owner"
        update_status_cache true
        echo -e "${C_GREEN}[+]${C_RESET} Mantenuta versione locale dello script e aggiornata sul NAS (versione NAS precedente storicizzata)."
        exit 0
    elif [[ "$CONFLICT_CHOICE" == "NAS" ]]; then
        if [[ "$ENC_MODE" == "none" && "$nas_src" != *.enc ]]; then
            if ! bash -n "$nas_src" 2>/dev/null; then
                echo -e "${C_RED}[-]${C_RESET} ERRORE CRITICO: La versione dello script sul NAS ($nas_src) contiene errori di sintassi Bash! Aggiornamento bloccato." >&2
                exit 1
            fi
        fi
        archive_local_item_to_bak "$target_local" "$nas_src" "$owner_delta_dir" "$owner_bak_dir" "$ts" "$src_owner"
        install_nas_item_to_local "$nas_src" "$target_local"
        update_status_cache true
        echo -e "${C_GREEN}[+]${C_RESET} Script aggiornato con successo dalla versione NAS (copia locale precedente storicizzata): $target_local"
        exit 0
    fi
    return 0
}

rewrite_bak_placeholder_ref() {
    local ph_file="$1" new_ref="$2"
    local old_sha="${BAK_SHA_CACHE[$ph_file]:-}" old_m="${NAS_MTIME[$ph_file]:-}"
    printf '# NC-NAS-CONF BACKUP PLACEHOLDER\nREF_BAK=%s\nREF_SHA256=%s\n' "$new_ref" "$old_sha" > "$ph_file"
    [[ -n "$old_m" && "$old_m" =~ ^[0-9]+$ ]] && touch -d "@$old_m" "$ph_file" 2>/dev/null || true
    BAK_IS_PH_CACHE["$ph_file"]="1"
    BAK_REF_CACHE["$ph_file"]="$new_ref"
    return 0
}

prune_single_system() {
    local sys_alias="$1" sys_bak_dir="$2"
    if [[ ! -d "$sys_bak_dir" ]]; then
        echo -e "${C_MUTED}[*] Nessuna cartella $BACKUP_DIR_NAME per '$sys_alias'.${C_RESET}"
        return 0
    fi

    load_persistent_caches
    local now_epoch; now_epoch_into now_epoch
    local d30_epoch=$(( now_epoch - (30 * 86400) ))

    local raw_baks=() p fsize fts fts_norm fstamp h_dir
    while IFS= read -r -d '' p && IFS= read -r -d '' fsize && IFS= read -r -d '' fts; do
        norm_ts_into fts_norm "$fts"
        fstamp="${fts_norm}:${fsize}"
        NAS_TYPE["$p"]="f"; NAS_SIZE["$p"]="$fsize"; NAS_MTIME["$p"]="${fts%%.*}"
        NAS_FIND_STAMP["$p"]="$fstamp"
        unset 'NAS_DIRTY_PATHS[$p]'
        if [[ "$p" == *.bak ]]; then
            h_dir="${p%/*}"
            [[ "$h_dir" == *.hist ]] && raw_baks+=("$p")
        elif [[ "$p" == *.bak.origin.txt && "${PERSIST_SC_STAMP[$p]:-}" == "$fstamp" ]]; then
            ORIGIN_RAW_CACHE["$p"]="${PERSIST_SC_RAW[$p]:-}"
        fi
    done < <(LC_ALL=C find "$sys_bak_dir" -type f \( -name "*.bak" -o -name "*.bak.origin.txt" \) -printf '%p\0%s\0%T@\0' 2>/dev/null || true)

    local all_baks_flat=()
    if (( ${#raw_baks[@]} > 1 )); then
        mapfile -d '' -t all_baks_flat < <(printf '%s\0' "${raw_baks[@]}" | LC_ALL=C sort -zr)
    elif (( ${#raw_baks[@]} == 1 )); then
        all_baks_flat=("${raw_baks[0]}")
    fi

    local -A hist_bak_indices=()
    local hist_dirs_list=() idx bf_key
    for (( idx=0; idx<${#all_baks_flat[@]}; idx++ )); do
        bf_key="${all_baks_flat[$idx]}"; h_dir="${bf_key%/*}"
        if [[ -z "${hist_bak_indices[$h_dir]+x}" ]]; then
            hist_dirs_list+=("$h_dir"); hist_bak_indices["$h_dir"]="${idx} "
        else
            hist_bak_indices["$h_dir"]+="${idx} "
        fi
    done
    (( ${#hist_dirs_list[@]} > 1 )) && sort_null_array hist_dirs_list

    local flat_epochs=() flat_humans=()
    local -A bak_epoch_map=()
    if (( ${#all_baks_flat[@]} > 0 )); then
        batch_bak_epochs_from_files all_baks_flat flat_epochs flat_humans
        for (( idx=0; idx<${#all_baks_flat[@]}; idx++ )); do
            bak_epoch_map["${all_baks_flat[$idx]}"]="${flat_epochs[$idx]:-0}"
        done
    fi

    local files_tracked=${#hist_dirs_list[@]} files_to_delete=0 bytes_to_free=0
    local total_versions=${#all_baks_flat[@]} dedup_candidates=0
    local del_list_bak=() del_list_meta=()
    local dedup_target_files=() dedup_ref_names=() dedup_ref_shas=()

    local versions idx_list count i j bak_file v_epoch day_idx tz n tape_id mark_delete meta_file b_name
    for hist_dir in "${hist_dirs_list[@]}"; do
        versions=()
        read -r -a idx_list <<< "${hist_bak_indices[$hist_dir]}"
        for idx in "${idx_list[@]}"; do versions+=("${all_baks_flat[$idx]}"); done
        count=${#versions[@]}
        (( count <= 1 )) && continue

        local -A filled_tapes=() marked_for_del=() surviving_by_sha=()

        for (( i=0; i<count; i++ )); do
            bak_file="${versions[$i]}"
            v_epoch="${bak_epoch_map[$bak_file]:-0}"
            (( v_epoch == 0 )) && continue
            day_idx=$(( v_epoch / 86400 )); tz=0; n=$day_idx
            if (( n > 0 )); then
                while (( (n & 1) == 0 )); do tz=$(( tz + 1 )); n=$(( n >> 1 )); done
            fi
            tape_id=$tz; mark_delete=false
            if (( i == 0 || v_epoch > d30_epoch )); then filled_tapes["$tape_id"]=1
            elif [[ -z "${filled_tapes[$tape_id]:-}" ]]; then filled_tapes["$tape_id"]=1
            else mark_delete=true; fi

            if [[ "$mark_delete" == true ]]; then
                marked_for_del["$bak_file"]=1
                del_list_bak+=("$bak_file")
                files_to_delete=$(( files_to_delete + 1 ))
                meta_file="${bak_file}.origin.txt"
                if [[ "${NAS_TYPE[$meta_file]:-}" == "f" ]]; then
                    del_list_meta+=("$meta_file")
                    bytes_to_free=$(( bytes_to_free + ${NAS_SIZE[$meta_file]:-0} ))
                fi
            fi
        done

        for (( i=count-1; i>=0; i-- )); do
            bak_file="${versions[$i]}"; b_name="${bak_file##*/}"
            if [[ -n "${marked_for_del[$bak_file]:-}" ]]; then
                if inspect_bak_placeholder_cached "$bak_file"; then
                    bytes_to_free=$(( bytes_to_free + ${NAS_SIZE[$bak_file]:-0} ))
                else
                    local referenced_by_survivor=false other_f
                    for (( j=0; j<count; j++ )); do
                        other_f="${versions[$j]}"
                        [[ -n "${marked_for_del[$other_f]:-}" ]] && continue
                        if inspect_bak_placeholder_cached "$other_f" && [[ "${BAK_REF_CACHE[$other_f]:-}" == "$b_name" ]]; then
                            referenced_by_survivor=true; break
                        fi
                    done
                    [[ "$referenced_by_survivor" == false ]] && bytes_to_free=$(( bytes_to_free + ${NAS_SIZE[$bak_file]:-0} ))
                fi
                continue
            fi

            if ! inspect_bak_placeholder_cached "$bak_file"; then
                read_origin_sha_enc_fast "${bak_file}.origin.txt"
                local b_sha="$FAST_ORIG_SHA" b_enc="$FAST_ORIG_ENC"
                [[ -z "$b_sha" && "$b_enc" == "none" ]] && calc_target_sha256_into b_sha "$bak_file"

                if [[ -n "$b_sha" ]]; then
                    local key="${b_enc}:${b_sha}"
                    if [[ -z "${surviving_by_sha[$key]:-}" ]]; then
                        surviving_by_sha["$key"]="$b_name"
                    else
                        local canon_name="${surviving_by_sha[$key]}"
                        dedup_target_files+=("$bak_file")
                        dedup_ref_names+=("$canon_name")
                        dedup_ref_shas+=("$b_sha")
                        dedup_candidates=$(( dedup_candidates + 1 ))
                        local f_size="${NAS_SIZE[$bak_file]:-0}"
                        (( f_size > 96 )) && bytes_to_free=$(( bytes_to_free + f_size - 96 ))
                    fi
                fi
            fi
        done
    done

    local avg_redundancy="0.0"
    if (( files_tracked > 0 )); then
        local tenths=$(( (total_versions * 10 + files_tracked / 2) / files_tracked ))
        avg_redundancy="$(( tenths / 10 )).$(( tenths % 10 ))"
    fi
    local kbytes_free=$(( bytes_to_free / 1024 ))

    echo -e "\n${C_SLATE}=================================================================${C_RESET}"
    echo -e " ${C_BOLD}HANOI PRUNING & DEDUP — PROFILO:${C_RESET} ${sys_alias} (${SYS_FOLDER_MAP[$sys_alias]:-})"
    echo -e "${C_SLATE}-----------------------------------------------------------------${C_RESET}"
    echo -e " File tracciati storicamente : $files_tracked ${C_MUTED}(media: $avg_redundancy versioni/file)${C_RESET}"
    echo -e " Target obsoleti (>30gg)     : $files_to_delete snapshot (+ metadati)"
    echo -e " Duplicati convertibili [↪]  : $dedup_candidates payload identici"
    echo -e " Spazio recuperabile         : ~ ${kbytes_free} KB"
    echo -e "${C_SLATE}=================================================================${C_RESET}"

    if (( files_to_delete == 0 && dedup_candidates == 0 )); then
        echo -e "${C_GREEN}[=]${C_RESET} Storico di '$sys_alias' già ottimizzato e deduplicato."
        return 0
    fi

    if [[ "${NC_AUTO_CONFIRM_PRUNE:-0}" != "1" ]]; then
        confirm_double "Vuoi procedere con l'ottimizzazione dello storico per '$sys_alias'?" "Confermi l'eliminazione di $files_to_delete obsoleti e la deduplicazione di $dedup_candidates file in '$sys_alias'?" || return 0
    fi

    local total_dedup=${#dedup_target_files[@]} d_file d_ref d_sha old_m d_base other_ph
    for (( i=0; i<total_dedup; i++ )); do
        d_file="${dedup_target_files[$i]}"; d_ref="${dedup_ref_names[$i]}"; d_sha="${dedup_ref_shas[$i]}"
        [[ -f "$d_file" ]] || continue
        old_m="${NAS_MTIME[$d_file]:-}"; h_dir="${d_file%/*}"; d_base="${d_file##*/}"

        read -r -a idx_list <<< "${hist_bak_indices[$h_dir]:-}"
        for idx in "${idx_list[@]}"; do
            other_ph="${all_baks_flat[$idx]}"
            [[ "$other_ph" == "$d_file" ]] && continue
            if inspect_bak_placeholder_cached "$other_ph" && [[ "${BAK_REF_CACHE[$other_ph]:-}" == "$d_base" ]]; then
                rewrite_bak_placeholder_ref "$other_ph" "$d_ref"
            fi
        done

        printf '# NC-NAS-CONF BACKUP PLACEHOLDER\nREF_BAK=%s\nREF_SHA256=%s\n' "$d_ref" "$d_sha" > "$d_file"
        [[ -n "$old_m" && "$old_m" =~ ^[0-9]+$ ]] && touch -d "@$old_m" "$d_file" 2>/dev/null || true
        NAS_SIZE["$d_file"]=96
        BAK_IS_PH_CACHE["$d_file"]="1"; BAK_REF_CACHE["$d_file"]="$d_ref"; BAK_SHA_CACHE["$d_file"]="$d_sha"
    done

    local -A is_deleting_map=() f
    for f in "${del_list_bak[@]}"; do is_deleting_map["$f"]=1; done

    local to_unlink=() s_idx
    for f in "${del_list_bak[@]}"; do
        [[ -e "$f" ]] || continue
        if ! inspect_bak_placeholder_cached "$f"; then
            h_dir="${f%/*}"
            local f_base="${f##*/}" surviving_Dependents=() cand_ph
            read -r -a idx_list <<< "${hist_bak_indices[$h_dir]:-}"
            for (( s_idx=${#idx_list[@]}-1; s_idx>=0; s_idx-- )); do
                cand_ph="${all_baks_flat[${idx_list[$s_idx]}]}"
                [[ -n "${is_deleting_map[$cand_ph]:-}" ]] && continue
                if inspect_bak_placeholder_cached "$cand_ph" && [[ "${BAK_REF_CACHE[$cand_ph]:-}" == "$f_base" ]]; then
                    surviving_Dependents+=("$cand_ph")
                fi
            done

            if (( ${#surviving_Dependents[@]} > 0 )); then
                local primary_dep="${surviving_Dependents[0]}" primary_base="${primary_dep##*/}" dep_mtime="${NAS_MTIME[$primary_dep]:-}"
                mv -f "$f" "$primary_dep"
                [[ -n "$dep_mtime" && "$dep_mtime" =~ ^[0-9]+$ ]] && touch -d "@$dep_mtime" "$primary_dep" 2>/dev/null || true
                NAS_SIZE["$primary_dep"]="${NAS_SIZE[$f]:-0}"
                invalidate_nas_cache "$f"
                BAK_IS_PH_CACHE["$primary_dep"]="0"
                unset 'BAK_REF_CACHE[$primary_dep]' 'BAK_SHA_CACHE[$primary_dep]'

                local dep_count=${#surviving_Dependents[@]} k
                for (( k=1; k<dep_count; k++ )); do
                    rewrite_bak_placeholder_ref "${surviving_Dependents[$k]}" "$primary_base"
                done
                continue
            fi
        fi
        to_unlink+=("$f")
    done

    to_unlink+=("${del_list_meta[@]}")
    if (( ${#to_unlink[@]} > 0 )); then
        local u_tot=${#to_unlink[@]} u_off=0
        while (( u_off < u_tot )); do
            rm -f -- "${to_unlink[@]:u_off:400}" 2>/dev/null || true
            u_off=$(( u_off + 400 ))
        done
    fi

    find "$sys_bak_dir" -type d -name "*.hist" -empty -delete 2>/dev/null || true
    echo -e "${C_GREEN}[+]${C_RESET} Potatura e deduplicazione completate per '$sys_alias'."
    return 0
}

run_prune_mode() {
