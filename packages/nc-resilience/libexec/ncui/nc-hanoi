path_dirname_into() {
    local __p="$2"
    while [[ "$__p" == */ && "$__p" != "/" ]]; do __p="${__p%/}"; done
    if [[ "$__p" == */* ]]; then
        local __d="${__p%/*}"
        printf -v "$1" '%s' "${__d:-/}"
    else
        printf -v "$1" '%s' "."
    fi
    return 0
}

path_basename_into() {
    local __p="$2"
    while [[ "$__p" == */ && "$__p" != "/" ]]; do __p="${__p%/}"; done
    if [[ "$__p" == "/" ]]; then
        printf -v "$1" '%s' "/"
    else
        printf -v "$1" '%s' "${__p##*/}"
    fi
    return 0
}

now_epoch_into() { printf -v "$1" '%(%s)T' -1; }
now_ts_into()    { printf -v "$1" '%(%Y-%m-%d_%H-%M-%S)T' -1; }

norm_ts_into() {
    local __ts="$2"
    local __sec="${__ts%%.*}"
    if [[ "$__ts" == *.* ]]; then
        local __frac="${__ts#*.}"
        __frac="${__frac%% *}"
        __frac="${__frac:0:9}"
        printf -v "$1" '%s.%s' "$__sec" "$__frac"
    else
        printf -v "$1" '%s.000000000' "$__sec"
    fi
    return 0
}

read_file_raw_into() {
    local __out_var="$1" __fpath="$2" __buf=""
    { IFS= read -r -d '' __buf || true; } < "$__fpath" 2>/dev/null || __buf=""
    printf -v "$__out_var" '%s' "$__buf"
    return 0
}

sort_null_array() {
    local -n __arr_ref="$1"
    (( ${#__arr_ref[@]} <= 1 )) && return 0
    mapfile -d '' -t __arr_ref < <(printf '%s\0' "${__arr_ref[@]}" | LC_ALL=C sort -z)
    return 0
}

touch_lock_heartbeat() {
    [[ "$LOCK_ACQUIRED" == true && -n "$LOCK_DIR" && -d "$LOCK_DIR" ]] || return 0
    local now_ep
    now_epoch_into now_ep
    printf 'PID=%s\nHOST=%s\nTS=%s\n' "$$" "${ACTIVE_ALIAS:-$DETECTED_HOSTNAME}" "$now_ep" > "$LOCK_DIR/info" 2>/dev/null || true
    return 0
}

read_single_key() {
    local prompt_str="$1" rendered_prompt
    if [[ "${NC_NONINTERACTIVE:-0}" == "1" ]]; then
        echo -e "${C_YELLOW}[!]${C_RESET} Interactive prompt aborted (NC_NONINTERACTIVE=1): ${prompt_str}" >&2
        exit 3
    fi
    printf -v rendered_prompt '%b' "$prompt_str"
    REPLY_KEY=""
    if ! IFS= read -r -s -n 1 -p "$rendered_prompt" REPLY_KEY </dev/tty; then
        echo
        echo -e "${C_RED}[-]${C_RESET} Input interrotto."
        exit 130
    fi
    echo
    touch_lock_heartbeat
    return 0
}

confirm_enter() {
    local prompt_msg="$1"
    read_single_key "${C_CYAN}[?]${C_RESET} $prompt_msg ${C_MUTED}[INVIO = continua | altro tasto = annulla]:${C_RESET} "
    if [[ -n "$REPLY_KEY" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Operazione annullata dall'utente."
        exit 0
    fi
    return 0
}

confirm_double() {
    local prompt_msg="$1"
    local red_msg="${2:-Confermi definitivamente l'esecuzione dell'operazione?}"
    read_single_key "${C_CYAN}[?]${C_RESET} $prompt_msg ${C_MUTED}[INVIO = procedi | altro tasto = annulla]:${C_RESET} "
    if [[ -n "$REPLY_KEY" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Operazione annullata dall'utente."
        return 1
    fi
    read_single_key "${C_RED}[!!] CONFERMA DEFINITIVA: ${red_msg}${C_RESET} ${C_MUTED}[INVIO = ESEGUI | altro tasto = annulla]:${C_RESET} "
    if [[ -n "$REPLY_KEY" ]]; then
        echo -e "${C_RED}[-]${C_RESET} Operazione annullata dall'utente."
        return 1
    fi
    return 0
}

confirm_double_or_exit() {
    confirm_double "$1" "${2:-Confermi definitivamente l'esecuzione dell'operazione?}" || exit 0
}

format_time_delta_into() {
    local __out_var="$1" __diff_sec="$2"
    (( __diff_sec < 0 )) && __diff_sec=$(( -__diff_sec ))
    local __days=$(( __diff_sec / 86400 ))
    local __hours=$(( (__diff_sec % 86400) / 3600 ))
    local __mins=$(( (__diff_sec % 3600) / 60 ))
    local __secs=$(( __diff_sec % 60 ))
    local __d_label="giorni" __h_label="ore" __m_label="minuti"
    (( __days == 1 )) && __d_label="giorno"
    (( __hours == 1 )) && __h_label="ora"
    (( __mins == 1 )) && __m_label="minuto"
    if (( __days > 0 )); then
        printf -v "$__out_var" "%d %s, %d %s e %d %s" "$__days" "$__d_label" "$__hours" "$__h_label" "$__mins" "$__m_label"
    elif (( __hours > 0 )); then
        printf -v "$__out_var" "%d %s e %d %s" "$__hours" "$__h_label" "$__mins" "$__m_label"
    elif (( __mins > 0 )); then
        printf -v "$__out_var" "%d %s e %d secondi" "$__mins" "$__m_label" "$__secs"
    else
        printf -v "$__out_var" "%d secondi" "$__secs"
    fi
    return 0
}

normalize_octal_mode_into() {
    local __out_var="$1" __m="${2:-}"
    if [[ "$__m" =~ ^[0-7]{4}$ || "$__m" == "lrwxrwxrwx" || -z "$__m" ]]; then
        printf -v "$__out_var" '%s' "$__m"
    elif [[ "$__m" =~ ^[0-7]+$ ]]; then
        printf -v "$__out_var" "%04d" "$(( 10#$__m ))"
    else
        printf -v "$__out_var" '%s' "0644"
    fi
    return 0
}

# Rimuove i suffissi di trasporto NAS SOLO su percorsi relativi provenienti dal NAS
strip_nas_rel_into() {
    local __out_var="$1" __rel="$2"
    __rel="${__rel#/}"
    __rel="${__rel%.origin.txt}"
    __rel="${__rel%.shared}"
    __rel="${__rel%.tar.gz.enc}"
    __rel="${__rel%.enc}"
    printf -v "$__out_var" '%s' "$__rel"
    return 0
}

# Normalizza un percorso locale reale senza mai mutilare .enc o .shared
normalize_local_rel_into() {
    local __out_var="$1" __rel="$2"
    __rel="${__rel#/}"
    printf -v "$__out_var" '%s' "$__rel"
    return 0
}

# Renderer unificato per tabelle a 4 colonne
render_4col_table() {
    local __title="$1" __subtitle="$2"
    local __h1="$3" __h2="$4" __h3="$5" __h4="$6"
    local -n __c1_col="$7" __c1_str="$8" __c2_col="$9" __c2_str="${10}" __c3_str="${11}" __c4_str="${12}"

    local __total_rows=${#__c1_str[@]}
    (( __total_rows == 0 )) && return 0

    local __w1=18 __w2=15 __w3=12 __i
    for (( __i=0; __i<__total_rows; __i++ )); do
        (( ${#__c1_str[$__i]} > __w1 )) && __w1=${#__c1_str[$__i]}
        (( ${#__c2_str[$__i]} > __w2 )) && __w2=${#__c2_str[$__i]}
        (( ${#__c3_str[$__i]} > __w3 )) && __w3=${#__c3_str[$__i]}
    done

    local __sep1 __sep2 __sep3
    printf -v __sep1 '%*s' "$(( __w1 + 2 ))" ''; __sep1="${__sep1// /─}"
    printf -v __sep2 '%*s' "$(( __w2 + 2 ))" ''; __sep2="${__sep2// /─}"
    printf -v __sep3 '%*s' "$(( __w3 + 2 ))" ''; __sep3="${__sep3// /─}"

    echo -e "\n${C_SLATE}============================================================================================${C_RESET}"
    echo -e " ${C_BOLD}${__title}${C_RESET}"
    [[ -n "$__subtitle" ]] && echo -e " ${C_MUTED}${__subtitle}${C_RESET}"
    echo -e "${C_SLATE}============================================================================================${C_RESET}"
    printf " %b%s%*s │ %s%*s │ %s%*s │ %s%b\n" \
        "$C_MUTED" "$__h1" "$(( __w1 - ${#__h1} ))" "" "$__h2" "$(( __w2 - ${#__h2} ))" "" "$__h3" "$(( __w3 - ${#__h3} ))" "" "$__h4" "$C_RESET"
    echo -e "${C_SLATE}${__sep1}┼${__sep2}┼${__sep3}┼──────────────────────────────────────${C_RESET}"

    local __out_buf="" __line_str __s1 __s2 __s3 __s4
    for (( __i=0; __i<__total_rows; __i++ )); do
        __s1="${__c1_str[$__i]}" __s2="${__c2_str[$__i]}" __s3="${__c3_str[$__i]}" __s4="${__c4_str[$__i]}"
        printf -v __line_str " %b%s%*s%b │ %b%s%*s%b │ %b%s%*s%b │ %b\n" \
            "${__c1_col[$__i]}" "$__s1" "$(( __w1 - ${#__s1} ))" "" "$C_RESET" \
            "${__c2_col[$__i]}" "$__s2" "$(( __w2 - ${#__s2} ))" "" "$C_RESET" \
            "$C_MUTED" "$__s3" "$(( __w3 - ${#__s3} ))" "" "$C_RESET" \
            "$__s4"
        __out_buf+="$__line_str"
    done
    printf '%s' "$__out_buf"
    echo -e "${C_SLATE}============================================================================================${C_RESET}"
    return 0
}

