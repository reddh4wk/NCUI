get_work_tmp_dir() {
    if [[ -n "$WORK_TMP_DIR" && -d "$WORK_TMP_DIR" ]]; then
        return 0
    fi
    if [[ -d /dev/shm && -w /dev/shm ]]; then
        WORK_TMP_DIR="/dev/shm/nc_nas_$$"
    else
        WORK_TMP_DIR="/tmp/nc_nas_$$"
    fi
    mkdir -p -m 0700 "$WORK_TMP_DIR"
    return 0
}

cleanup_trap() {
    flush_persistent_caches 2>/dev/null || true
    if [[ -n "${WORK_TMP_DIR:-}" && -d "$WORK_TMP_DIR" ]]; then
        rm -rf "$WORK_TMP_DIR" 2>/dev/null || true
    fi
    rm -rf /tmp/nc_nas_$$_* 2>/dev/null || true
    if [[ -n "${LINUX_ROOT:-}" ]]; then
        rm -f "$LINUX_ROOT/.time_probe_$$" 2>/dev/null || true
    fi
    if (( ${#LOCAL_TMP_FILES[@]} > 0 )); then
        rm -f -- "${!LOCAL_TMP_FILES[@]}" 2>/dev/null || true
    fi
    if (( ${#NAS_TMP_FILES[@]} > 0 )); then
        rm -f -- "${!NAS_TMP_FILES[@]}" 2>/dev/null || true
    fi
    if [[ "$LOCK_ACQUIRED" == true && -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
        local lock_pid=""
        if [[ -r "$LOCK_DIR/info" ]]; then
            local k v
            while IFS='=' read -r k v; do
                [[ "$k" == "PID" ]] && lock_pid="$v"
            done < "$LOCK_DIR/info" 2>/dev/null || true
        elif [[ -r "$LOCK_DIR/pid" ]]; then
            IFS= read -r lock_pid < "$LOCK_DIR/pid" 2>/dev/null || true
        fi
        if [[ "$lock_pid" == "$$" ]]; then
            rm -rf "$LOCK_DIR" 2>/dev/null || true
        fi
    fi
    return 0
}

