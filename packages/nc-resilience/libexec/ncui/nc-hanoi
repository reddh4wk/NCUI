    ensure_nas_mounted false
    resolve_active_profile true
    acquire_nas_lock
    index_all_nas_deltas
    resolve_nas_target_for_query "$abs_p" false
    [[ -n "${RESOLVED_QUERY_REL:-}" ]] || { echo "SHARE_ERR|Item not tracked in Vault: $abs_p" >&2; exit 3; }
    local owner="${RESOLVED_QUERY_OWNER:-$ACTIVE_ALIAS}"
    [[ "$owner" == "$ACTIVE_ALIAS" ]] || { echo "SHARE_ERR|Shared source owned by $owner (transfer via terminal)" >&2; exit 3; }
