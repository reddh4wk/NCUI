# ==============================================================================
# LIVELLO 8: LISTA (--list), CHECK ASINCRONO (--check) & STATUS CACHE
# ==============================================================================
write_status_env_from_counts() {
    local push_total="$1" push_shared="$2" pull_total="$3"
    [[ -d "$LOCAL_STATE_DIR" ]] || mkdir -p -m 0755 "$LOCAL_STATE_DIR"
    local now_ep tmp_env="$LOCAL_STATE_DIR/.status.env.tmp.$$"
    now_epoch_into now_ep
    printf 'NC_STATUS_SYS="%s"\nNC_STATUS_TIMESTAMP="%s"\nNC_PUSH_TOTAL=%d\nNC_PUSH_SHARED=%d\nNC_PULL_TOTAL=%d\n' \
        "$ACTIVE_ALIAS" "$now_ep" "$push_total" "$push_shared" "$pull_total" > "$tmp_env"
    chmod 0644 "$tmp_env"
    mv -f "$tmp_env" "$LOCAL_STATUS_ENV"
    return 0
}

update_status_cache() {
    local nas_already_ready="${1:-false}"
    [[ -d "$LOCAL_STATE_DIR" ]] || mkdir -p -m 0755 "$LOCAL_STATE_DIR"

    if [[ "$nas_already_ready" == false ]]; then
        ensure_nas_mounted true || return 0
        resolve_active_profile true
    fi

    if [[ "$nas_already_ready" == false || "$NAS_STATE_MUTATED" == true || "$PREFETCH_DONE" == false ]]; then
        prefetch_active_profile_state
    fi

    local saved_rev="$REVERSE_SYNC"
    REVERSE_SYNC=false
    evaluate_profile_drift
    REVERSE_SYNC="$saved_rev"

    write_status_env_from_counts "$EVAL_PUSH_TOTAL" "$EVAL_PUSH_SHARED" "$EVAL_PULL_TOTAL"
    return 0
}

run_list_mode() {
    prefetch_active_profile_state
