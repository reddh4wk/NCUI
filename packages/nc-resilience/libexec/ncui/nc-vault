TMP_CREDS=""
TEST_MNT=""
cleanup() {
    set +e
    if [[ -n "${TEST_MNT:-}" ]]; then
        if mountpoint -q "$TEST_MNT" 2>/dev/null; then
            umount -l "$TEST_MNT" 2>/dev/null || true
        fi
        [[ -d "$TEST_MNT" ]] && rmdir "$TEST_MNT" 2>/dev/null || true
    fi
    if [[ -n "${TMP_CREDS:-}" && -f "$TMP_CREDS" ]]; then
        shred -u -z "$TMP_CREDS" 2>/dev/null || rm -f "$TMP_CREDS"
    fi
}
trap cleanup EXIT INT TERM HUP

probe_host_port() {
    local host="$1" port="$2"
    if timeout 2 bash -c "</dev/tcp/${host}/${port}" 2>/dev/null; then
        return 0
    fi
    ping -c 1 -W 2 "$host" >/dev/null 2>&1
}

mount_smb_with_creds() {
    local creds_path="$1"
    command -v mount.cifs >/dev/null 2>&1 || { log_err "mount.cifs not installed (install cifs-utils)."; exit 1; }
    [[ -n "$CFG_HOST" ]] || { log_err "Vault host not configured."; exit 1; }
    (( ${#CFG_SHARES[@]} > 0 )) || { log_err "No SMB shares configured."; exit 1; }
    local smb_port="${CFG_PORT:-445}"
    probe_host_port "$CFG_HOST" "$smb_port" || { log_err "SMB host ${CFG_HOST}:${smb_port} unreachable."; exit 1; }

    refresh_mounted_map
    mkdir -p "$EFFECTIVE_MP"
    chown "$MOUNT_UID:$MOUNT_GID" "$EFFECTIVE_MP" 2>/dev/null || true
    chmod 755 "$EFFECTIVE_MP"

    local creds_opt="credentials=${creds_path}"
    [[ "${CFG_SMB_CREDS,,}" == "guest" || -z "$creds_path" ]] && creds_opt="guest"
    local vers_opt="" port_opt="" extra_opt=""
    [[ "$CFG_SMB_VERSION" != "auto" && -n "$CFG_SMB_VERSION" ]] && vers_opt=",vers=${CFG_SMB_VERSION}"
    [[ -n "$CFG_PORT" ]] && port_opt=",port=${CFG_PORT}"
    [[ -n "$CFG_MOUNT_OPTS" ]] && extra_opt=",${CFG_MOUNT_OPTS}"

    local failed=0 sh rem_sh sh_dir lbl actimeo gvfs_opt
    for sh in "${CFG_SHARES[@]}"; do
        rem_sh="$(share_remote_part "$sh")"
        sh_dir="$(share_target_dir "$sh" "$EFFECTIVE_MP")"
        lbl="$(share_label_name "$sh" "$EFFECTIVE_MP")"
        if is_mounted "$sh_dir"; then
            continue
        fi
        if [[ -d "$sh_dir" ]] && ! is_dir_empty "$sh_dir"; then
            log_err "Target '${sh_dir}' non-empty; skipping mount."
            failed=1
            continue
        fi
        mkdir -p "$sh_dir"
        chown "$MOUNT_UID:$MOUNT_GID" "$(dirname "$sh_dir")" "$sh_dir" 2>/dev/null || true
        [[ "$CFG_BACKUP_SUBDIR" == "${rem_sh}/"* || "$CFG_BACKUP_SUBDIR" == "$rem_sh" || "$CFG_BACKUP_SUBDIR" == "${lbl}/"* || "$CFG_BACKUP_SUBDIR" == "$lbl" ]] && actimeo=1 || actimeo=30
        gvfs_opt="$(gvfs_opts_for_label "$lbl")"
        if mount -t cifs "//${CFG_HOST}/${rem_sh}" "$sh_dir" \
            -o "${creds_opt},iocharset=utf8,uid=${MOUNT_UID},gid=${MOUNT_GID},file_mode=0600,dir_mode=0700${vers_opt}${port_opt}${gvfs_opt}${extra_opt},actimeo=${actimeo},nosuid,nodev"; then
            log_ok "Mounted ${sh_dir}"
        else
            log_err "Failed mounting //${CFG_HOST}/${rem_sh}"
            failed=1
        fi
    done

    refresh_mounted_map
    sync_user_symlinks_shares
    (( failed == 0 )) || exit 1
}

cmd_mount_smb() {
    refresh_mounted_map
    local missing=0 sh sh_tgt
    for sh in "${CFG_SHARES[@]}"; do
        sh_tgt="$(share_target_dir "$sh" "$EFFECTIVE_MP")"
        is_mounted "$sh_tgt" || missing=$(( missing + 1 ))
    done
    if (( ${#CFG_SHARES[@]} > 0 && missing == 0 )); then
        sync_user_symlinks_shares
        log_ok "All SMB shares already mounted in ${EFFECTIVE_MP}."
        return 0
    fi
    if [[ "${CFG_SMB_CREDS,,}" == "guest" ]]; then
        mount_smb_with_creds ""
        return 0
    fi
    if [[ "$SYS_TRUST" == "TRUSTED" && -f "$CFG_SMB_CREDS" ]]; then
        mount_smb_with_creds "$CFG_SMB_CREDS"
        return 0
    fi
    if [[ -t 0 ]]; then
        local tty_user="" tty_pass="" tty_ans="" tty_persist="0"
        printf 'SMB username for %s: ' "$CFG_HOST" >&2
        IFS= read -r tty_user || true
        printf 'SMB password for %s@%s: ' "${tty_user:-user}" "$CFG_HOST" >&2
        IFS= read -rs tty_pass || true
        printf '\n' >&2
        if [[ "$SYS_TRUST" == "TRUSTED" ]]; then
            printf 'Save credentials to %s? [y/N]: ' "$CFG_SMB_CREDS" >&2
            IFS= read -r tty_ans || true
            [[ "${tty_ans,,}" == "y" || "${tty_ans,,}" == "yes" || "${tty_ans,,}" == "s" ]] && tty_persist="1"
        fi
        printf '%s\n%s\n%s\n' "$tty_user" "$tty_pass" "$tty_persist" | cmd_creds_stdin
        return $?
    fi
    echo "CREDENTIALS_REQUIRED"
    exit 10
}

cmd_creds_stdin() {
    local smb_user="" smb_pass="" persist="0"
    IFS= read -r smb_user || true
    IFS= read -r smb_pass || true
    IFS= read -r persist || true
    smb_user="${smb_user//$'\r'/}"
    smb_pass="${smb_pass//$'\r'/}"
    persist="$(printf '%s' "${persist:-0}" | tr -d '[:space:]')"
    [[ -n "$smb_user" && -n "$smb_pass" ]] || { log_err "Username and password required."; exit 2; }
    [[ -n "$CFG_HOST" ]] || { log_err "Vault host not configured."; exit 2; }
    (( ${#CFG_SHARES[@]} > 0 )) || { log_err "No SMB shares configured."; exit 2; }
    local smb_port="${CFG_PORT:-445}"
    local vers_opt="" port_opt=""
    [[ "$CFG_SMB_VERSION" != "auto" && -n "$CFG_SMB_VERSION" ]] && vers_opt=",vers=${CFG_SMB_VERSION}"
    [[ -n "$CFG_PORT" ]] && port_opt=",port=${CFG_PORT}"
    probe_host_port "$CFG_HOST" "$smb_port" || { log_err "SMB host ${CFG_HOST}:${smb_port} unreachable."; exit 1; }

    TMP_CREDS=$(mktemp -p /dev/shm .nc_vault_cred_XXXXXX)
    chmod 0600 "$TMP_CREDS"
    printf 'username=%s\npassword=%s\n' "$smb_user" "$smb_pass" > "$TMP_CREDS"

    local probe_sh
    probe_sh="$(share_remote_part "${CFG_SHARES[0]}")"
    TEST_MNT="$(mktemp -d -p /dev/shm .ncui_vault_probe.XXXXXX)"
    if ! mount -t cifs "//${CFG_HOST}/${probe_sh}" "$TEST_MNT" -o "credentials=${TMP_CREDS},ro${vers_opt}${port_opt},nosuid,nodev" >/dev/null 2>&1; then
        log_err "SMB authentication rejected by ${CFG_HOST}."
        exit 1
    fi
    umount "$TEST_MNT"
    rmdir "$TEST_MNT"
    TEST_MNT=""

    local creds_use="$TMP_CREDS"
    if [[ "$persist" == "1" && "$SYS_TRUST" == "TRUSTED" ]]; then
        mkdir -p "$(dirname "$CFG_SMB_CREDS")"
        install -m 0600 -o root -g root "$TMP_CREDS" "$CFG_SMB_CREDS"
        creds_use="$CFG_SMB_CREDS"
    fi
    mount_smb_with_creds "$creds_use"
}

cmd_mount_nfs() {
    command -v mount.nfs >/dev/null 2>&1 || command -v mount.nfs4 >/dev/null 2>&1 || { log_err "nfs-utils not installed."; exit 1; }
    [[ -n "$CFG_HOST" ]] || { log_err "NFS host not configured."; exit 1; }
    (( ${#CFG_SHARES[@]} > 0 )) || { log_err "No NFS exports configured in shares[]."; exit 1; }
    local nfs_port="${CFG_PORT:-2049}"
    probe_host_port "$CFG_HOST" "$nfs_port" || { log_err "NFS host ${CFG_HOST}:${nfs_port} unreachable."; exit 1; }

    refresh_mounted_map
    mkdir -p "$EFFECTIVE_MP"
    chmod 755 "$EFFECTIVE_MP"
    local port_opt="${CFG_PORT:+,port=${CFG_PORT}}" extra_opt="${CFG_MOUNT_OPTS:+,${CFG_MOUNT_OPTS}}"
    local sh rem_sh sh_dir lbl failed=0 exp gvfs_opt
    for sh in "${CFG_SHARES[@]}"; do
        rem_sh="$(share_remote_part "$sh")"
        sh_dir="$(share_target_dir "$sh" "$EFFECTIVE_MP")"
        lbl="$(share_label_name "$sh" "$EFFECTIVE_MP")"
        is_mounted "$sh_dir" && continue
        mkdir -p "$sh_dir"
        [[ "$rem_sh" == /* ]] && exp="$rem_sh" || exp="/${rem_sh}"
        gvfs_opt="$(gvfs_opts_for_label "$lbl")"
        if mount -t nfs4 -o "rw,nosuid,nodev,soft,timeo=50${port_opt}${gvfs_opt}${extra_opt}" "${CFG_HOST}:${exp}" "$sh_dir" \
           || mount -t nfs -o "rw,nosuid,nodev,soft,timeo=50${port_opt}${gvfs_opt}${extra_opt}" "${CFG_HOST}:${exp}" "$sh_dir"; then
            log_ok "Mounted NFS ${sh_dir}"
        else
            log_err "Failed mounting NFS ${CFG_HOST}:${exp}"
            failed=1
        fi
    done
    refresh_mounted_map
    sync_user_symlinks_shares
    (( failed == 0 )) || exit 1
}

cmd_mount_ssh() {
    [[ -n "$CFG_HOST" ]] || { log_err "SSH host not configured."; exit 1; }
    local rpath="${CFG_REMOTE_PATH:-/srv/vault}"
    local target="${CFG_SSH_USER:+${CFG_SSH_USER}@}${CFG_HOST}:${rpath}"
    local ssh_port="${CFG_PORT:-22}"
    probe_host_port "$CFG_HOST" "$ssh_port" || { log_err "SSH host ${CFG_HOST}:${ssh_port} unreachable."; exit 1; }

    refresh_mounted_map
    mkdir -p "$EFFECTIVE_MP"
    chown "$MOUNT_UID:$MOUNT_GID" "$EFFECTIVE_MP" 2>/dev/null || true

    if command -v sshfs >/dev/null 2>&1; then
        if ! is_mounted "$EFFECTIVE_MP"; then
            local port_opt="${CFG_PORT:+,port=${CFG_PORT}}" extra_opt="${CFG_MOUNT_OPTS:+,${CFG_MOUNT_OPTS}}"
            local gvfs_opt lbl="${EFFECTIVE_MP##*/}"
            gvfs_opt="$(gvfs_opts_for_label "${lbl:-Vault}")"
            if [[ -n "$gvfs_opt" ]]; then
                run_ssh_cmd sshfs "$target" "$EFFECTIVE_MP" -o "uid=${MOUNT_UID},gid=${MOUNT_GID},reconnect,ServerAliveInterval=15${port_opt}${gvfs_opt}${extra_opt}" 2>/dev/null \
                    || run_ssh_cmd sshfs "$target" "$EFFECTIVE_MP" -o "uid=${MOUNT_UID},gid=${MOUNT_GID},reconnect,ServerAliveInterval=15${port_opt}${extra_opt}"
            else
                run_ssh_cmd sshfs "$target" "$EFFECTIVE_MP" -o "uid=${MOUNT_UID},gid=${MOUNT_GID},reconnect,ServerAliveInterval=15${port_opt}${extra_opt}"
            fi
        fi
        log_ok "Mounted SSHFS ${target} -> ${EFFECTIVE_MP}"
    else
        command -v rsync >/dev/null 2>&1 || { log_err "Neither sshfs nor rsync is installed."; exit 1; }
        local -a ssh_opts=(-o BatchMode=yes -o ConnectTimeout=6)
        local rsh_cmd="ssh"
        if [[ -n "$CFG_PORT" ]]; then
            ssh_opts+=(-p "$CFG_PORT")
            rsh_cmd="ssh -p ${CFG_PORT}"
        fi
        run_ssh_cmd ssh "${ssh_opts[@]}" "${CFG_SSH_USER:+${CFG_SSH_USER}@}${CFG_HOST}" "mkdir -p '${rpath}'"
        run_ssh_cmd rsync -az -e "$rsh_cmd" --delete --exclude='.ncui_ssh_mounted' "${target%/}/" "${EFFECTIVE_MP%/}/"
        printf 'HOST=%s\nTARGET=%s\n' "$CFG_HOST" "$target" > "${EFFECTIVE_MP}/.ncui_ssh_mounted"
        chown "$MOUNT_UID:$MOUNT_GID" "${EFFECTIVE_MP}/.ncui_ssh_mounted" 2>/dev/null || true
        log_ok "Staged SSH/Rsync vault ${target} -> ${EFFECTIVE_MP}"
    fi
    sync_user_symlink_single "$EFFECTIVE_MP" "vault"
}

cmd_ssh_push() {
    [[ "$CFG_PROTOCOL" == "ssh" ]] || return 0
    [[ -f "${EFFECTIVE_MP}/.ncui_ssh_mounted" ]] || return 0
    command -v rsync >/dev/null 2>&1 || return 0
    local rpath="${CFG_REMOTE_PATH:-/srv/vault}"
    local target="${CFG_SSH_USER:+${CFG_SSH_USER}@}${CFG_HOST}:${rpath}"
    local rsh_cmd="ssh"
    [[ -n "$CFG_PORT" ]] && rsh_cmd="ssh -p ${CFG_PORT}"
    run_ssh_cmd rsync -az -e "$rsh_cmd" --delete --exclude='.ncui_ssh_mounted' "${EFFECTIVE_MP%/}/" "${target%/}/"
    log_ok "Pushed staged vault to ${target}"
}

cmd_mount_local() {
    mkdir -p "${EFFECTIVE_MP}/${CFG_BACKUP_SUBDIR}" "${EFFECTIVE_MP}/${CFG_PKGLIST_SUBDIR}"
    chown -R "$MOUNT_UID:$MOUNT_GID" "${EFFECTIVE_MP}" 2>/dev/null || true
    sync_user_symlink_single "$EFFECTIVE_MP" "vault"
    log_ok "Local vault ready at ${EFFECTIVE_MP}"
}

cmd_mount() {
    case "$CFG_PROTOCOL" in
        smb)   cmd_mount_smb ;;
        nfs)   cmd_mount_nfs ;;
        ssh)   cmd_mount_ssh ;;
        local) cmd_mount_local ;;
    esac
}

cmd_umount() {
    refresh_mounted_map
    if [[ "$CFG_PROTOCOL" == "ssh" ]]; then
        if is_mounted "$EFFECTIVE_MP"; then
            umount "$EFFECTIVE_MP" 2>/dev/null || umount -l "$EFFECTIVE_MP" 2>/dev/null || true
        elif [[ -f "${EFFECTIVE_MP}/.ncui_ssh_mounted" ]]; then
            cmd_ssh_push || true
            rm -f "${EFFECTIVE_MP}/.ncui_ssh_mounted"
        fi
        cleanup_user_symlinks --force
        log_ok "Unmounted SSH vault."
        return 0
    fi
    if [[ "$CFG_PROTOCOL" == "local" ]]; then
        if is_mounted "$EFFECTIVE_MP"; then
            umount "$EFFECTIVE_MP" 2>/dev/null || true
        fi
        cleanup_user_symlinks --force
        log_ok "Detached local vault symlinks."
        return 0
    fi

    local base sh sh_name sh_tgt sd failed=0
    for sh in "${CFG_SHARES[@]}"; do
        sh_tgt="$(share_target_dir "$sh" "$EFFECTIVE_MP")"
        if is_mounted "$sh_tgt"; then
            umount "$sh_tgt" 2>/dev/null || umount -l "$sh_tgt" 2>/dev/null || failed=1
        fi
    done
    for base in "$EFFECTIVE_MP" "/nas" "/run/nas"; do
        for sh in "${CFG_SHARES[@]}"; do
            sh_name="$(share_label_name "$sh" "$base")"
            sd="${base}/${sh_name}"
            if is_mounted "$sd"; then
                umount "$sd" 2>/dev/null || umount -l "$sd" 2>/dev/null || failed=1
            fi
        done
        if [[ "$base" == "/run/nas" && -d "$base" ]]; then
            rmdir "$base"/* 2>/dev/null || true
            rmdir "$base" 2>/dev/null || true
        fi
    done
    refresh_mounted_map
    cleanup_user_symlinks
    (( failed == 0 )) || exit 1
    log_ok "Unmounted all shares."
}

cmd_pkglist_stdin() {
    compute_mount_counts
    if [[ "$MOUNTED_STATE" != "1" ]]; then
        log_err "Vault is not mounted; mount vault first."
        exit 1
    fi
    local label="" dest_dir="${ACTIVE_BASE}/${CFG_PKGLIST_SUBDIR}"
    IFS= read -r label || true
    label="${label//$'\r'/}"
    label="${label,,}"
    label="${label//[^a-z0-9]/_}"
    label="${label//+(_)/_}"
    label="${label#_}"; label="${label%_}"
    [[ -n "$label" ]] || label="snapshot"

    mkdir -p "$dest_dir"
    local max_num=-1 f base num
    shopt -s nullglob
    for f in "$dest_dir"/*_pkglist.txt; do
        base="${f##*/}"
        if [[ "$base" =~ ^([0-9]+)_ ]]; then
            num=$((10#${BASH_REMATCH[1]}))
            (( num > max_num )) && max_num=$num
        fi
    done
    shopt -u nullglob

    local next_num=$(( max_num + 1 ))
    local file_path="${dest_dir}/${next_num}_${label}_pkglist.txt"
    local tmp_path="${file_path}.tmp.$$"
    local aur_path="${dest_dir}/${next_num}_${label}_aur.txt"
    local tmp_aur="${aur_path}.tmp.$$"

    local -a pkgs=() aur_pkgs=()
    local aur_cnt=0
    if command -v pacman >/dev/null 2>&1; then
        mapfile -t pkgs < <(pacman -Qqe 2>/dev/null || true)
        mapfile -t aur_pkgs < <(pacman -Qqm 2>/dev/null || true)
    elif command -v apt-mark >/dev/null 2>&1; then
        mapfile -t pkgs < <(apt-mark showmanual 2>/dev/null | sort -u || true)
    elif command -v dpkg-query >/dev/null 2>&1; then
        mapfile -t pkgs < <(dpkg-query -W -f='${Package}\n' 2>/dev/null | sort -u || true)
    elif command -v dnf >/dev/null 2>&1; then
        mapfile -t pkgs < <(dnf repoquery --userinstalled --qf '%{name}' 2>/dev/null | sort -u || true)
        (( ${#pkgs[@]} > 0 )) || mapfile -t pkgs < <(rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort -u || true)
    elif command -v rpm >/dev/null 2>&1; then
        mapfile -t pkgs < <(rpm -qa --qf '%{NAME}\n' 2>/dev/null | sort -u || true)
    else
        log_err "No supported package manager found (pacman/apt/dnf/rpm)."
        exit 1
    fi
    (( ${#pkgs[@]} > 0 )) || { log_err "Package query returned no packages."; exit 1; }
    printf '%s\n' "${pkgs[@]}" > "$tmp_path"
    sync -f "$tmp_path" 2>/dev/null || true
    chown "$MOUNT_UID:$MOUNT_GID" "$tmp_path" 2>/dev/null || true
    mv -f "$tmp_path" "$file_path"

    if (( ${#aur_pkgs[@]} > 0 )); then
        aur_cnt=${#aur_pkgs[@]}
        printf '%s\n' "${aur_pkgs[@]}" > "$tmp_aur"
        sync -f "$tmp_aur" 2>/dev/null || true
        chown "$MOUNT_UID:$MOUNT_GID" "$tmp_aur" 2>/dev/null || true
        mv -f "$tmp_aur" "$aur_path"
    fi

    [[ "$CFG_PROTOCOL" == "ssh" && -f "${EFFECTIVE_MP}/.ncui_ssh_mounted" ]] && cmd_ssh_push >/dev/null 2>&1 || true
    printf 'OK|%s|%d|%d\n' "$file_path" "${#pkgs[@]}" "$aur_cnt"
}

cmd_pkglist_tsv() {
    compute_mount_counts
    [[ "$MOUNTED_STATE" == "1" ]] || return 0
    local dest_dir="${ACTIVE_BASE}/${CFG_PKGLIST_SUBDIR}"
    local alt_dir="${ACTIVE_BASE}/${CFG_BACKUP_SUBDIR}/${CFG_SYS_FOLDER}/pkglists"

    shopt -s nullglob
    local -a pk_files=("$dest_dir"/*_pkglist.txt)
    if (( ${#pk_files[@]} == 0 )) && [[ -n "$CFG_SYS_FOLDER" && -d "$alt_dir" ]]; then
        pk_files=("$alt_dir"/*_pkglist.txt)
    fi
    shopt -u nullglob
    (( ${#pk_files[@]} > 0 )) || return 0

    local entries=() f base num lbl cnt mtime_h
    for f in "${pk_files[@]}"; do
        base="${f##*/}"
        if [[ "$base" =~ ^([0-9]+)_(.+)_pkglist\.txt$ ]]; then
            num=$((10#${BASH_REMATCH[1]}))
            lbl="${BASH_REMATCH[2]}"
            cnt=$(wc -l < "$f" 2>/dev/null | tr -d '[:space:]' || echo 0)
            mtime_h=$(stat -c '%y' "$f" 2>/dev/null | cut -c1-16 || echo "-")
            entries+=("$(printf '%08d\t%d\t%s\t%s\t%s\t%s' "$num" "$num" "$lbl" "$cnt" "$mtime_h" "$base")")
        fi
    done
    (( ${#entries[@]} > 0 )) || return 0
    printf '%s\n' "${entries[@]}" | sort -r | head -n 25 | cut -f2-
}

toml_format_str_array() {
    local csv="$1" out="" item
    local -a parts=()
    while IFS= read -r -d ',' item || [[ -n "$item" ]]; do
        item="$(printf '%s' "$item" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -n "$item" ]] || continue
        [[ "$item" =~ ^[a-zA-Z0-9_.:/{}\$-]+$ && "$item" != *".."* ]] || return 1
        parts+=("\"$item\"")
    done <<< "${csv},"
    local IFS_SAV="$IFS"; IFS=", "; out="[${parts[*]}]"; IFS="$IFS_SAV"
    printf '%s' "$out"
}

apply_toml_kv_section() {
    local target_sec="$1" upd_spec="$2"
    mkdir -p "$(dirname "$CONF_FILE")"
    [[ -f "$CONF_FILE" ]] || printf '[identity]\n\n[vault]\n' > "$CONF_FILE"
    local tmp_conf="${CONF_FILE}.tmp.$$"
    awk -v sec_name="$target_sec" -v spec="$upd_spec" '
    BEGIN {
        n = split(spec, lines, "\n")
        for (i = 1; i <= n; i++) {
            if (lines[i] == "") continue
            eq = index(lines[i], "=")
            k = substr(lines[i], 1, eq - 1)
            v = substr(lines[i], eq + 1)
            upd[k] = v; done_k[k] = 0
        }
        in_sec = 0; saw_sec = 0
    }
    function flush_missing() {
        for (k in upd) {
            if (!done_k[k]) { print k " = " upd[k]; done_k[k] = 1 }
        }
    }
    /^\[.*\]/ {
        if (in_sec) flush_missing()
        in_sec = ($0 ~ "^\\[" sec_name "\\]") ? 1 : 0
        if (in_sec) saw_sec = 1
        print; next
    }
    {
        if (in_sec && match($0, /^[[:space:]]*([a-z_]+)[[:space:]]*=/, m) && (m[1] in upd)) {
            k = m[1]; print k " = " upd[k]; done_k[k] = 1; next
        }
        print
    }
    END {
        if (in_sec) flush_missing()
        else if (!saw_sec) { print ""; print "[" sec_name "]"; flush_missing() }
    }' "$CONF_FILE" > "$tmp_conf"
    chmod 0644 "$tmp_conf"
    chown root:root "$tmp_conf" 2>/dev/null || true
    mv -f "$tmp_conf" "$CONF_FILE"
}

cmd_config_stdin() {
    local -A upd_vault=() upd_ident=()
    local count=0 line k v arr_v
    while IFS= read -r line && (( count < 20 )); do
        count=$((count + 1))
        line="${line//$'\r'/}"
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -n "$line" ]] || continue
        [[ "$line" == *"="* ]] || { log_err "Invalid config line"; exit 2; }
        k="${line%%=*}"; v="${line#*=}"
        k="$(printf '%s' "$k" | tr -d '[:space:]')"
        v="$(printf '%s' "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        case "$k" in
            protocol)
                [[ "$v" =~ ^(smb|nfs|ssh|local)$ ]] || { log_err "Invalid protocol: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            host|ssh_user)
                [[ -z "$v" || "$v" =~ ^[a-zA-Z0-9_.:-]{1,64}$ ]] || { log_err "Invalid $k: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            mountpoint|remote_path)
                [[ -z "$v" || ( "$v" != *".."* && "$v" =~ ^/[a-zA-Z0-9_./{}\$-]{1,96}$ ) ]] || { log_err "Invalid path $k: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            mount_visibility)
                v="${v,,}"
                [[ "$v" =~ ^(symlink|filemanager|both|none)$ ]] || { log_err "Invalid mount_visibility: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            user_symlink_dir)
                [[ -z "$v" || ( "$v" != *".."* && "$v" =~ ^(~/[a-zA-Z0-9_./{}\$-]{1,62}|/[a-zA-Z0-9_./{}\$-]{1,63})$ ) ]] || { log_err "Invalid user_symlink_dir: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            smb_version)
                v="${v,,}"
                [[ "$v" =~ ^(auto|3\.1\.1|3\.0|2\.1|2\.0|1\.0)$ ]] || { log_err "Invalid smb_version: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            port)
                [[ -z "$v" || ( "$v" =~ ^[0-9]{1,5}$ && "$v" -ge 1 && "$v" -le 65535 ) ]] || { log_err "Invalid port: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            mount_opts)
                [[ -z "$v" || ( "$v" != *".."* && "$v" =~ ^[a-zA-Z0-9_.,=:/-]{1,128}$ ) ]] || { log_err "Invalid mount_opts: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            smb_creds_file)
                [[ -z "$v" || "${v,,}" == "guest" || ( "$v" != *".."* && "$v" =~ ^/etc/[a-zA-Z0-9_./-]{1,80}$ ) ]] || { log_err "Invalid creds path: $v"; exit 2; }
                [[ "${v,,}" == "guest" ]] && v="guest"
                upd_vault["$k"]="\"$v\"" ;;
            shares)
                arr_v=$(toml_format_str_array "$v") || { log_err "Invalid shares list"; exit 2; }
                upd_vault["shares"]="$arr_v" ;;
            backup_root_subdir|pkglist_subdir)
                [[ -z "$v" || ( "$v" != *".."* && "$v" =~ ^[a-zA-Z0-9_./-]{1,96}$ ) ]] || { log_err "Invalid subdir $k: $v"; exit 2; }
                upd_vault["$k"]="\"$v\"" ;;
            sys_alias)
                [[ "$v" =~ ^[a-z0-9_-]{1,16}$ ]] || { log_err "Invalid sys_alias: $v"; exit 2; }
                upd_ident["$k"]="\"$v\"" ;;
            sys_folder)
                [[ "$v" =~ ^[a-zA-Z0-9_.-]{1,64}$ && "$v" != *".."* ]] || { log_err "Invalid sys_folder: $v"; exit 2; }
                upd_ident["$k"]="\"$v\"" ;;
            *)
                log_err "Unknown config key: $k"; exit 2 ;;
        esac
    done

    if (( ${#upd_vault[@]} > 0 )); then
        local sp=""
        for k in "${!upd_vault[@]}"; do sp+="${k}=${upd_vault[$k]}"$'\n'; done
        apply_toml_kv_section "vault" "$sp"
    fi
    if (( ${#upd_ident[@]} > 0 )); then
        local sp=""
        for k in "${!upd_ident[@]}"; do sp+="${k}=${upd_ident[$k]}"$'\n'; done
        apply_toml_kv_section "identity" "$sp"
    fi
    (( ${#upd_vault[@]} + ${#upd_ident[@]} > 0 )) || { log_err "No valid updates."; exit 2; }

    load_vault_config
    detect_hardware_trust
    cat > "${NC_PROFILE_FILE}.tmp.$$" <<EOF
# Managed by NC-UI nc-vault
NC_SYS_ALIAS="${CFG_SYS_ALIAS}"
NC_SYS_FOLDER="${CFG_SYS_FOLDER}"
NC_SYS_HOSTNAME="${CFG_HOSTNAME}"
NC_SYS_UUID="${CFG_HW_UUID:-$CURRENT_UUID}"
NC_SYS_IS_WSL="false"
NC_NAS_MOUNTPOINT="${CFG_MOUNTPOINT}"
EOF
    chmod 0644 "${NC_PROFILE_FILE}.tmp.$$"
    chown root:root "${NC_PROFILE_FILE}.tmp.$$" 2>/dev/null || true
    mv -f "${NC_PROFILE_FILE}.tmp.$$" "$NC_PROFILE_FILE"
    log_ok "Updated vault configuration in ${CONF_FILE}."
}

# ==============================================================================
# ROUTING
# ==============================================================================
ORIG_ARGS=("$@")
ACTION="${1:-status}"
case "$ACTION" in
    -h|--help) usage ;;
esac

load_vault_config
detect_hardware_trust

case "$ACTION" in
    status|--status)  cmd_status; exit 0 ;;
    status-env)       cmd_status_env; exit 0 ;;
    pkglist-tsv)      cmd_pkglist_tsv; exit 0 ;;
esac

if [[ "${NC_VAULT_ALLOW_NONROOT:-0}" != "1" && $EUID -ne 0 ]]; then
    if [[ -t 0 || -t 1 ]]; then
        self_bin="$(realpath -e "$0" 2>/dev/null || printf '%s' "$0")"
        exec sudo "$self_bin" "${ORIG_ARGS[@]}"
    fi
    log_err "Root privileges required."
    exit 1
fi

mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR" 2>/dev/null || true
exec 201>"${RUN_DIR}/nc-vault.lock"
flock -n 201 || { log_err "Another ${0##*/} instance is running."; exit 1; }

case "$ACTION" in
    mount)          cmd_mount ;;
    remount|-r)     cmd_umount || true; cmd_mount ;;
    umount|-u)      cmd_umount ;;
    creds-stdin)    cmd_creds_stdin ;;
    ssh-push)       cmd_ssh_push ;;
    pkglist)        cmd_pkglist_stdin <<< "${2:-snapshot}" ;;
    pkglist-stdin)  cmd_pkglist_stdin ;;
    config-stdin)   cmd_config_stdin ;;
    *)              log_err "Unknown action: $ACTION"; exit 1 ;;
esac
