#!/usr/bin/env bash
# ==============================================================================
# /usr/lib/ncui/sbin/nc-vault
# Generalized Multi-Protocol Vault Mount, Hardware Attestation & Pkglist Helper
# Supports: smb (CIFS), nfs (NFSv4), ssh (SSHFS / Rsync staging), local
# ==============================================================================
set -euo pipefail
shopt -s extglob

CONF_FILE="${NC_RESILIENCE_CONF:-/etc/ncui/resilience.toml}"
NC_PROFILE_FILE="${NC_PROFILE_FILE:-/etc/nc.profile}"
MOUNTINFO_PATH="${NC_VAULT_MOUNTINFO:-/proc/self/mountinfo}"
DMI_UUID_PATH="${NC_VAULT_DMI_UUID:-/sys/class/dmi/id/product_uuid}"
RUN_DIR="${NC_VAULT_RUN_DIR:-/run/nc-vault}"

if [[ -t 1 ]]; then
    C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_SLATE=$'\033[38;5;110m'
    C_MINT=$'\033[38;5;114m' C_PEACH=$'\033[38;5;216m' C_ROSE=$'\033[38;5;203m'
else
    C_RESET='' C_BOLD='' C_SLATE='' C_MINT='' C_PEACH='' C_ROSE=''
fi

log_info() { printf " %b[*]%b %s\n" "$C_SLATE" "$C_RESET" "$*"; }
log_ok()   { printf " %b[+]%b %s\n" "$C_MINT"  "$C_RESET" "$*"; }
log_warn() { printf " %b[!]%b %s\n" "$C_PEACH" "$C_RESET" "$*" >&2; }
log_err()  { printf " %b[-]%b %s\n" "$C_ROSE"  "$C_RESET" "$*" >&2; }

usage() {
    local prog="${0##*/}"
    cat <<EOF
Usage: ${prog} <ACTION>

Actions:
  status, --status      Human-readable vault status
  status-env            Machine-readable KEY=VALUE vault status
  mount                 Mount or initialize configured vault backend
  remount               Unmount then re-mount vault backend
  umount, -u            Unmount vault backend (auto-pushes SSH staging if active)
  creds-stdin           Read 'user\\npass\\npersist(0|1)' on stdin, verify & mount SMB
  ssh-push              Push staged local SSH vault directory back to remote
  pkglist [label]       Export installed packages list to vault pkglists (default: snapshot)
  pkglist-stdin         Export installed packages list to vault pkglists using stdin label
  pkglist-tsv           List saved pkglists as TSV
  config-stdin          Update [vault] / [identity] in ${CONF_FILE} and sync /etc/nc.profile
  -h, --help            Show this help
EOF
    exit 0
}

CFG_SYS_ALIAS=""
CFG_HOSTNAME=""
CFG_HW_UUID=""
CFG_SYS_FOLDER=""
CFG_PROTOCOL="smb"
CFG_HOST=""
CFG_MOUNTPOINT="/nas"
CFG_SSH_USER=""
CFG_REMOTE_PATH=""
CFG_SMB_CREDS="/etc/samba/nas-cred"
CFG_SHARES=()
CFG_BACKUP_SUBDIR=""
CFG_PKGLIST_SUBDIR=""
CFG_MOUNT_VISIBILITY="symlink"
CFG_USER_SYMLINK_DIR="~/NAS"
CFG_SMB_VERSION="auto"
CFG_PORT=""
CFG_MOUNT_OPTS=""

expand_user_tokens() {
    local p="${1:-}" tilde_pfx="~/"
    [[ -n "$p" ]] || { printf ''; return 0; }
    local u="${CALLING_USER:-root}" h="${USER_HOME:-/root}"
    p="${p//\$USER/$u}"
    p="${p//\{user\}/$u}"
    if [[ "$p" == "~" ]]; then
        p="$h"
    elif [[ "$p" == "~/"* ]]; then
        p="${h%/}/${p#"$tilde_pfx"}"
    fi
    printf '%s' "$p"
}

share_remote_part() {
    local s="$1"
    if [[ "$s" == *":/"* ]]; then
        printf '%s' "${s%%:/*}"
    else
        printf '%s' "$s"
    fi
}

share_mount_name() {
    local r
    r="$(share_remote_part "$1")"
    r="${r%/}"
    printf '%s' "${r##*/}"
}

share_target_dir() {
    local s="$1" base_mp="$2" tgt=""
    if [[ "$SYS_TRUST" == "UNTRUSTED" ]]; then
        tgt="${base_mp%/}/$(share_mount_name "$s")"
    elif [[ "$s" == *":/"* ]]; then
        tgt="/${s#*:/}"
        tgt="$(expand_user_tokens "$tgt")"
    else
        tgt="${base_mp%/}/$(share_mount_name "$s")"
    fi
    tgt="${tgt%/}"
    [[ -n "$tgt" ]] || tgt="/"
    printf '%s' "$tgt"
}

share_label_name() {
    local s="$1" base_mp="${2:-$EFFECTIVE_MP}" tgt lbl
    tgt="$(share_target_dir "$s" "$base_mp")"
    lbl="${tgt##*/}"
    [[ -n "$lbl" ]] || lbl="$(share_mount_name "$s")"
    printf '%s' "$lbl"
}

gvfs_opts_for_label() {
    local raw="$1" safe=""
    case "$CFG_MOUNT_VISIBILITY" in
        filemanager|both)
            safe="${raw//[,[:space:]]/_}"
            [[ -n "$safe" ]] || safe="NAS"
            printf ',x-gvfs-show,x-gvfs-name=%s' "$safe"
            ;;
        *)
            printf ''
            ;;
    esac
}

parse_toml_array() {
    local raw="$1"
    CFG_SHARES=()
    raw="${raw#[}"; raw="${raw%]}"
    local item
    while IFS= read -r -d ',' item || [[ -n "$item" ]]; do
        item="$(printf '%s' "$item" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        item="${item#\"}"; item="${item%\"}"
        item="${item#\'}"; item="${item%\'}"
        if [[ -n "$item" ]]; then
            CFG_SHARES+=("$item")
        fi
    done <<< "${raw},"
    return 0
}

load_vault_config() {
    local host_def os_id="linux"
    host_def="$(uname -n 2>/dev/null | cut -d. -f1 || true)"
    if [[ -r /etc/os-release ]]; then
        os_id="$(awk -F= '/^ID=/{gsub(/["[:space:]]/,"",$2); print tolower($2); exit}' /etc/os-release 2>/dev/null || true)"
        os_id="$(printf '%s' "${os_id:-linux}" | tr -cd 'a-z0-9_-')"
        [[ -n "$os_id" ]] || os_id="linux"
    fi
    CFG_HOSTNAME="${host_def:-linux}"
    CFG_SYS_ALIAS="$(printf '%s' "$CFG_HOSTNAME" | tr '[:upper:]' '[:lower:]' | cut -c1-8)"
    CFG_SYS_FOLDER="${CFG_HOSTNAME}-${os_id}"

    toml_has_alias=0
    toml_has_folder=0
    toml_has_mp=0
    if [[ -r "$CONF_FILE" ]]; then
        local sec="" line k v
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            [[ -n "$line" ]] || continue
            if [[ "$line" =~ ^\[([a-zA-Z0-9_.-]+)\]$ ]]; then
                sec="${BASH_REMATCH[1]}"
                continue
            fi
            if [[ "$sec" == "identity" && "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\"$ ]]; then
                k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
                case "$k" in
                    sys_alias)  CFG_SYS_ALIAS="$v"; [[ -n "$v" ]] && toml_has_alias=1 ;;
                    hostname)   CFG_HOSTNAME="$v" ;;
                    hw_uuid)    CFG_HW_UUID="${v,,}" ;;
                    sys_folder) CFG_SYS_FOLDER="$v"; [[ -n "$v" ]] && toml_has_folder=1 ;;
                esac
                continue
            fi
            [[ "$sec" == "vault" ]] || continue
            if [[ "$line" =~ ^shares[[:space:]]*=[[:space:]]*(\[.*\])$ ]]; then
                parse_toml_array "${BASH_REMATCH[1]}"
                continue
            fi
            if [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\"$ ]]; then
                k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
                case "$k" in
                    protocol)           CFG_PROTOCOL="${v,,}" ;;
                    host)               CFG_HOST="$v" ;;
                    mountpoint)         CFG_MOUNTPOINT="$v"; [[ -n "$v" ]] && toml_has_mp=1 ;;
                    mount_visibility)   CFG_MOUNT_VISIBILITY="${v,,}" ;;
                    user_symlink_dir)   CFG_USER_SYMLINK_DIR="$v" ;;
                    ssh_user)           CFG_SSH_USER="$v" ;;
                    remote_path)        CFG_REMOTE_PATH="$v" ;;
                    smb_creds_file)     CFG_SMB_CREDS="$v" ;;
                    smb_version)        CFG_SMB_VERSION="${v,,}" ;;
                    port)               CFG_PORT="$v" ;;
                    mount_opts)         CFG_MOUNT_OPTS="$v" ;;
                    backup_root_subdir) CFG_BACKUP_SUBDIR="$v" ;;
                    pkglist_subdir)     CFG_PKGLIST_SUBDIR="$v" ;;
                esac
            fi
        done < "$CONF_FILE"
    fi

    # Fallback / backfill from /etc/nc.profile and active /proc/self/mountinfo
    if [[ -r "$NC_PROFILE_FILE" ]]; then
        local pk pv
        while IFS='=' read -r pk pv || [[ -n "$pk" ]]; do
            pk="$(printf '%s' "$pk" | tr -d '[:space:]')"
            [[ -z "$pk" || "$pk" == \#* ]] && continue
            pv="${pv#\"}"; pv="${pv%\"}"
            case "$pk" in
                NC_SYS_ALIAS)      (( toml_has_alias == 0 )) && [[ -n "$pv" ]] && CFG_SYS_ALIAS="$pv" ;;
                NC_SYS_FOLDER)     (( toml_has_folder == 0 )) && [[ -n "$pv" ]] && CFG_SYS_FOLDER="$pv" ;;
                NC_SYS_UUID)       [[ -n "$CFG_HW_UUID" ]] || CFG_HW_UUID="${pv,,}" ;;
                NC_NAS_MOUNTPOINT) (( toml_has_mp == 0 )) && [[ -n "$pv" ]] && CFG_MOUNTPOINT="$pv" ;;
            esac
        done < "$NC_PROFILE_FILE"
    fi

    case "$CFG_PROTOCOL" in
        smb|nfs|ssh|local) ;;
        *) CFG_PROTOCOL="smb" ;;
    esac
    case "$CFG_MOUNT_VISIBILITY" in
        symlink|filemanager|both|none) ;;
        *) CFG_MOUNT_VISIBILITY="symlink" ;;
    esac
    case "$CFG_SMB_VERSION" in
        auto|3.1.1|3.0|2.1|2.0|1.0) ;;
        *) CFG_SMB_VERSION="auto" ;;
    esac
    [[ "$CFG_PORT" =~ ^[0-9]+$ ]] && (( CFG_PORT >= 1 && CFG_PORT <= 65535 )) || CFG_PORT=""

    resolve_calling_user
    CFG_MOUNTPOINT="$(expand_user_tokens "${CFG_MOUNTPOINT:-/nas}")"
    CFG_MOUNTPOINT="${CFG_MOUNTPOINT%/}"
    [[ -n "$CFG_MOUNTPOINT" ]] || CFG_MOUNTPOINT="/nas"
    [[ -n "$CFG_SMB_CREDS" ]] || CFG_SMB_CREDS="/etc/samba/nas-cred"
    if [[ -n "$CFG_USER_SYMLINK_DIR" ]]; then
        USER_NAS_DIR="$(expand_user_tokens "$CFG_USER_SYMLINK_DIR")"
        USER_NAS_DIR="${USER_NAS_DIR%/}"
    else
        USER_NAS_DIR=""
    fi

    # Auto-detect live CIFS/NFS/SSHFS mounts when TOML vault is still unpopulated
    if [[ ( -z "$CFG_HOST" || ${#CFG_SHARES[@]} -eq 0 ) && -r "$MOUNTINFO_PATH" ]]; then
        local _id _pid _maj _rt _mp _rest _fs _src _opts det_host="" det_proto=""
        local -a det_shares=()
        local media_prefix="/run/media/${CALLING_USER}/"
        while read -r _id _pid _maj _rt _mp _rest; do
            [[ -n "$_mp" ]] || continue
            _mp="${_mp//\\040/ }"; _mp="${_mp//\\011/$'\t'}"; _mp="${_mp//\\134/\\}"
            [[ "$_mp" == "$CFG_MOUNTPOINT" || "$_mp" == "${CFG_MOUNTPOINT}/"* || "$_mp" == "/run/nas/"* || "$_mp" == "${media_prefix}"* ]] || continue
            if [[ "$_rest" =~ [[:space:]]-[[:space:]]([^[:space:]]+)[[:space:]]+([^[:space:]]+)[[:space:]]*(.*)$ ]]; then
                _fs="${BASH_REMATCH[1]}"; _src="${BASH_REMATCH[2]}"
                if [[ "$_fs" == "cifs" && "$_src" =~ ^//([^/]+)/([^/]+)$ ]]; then
                    det_proto="${det_proto:-smb}"; det_host="${det_host:-${BASH_REMATCH[1]}}"
                    det_shares+=("${BASH_REMATCH[2]}")
                elif [[ ( "$_fs" == "nfs" || "$_fs" == "nfs4" ) && "$_src" =~ ^([^:]+):(.+)$ ]]; then
                    det_proto="${det_proto:-nfs}"; det_host="${det_host:-${BASH_REMATCH[1]}}"
                    det_shares+=("${BASH_REMATCH[2]#/}")
                elif [[ "$_fs" == "fuse.sshfs" && "$_src" =~ ^([^:@]+@)?([^:]+):(.+)$ ]]; then
                    det_proto="${det_proto:-ssh}"; det_host="${det_host:-${BASH_REMATCH[2]}}"
                    [[ -n "$CFG_SSH_USER" || -z "${BASH_REMATCH[1]}" ]] || CFG_SSH_USER="${BASH_REMATCH[1]%@}"
                    [[ -n "$CFG_REMOTE_PATH" ]] || CFG_REMOTE_PATH="${BASH_REMATCH[3]}"
                fi
            fi
        done < "$MOUNTINFO_PATH"
        [[ -z "$CFG_HOST" && -n "$det_host" ]] && CFG_HOST="$det_host"
        if (( ${#CFG_SHARES[@]} == 0 && ${#det_shares[@]} > 0 )); then
            mapfile -t CFG_SHARES < <(printf '%s\n' "${det_shares[@]}" | LC_ALL=C sort -u)
        fi
    fi

    [[ -n "$CFG_BACKUP_SUBDIR" ]] || CFG_BACKUP_SUBDIR="ncui-vault"
    [[ -n "$CFG_PKGLIST_SUBDIR" ]] || CFG_PKGLIST_SUBDIR="${CFG_BACKUP_SUBDIR%/}/pkglists"
    CFG_BACKUP_SUBDIR="${CFG_BACKUP_SUBDIR#/}"; CFG_BACKUP_SUBDIR="${CFG_BACKUP_SUBDIR%/}"
    CFG_PKGLIST_SUBDIR="${CFG_PKGLIST_SUBDIR#/}"; CFG_PKGLIST_SUBDIR="${CFG_PKGLIST_SUBDIR%/}"
    return 0
}

detect_hardware_trust() {
    CURRENT_UUID=""
    if [[ -r "$DMI_UUID_PATH" ]]; then
        IFS= read -r CURRENT_UUID < "$DMI_UUID_PATH" 2>/dev/null || true
        CURRENT_UUID="${CURRENT_UUID//[[:space:]]/}"
        CURRENT_UUID="${CURRENT_UUID,,}"
    fi
    local live_host=""
    live_host="$(uname -n 2>/dev/null | cut -d. -f1 || true)"
    live_host="${live_host,,}"
    SYS_TRUST="TRUSTED"
    if [[ -n "$CFG_HW_UUID" && -n "$CURRENT_UUID" && "$CURRENT_UUID" != "$CFG_HW_UUID" ]]; then
        SYS_TRUST="UNTRUSTED"
    elif [[ -d "/run/recovery-ram/upper" ]] || grep -Eq '^NC_RECOVERY_IMAGE="?1"?$' "${NC_RECOVERY_ORIGIN_FILE:-/etc/ncui/recovery-origin.env}" 2>/dev/null; then
        SYS_TRUST="RECOVERY"
    fi
    if [[ "$SYS_TRUST" == "UNTRUSTED" && ( "$CFG_PROTOCOL" == "smb" || "$CFG_PROTOCOL" == "nfs" ) ]]; then
        EFFECTIVE_MP="/run/nas"
    else
        EFFECTIVE_MP="$CFG_MOUNTPOINT"
    fi
}

resolve_calling_user() {
    local cand="" pw=""
    if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
        cand="$SUDO_USER"
    elif [[ -n "${DOAS_USER:-}" && "$DOAS_USER" != "root" ]]; then
        cand="$DOAS_USER"
    elif [[ "${PKEXEC_UID:-}" =~ ^[0-9]+$ && "$PKEXEC_UID" != "0" ]]; then
        cand="$PKEXEC_UID"
    elif [[ $EUID -ne 0 && -n "${USER:-}" && "$USER" != "root" ]]; then
        cand="$USER"
    elif [[ -n "${CFG_SSH_USER:-}" && "$CFG_SSH_USER" != "root" ]]; then
        cand="$CFG_SSH_USER"
    else
        cand="root"
    fi
    CALLING_USER="$cand"
    MOUNT_UID=0
    MOUNT_GID=0
    USER_HOME="/root"
    if [[ "$cand" != "root" ]]; then
        if pw="$(getent passwd "$cand" 2>/dev/null)" && [[ -n "$pw" ]]; then
            IFS=: read -r CALLING_USER _ MOUNT_UID MOUNT_GID _ USER_HOME _ <<< "$pw"
            [[ -n "${USER_HOME:-}" ]] || USER_HOME="/root"
        else
            CALLING_USER="root"
        fi
    fi
}

declare -A MOUNTED_PATHS=()
declare -A MOUNTED_UIDS=()
declare -A MOUNTED_FS=()

refresh_mounted_map() {
    MOUNTED_PATHS=()
    MOUNTED_UIDS=()
    MOUNTED_FS=()
    [[ -r "$MOUNTINFO_PATH" ]] || return 0
    local _id _pid _maj _rt _mp _rest _fs
    while read -r _id _pid _maj _rt _mp _rest; do
        [[ -n "$_mp" ]] || continue
        _mp="${_mp//\\040/ }"; _mp="${_mp//\\011/$'\t'}"; _mp="${_mp//\\134/\\}"
        MOUNTED_PATHS["$_mp"]=1
        if [[ "$_rest" =~ uid=([0-9]+) ]]; then
            MOUNTED_UIDS["$_mp"]="${BASH_REMATCH[1]}"
        fi
        if [[ "$_rest" =~ [[:space:]]-[[:space:]]([^[:space:]]+) ]]; then
            MOUNTED_FS["$_mp"]="${BASH_REMATCH[1]}"
        fi
    done < "$MOUNTINFO_PATH"
}

is_mounted() { [[ -n "${MOUNTED_PATHS[$1]:-}" ]]; }
is_dir_empty() {
    local d="$1"
    [[ -d "$d" && ! -L "$d" && -z "$(find "$d" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]
}

get_ssh_agent_sock() {
    local sock="/run/user/${MOUNT_UID}/ssh-agent.socket"
    [[ -S "$sock" ]] && printf '%s' "$sock" || true
}

run_ssh_cmd() {
    local sock
    sock="$(get_ssh_agent_sock)"
    if [[ "$CALLING_USER" != "root" ]] && command -v runuser >/dev/null 2>&1; then
        if [[ -n "$sock" ]]; then
            SSH_AUTH_SOCK="$sock" runuser -u "$CALLING_USER" -- "$@"
        else
            runuser -u "$CALLING_USER" -- "$@"
        fi
    else
        if [[ -n "$sock" ]]; then
            SSH_AUTH_SOCK="$sock" "$@"
        else
            "$@"
        fi
    fi
}

setup_user_symlinks_shares() {
    [[ -n "$USER_HOME" && -d "$USER_HOME" && -w "$USER_HOME" ]] || return 0
    [[ -n "$USER_NAS_DIR" ]] || return 0
    [[ -e "$USER_NAS_DIR" && ! -d "$USER_NAS_DIR" ]] && return 0
    local sh sh_name mp lp cur ensured=0
    for sh in "${CFG_SHARES[@]}"; do
        sh_name="$(share_label_name "$sh" "$EFFECTIVE_MP")"
        mp="$(share_target_dir "$sh" "$EFFECTIVE_MP")"
        is_mounted "$mp" || continue
        if (( ensured == 0 )); then
            mkdir -p "$USER_NAS_DIR"
            chown "$MOUNT_UID:$MOUNT_GID" "$USER_NAS_DIR"
            chmod 755 "$USER_NAS_DIR"
            ensured=1
        fi
        lp="${USER_NAS_DIR}/${sh_name}"
        if [[ -L "$lp" ]]; then
            cur="$(readlink "$lp" || true)"
            [[ "$cur" == "$mp" ]] || { ln -sfn "$mp" "$lp"; chown -h "$MOUNT_UID:$MOUNT_GID" "$lp"; }
        elif [[ ! -e "$lp" ]]; then
            ln -s "$mp" "$lp"
            chown -h "$MOUNT_UID:$MOUNT_GID" "$lp"
        fi
    done
}

setup_user_symlink_single() {
    local target="$1" name="${2:-vault}"
    [[ -n "$USER_HOME" && -d "$USER_HOME" && -w "$USER_HOME" ]] || return 0
    [[ -n "$USER_NAS_DIR" ]] || return 0
    mkdir -p "$USER_NAS_DIR"
    chown "$MOUNT_UID:$MOUNT_GID" "$USER_NAS_DIR"
    chmod 755 "$USER_NAS_DIR"
    local lp="${USER_NAS_DIR}/${name}"
    if [[ -L "$lp" || ! -e "$lp" ]]; then
        ln -sfn "$target" "$lp"
        chown -h "$MOUNT_UID:$MOUNT_GID" "$lp"
    fi
}

cleanup_user_symlinks() {
    local force="${1:-0}"
    [[ -n "$USER_HOME" && -n "$USER_NAS_DIR" && -d "$USER_NAS_DIR" && -w "$USER_NAS_DIR" ]] || return 0
    local sh sh_name mp_tgt lp base still_mounted
    for sh in "${CFG_SHARES[@]}"; do
        sh_name="$(share_label_name "$sh" "$EFFECTIVE_MP")"
        mp_tgt="$(share_target_dir "$sh" "$EFFECTIVE_MP")"
        still_mounted=0
        if [[ "$force" != "--force" ]]; then
            if is_mounted "$mp_tgt"; then
                still_mounted=1
            else
                for base in "$EFFECTIVE_MP" "/nas" "/run/nas"; do
                    if is_mounted "${base}/${sh_name}"; then
                        still_mounted=1
                        break
                    fi
                done
            fi
        fi
        (( still_mounted == 1 )) && continue
        lp="${USER_NAS_DIR}/${sh_name}"
        [[ -L "$lp" ]] && rm -f "$lp" 2>/dev/null || true
    done
    lp="${USER_NAS_DIR}/vault"
    if [[ -L "$lp" ]] && ( [[ "$force" == "--force" ]] || ( ! is_mounted "$EFFECTIVE_MP" && [[ ! -f "${EFFECTIVE_MP}/.ncui_ssh_mounted" ]] ) ); then
        rm -f "$lp" 2>/dev/null || true
    fi
    is_dir_empty "$USER_NAS_DIR" && rmdir "$USER_NAS_DIR" 2>/dev/null || true
}

sync_user_symlinks_shares() {
    if [[ ( "$CFG_MOUNT_VISIBILITY" == "symlink" || "$CFG_MOUNT_VISIBILITY" == "both" ) && -n "$USER_NAS_DIR" ]]; then
        setup_user_symlinks_shares
    else
        cleanup_user_symlinks --force
    fi
}

sync_user_symlink_single() {
    local target="$1" name="${2:-vault}"
    if [[ ( "$CFG_MOUNT_VISIBILITY" == "symlink" || "$CFG_MOUNT_VISIBILITY" == "both" ) && -n "$USER_NAS_DIR" ]]; then
        setup_user_symlink_single "$target" "$name"
    else
        cleanup_user_symlinks --force
    fi
}

resolve_active_base() {
    local mp first_name="" first_tgt=""
    if (( ${#CFG_SHARES[@]} > 0 )); then
        first_tgt="$(share_target_dir "${CFG_SHARES[0]}" "$EFFECTIVE_MP")"
        first_name="$(share_label_name "${CFG_SHARES[0]}" "$EFFECTIVE_MP")"
    fi
    if [[ "$CFG_PROTOCOL" == "smb" || "$CFG_PROTOCOL" == "nfs" ]]; then
        if [[ -n "$first_tgt" ]] && is_mounted "$first_tgt"; then
            if [[ "${CFG_SHARES[0]}" == *":/"* ]]; then
                printf '%s' "${first_tgt%/*}"
            else
                printf '%s' "$EFFECTIVE_MP"
            fi
            return 0
        fi
        for mp in "$EFFECTIVE_MP" "/nas" "/run/nas"; do
            if [[ -n "$first_name" ]] && is_mounted "${mp}/${first_name}"; then
                printf '%s' "$mp"
                return 0
            fi
        done
    elif [[ "$CFG_PROTOCOL" == "ssh" ]]; then
        if is_mounted "$EFFECTIVE_MP" || [[ -f "${EFFECTIVE_MP}/.ncui_ssh_mounted" ]]; then
            printf '%s' "$EFFECTIVE_MP"
            return 0
        fi
    elif [[ "$CFG_PROTOCOL" == "local" ]]; then
        if [[ -d "$EFFECTIVE_MP" ]]; then
            printf '%s' "$EFFECTIVE_MP"
            return 0
        fi
    fi
    printf '%s' "$EFFECTIVE_MP"
}

compute_mount_counts() {
    refresh_mounted_map
    MOUNTED_STATE=0
    MOUNTED_CNT=0
    TOTAL_CNT=${#CFG_SHARES[@]}
    ACTIVE_BASE="$(resolve_active_base)"

    case "$CFG_PROTOCOL" in
        smb|nfs)
            (( TOTAL_CNT > 0 )) || TOTAL_CNT=1
            local sh sh_tgt sh_lbl
            for sh in "${CFG_SHARES[@]}"; do
                sh_tgt="$(share_target_dir "$sh" "$ACTIVE_BASE")"
                sh_lbl="$(share_label_name "$sh" "$ACTIVE_BASE")"
                if is_mounted "$sh_tgt" || is_mounted "${ACTIVE_BASE}/${sh_lbl}"; then
                    MOUNTED_CNT=$(( MOUNTED_CNT + 1 ))
                fi
            done
            if (( MOUNTED_CNT > 0 )); then
                MOUNTED_STATE=1
            fi
            ;;
        ssh)
            TOTAL_CNT=1
            if is_mounted "$EFFECTIVE_MP" || [[ -f "${EFFECTIVE_MP}/.ncui_ssh_mounted" ]]; then
                MOUNTED_CNT=1
                MOUNTED_STATE=1
            fi
            ;;
        local)
            TOTAL_CNT=1
            if [[ -d "$EFFECTIVE_MP" ]]; then
                MOUNTED_CNT=1
                MOUNTED_STATE=1
            fi
            ;;
    esac
    return 0
}

