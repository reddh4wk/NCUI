load_golden_resilience_config() {
    if [[ -r "$CONF_FILE" ]]; then
        local sec="" line k v
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%%#*}"
            line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            [[ -n "$line" ]] || continue
            if [[ "$line" =~ ^\[([a-zA-Z0-9_.-]+)\]$ ]]; then
                sec="${BASH_REMATCH[1]}"
                continue
            fi
            if [[ "$line" =~ ^([a-z_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\"$ ]]; then
                k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
                case "${sec}.${k}" in
                    vault.mountpoint)         [[ -n "$v" ]] && CFG_VAULT_MP="${v%/}" ;;
                    vault.backup_root_subdir) [[ -n "$v" ]] && CFG_BACKUP_SUBDIR="${v#/}" && CFG_BACKUP_SUBDIR="${CFG_BACKUP_SUBDIR%/}" ;;
                    snapshots.vg_name)        [[ -n "$v" ]] && CFG_VG_NAME="$v" ;;
                    snapshots.uki_prefix)     [[ -n "$v" ]] && CFG_UKI_PREFIX="$v" ;;
                    recovery.uki_name)        [[ -n "$v" ]] && CFG_RECOVERY_UKI="$v" ;;
                    recovery.golden_subdir)   [[ -n "$v" ]] && CFG_GOLDEN_SUBDIR="${v#/}" && CFG_GOLDEN_SUBDIR="${CFG_GOLDEN_SUBDIR%/}" ;;
                esac
            fi
        done < "$CONF_FILE"
    fi
    return 0
}
