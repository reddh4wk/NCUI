# Maintainer: Damiano <damiano@nightcity.local>
pkgname=nc-matrix
pkgver=1.0.0
pkgrel=2
pkgdesc='High-performance C11/EGL/Wayland & TTY Matrix digital rain engine'
arch=('x86_64')
url='https://nightcity.local/nc-matrix'
license=('MIT')
conflicts=('ncmatrix')
replaces=('ncmatrix')
depends=(
    'gtk3'
    'gtk-layer-shell'
    'pango'
    'cairo'
    'libepoxy'
    'ncurses'
    'wayland'
    'libglvnd'
    'gcc-libs'
)
makedepends=('gcc' 'pkgconf')
source=('nc-matrix.c' 'Makefile' 'nc-matrix.1' 'LICENSE')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
    make -C "$srcdir" OPT_FLAGS="" TARGET=nc-matrix
}

package() {
    make -C "$srcdir" DESTDIR="$pkgdir" PREFIX=/usr TARGET=nc-matrix install
}
