{
    "layer": "top",
    "position": "top",
    "height": 30,
    "keyboard-interactive": true,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "custom/media",
        "custom/settings",
        "custom/calendar",
        "custom/notifications",
        "custom/telegram"
    ],
    "modules-right": [
        "custom/printers",
        "custom/kb_layout",
        "custom/desktop",
        "custom/cliphist",
        "custom/screenshot",
        "custom/audio",
        "custom/netcycle",
        "custom/cpu",
        "custom/ram",
        "custom/gpu",
        "custom/ups",
        "custom/session"
    ],
    "niri/workspaces": {
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "active": "\uf111",
            "default": "\uf111"
        }
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 158,
        "tooltip": false
    },
    "custom/settings": {
        "format": "\uf013",
        "tooltip": false,
        "on-click": "nc-ctl settings"
    },
    "custom/calendar": {
        "class": "module-nc",
        "exec": "nc-bar-agent calendar",
        "return-type": "json",
        "interval": 1,
        "tooltip": false,
        "on-click": "nc-ctl popup calendar",
        "on-click-right": "nc-ctl settings datetime calendar"
    },
    "custom/desktop": {
        "class": "module-nc",
        "exec": "nc-bar-agent display",
        "return-type": "json",
        "interval": 10,
        "tooltip": false,
        "on-click": "nc-ctl popup display",
        "on-click-right": "nc-ctl settings display monitors"
    },
    "custom/cliphist": {
        "format": "\uf0ea",
        "on-click": "nc-ctl popup clipboard",
        "tooltip": false
    },
    "custom/screenshot": {
        "format": "\uf030",
        "tooltip": false,
        "on-click": "nc-ctl popup capture",
        "on-click-right": "nc-ctl action capture repeat"
    },
    "custom/audio": {
        "class": "module-nc",
        "exec": "nc-bar-agent audio",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "nc-ctl popup audio",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "nc-ctl action audio vol-up",
        "on-scroll-down": "nc-ctl action audio vol-down"
    },
    "custom/netcycle": {
        "class": "module-nc",
        "exec": "nc-bar-agent network",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "nc-ctl popup network",
        "on-click-right": "nc-ctl action network cycle-iface",
        "on-click-middle": "nc-ctl action network toggle-unit"
    },
    "custom/cpu": {
        "class": "module-nc",
        "exec": "nc-bar-agent cpu",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "nc-ctl popup cpu",
        "on-click-right": "nc-ctl settings power cpu_ram"
    },
    "custom/ram": {
        "class": "module-nc",
        "exec": "nc-bar-agent ram",
        "return-type": "json",
        "interval": 3,
        "tooltip": false,
        "on-click": "nc-ctl popup ram",
        "on-click-right": "nc-ctl settings power cpu_ram"
    },
    "custom/gpu": {
        "class": "module-nc",
        "exec": "nc-bar-agent gpu",
        "return-type": "json",
        "interval": 2,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "nc-ctl popup gpu",
        "on-click-right": "nc-ctl settings power gpu"
    },
    "custom/ups": {
        "class": "module-nc",
        "exec": "nc-bar-agent ups",
        "return-type": "json",
        "interval": 5,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "nc-ctl popup ups",
        "on-click-right": "nc-ctl settings power ups"
    },
    "custom/printers": {
        "class": "module-nc",
        "exec": "nc-bar-agent printers",
        "return-type": "json",
        "interval": 3,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "nc-ctl popup printers",
        "on-click-right": "nc-ctl settings printers queue"
    },
    "custom/kb_layout": {
        "class": "module-nc",
        "exec": "nc-bar-agent kb_layout",
        "return-type": "json",
        "interval": 2,
        "tooltip": false,
        "on-click": "nc-ctl popup kb_layout",
        "on-click-right": "nc-ctl action kb_layout cycle"
    },
    "custom/notifications": {
        "class": "module-nc",
        "exec": "nc-bar-agent notifications",
        "return-type": "json",
        "interval": 5,
        "tooltip": false,
        "on-click": "nc-ctl popup notifications"
    },
    "custom/telegram": {
        "class": "module-nc",
        "exec": "nc-telegram-status",
        "return-type": "json",
        "interval": 2,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "sh -c 'id=$(niri msg -j windows 2>/dev/null | jq -r \".[] | select((.app_id // \\\"\\\") | test(\\\"telegram\\\"; \\\"i\\\")) | .id\" | head -n1); if [ -n \"$id\" ]; then niri msg action focus-window --id \"$id\"; else nohup sh -c \"Telegram || telegram-desktop\" >/dev/null 2>&1 & fi'",
        "on-click-right": "pkill -f '(^|/)[Tt]elegram(-desktop)?([[:space:]]|$)' >/dev/null 2>&1 || true"
    },
    "tray": {
        "icon-size": 1,
        "spacing": 0,
        "show-passive-items": false,
        "tooltip": false
    },
    "custom/media": {
        "class": "module-nc-media",
        "exec": "nc-bar-agent media",
        "return-type": "json",
        "interval": 2,
        "tooltip": false
    },
    "custom/session": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "nc-ctl popup session",
        "on-click-right": "nc-ctl settings waybar options"
    }
}