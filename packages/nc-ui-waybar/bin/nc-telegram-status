#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NC-UI Telegram Status Agent for Waybar (`custom/telegram`)."""

import json
import subprocess


def _is_telegram_running() -> bool:
    try:
        ret = subprocess.run(
            ["pgrep", "-f", "(^|/)[Tt]elegram(-desktop)?([[:space:]]|$)"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return ret.returncode == 0
    except Exception:
        return False


def main():
    if not _is_telegram_running():
        print(json.dumps({"text": "", "class": "module-nc-empty"}))
        return
    print(json.dumps({
        "text": "\ue217",
        "class": "module-nc",
        "tooltip": "Telegram Desktop",
    }))


if __name__ == "__main__":
    main()
