#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NC-UI System Notification Ingestion Hook for SwayNC / D-Bus."""

import argparse
import datetime
import json
import os
import shutil
import socket
import subprocess
import sys


def _bootstrap_ncui() -> None:
    cur = os.path.dirname(os.path.realpath(__file__))
    while cur and cur != os.path.dirname(cur):
        core_pkg = os.path.join(cur, "packages", "nc-ui-core")
        if os.path.isdir(core_pkg):
            if core_pkg not in sys.path:
                sys.path.insert(0, core_pkg)
            break
        cur = os.path.dirname(cur)
    else:
        for sys_root in ("/usr/lib/ncui", os.path.dirname(os.path.dirname(os.path.realpath(__file__)))):
            if os.path.isdir(sys_root) and sys_root not in sys.path:
                sys.path.insert(0, sys_root)
    from core.paths import bootstrap_sys_path
    bootstrap_sys_path(__file__)


_bootstrap_ncui()

from core.paths import find_bin
from panels.cc_engine_notifications import (
    _get_max_notifications,
    _load_rules,
    get_popup_socket_path,
    is_in_quiet_hours,
    load_notifs,
    save_notifs,
)

_BIN_DIR = os.path.dirname(os.path.realpath(__file__))
POPUP_BIN = find_bin("nc-notify-popup") or os.path.join(_BIN_DIR, "nc-notify-popup")


def _dispatch_popup(item: dict) -> None:
    if shutil.which("swaync-client"):
        try:
            subprocess.Popen(
                ["swaync-client", "--hide-latest"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except Exception:
            pass

    raw = json.dumps(item, ensure_ascii=False)
    sock_path = get_popup_socket_path()
    if os.path.exists(sock_path):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.25)
                s.connect(sock_path)
                s.sendall((raw + "\n").encode("utf-8"))
            return
        except Exception:
            pass

    if POPUP_BIN and os.path.exists(POPUP_BIN):
        try:
            subprocess.Popen(
                [sys.executable, POPUP_BIN, "--payload", raw],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except Exception:
            pass


def record_notification(app_name: str, summary: str, body: str, urgency: str = "normal", notif_id=None) -> None:
    if not summary and not body:
        return

    rules = _load_rules(check_swaync=False)
    muted = [str(a).strip().lower() for a in (rules.get("muted_apps") or []) if a is not None]
    if (app_name or "").strip().lower() in muted:
        return

    urg_levels = {"low": 0, "normal": 1, "critical": 2}
    min_urg = str(rules.get("min_urgency", "low")).lower()
    notif_urg = str(urgency).lower()
    if urg_levels.get(notif_urg, 1) < urg_levels.get(min_urg, 0):
        return

    now = datetime.datetime.now()
    now_ts = int(now.timestamp() * 1000)
    time_str = now.strftime("%H:%M")

    # Clean app name
    app_clean = (app_name or "System").strip()
    if app_clean.lower() == "org.telegram.desktop":
        app_clean = "Telegram Desktop"

    new_item = {
        "id": int(notif_id) if (notif_id and str(notif_id).isdigit()) else now_ts,
        "app_name": app_clean,
        "app": app_clean,
        "title": summary.strip(),
        "body": body.strip(),
        "urgency": notif_urg,
        "time": time_str,
        "deleted": False,
    }

    max_n = _get_max_notifications()
    notifs = load_notifs()

    # Avoid duplicate identical items within 1.5 seconds
    if notifs:
        latest = notifs[0]
        latest_id = latest.get("id")
        if (
            isinstance(latest_id, (int, float))
            and not isinstance(latest_id, bool)
            and latest.get("title") == new_item["title"]
            and latest.get("body") == new_item["body"]
            and latest.get("app_name") == new_item["app_name"]
            and abs(latest_id - new_item["id"]) < 1500
        ):
            return

    notifs.insert(0, new_item)
    notifs = notifs[:max_n]
    save_notifs(notifs)

    if rules.get("popup_enabled") and not rules.get("dnd") and not is_in_quiet_hours(rules, now):
        _dispatch_popup(new_item)


def main():
    parser = argparse.ArgumentParser(description="NC-UI Notification Ingestion")
    parser.add_argument("--app", default=os.environ.get("SWAYNC_APP_NAME", "System"))
    parser.add_argument("--title", default=os.environ.get("SWAYNC_SUMMARY", ""))
    parser.add_argument("--body", default=os.environ.get("SWAYNC_BODY", ""))
    parser.add_argument("--urgency", default=os.environ.get("SWAYNC_URGENCY", "normal"))
    parser.add_argument("--id", default=os.environ.get("SWAYNC_ID", None))
    args, _ = parser.parse_known_args()

    record_notification(
        app_name=args.app,
        summary=args.title,
        body=args.body,
        urgency=args.urgency,
        notif_id=args.id,
    )


if __name__ == "__main__":
    main()
