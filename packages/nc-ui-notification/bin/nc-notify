#!/usr/bin/env bash

CFG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
CONFIG_FILE="${CFG_HOME}/ncui/nc-addons.conf"
[[ -f "$CONFIG_FILE" ]] || [[ ! -f "${CFG_HOME}/nc-ui/nc-addons.conf" ]] || CONFIG_FILE="${CFG_HOME}/nc-ui/nc-addons.conf"

MAX_NOTIFS=""
if [[ -f "$CONFIG_FILE" ]]; then
    MAX_NOTIFS=$(grep -E '^\s*max_notifications\s*=' "$CONFIG_FILE" | tail -n 1 | awk -F= '{print $2}' | tr -d '[:space:]')
fi
[[ "$MAX_NOTIFS" =~ ^[0-9]+$ ]] || MAX_NOTIFS=50

HISTORY_FILE="${CACHE_HOME}/ncui/nc_notifications.json"
LEGACY_HISTORY_FILE="${CACHE_HOME}/nc_notifications.json"

TITLE="Notification"
BODY=""
NOTATION="bash"

while [[ $# -gt 0 ]]; do
    case $1 in
        --title)
            [[ $# -ge 2 ]] || { printf 'nc-notify: missing argument for %s\n' "$1" >&2; exit 2; }
            TITLE="$2"; shift 2 ;;
        --body)
            [[ $# -ge 2 ]] || { printf 'nc-notify: missing argument for %s\n' "$1" >&2; exit 2; }
            BODY="$2"; shift 2 ;;
        --notation)
            [[ $# -ge 2 ]] || { printf 'nc-notify: missing argument for %s\n' "$1" >&2; exit 2; }
            NOTATION="$2"; shift 2 ;;
        *) shift ;;
    esac
done

ansi_to_pango() {
    local text="$1"
    local esc=$'\033'
    
    # Translate literal CSI escape representations into actual ESC[ bytes
    text="${text//\\033\[/${esc}[}"
    text="${text//\\e\[/${esc}[}"
    text="${text//\\x1B\[/${esc}[}"
    text="${text//\\x1b\[/${esc}[}"

    # FONDAMENTALE: Esegui l'escape HTML prima di aggiungere i tag Pango
    text="${text//&/\&amp;}"
    text="${text//</\&lt;}"
    text="${text//>/\&gt;}"

    local out=""
    local open_spans=0
    local IFS="$esc"
    read -r -d '' -a parts < <(printf '%s' "$text") || true

    local csi_re='^\[[0-9:;<=>?]*[@A-Za-z](.*)$'
    out="${parts[0]}"
    for ((i=1; i<${#parts[@]}; i++)); do
        local part="${parts[i]}"
        if [[ $part =~ ^\[([0-9;]*)m(.*)$ ]]; then
            local codes="${BASH_REMATCH[1]}"
            local rest="${BASH_REMATCH[2]}"
            [[ -z "$codes" ]] && codes="0"

            local tags=""
            local IFS_old="$IFS"
            IFS=';'
            read -ra code_arr <<< "$codes"
            IFS="$IFS_old"

            for code in "${code_arr[@]}"; do
                if [[ "$code" == "0" ]]; then
                    while (( open_spans > 0 )); do
                        out+="</span>"
                        ((open_spans--))
                    done
                    tags=""
                else
                    case "$code" in
                        1) tags+=" weight=\"bold\"" ;;
                        3) tags+=" style=\"italic\"" ;;
                        4) tags+=" underline=\"single\"" ;;
                        30) tags+=" foreground=\"#000000\"" ;;
                        31) tags+=" foreground=\"#ff5555\"" ;;
                        32) tags+=" foreground=\"#50fa7b\"" ;;
                        33) tags+=" foreground=\"#f1fa8c\"" ;;
                        34) tags+=" foreground=\"#bd93f9\"" ;;
                        35) tags+=" foreground=\"#ff79c6\"" ;;
                        36) tags+=" foreground=\"#8be9fd\"" ;;
                        37) tags+=" foreground=\"#bbbbbb\"" ;;
                        90) tags+=" foreground=\"#555555\"" ;;
                        91) tags+=" foreground=\"#ff6e6e\"" ;;
                        92) tags+=" foreground=\"#69ff94\"" ;;
                        93) tags+=" foreground=\"#ffffa5\"" ;;
                        94) tags+=" foreground=\"#d6acff\"" ;;
                        95) tags+=" foreground=\"#ff92df\"" ;;
                        96) tags+=" foreground=\"#a4ffff\"" ;;
                        97) tags+=" foreground=\"#ffffff\"" ;;
                    esac
                fi
            done
            if [[ -n "$tags" ]]; then
                out+="<span${tags}>"
                ((open_spans++))
            fi
            out+="$rest"
        elif [[ $part =~ $csi_re ]]; then
            out+="${BASH_REMATCH[1]}"
        else
            out+="$part"
        fi
    done

    while (( open_spans > 0 )); do
        out+="</span>"
        ((open_spans--))
    done
    printf '%s\n' "$out"
}

_escape_xml_text() {
    local s="$1" res=""
    local re_xml='^([^&>]*)(&|>)(.*)$'
    local re_ent='^((amp|lt|gt|quot|apos|#[0-9]+|#[xX][0-9a-fA-F]+);)(.*)$'
    local was_nocase=0
    shopt -q nocasematch && { was_nocase=1; shopt -u nocasematch; }
    while [[ "$s" =~ $re_xml ]]; do
        res+="${BASH_REMATCH[1]}"
        local ch="${BASH_REMATCH[2]}"
        local tail="${BASH_REMATCH[3]}"
        if [[ "$ch" == ">" ]]; then
            res+="&gt;"
        elif [[ "$tail" =~ $re_ent ]]; then
            res+="&${BASH_REMATCH[1]}"
            tail="${BASH_REMATCH[3]}"
        else
            res+="&amp;"
        fi
        s="$tail"
    done
    (( was_nocase )) && shopt -s nocasematch
    printf '%s' "${res}${s}"
}

html_to_pango() {
    local text="$1"
    local out=""
    local sq="'"
    local dq='"'
    local open_tags=()
    local IFS='<'
    read -r -d '' -a parts < <(printf '%s' "$text") || true
    [[ "$text" == *"<" ]] && parts+=("")

    _pop_tag() {
        local want="$1" idx=-1 j
        for ((j=${#open_tags[@]}-1; j>=0; j--)); do
            if [[ "${open_tags[j]}" == "$want" ]]; then
                idx=$j
                break
            fi
        done
        (( idx < 0 )) && return 0
        while (( ${#open_tags[@]} > idx )); do
            local top="${open_tags[-1]}"
            unset 'open_tags[-1]'
            [[ "$top" == "p_span" ]] && out+="</span>" || out+="</${top}>"
        done
    }

    out="$(_escape_xml_text "${parts[0]}")"
    shopt -s nocasematch
    for ((i=1; i<${#parts[@]}; i++)); do
        local part="${parts[i]}"
        if [[ $part =~ ^([^>]*)\>(.*)$ ]]; then
            local tag_content="${BASH_REMATCH[1]}"
            local rest="${BASH_REMATCH[2]}"

            if [[ $tag_content =~ ^p([[:space:]].*)?$ ]]; then
                local attr="${BASH_REMATCH[1]}"
                if [[ $attr =~ color[[:space:]]*:[[:space:]]*([^;\>[:space:]${sq}${dq}]+) ]]; then
                    local col="${BASH_REMATCH[1]//[\"\'<>&]/}"
                    out+="<span foreground=\"${col}\">"
                    open_tags+=("p_span")
                fi
            elif [[ $tag_content == "/p" ]]; then
                _pop_tag "p_span"
                out+=$'\n'
            elif [[ $tag_content =~ ^br([[:space:]]*/)?$ ]]; then
                out+=$'\n'
            elif [[ $tag_content == "strong" || $tag_content == "b" ]]; then
                out+="<b>"
                open_tags+=("b")
            elif [[ $tag_content == "/strong" || $tag_content == "/b" ]]; then
                _pop_tag "b"
            elif [[ $tag_content == "em" || $tag_content == "i" ]]; then
                out+="<i>"
                open_tags+=("i")
            elif [[ $tag_content == "/em" || $tag_content == "/i" ]]; then
                _pop_tag "i"
            elif [[ $tag_content == "u" ]]; then
                out+="<u>"
                open_tags+=("u")
            elif [[ $tag_content == "/u" ]]; then
                _pop_tag "u"
            elif [[ $tag_content =~ ^font[[:space:]]+color=[${sq}${dq}]([^${sq}${dq}]+)[${sq}${dq}] ]]; then
                local col="${BASH_REMATCH[1]//[\"\'<>&]/}"
                out+="<span foreground=\"${col}\">"
                open_tags+=("span")
            elif [[ $tag_content == "/font" ]]; then
                _pop_tag "span"
            elif [[ $tag_content == "span" ]]; then
                out+="<span>"
                open_tags+=("span")
            elif [[ $tag_content == "/span" ]]; then
                _pop_tag "span"
            elif [[ $tag_content =~ ^span[[:space:]]+style=([${sq}${dq}])([^${sq}${dq}]+)\1 ]] || \
                 [[ $tag_content =~ ^span[[:space:]]+style=([^[:space:]${sq}${dq}]+) ]]; then
                local style="${BASH_REMATCH[2]:-${BASH_REMATCH[1]}}"
                if [[ $style =~ color[[:space:]]*:[[:space:]]*([^;]+) ]]; then
                    local col="${BASH_REMATCH[1]}"
                    col="${col%"${col##*[![:space:]]}"}"
                    col="${col//[\"\'<>&]/}"
                    out+="<span foreground=\"$col\">"
                else
                    out+="<span>"
                fi
                open_tags+=("span")
            else
                out+="&lt;$(_escape_xml_text "${tag_content}")&gt;"
            fi
            out+="$(_escape_xml_text "$rest")"
        else
            out+="&lt;$(_escape_xml_text "$part")"
        fi
    done
    shopt -u nocasematch
    while (( ${#open_tags[@]} > 0 )); do
        local top="${open_tags[-1]}"
        unset 'open_tags[-1]'
        [[ "$top" == "p_span" ]] && out+="</span>" || out+="</${top}>"
    done
    printf '%s\n' "$out"
}

if [[ "$NOTATION" == "html" ]]; then
    PANGO_TITLE=$(html_to_pango "$TITLE")
    PANGO_BODY=$(html_to_pango "$BODY")
else
    PANGO_TITLE=$(ansi_to_pango "$TITLE")
    PANGO_BODY=$(ansi_to_pango "$BODY")
fi

mkdir -p "$(dirname "$HISTORY_FILE")"
if [[ ! -f "$HISTORY_FILE" && -f "$LEGACY_HISTORY_FILE" ]]; then
    cp "$LEGACY_HISTORY_FILE" "$HISTORY_FILE" 2>/dev/null || true
fi

if command -v jq >/dev/null 2>&1; then
    NEW_OBJ=$(jq -n --arg title "$PANGO_TITLE" --arg body "$PANGO_BODY" \
        '{"id": (now * 1000 | floor), "title": $title, "body": $body, "deleted": false}')

    TMP_HIST="${HISTORY_FILE}.tmp.$$"
    if [[ -s "$HISTORY_FILE" ]] && jq -e 'type == "array"' "$HISTORY_FILE" >/dev/null 2>&1; then
        jq --argjson new "$NEW_OBJ" --arg max "$MAX_NOTIFS" \
           '[$new] + . | .[:($max | tonumber)]' "$HISTORY_FILE" > "$TMP_HIST" && \
        mv "$TMP_HIST" "$HISTORY_FILE"
    else
        printf '%s\n' "[$NEW_OBJ]" > "$TMP_HIST" && mv "$TMP_HIST" "$HISTORY_FILE"
    fi
else
    python3 - "$HISTORY_FILE" "$PANGO_TITLE" "$PANGO_BODY" "$MAX_NOTIFS" <<'PY'
import json, os, sys, tempfile, time

hist_file, title, body, max_n = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
items = []
if os.path.exists(hist_file):
    try:
        with open(hist_file, "r", encoding="utf-8") as f:
            loaded = json.load(f)
            if isinstance(loaded, list):
                items = loaded
    except Exception:
        items = []
items.insert(0, {"id": int(time.time() * 1000), "title": title, "body": body, "deleted": False})
if max_n >= 0:
    items = items[:max_n]
fd, tmp = tempfile.mkstemp(prefix=".nc_notif_", suffix=".tmp", dir=os.path.dirname(hist_file) or ".")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(items, f, ensure_ascii=False)
    os.replace(tmp, hist_file)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY
fi

if command -v notify-send >/dev/null 2>&1; then
    notify-send "$PANGO_TITLE" "$PANGO_BODY" || exit $?
fi
