#!/usr/bin/env python3
import json
import os
import signal
import sys
import time

def _bootstrap_ncui() -> None:
    cur = os.path.dirname(os.path.realpath(__file__))
    while cur and cur != os.path.dirname(cur):
        core_pkg = os.path.join(cur, "packages", "nc-ui-core")
        if os.path.isdir(core_pkg):
            if core_pkg not in sys.path:
                sys.path.insert(0, core_pkg)
            break
        cur = os.path.dirname(cur)
    else:
        for sys_root in ("/usr/lib/ncui", os.path.dirname(os.path.dirname(os.path.realpath(__file__)))):
            if os.path.isdir(sys_root) and sys_root not in sys.path:
                sys.path.insert(0, sys_root)
    from core.paths import bootstrap_sys_path
    bootstrap_sys_path(__file__)


_bootstrap_ncui()

from core.config import CONFIG
from core import log
from panels.base import load_panel

ACTIVE_POPUP_FILE = "/tmp/nc_ui_active_popup.json"
LEAVE_STAMP_FILE = "/tmp/nc_ui_last_leave.json"


def _read_json(path: str) -> dict:
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _write_json(path: str, data: dict) -> None:
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f)
    except Exception:
        pass


def _remove_file(path: str) -> None:
    try:
        if os.path.exists(path):
            os.remove(path)
    except Exception:
        pass


def _is_pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        with open(f"/proc/{pid}/stat", "r", encoding="utf-8") as f:
            stat_str = f.read()
            if ") Z " in stat_str:
                return False
        return True
    except Exception:
        return False


def _kill_pid(pid: int) -> None:
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(15):
            if not _is_pid_alive(pid):
                return
            time.sleep(0.01)
        os.kill(pid, signal.SIGKILL)
    except Exception:
        pass


def _detach_from_waybar() -> None:
    try:
        pid = os.fork()
        if pid > 0:
            os._exit(0)
    except Exception:
        pass
    try:
        os.setsid()
    except Exception:
        pass
    try:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    except Exception:
        pass
    try:
        devnull_fd = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull_fd, 0)
        os.dup2(devnull_fd, 1)
        os.dup2(devnull_fd, 2)
        if devnull_fd > 2:
            os.close(devnull_fd)
    except Exception:
        pass
    log.install_stderr_logger()


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print("Uso: nc-ctl <popup|settings|action> <panel_id> [args...] [--x <px>]")
        sys.exit(0)

    cmd = args[0]
    pos_args = []
    i = 1
    anchor_x = None
    while i < len(args):
        if args[i] == "--x" and i + 1 < len(args):
            try:
                anchor_x = int(args[i + 1])
            except ValueError:
                pass
            i += 2
            continue
        if not args[i].startswith("-"):
            pos_args.append(args[i].strip())
        i += 1

    if cmd == "action":
        target = pos_args[0] if pos_args else "network"
        if target == "capture":
            active_info = _read_json(ACTIVE_POPUP_FILE)
            old_pid = int(active_info.get("pid", 0))
            if (
                old_pid
                and active_info.get("panel_id") == "capture"
                and active_info.get("mode") == "popup"
                and _is_pid_alive(old_pid)
            ):
                _kill_pid(old_pid)
                _remove_file(ACTIVE_POPUP_FILE)
        act = pos_args[1] if len(pos_args) > 1 else ""
        extra = pos_args[2:] if len(pos_args) > 2 else []
        panel = load_panel(target)
        panel.on_bar_action(act, extra)
        sys.exit(0)

    subtab = ""
    if cmd == "settings":
        mode = "settings"
        target = pos_args[0] if pos_args else ""
        subtab = pos_args[1] if len(pos_args) > 1 else ""
    elif cmd == "popup" and pos_args and pos_args[0] == "settings":
        mode = "settings"
        target = pos_args[1] if len(pos_args) > 1 else ""
        subtab = pos_args[2] if len(pos_args) > 2 else ""
    else:
        mode = "popup"
        target = pos_args[0] if pos_args else "network"

    if mode == "settings" and target and ":" in target:
        target, subtab = [p.strip() for p in target.split(":", 1)]
    if mode == "settings" and target and subtab:
        from core.state import STATE
        STATE.set("control_center", f"subtab_{target}", subtab)

    active_info = _read_json(ACTIVE_POPUP_FILE)
    old_pid = int(active_info.get("pid", 0))
    old_panel = active_info.get("panel_id", "")
    old_mode = active_info.get("mode", "")

    if old_pid and _is_pid_alive(old_pid):
        _kill_pid(old_pid)
        _remove_file(ACTIVE_POPUP_FILE)
        if (mode == "settings" and old_mode == "settings" and not target) or (old_panel == target and old_mode == mode):
            sys.exit(0)
    else:
        leave_info = _read_json(LEAVE_STAMP_FILE)
        if (
            mode == "popup"
            and leave_info.get("panel_id") == target
            and (time.time() - float(leave_info.get("ts", 0.0))) < 0.32
        ):
            _remove_file(LEAVE_STAMP_FILE)
            sys.exit(0)

    _detach_from_waybar()

    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib
    try:
        from gi.repository import GLibUnix
        _unix_signal_add = GLibUnix.signal_add
    except (ImportError, AttributeError):
        _unix_signal_add = GLib.unix_signal_add

    from ui.shell import ShellWindow

    _write_json(ACTIVE_POPUP_FILE, {
        "pid": os.getpid(),
        "panel_id": target,
        "mode": mode,
        "ts": time.time(),
    })

    win_ref = {"win": None}

    def _cleanup_and_quit(*_a):
        tel_mod = sys.modules.get("panels.cc_engine_resources")
        if tel_mod is not None and hasattr(tel_mod, "close_embedded_tuis"):
            try:
                tel_mod.close_embedded_tuis()
            except Exception:
                pass
        cur = _read_json(ACTIVE_POPUP_FILE)
        if int(cur.get("pid", 0)) == os.getpid():
            _remove_file(ACTIVE_POPUP_FILE)
        if win_ref["win"] is not None:
            try:
                win_ref["win"].hide()
                win_ref["win"].destroy()
            except Exception:
                pass
        Gtk.main_quit()
        GLib.timeout_add(120, lambda: os._exit(0))
        return False

    _unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, _cleanup_and_quit)
    _unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, _cleanup_and_quit)

    try:
        log.info(f"nc-ctl {mode} {target or '<last>'} started (pid={os.getpid()})")
        win = ShellWindow(panel_id=target, mode=mode, anchor_x=anchor_x)
        win_ref["win"] = win
        win.connect("destroy", lambda *_: _cleanup_and_quit())
        win.show_all()
        Gtk.main()
    finally:
        tel_mod = sys.modules.get("panels.cc_engine_resources")
        if tel_mod is not None and hasattr(tel_mod, "close_embedded_tuis"):
            try:
                tel_mod.close_embedded_tuis()
            except Exception:
                pass
        cur = _read_json(ACTIVE_POPUP_FILE)
        if int(cur.get("pid", 0)) == os.getpid():
            _remove_file(ACTIVE_POPUP_FILE)
        os._exit(0)


if __name__ == "__main__":
    main()
