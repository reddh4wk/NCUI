#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
_CLI_UI="${REPO_DIR}/packages/nc-resilience/libexec/ncui/nc-cli-ui.sh"
if [[ -r "$_CLI_UI" ]]; then
    # shellcheck source=../packages/nc-resilience/libexec/ncui/nc-cli-ui.sh
    source "$_CLI_UI"
else
    msg_step() { printf '  ⯈ %b\n' "$*"; }
    msg_ok()   { printf '  ✓ %b\n' "$*"; }
    msg_err()  { printf '  ✗ ERROR: %b\n' "$*" >&2; }
    ui_header() { printf '\n  %s\n  %s\n' "$1" "${2:-}"; }
    ui_section() { printf '\n  -- %s --\n' "${2:-$1}"; }
    ui_help_row() { printf '  %-18s %s\n' "$1" "$2"; }
    CLR_SCHEMA='' CLR_RESET='' CLR_VAL='' CLR_INTENT='' CLR_DIM=''
fi

if [[ ! -f "${REPO_DIR}/PKGBUILD" ]]; then
    msg_err "PKGBUILD non trovato in ${REPO_DIR}"
    exit 1
fi

DO_BUILD=1
DO_MAIN=0
DO_RECOVERY=0

usage() {
    local prog="${0##*/}"
    ui_header "${prog^^} — NC-UI PACKAGE BUILDER" "Rigenera e installa i pacchetti split su sistema e recovery"
    printf "\n  %sUsage:%s  %s%s%s %s[opzioni]%s\n" \
        "$CLR_SCHEMA" "$CLR_RESET" "$CLR_VAL" "$prog" "$CLR_RESET" "$CLR_INTENT" "$CLR_RESET"
    ui_section "OPTS" "Opzioni"
    ui_help_row "--main" "Reinstalla i pacchetti compilati sul sistema host (pacman -U)" 18
    ui_help_row "--recovery" "Aggiorna i pacchetti nella recovery SquashFS e rigenera l'UKI" 18
    ui_help_row "--all" "Esegue entrambi (--main --recovery)" 18
    ui_help_row "--no-build" "Salta makepkg -f e riusa i .pkg.tar.zst gia' presenti" 18
    ui_help_row "-h, --help" "Mostra questo messaggio di aiuto" 18
    printf "\n  %sSenza --main ne' --recovery, esegue il solo rebuild con makepkg -f.%s\n\n" "$CLR_DIM" "$CLR_RESET"
}

while (($# > 0)); do
    case "$1" in
        --main)
            DO_MAIN=1
            ;;
        --recovery)
            DO_RECOVERY=1
            ;;
        --all)
            DO_MAIN=1
            DO_RECOVERY=1
            ;;
        --no-build)
            DO_BUILD=0
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            msg_err "Opzione sconosciuta: ${1}"
            usage >&2
            exit 2
            ;;
    esac
    shift
done

cd "$REPO_DIR"

if (( DO_BUILD )); then
    msg_step "Rebuild pacchetti NC-UI in ${REPO_DIR}..."
    makepkg -f
fi

shopt -s nullglob
PKGS=(nc-*.pkg.tar.zst)
shopt -u nullglob

if (( ${#PKGS[@]} == 0 )); then
    msg_err "Nessun pacchetto nc-*.pkg.tar.zst trovato in ${REPO_DIR}"
    exit 1
fi

if (( DO_MAIN || DO_RECOVERY )); then
    msg_step "Copia di ${#PKGS[@]} pacchetti in /var/cache/pacman/pkg/..."
    sudo cp -f "${PKGS[@]}" /var/cache/pacman/pkg/
fi

if (( DO_MAIN )); then
    msg_step "Installazione pacchetti su sistema host (pacman -U)..."
    sudo pacman -U --noconfirm "${PKGS[@]}"
fi

if (( DO_RECOVERY )); then
    msg_step "Aggiornamento recovery SquashFS e UKI (nc-rescue --sync-ncui)..."
    sudo env "NCUI_PKG_DIR=${REPO_DIR}" /usr/bin/nc-rescue --sync-ncui
fi

msg_ok "Operazione completata (${#PKGS[@]} pacchetti)."
