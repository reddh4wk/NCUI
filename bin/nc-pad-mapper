#!/usr/bin/env python3
"""NC-UI Kernel /dev/uinput Controller Compatibility Layer Daemon (`bin/nc-pad-mapper`).

Translates live Linux evdev gamepad events (USB/BT, multi-driver + Xbox Elite paddles)
into virtual Keyboard + Relative Mouse + Wheel events via a single persistent /dev/uinput device,
with calibrated Mouse Look, Mode Shift layer, Macro Studio in-process playback, and niri Auto-Switch.
"""

import argparse
import fcntl
import json
import math
import os
import re
import selectors
import signal
import struct
import subprocess
import sys
import time

ROOT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT_DIR not in sys.path:
    sys.path.insert(0, ROOT_DIR)

from core.pad_mapper_core import (  # noqa: E402
    CONTROLLERS_FILE,
    MACROS_FILE,
    MOUSE_TARGET_TO_EVDEV,
    PAD_MAPPER_PID_FILE,
    PAD_MAPPER_STATUS_FILE,
    WHEEL_TARGETS,
    _BTN_SOUTH,
    _BTN_TL2,
    _BTN_TR2,
    _EVIOCGRAB,
    _EV_ABS,
    _EV_KEY,
    _EV_REL,
    _PROBE_AXES,
    _REL_HWHEEL,
    _REL_WHEEL,
    _REL_X,
    _REL_Y,
    _detect_family,
    apply_stick_calibration,
    compile_macro_events,
    eval_8way_directions,
    eval_trigger_curve,
    load_pad_store,
    match_window_to_profile,
    resolve_evdev_axis_map,
    resolve_evdev_btn_map,
)

UINPUT_PATH = "/dev/uinput"
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
UI_DEV_SETUP = 0x405C5503
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_SET_RELBIT = 0x40045566
EV_SYN = 0x00
SYN_REPORT = 0
BUS_VIRTUAL = 0x06
_EV_STRUCT = struct.Struct("@qqHHi")

_DIR_TO_KEYS = {
    "wasd": {"up": 17, "left": 30, "down": 31, "right": 32},
    "arrows": {"up": 103, "down": 108, "left": 105, "right": 106},
}

_RUNNING = True
_RELOAD_NEEDED = False


def _on_stop(_sig, _frm) -> None:
    global _RUNNING
    _RUNNING = False


def _on_reload(_sig, _frm) -> None:
    global _RELOAD_NEEDED
    _RELOAD_NEEDED = True


def _bitmask_has(hex_line: str, bit_num: int) -> bool:
    if not hex_line:
        return False
    words = hex_line.strip().split()
    word_idx = bit_num // 64
    bit_pos = bit_num % 64
    if word_idx >= len(words):
        return False
    try:
        val = int(words[len(words) - 1 - word_idx], 16)
        return bool((val >> bit_pos) & 1)
    except ValueError:
        return False


def _discover_active_gamepad(prefer_path: str = "") -> dict | None:
    if not os.path.exists("/proc/bus/input/devices"):
        return None
    try:
        txt = open("/proc/bus/input/devices", "r", encoding="utf-8", errors="ignore").read()
    except OSError:
        return None

    cands = []
    for blk in txt.strip().split("\n\n"):
        info = {"vendor": "", "product": "", "name": "", "uniq": "", "handlers": [], "key": ""}
        for ln in blk.splitlines():
            if ln.startswith("I:"):
                m = re.search(r"Vendor=([0-9a-fA-F]+)\s+Product=([0-9a-fA-F]+)", ln)
                if m:
                    info["vendor"], info["product"] = m.group(1).lower(), m.group(2).lower()
            elif ln.startswith("N: Name="):
                info["name"] = ln.split("=", 1)[1].strip().strip('"')
            elif ln.startswith("U: Uniq="):
                info["uniq"] = ln.split("=", 1)[1].strip()
            elif ln.startswith("H: Handlers="):
                info["handlers"] = ln.split("=", 1)[1].strip().split()
            elif ln.startswith("B: KEY="):
                info["key"] = ln.split("=", 1)[1].strip()
        nl = info["name"].lower()
        if not info["name"] or any(s in nl for s in ("touchpad", "motion sensors", "consumer control", "keyboard", "mouse", "nc-ui-")):
            continue
        has_js = any(h.startswith("js") for h in info["handlers"])
        has_gp = _bitmask_has(info["key"], _BTN_SOUTH) or _bitmask_has(info["key"], 0x120)
        if not (has_js or has_gp):
            continue
        ev_h = next((h for h in info["handlers"] if h.startswith("event")), "")
        if not ev_h:
            continue
        ev_path = f"/dev/input/{ev_h}"
        if not os.access(ev_path, os.R_OK):
            continue
        uniq_l = info["uniq"].lower().replace(":", "") or ev_h
        cands.append({
            "id": f"{info['vendor']}_{info['product']}_{uniq_l}",
            "name": info["name"],
            "family": _detect_family(info["name"], info["vendor"], info["product"]),
            "evdev": ev_path,
        })
    if not cands:
        return None
    if prefer_path:
        m = next((c for c in cands if c["evdev"] == prefer_path or c["id"] == prefer_path), None)
        if m:
            return m
    return cands[0]


def _load_hw_profile(dev_id: str) -> dict:
    base = {"layout": "xbox", "curve": "linear", "inner_dz": 8, "outer_th": 95, "trigger_cut": 85, "inv_ly": False, "inv_ry": False, "swap_sticks": False, "cal_lx": 0.0, "cal_ly": 0.0, "cal_rx": 0.0, "cal_ry": 0.0, "stick_calc": "radial"}
    if not dev_id or not os.path.exists(CONTROLLERS_FILE):
        return base
    try:
        data = json.load(open(CONTROLLERS_FILE, "r", encoding="utf-8"))
        if isinstance(data, dict) and isinstance(data.get(dev_id), dict):
            base.update(data[dev_id])
    except Exception:
        pass
    return base


def _load_macros_map() -> dict[str, dict]:
    out: dict[str, dict] = {}
    if not os.path.exists(MACROS_FILE):
        return out
    try:
        data = json.load(open(MACROS_FILE, "r", encoding="utf-8"))
        if isinstance(data, list):
            for idx, m in enumerate(data):
                if isinstance(m, dict):
                    mid = str(m.get("id") or idx)
                    out[mid] = m
    except Exception:
        pass
    return out


def _query_focused_window() -> tuple[str, str]:
    try:
        r = subprocess.run(["niri", "msg", "-j", "focused-window"], capture_output=True, text=True, timeout=1.5)
        if r.returncode == 0 and r.stdout.strip():
            d = json.loads(r.stdout)
            if isinstance(d, dict):
                return str(d.get("app_id") or ""), str(d.get("title") or "")
    except Exception:
        pass
    return "", ""


class PadMapperDaemon:
    def __init__(self, prefer_device: str = ""):
        self.prefer_device = prefer_device
        self.uinput_fd: int = -1
        self.pad_fd: int | None = None
        self.grabbed: bool = False
        self.dev_info: dict | None = None
        self.hw_prof: dict = _load_hw_profile("")
        self.axis_map: dict[str, int | None] = {}
        self.btn_map: dict[int, str] = {}
        self.abs_ranges: dict[int, tuple[int, int]] = {}

        self.store: dict = load_pad_store()
        self.macros_by_id: dict[str, dict] = _load_macros_map()
        self.windows_by_id: dict[int, tuple[str, str]] = {}
        self.focus_app_id, self.focus_title = _query_focused_window()
        self.active_prof: dict | None = None
        self.paused: bool = False

        # Live controller raw state
        self.lx = self.ly = self.rx = self.ry = self.lt = self.rt = 0.0
        self.hat_x = self.hat_y = 0
        self.phys_pressed: set[str] = set()
        self.panic_since: float = 0.0

        # Virtual output state
        self.key_refcounts: dict[int, int] = {}
        self.held_by_ctrl: dict[str, list[int]] = {}
        self.toggled_ctrls: dict[str, list[int]] = {}
        self.turbo_next_ts: dict[str, float] = {}
        self.turbo_state: dict[str, bool] = {}
        self.active_dirs: dict[str, set[str]] = {"l_stick": set(), "r_stick": set()}
        self.dir_codes_held: dict[str, set[int]] = {"l_stick": set(), "r_stick": set()}
        self.rem_mouse: list[float] = [0.0, 0.0]
        self.rem_scroll: list[float] = [0.0, 0.0]
        self.macro_tasks: dict[str, dict] = {}
        self.last_status_sig: tuple = ()

        self.niri_proc: subprocess.Popen | None = None
        self.niri_buf: str = ""
        self.sel = selectors.DefaultSelector()

    # --- /dev/uinput setup & emission ---
    def setup_uinput(self) -> None:
        fd = os.open(UINPUT_PATH, os.O_WRONLY | os.O_NONBLOCK)
        try:
            fcntl.ioctl(fd, UI_SET_EVBIT, _EV_KEY)
            fcntl.ioctl(fd, UI_SET_EVBIT, _EV_REL)
            for kc in range(1, 249):
                fcntl.ioctl(fd, UI_SET_KEYBIT, kc)
            for mcode in MOUSE_TARGET_TO_EVDEV.values():
                fcntl.ioctl(fd, UI_SET_KEYBIT, mcode)
            for rcode in (_REL_X, _REL_Y, _REL_HWHEEL, _REL_WHEEL):
                fcntl.ioctl(fd, UI_SET_RELBIT, rcode)
            setup = struct.pack("@HHHH80sI", BUS_VIRTUAL, 0x4E43, 0x504D, 1, b"nc-ui-virtual-kbm", 0)
            fcntl.ioctl(fd, UI_DEV_SETUP, setup)
            fcntl.ioctl(fd, UI_DEV_CREATE)
            time.sleep(0.08)
            self.uinput_fd = fd
        except Exception:
            os.close(fd)
            raise

    def _emit_raw(self, ev_type: int, code: int, value: int) -> None:
        if self.uinput_fd < 0:
            return
        now = time.time()
        sec = int(now)
        usec = int((now - sec) * 1_000_000)
        os.write(self.uinput_fd, _EV_STRUCT.pack(sec, usec, ev_type, code, int(value)))

    def _syn(self) -> None:
        self._emit_raw(EV_SYN, SYN_REPORT, 0)

    def _press_code(self, code: int) -> None:
        c = self.key_refcounts.get(code, 0)
        self.key_refcounts[code] = c + 1
        if c == 0:
            self._emit_raw(_EV_KEY, code, 1)
            self._syn()

    def _release_code(self, code: int) -> None:
        c = self.key_refcounts.get(code, 0)
        if c <= 1:
            self.key_refcounts.pop(code, None)
            if c == 1:
                self._emit_raw(_EV_KEY, code, 0)
                self._syn()
        else:
            self.key_refcounts[code] = c - 1

    def release_all_virtual(self) -> None:
        for codes in list(self.held_by_ctrl.values()):
            for kc in codes:
                self._release_code(kc)
        self.held_by_ctrl.clear()
        for codes in list(self.toggled_ctrls.values()):
            for kc in codes:
                self._release_code(kc)
        self.toggled_ctrls.clear()
        for skey in ("l_stick", "r_stick"):
            for kc in list(self.dir_codes_held[skey]):
                self._release_code(kc)
            self.dir_codes_held[skey].clear()
            self.active_dirs[skey].clear()
        for task in list(self.macro_tasks.values()):
            for kc in list(task.get("pressed", ())):
                self._release_code(kc)
        self.macro_tasks.clear()
        self.turbo_next_ts.clear()
        self.turbo_state.clear()
        for kc in list(self.key_refcounts.keys()):
            self._emit_raw(_EV_KEY, kc, 0)
        if self.key_refcounts:
            self._syn()
        self.key_refcounts.clear()

    # --- Controller device & niri stream attachment ---
    def attach_gamepad(self) -> bool:
        dev = _discover_active_gamepad(self.prefer_device)
        if not dev:
            return False
        if self.dev_info and dev["evdev"] == self.dev_info["evdev"] and self.pad_fd is not None:
            return True
        self.detach_gamepad()
        try:
            fd = os.open(dev["evdev"], os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            return False
        self.pad_fd = fd
        self.dev_info = dev
        self.hw_prof = _load_hw_profile(dev["id"])
        self.abs_ranges = {}
        init_vals = {}
        for ax in _PROBE_AXES:
            try:
                req = (2 << 30) | (24 << 16) | (ord("E") << 8) | (0x40 + ax)
                buf = bytearray(24)
                fcntl.ioctl(fd, req, buf)
                val, mn, mx, _fz, _fl, _rs = struct.unpack("@6i", buf)
                if mx > mn:
                    self.abs_ranges[ax] = (mn, mx)
                    init_vals[ax] = val
            except OSError:
                pass
        self.axis_map = resolve_evdev_axis_map(self.abs_ranges)
        self.btn_map = resolve_evdev_btn_map(dev["family"])
        for ax, val in init_vals.items():
            self._apply_abs(ax, val)
        self.sel.register(fd, selectors.EVENT_READ, data="pad")
        self._sync_grab()
        self._write_status(force=True)
        return True

    def detach_gamepad(self) -> None:
        self.release_all_virtual()
        self._set_grab(False)
        if self.pad_fd is not None:
            try:
                self.sel.unregister(self.pad_fd)
            except Exception:
                pass
            try:
                os.close(self.pad_fd)
            except OSError:
                pass
            self.pad_fd = None
        self.dev_info = None
        self.phys_pressed.clear()
        self.lx = self.ly = self.rx = self.ry = self.lt = self.rt = 0.0

    def _set_grab(self, enable: bool) -> None:
        if self.pad_fd is None:
            self.grabbed = False
            return
        want = bool(enable)
        if want == self.grabbed:
            return
        try:
            fcntl.ioctl(self.pad_fd, _EVIOCGRAB, 1 if want else 0)
            self.grabbed = want
        except OSError:
            self.grabbed = False

    def _sync_grab(self) -> None:
        want = bool(not self.paused and self.active_prof and self.active_prof.get("exclusive_grab", True))
        self._set_grab(want)

    def start_niri_stream(self) -> None:
        try:
            p = subprocess.Popen(
                ["niri", "msg", "-j", "event-stream"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
            )
            if p.stdout:
                os.set_blocking(p.stdout.fileno(), False)
                self.sel.register(p.stdout, selectors.EVENT_READ, data="niri")
                self.niri_proc = p
        except Exception:
            self.niri_proc = None

    def _on_niri_line(self, line: str) -> None:
        try:
            ev = json.loads(line)
        except Exception:
            return
        if not isinstance(ev, dict):
            return
        changed = False
        if "WindowsChanged" in ev:
            wins = (ev["WindowsChanged"] or {}).get("windows") or []
            self.windows_by_id = {}
            for w in wins:
                wid = int(w.get("id", -1))
                self.windows_by_id[wid] = (str(w.get("app_id") or ""), str(w.get("title") or ""))
                if w.get("is_focused"):
                    self.focus_app_id, self.focus_title = self.windows_by_id[wid]
                    changed = True
        elif "WindowOpenedOrChanged" in ev:
            w = (ev["WindowOpenedOrChanged"] or {}).get("window") or {}
            wid = int(w.get("id", -1))
            if wid >= 0:
                self.windows_by_id[wid] = (str(w.get("app_id") or ""), str(w.get("title") or ""))
                if w.get("is_focused"):
                    self.focus_app_id, self.focus_title = self.windows_by_id[wid]
                    changed = True
        elif "WindowClosed" in ev:
            wid = int((ev["WindowClosed"] or {}).get("id", -1))
            self.windows_by_id.pop(wid, None)
        elif "WindowFocusChanged" in ev:
            wid = (ev["WindowFocusChanged"] or {}).get("id")
            if wid is None:
                self.focus_app_id, self.focus_title = "", ""
            elif int(wid) in self.windows_by_id:
                self.focus_app_id, self.focus_title = self.windows_by_id[int(wid)]
            else:
                self.focus_app_id, self.focus_title = _query_focused_window()
            changed = True
        if changed:
            if self.paused:
                self.paused = False
            self.resolve_active_profile()

    def resolve_active_profile(self) -> None:
        profs = self.store.get("profiles") or []
        new_p = match_window_to_profile(
            profs,
            self.focus_app_id,
            self.focus_title,
            active_id=str(self.store.get("active_profile_id") or ""),
            auto_switch=bool(self.store.get("auto_switch", True)),
        )
        old_id = self.active_prof["id"] if self.active_prof else ""
        new_id = new_p["id"] if new_p else ""
        if old_id != new_id:
            self.release_all_virtual()
        self.active_prof = new_p
        self._sync_grab()
        self._write_status()

    def reload_config(self) -> None:
        self.store = load_pad_store()
        self.macros_by_id = _load_macros_map()
        if self.dev_info:
            self.hw_prof = _load_hw_profile(self.dev_info["id"])
        self.paused = False
        self.resolve_active_profile()
        self._write_status(force=True)

    # --- Evdev axis & button handling ---
    def _norm_axis(self, axis: int, val: int, signed: bool) -> float:
        mn, mx = self.abs_ranges.get(axis, (-32768, 32767) if signed else (0, 255))
        span = max(1, mx - mn)
        u = (float(val) - float(mn)) / float(span)
        return max(-1.0, min(1.0, u * 2.0 - 1.0)) if signed else max(0.0, min(1.0, u))

    def _apply_abs(self, code: int, val: int) -> None:
        am = self.axis_map
        if code == am.get("lx"):
            self.lx = self._norm_axis(code, val, True)
        elif code == am.get("ly"):
            self.ly = self._norm_axis(code, val, True)
        elif code == am.get("rx"):
            self.rx = self._norm_axis(code, val, True)
        elif code == am.get("ry"):
            self.ry = self._norm_axis(code, val, True)
        elif code == am.get("lt"):
            self.lt = self._norm_axis(code, val, False)
            self._update_trigger("lt", self.lt)
        elif code == am.get("rt"):
            self.rt = self._norm_axis(code, val, False)
            self._update_trigger("rt", self.rt)
        elif code == am.get("hat_x"):
            self.hat_x = -1 if val < 0 else (1 if val > 0 else 0)
            self._sync_hat("left", self.hat_x < 0)
            self._sync_hat("right", self.hat_x > 0)
        elif code == am.get("hat_y"):
            self.hat_y = -1 if val < 0 else (1 if val > 0 else 0)
            self._sync_hat("up", self.hat_y < 0)
            self._sync_hat("down", self.hat_y > 0)
        elif code == am.get("lpad_x"):
            nv = self._norm_axis(code, val, True)
            self._sync_hat("left", nv < -0.35)
            self._sync_hat("right", nv > 0.35)
        elif code == am.get("lpad_y"):
            nv = self._norm_axis(code, val, True)
            self._sync_hat("up", nv < -0.35)
            self._sync_hat("down", nv > 0.35)

    def _sync_hat(self, dir_name: str, is_down: bool) -> None:
        cid = f"d{dir_name}"
        if is_down and cid not in self.phys_pressed:
            self._on_ctrl_edge(cid, True)
        elif not is_down and cid in self.phys_pressed:
            self._on_ctrl_edge(cid, False)

    def _update_trigger(self, cid: str, raw_val: float) -> None:
        cut_f = float(self.hw_prof.get("trigger_cut", 85)) / 100.0
        eff = eval_trigger_curve(raw_val, cut_f)
        was_down = cid in self.phys_pressed
        if not was_down and eff >= 0.50:
            self._on_ctrl_edge(cid, True)
        elif was_down and eff < 0.35:
            self._on_ctrl_edge(cid, False)

    def _is_shift_held(self) -> bool:
        if not self.active_prof:
            return False
        binds = self.active_prof.get("binds") or {}
        for cid in self.phys_pressed:
            base = (binds.get(cid) or {}).get("base")
            if isinstance(base, dict) and base.get("kind") == "shift":
                return True
        return False

    def _resolve_ctrl_action(self, cid: str) -> dict | None:
        if not self.active_prof or self.paused:
            return None
        entry = (self.active_prof.get("binds") or {}).get(cid)
        if not isinstance(entry, dict):
            return None
        base = entry.get("base")
        if isinstance(base, dict) and base.get("kind") == "shift":
            return base
        if self._is_shift_held() and isinstance(entry.get("shift"), dict):
            return entry["shift"]
        return base if isinstance(base, dict) else None

    def _spec_codes(self, spec: dict) -> list[int]:
        k = spec.get("kind")
        if k == "key":
            return [int(c) for c in (spec.get("codes") or []) if 0 < int(c) < 256]
        if k == "mouse_btn":
            mc = MOUSE_TARGET_TO_EVDEV.get(str(spec.get("target") or ""))
            return [mc] if mc else []
        return []

    def _on_ctrl_edge(self, cid: str, pressed: bool) -> None:
        if pressed:
            self.phys_pressed.add(cid)
        else:
            self.phys_pressed.discard(cid)

        # Panic Unstick Chord: hold View + Menu >= 0.8s
        if "view" in self.phys_pressed and "menu" in self.phys_pressed:
            if not self.panic_since:
                self.panic_since = time.monotonic()
        else:
            self.panic_since = 0.0

        if not self.active_prof or self.paused:
            return

        if not pressed:
            # Always release held virtual keys & while_held macros even if Shift changed mid-press!
            old = self.held_by_ctrl.pop(cid, [])
            for kc in old:
                self._release_code(kc)
            self.turbo_next_ts.pop(cid, None)
            if self.turbo_state.pop(cid, False):
                for kc in old:
                    self._release_code(kc)
            task = self.macro_tasks.get(cid)
            if task and task.get("pad_mode") == "while_held":
                self._stop_macro_task(cid)
            return

        act = self._resolve_ctrl_action(cid)
        if not act:
            return
        kind = act.get("kind")
        if kind == "shift":
            return

        if kind == "mouse_wheel":
            val = 1 if act.get("target") == "WheelUp" else -1
            self._emit_raw(_EV_REL, _REL_WHEEL, val)
            self._syn()
            if act.get("mode") == "turbo":
                hz = max(2, int(self.active_prof.get("turbo_hz", 12)))
                self.turbo_next_ts[cid] = time.monotonic() + (1.0 / hz)
            return

        if kind in ("key", "mouse_btn"):
            codes = self._spec_codes(act)
            if not codes:
                return
            mode = act.get("mode", "hold")
            if mode == "toggle":
                if cid in self.toggled_ctrls:
                    for kc in self.toggled_ctrls.pop(cid):
                        self._release_code(kc)
                else:
                    self.toggled_ctrls[cid] = list(codes)
                    for kc in codes:
                        self._press_code(kc)
            elif mode == "turbo":
                self.held_by_ctrl[cid] = list(codes)
                self.turbo_state[cid] = True
                for kc in codes:
                    self._press_code(kc)
                hz = max(2, int(self.active_prof.get("turbo_hz", 12)))
                self.turbo_next_ts[cid] = time.monotonic() + (0.5 / hz)
            else:
                self.held_by_ctrl[cid] = list(codes)
                for kc in codes:
                    self._press_code(kc)
            return

        if kind == "macro":
            self._trigger_macro(cid, act)

    def _stop_macro_task(self, cid: str) -> None:
        t_obj = self.macro_tasks.pop(cid, None)
        if t_obj:
            for kc in list(t_obj.get("pressed", ())):
                self._release_code(kc)

    def _trigger_macro(self, cid: str, act: dict) -> None:
        mid = str(act.get("macro_id") or "")
        pad_mode = str(act.get("mode", "once"))
        if pad_mode == "toggle_loop" and cid in self.macro_tasks:
            self._stop_macro_task(cid)
            return
        macro = self.macros_by_id.get(mid)
        if not macro:
            return
        events = compile_macro_events(macro)
        if not events:
            cmd = str(macro.get("cmd") or "").strip()
            if cmd:
                subprocess.Popen(["bash", "-c", cmd], start_new_session=True)
            return
        rep_mode = str(macro.get("repeat_mode", "once"))
        if pad_mode in ("while_held", "toggle_loop"):
            reps = 10**9
        elif rep_mode == "once":
            reps = 1
        elif rep_mode == "count":
            reps = max(1, int(macro.get("repeat_count", 1) or 1))
        else:
            reps = 1
        self._stop_macro_task(cid)
        self.macro_tasks[cid] = {
            "events": events,
            "idx": 0,
            "reps_left": reps,
            "start_t": time.monotonic(),
            "pressed": set(),
            "pad_mode": pad_mode,
        }

    def _read_gamepad_events(self) -> None:
        if self.pad_fd is None:
            return
        try:
            while True:
                data = os.read(self.pad_fd, _EV_STRUCT.size * 32)
                if not data:
                    break
                off = 0
                has_ana_lt = self.axis_map.get("lt") is not None
                has_ana_rt = self.axis_map.get("rt") is not None
                while off + _EV_STRUCT.size <= len(data):
                    _s, _us, ev_t, code, val = _EV_STRUCT.unpack_from(data, off)
                    off += _EV_STRUCT.size
                    if ev_t == _EV_ABS:
                        self._apply_abs(code, val)
                    elif ev_t == _EV_KEY:
                        if code == _BTN_TL2 and not has_ana_lt:
                            self.lt = 1.0 if val else 0.0
                            self._update_trigger("lt", self.lt)
                        elif code == _BTN_TR2 and not has_ana_rt:
                            self.rt = 1.0 if val else 0.0
                            self._update_trigger("rt", self.rt)
                        elif code in self.btn_map:
                            cid = self.btn_map[code]
                            if cid == "lpad_click":
                                cid = "l3"
                            self._on_ctrl_edge(cid, bool(val))
        except BlockingIOError:
            pass
        except OSError:
            self.detach_gamepad()
            self._write_status()

    def _tick_continuous(self, now: float) -> bool:
        if self.panic_since and (now - self.panic_since) >= 0.8 and not self.paused:
            self.paused = True
            self.panic_since = 0.0
            self.release_all_virtual()
            self._sync_grab()
            self._write_status(force=True)
            return False

        if not self.active_prof or self.paused:
            return False

        any_active = False
        raw_lx, raw_ly, raw_rx, raw_ry = self.lx, self.ly, self.rx, self.ry
        if self.hw_prof.get("swap_sticks"):
            raw_lx, raw_ly, raw_rx, raw_ry = raw_rx, raw_ry, raw_lx, raw_ly
        cal_lx, cal_ly = apply_stick_calibration(raw_lx, raw_ly, self.hw_prof, is_right=False)
        cal_rx, cal_ry = apply_stick_calibration(raw_rx, raw_ry, self.hw_prof, is_right=True)

        # 1. Stick processing (8-way WASD/Arrows, Mouse Look, Scroll)
        total_dx = 0
        total_dy = 0
        total_wv = 0
        total_wh = 0
        for skey, (cx, cy) in (("l_stick", (cal_lx, cal_ly)), ("r_stick", (cal_rx, cal_ry))):
            scfg = self.active_prof.get(skey) or {}
            smode = scfg.get("mode", "off")
            if smode == "off":
                continue
            if smode in ("wasd", "arrows"):
                th = float(scfg.get("threshold", 35)) / 100.0
                new_dirs = eval_8way_directions(cx, cy, self.active_dirs[skey], thresh=th)
                self.active_dirs[skey] = new_dirs
                kmap = _DIR_TO_KEYS[smode]
                want_codes = {kmap[d] for d in new_dirs if d in kmap}
                held = self.dir_codes_held[skey]
                for kc in held - want_codes:
                    self._release_code(kc)
                for kc in want_codes - held:
                    self._press_code(kc)
                self.dir_codes_held[skey] = want_codes
                if want_codes:
                    any_active = True
            elif smode == "mouse":
                if math.hypot(cx, cy) > 0.005:
                    any_active = True
                    inv_y = bool(scfg.get("invert_y", False))
                    sens = float(self.active_prof.get("mouse_sens", 18))
                    scale = sens * 1.15
                    sy = -cy if inv_y else cy
                    fx = cx * scale + self.rem_mouse[0]
                    fy = sy * scale + self.rem_mouse[1]
                    dx = int(math.trunc(fx))
                    dy = int(math.trunc(fy))
                    self.rem_mouse[0] = fx - dx
                    self.rem_mouse[1] = fy - dy
                    total_dx += dx
                    total_dy += dy
                else:
                    self.rem_mouse[0] = 0.0
                    self.rem_mouse[1] = 0.0
            elif smode == "scroll":
                if math.hypot(cx, cy) > 0.05:
                    any_active = True
                    ssens = float(self.active_prof.get("scroll_sens", 4)) * 0.08
                    fx = cx * ssens + self.rem_scroll[0]
                    fy = (-cy) * ssens + self.rem_scroll[1]
                    wh = int(math.trunc(fx))
                    wv = int(math.trunc(fy))
                    self.rem_scroll[0] = fx - wh
                    self.rem_scroll[1] = fy - wv
                    total_wh += wh
                    total_wv += wv

        if total_dx or total_dy or total_wv or total_wh:
            if total_dx:
                self._emit_raw(_EV_REL, _REL_X, total_dx)
            if total_dy:
                self._emit_raw(_EV_REL, _REL_Y, total_dy)
            if total_wv:
                self._emit_raw(_EV_REL, _REL_WHEEL, total_wv)
            if total_wh:
                self._emit_raw(_EV_REL, _REL_HWHEEL, total_wh)
            self._syn()

        # 2. Turbo repeats
        if self.turbo_next_ts:
            any_active = True
            hz = max(2, int(self.active_prof.get("turbo_hz", 12)))
            half = 0.5 / hz
            for cid, due in list(self.turbo_next_ts.items()):
                if now >= due:
                    act = self._resolve_ctrl_action(cid)
                    if act and act.get("kind") == "mouse_wheel":
                        val = 1 if act.get("target") == "WheelUp" else -1
                        self._emit_raw(_EV_REL, _REL_WHEEL, val)
                        self._syn()
                        self.turbo_next_ts[cid] = now + (1.0 / hz)
                    else:
                        codes = self.held_by_ctrl.get(cid, [])
                        st = not self.turbo_state.get(cid, False)
                        self.turbo_state[cid] = st
                        for kc in codes:
                            if st:
                                self._press_code(kc)
                            else:
                                self._release_code(kc)
                        self.turbo_next_ts[cid] = now + half

        # 3. In-process Macro Studio scheduler
        if self.macro_tasks:
            any_active = True
            for cid, task in list(self.macro_tasks.items()):
                evs = task["events"]
                while task["idx"] < len(evs):
                    t_ms, kc, val = evs[task["idx"]]
                    if now < task["start_t"] + (t_ms / 1000.0):
                        break
                    task["idx"] += 1
                    if val:
                        self._press_code(kc)
                        task["pressed"].add(kc)
                    else:
                        self._release_code(kc)
                        task["pressed"].discard(kc)
                if task["idx"] >= len(evs):
                    task["reps_left"] -= 1
                    if task["reps_left"] > 0:
                        task["idx"] = 0
                        task["start_t"] = now + 0.02
                    else:
                        self._stop_macro_task(cid)

        return any_active

    def _write_status(self, force: bool = False) -> None:
        st = {
            "running": True,
            "pid": os.getpid(),
            "device_name": self.dev_info["name"] if self.dev_info else "",
            "device_evdev": self.dev_info["evdev"] if self.dev_info else "",
            "active_profile_id": self.active_prof["id"] if self.active_prof else "",
            "active_profile_name": self.active_prof["name"] if self.active_prof else "",
            "app_id": self.focus_app_id,
            "title": self.focus_title[:60],
            "grabbed": self.grabbed,
            "paused": self.paused,
        }
        sig = tuple(st.items())
        if not force and sig == self.last_status_sig:
            return
        self.last_status_sig = sig
        try:
            tmp = f"{PAD_MAPPER_STATUS_FILE}.tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(st, f)
            os.replace(tmp, PAD_MAPPER_STATUS_FILE)
        except OSError:
            pass

    def run(self) -> int:
        global _RELOAD_NEEDED
        self.setup_uinput()
        with open(PAD_MAPPER_PID_FILE, "w", encoding="utf-8") as pf:
            pf.write(str(os.getpid()))
        self.start_niri_stream()
        self.attach_gamepad()
        self.resolve_active_profile()
        self._write_status(force=True)

        last_scan_ts = time.monotonic()
        try:
            while _RUNNING:
                now = time.monotonic()
                if _RELOAD_NEEDED:
                    _RELOAD_NEEDED = False
                    self.reload_config()
                if self.pad_fd is None and (now - last_scan_ts) >= 2.0:
                    last_scan_ts = now
                    self.attach_gamepad()
                need_fast = self._tick_continuous(now)
                timeout = 0.008 if (need_fast or self.panic_since) else 2.0
                for key, _mask in self.sel.select(timeout=timeout):
                    if key.data == "pad":
                        self._read_gamepad_events()
                    elif key.data == "niri":
                        try:
                            chunk = key.fileobj.read()
                        except Exception:
                            chunk = ""
                        if chunk:
                            self.niri_buf += chunk
                            while "\n" in self.niri_buf:
                                ln, self.niri_buf = self.niri_buf.split("\n", 1)
                                if ln.strip():
                                    self._on_niri_line(ln)
                        elif self.niri_proc and self.niri_proc.poll() is not None:
                            try:
                                self.sel.unregister(key.fileobj)
                            except Exception:
                                pass
                            self.niri_proc = None
        finally:
            self.cleanup()
        return 0

    def cleanup(self) -> None:
        self.detach_gamepad()
        if self.niri_proc:
            try:
                if self.niri_proc.stdout:
                    self.sel.unregister(self.niri_proc.stdout)
                self.niri_proc.terminate()
            except Exception:
                pass
            self.niri_proc = None
        if self.uinput_fd >= 0:
            try:
                fcntl.ioctl(self.uinput_fd, UI_DEV_DESTROY)
            except Exception:
                pass
            try:
                os.close(self.uinput_fd)
            except OSError:
                pass
            self.uinput_fd = -1
        for p in (PAD_MAPPER_PID_FILE, PAD_MAPPER_STATUS_FILE):
            try:
                if os.path.exists(p):
                    os.unlink(p)
            except OSError:
                pass


def main() -> int:
    ap = argparse.ArgumentParser(description="NC-UI Controller Compatibility Layer Daemon")
    ap.add_argument("--device", default="", help="Preferred /dev/input/eventX or controller id")
    args = ap.parse_args()
    if not os.access(UINPUT_PATH, os.W_OK):
        sys.stderr.write(f"Cannot write {UINPUT_PATH} (run Unlock uinput first)\n")
        return 1
    signal.signal(signal.SIGTERM, _on_stop)
    signal.signal(signal.SIGINT, _on_stop)
    signal.signal(signal.SIGHUP, _on_reload)
    daemon = PadMapperDaemon(prefer_device=args.device)
    return daemon.run()


if __name__ == "__main__":
    sys.exit(main())
