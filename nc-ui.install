post_install() {
    printf '\n\033[1;93m[NC-UI]\033[0m \033[1;97mRun \033[1;96mnc-ctl setup\033[1;97m as your normal user to link Niri (ncui.kdl) and Waybar.\033[0m\n'
    printf '\033[1;93m[NC-UI]\033[0m Existing Niri/Waybar config files will be \033[1;93mbacked up automatically\033[0m with paths printed on screen (reversible via \033[1;96mnc-ctl setup --restore\033[0m).\n\n'
}
